# BuildingGenerator slot asset: камин (§9.2, §11.1): кирпичный портал шириной w,
# тёмная топка, утопленная в стену, камень предтопка и полка. Локальная рамка
# терминала: низ-центр в origin, лицо +Z (§5.6 lib/arch).

import lib.parts as parts

def slot_version() -> (out: int) {
    out = 1
}

param w: f32 = 1.2
param rng_seed: int = 7

pier_l = parts.slab(size = vec3(0.28, 1.15, 0.35), pos = vec3(0.0 - (w * 0.5 - 0.14), 0.575, 0.0), grp = "brick")
pier_r = parts.slab(size = vec3(0.28, 1.15, 0.35), pos = vec3(w * 0.5 - 0.14, 0.575, 0.0), grp = "brick")
band = parts.slab(size = vec3(w, 0.22, 0.35), pos = vec3(0.0, 1.04, 0.0), grp = "brick")
firebox = parts.slab(size = vec3(w - 0.50, 0.93, 0.02), pos = vec3(0.0, 0.465, 0.0 - 0.14), grp = "iron")
hearth = parts.slab(size = vec3(w + 0.20, 0.04, 0.55), pos = vec3(0.0, 0.02, 0.10), grp = "stone")
mantel = parts.slab(size = vec3(w + 0.16, 0.07, 0.42), pos = vec3(0.0, 1.185, 0.0), grp = "trim")
body = merge(pier_l, pier_r, band, firebox, hearth, mantel)
mesh = set(body, "Cd", ingroup("iron") ? vec3(0.10, 0.09, 0.08) : (ingroup("stone") ? vec3(0.55, 0.54, 0.50) : (ingroup("trim") ? vec3(0.50, 0.36, 0.22) : vec3(0.60, 0.35, 0.28))), domain = faces)
anchors = empty_points()

output mesh
output anchors
