# BuildingGenerator slot asset: дверь в проём (§11.1): терминал door_plain из
# lib/arch/terminals_basic под размер проёма (w — чистая ширина, h — высота).
# Локальная рамка терминала: низ-центр в origin, лицо +Z; ставит BGG.

import lib.arch.terminals_basic as tb

def slot_version() -> (out: int) {
    out = 1
}

param w: f32 = 1.0
param h: f32 = 2.1
param rng_seed: int = 7

door = tb.door_plain(w = w, h = h)
mesh = set(door, "Cd", ingroup("iron") ? vec3(0.20, 0.18, 0.15) : (ingroup("trim") ? vec3(0.62, 0.55, 0.44) : vec3(0.40, 0.28, 0.16)), domain = faces)
anchors = empty_points()

output mesh
output anchors
