# BuildingGenerator slot asset: чистовой пол пространства (§11.1): rect'ы клеток
# пространства минус проёмы (BGG вычитает), тонкая пластина 0.02 на верх плиты.

import Building.lib as bl

def slot_version() -> (out: int) {
    out = 1
}

param rects: geo<points>
param t: f32 = 0.02
param rng_seed: int = 7

mesh = bl.rect_plates(rects = rects, t = t, grp = "wood", col = vec3(0.62, 0.47, 0.30))
anchors = empty_points()

output mesh
output anchors
