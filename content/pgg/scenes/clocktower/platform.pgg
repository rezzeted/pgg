# Островок-платформа часовой башни: скальный лепестковый постамент (SDF — гладкое
# объединение сфер, срезанное плитой, с fbm-рванью по краю), булыжная мостовая
# (poisson-разброс камней по плоскому верху вне пятна дома), парадная лестница вниз
# к причалу и дощатый причал на сваях. Верх платформы — y = 0, лицо — +Z.
# Группы: rock, cobble, stone, wall, wood, brass.

import lib.parts
import lib.shapes
import lib.ironwork
import lib.architecture

def island(rx: f32, rz: f32, h: f32, lobes: int, rng: rng) -> (out: geo<mesh>) {
    """Скальный постамент ~rx×rz (полуоси) высоты h, верх на y = 0: lobes сфер со
    случайным @scale, гладко объединённых (k), fbm-дисплейс краёв, пересечение с плитой
    (плита — первый операнд: bbox грида по ней). Группа rock, нормали auto."""
    expect rx > 2 & rz > 2: "island: слишком маленький постамент"
    # point_cloud: bounds — полный габарит облака (не полуоси).
    centers0 = point_cloud(count = lobes, bounds = vec3(rx * 1.5, 0.0, rz * 1.5), rng = split_rng(rng, key = "lobes"))
    centers = set(centers0, "scale", random(lo = 0.75, hi = 1.0, rng = split_rng(rng, key = "lobe_scale")))
    r0 = min(rx, rz) * 0.5
    blob = sdf_instance_on_points(centers, source = sdf_sphere(r = r0), k = r0 * 0.3)
    # Гарантированный передний фартук под парадную лестницу: до z = rz + 0.6.
    apron = shapes.sdf_box_at(size = vec3(rx * 0.7, h * 3.0, 4.0), pos = vec3(0, 0, rz - 1.4))
    rough = sdf_displace(sdf_union(blob, apron), fbm(@P * 0.28, octaves = 3, rng = split_rng(rng, key = "rough")) * 0.8)
    slab = shapes.sdf_box_at(size = vec3(rx * 3.0, h, rz * 3.0), pos = vec3(0, 0.0 - h * 0.5, 0))
    field = sdf_intersect(slab, rough)
    raw = mesh_from_sdf(field, voxel = 0.28)
    out = mark(compute_normals(raw, mode = auto, angle = 40), "rock", where = true, domain = faces)
}

def cobbles(ground: geo<mesh>, keep_out: vec3, rng: rng) -> (out: geo<mesh>) {
    """Булыжники по плоскому верху ground (грани с @N.y > 0.9), кроме прямоугольника
    |x| < keep_out.x, |z| < keep_out.z под домом: poisson с min_dist 0.3 (дарт-троуинг даёт ~3.5 камня/м², камни слегка перекрываются — плотная мостовая), камень —
    cbox ~0.5×0.18×0.4 в трёх вариантах, @scale/@orient(yaw)/@tint на якорях, утоплен
    на 0.05. Группа cobble."""
    up = dot(@N, (0, 1, 0)) > 0.9
    inside = (abs(dot(@P, (1, 0, 0))) < dot(keep_out, (1, 0, 0))) & (abs(dot(@P, (0, 0, 1))) < dot(keep_out, (0, 0, 1)))
    pts0 = distribute_points(ground, density = (up & !inside) ? 40.0 : 0.0, min_dist = 0.3, rng = split_rng(rng, key = "scatter"))
    pts1 = set(pts0, "scale", random(lo = 0.8, hi = 1.15, rng = split_rng(rng, key = "scale")))
    pts2 = set(pts1, "orient", orient_from_euler(vec3(0, random(lo = 0.0, hi = 180.0, rng = split_rng(rng, key = "yaw")), 0)))
    pts3 = set(pts2, "variant", random_int(n = 3, rng = split_rng(rng, key = "var")))
    shade = random(lo = 0.7, hi = 1.3, rng = split_rng(rng, key = "tint"))
    pts4 = set(pts3, "tint", vec3(shade, shade, shade * 1.03))
    pts = transform(pts4, translate = vec3(0, -0.07, 0))
    s0 = parts.cbox(size = vec3(0.50, 0.18, 0.40), k = 0.25)
    s1 = parts.cbox(size = vec3(0.42, 0.18, 0.42), k = 0.25)
    s2 = parts.cbox(size = vec3(0.58, 0.18, 0.36), k = 0.25)
    out = mark(realize(instance_on_points(pts, source = s0, variants = [s0, s1, s2])), "cobble", where = true, domain = faces)
}

def dock(front_z: f32, drop: f32, w: f32, len: f32, rng: rng) -> (out: geo<mesh>) {
    """Причал перед платформой: лестница шириной w спускается с края front_z на drop
    вниз в +Z (architecture.stair, повёрнутая), дощатый настил w×len на y = −drop,
    четыре сваи с латунными шариками, два кнехта."""
    run = drop * 1.5
    st0 = architecture.stair(run = run, rise = drop, n = int(drop / 0.25), w = w)
    st = transform(transform(st0, rotate = vec3(0, 90, 0)), translate = vec3(0, 0.0 - drop, front_z + run))
    deck0 = parts.plank_panel(w = w + 0.4, h = len, t = 0.12, n = int((w + 0.4) / 0.3), rng = split_rng(rng, key = "deck"))
    deck = transform(transform(deck0, rotate = vec3(90, 0, 0)), translate = vec3(0, 0.0 - drop - 0.06, front_z + run + len * 0.5))
    pile = regroup_wood(ironwork.spool(p0 = vec3(0, 0.0 - drop - 1.2, 0), p1 = vec3(0, 0.0 - drop + 0.7, 0), r0 = 0.12, r1 = 0.10, sides = 8))
    ball = mark(ico_sphere(subdiv = 1, radius = 0.12), "brass", where = true, domain = faces)
    post = merge(pile, transform(ball, translate = vec3(0, 0.0 - drop + 0.78, 0)))
    px = w * 0.5 + 0.1
    z0 = front_z + run + 0.3
    z1 = front_z + run + len - 0.3
    posts = merge(transform(post, translate = vec3(0.0 - px, 0, z0)), transform(post, translate = vec3(px, 0, z0)), transform(post, translate = vec3(0.0 - px, 0, z1)), transform(post, translate = vec3(px, 0, z1)))
    bollard = regroup_wood(ironwork.spool(p0 = vec3(0, 0.0 - drop, 0), p1 = vec3(0, 0.0 - drop + 0.45, 0), r0 = 0.09, r1 = 0.12, sides = 8))
    bollards = merge(transform(bollard, translate = vec3(0.0 - w * 0.25, 0, z1 - 0.4)), transform(bollard, translate = vec3(w * 0.25, 0, z1 - 0.4)))
    out = merge(st, deck, posts, bollards)
}

def regroup_wood(g: geo<mesh>) -> (out: geo<mesh>) {
    """iron → wood для точёных деревянных свай."""
    out = mark(unmark(g, "iron"), "wood", where = true, domain = faces)
}

def platform(rx: f32, rz: f32, h: f32, keep_out: vec3, rng: rng) -> (out: geo<mesh>) {
    """Платформа целиком: скала, мостовая, причал с лестницей (по центру фасада)."""
    rock = island(rx = rx, rz = rz, h = h, lobes = 9, rng = split_rng(rng, key = "island"))
    paving = cobbles(ground = rock, keep_out = keep_out, rng = split_rng(rng, key = "cobbles"))
    pier = dock(front_z = rz + 0.2, drop = 1.6, w = 3.0, len = 3.6, rng = split_rng(rng, key = "dock"))
    out = merge(rock, paving, pier)
}
