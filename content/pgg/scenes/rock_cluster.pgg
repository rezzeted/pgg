param seed: int = 7

# Кластер угловатых валунов «по референсу»: четыре крупных камня разной высоты,
# каждый — гранёный блок с трещинами и мхом на верхних гранях, плюс россыпь
# мелких камешков у подножия. Верх — ось Y (сетка grid/point_cloud плейграундов).
# 
# Приём для гранёности без sdf_plane: пересечение трёх SDF-боксов, два из
# которых повёрнуты случайно (@orient на одиночной точке +
# sdf_instance_on_points), затем лёгкий низкочастотный fbm-дисплейс, чтобы
# грани перестали быть идеально плоскими. Трещины — неглубокие борозды:
# из тела вычитаются тонкие повёрнутые плиты, а результат объединяется с
# усаженной копией тела (sdf_displace с константой = offset) — глубина
# борозды ограничена. Плита тоньше вокселя marching cubes всё равно даёт
# борозду шириной в воксель — поэтому voxel = size·0.015. Мох — группа
# faces «moss» по @N и fbm (в PggViewer: highlight = faces:moss).
def boulder(size: f32 = 2.0, aspect: vec3 = (1.0, 0.9, 0.8), cracks: int = 3, rng: rng) -> (out: geo<mesh>) {
    """Один гранёный валун, стоящий подошвой на y = 0 (утоплен на 10% высоты).
    Пишет: @N (точки), группу moss (faces) — мох на верхних гранях."""
    expect size > 0: "размер в метрах, положительный"
    cut_rng = split_rng(rng, key = "cut")
    yaw_rng = split_rng(rng, key = "cut_yaw")
    cut2_rng = split_rng(rng, key = "cut2")
    yaw2_rng = split_rng(rng, key = "cut2_yaw")
    shape_rng = split_rng(rng, key = "shape")
    site_rng = split_rng(rng, key = "crack_sites")
    tilt_rng = split_rng(rng, key = "crack_tilt")
    moss_rng = split_rng(rng, key = "moss")
    core = sdf_box(size = aspect * size)
    # Два режущих бокса чуть крупнее и повёрнуты: пересечение срезает углы и
    # рёбра первого под разными углами — получается неправильный многогранник.
    pivot0 = point_cloud(count = 1, bounds = (0, 0, 0), rng = cut_rng)
    pivot = set(pivot0, "orient", orient_from_euler(random_vec(lo = vec3(-20, 0, -20), hi = (20, 360, 20), rng = yaw_rng)))
    cutter = sdf_instance_on_points(pivot, source = sdf_box(size = aspect * size * 1.08))
    pivot2_0 = point_cloud(count = 1, bounds = (0, 0, 0), rng = cut2_rng)
    pivot2 = set(pivot2_0, "orient", orient_from_euler(random_vec(lo = vec3(-30, 0, -30), hi = (30, 360, 30), rng = yaw2_rng)))
    cutter2 = sdf_instance_on_points(pivot2, source = sdf_box(size = aspect * size * 1.12))
    faceted = sdf_intersect(sdf_intersect(core, cutter), cutter2)
    # Низкочастотный дисплейс: грани слегка «дышат», силуэт остаётся блочным.
    bumpy = sdf_displace(faceted, fbm(@P * (0.8 / size), octaves = 3, rng = shape_rng) * 0.04 * size)
    # Трещины — неглубокие борозды: тонкие плиты вырезаются из камня, а затем
    # результат объединяется с усаженной копией тела (sdf_displace с
    # константой = offset), так что борозда не проходит глубже crack_depth.
    sites0 = point_cloud(count = cracks, bounds = aspect * size * 0.8, rng = site_rng)
    sites = set(sites0, "orient", orient_from_euler(random_vec(lo = (0, 0, 0), hi = (360, 360, 360), rng = tilt_rng)))
    slabs = sdf_instance_on_points(sites, source = sdf_box(size = vec3(size * 1.6, size * 1.6, size * 0.015)))
    core_inner = sdf_displace(bumpy, size * 0.03)
    cracked = sdf_union(sdf_subtract(bumpy, slabs), core_inner)
    raw = mesh_from_sdf(cracked, voxel = size * 0.015)
    shaped = compute_normals(raw)
    mossy = mark(shaped, "moss", where = (dot(@N, (0, 1, 0)) > 0.75) & (fbm(scale = 2.5 / size, rng = moss_rng) > 0.2), domain = faces)
    out = transform(mossy, translate = vec3(0, dot(aspect, (0, 1, 0)) * size * 0.4, 0))
}

world_rng = rng_from_seed(seed)
r_back = split_rng(world_rng, key = "back")
r_left = split_rng(world_rng, key = "left")
r_right = split_rng(world_rng, key = "right")
r_front = split_rng(world_rng, key = "front")
r_pebble = split_rng(world_rng, key = "pebble")
r_scatter = split_rng(world_rng, key = "scatter")
r_pscale = split_rng(world_rng, key = "pebble_scale")
r_porient = split_rng(world_rng, key = "pebble_orient")

# Композиция как на референсе: высокий камень сзади, два средних по бокам,
# низкий спереди.
back = boulder(size = 3.2, aspect = (0.85, 1.0, 0.75), cracks = 4, rng = r_back)
left = boulder(size = 2.4, aspect = (1.0, 0.85, 0.8), cracks = 4, rng = r_left)
right = boulder(size = 2.1, aspect = (1.0, 0.8, 0.9), cracks = 3, rng = r_right)
front = boulder(size = 1.5, aspect = (1.1, 0.7, 0.9), cracks = 2, rng = r_front)
back_p = transform(back, translate = vec3(-0.3, 0, -1.6))
left_p = transform(left, translate = vec3(-2.9, 0, 0.9), rotate = (0, 20, 0))
right_p = transform(right, translate = vec3(2.5, 0, 0.4), rotate = vec3(0, -15, 0))
front_p = transform(front, translate = vec3(-0.2, 0, 2.4), rotate = (0, 35, 0))
big3 = merge(merge(back_p, left_p), merge(right_p, front_p))

# Россыпь: один маленький валун как источник, инстансы по площадке у подножия
# с разбросом масштаба и поворота.
pebble0 = boulder(size = 0.3, aspect = (1.0, 0.7, 0.85), cracks = 1, rng = r_pebble)
spots0 = point_cloud(count = 14, bounds = (8, 0, 8), rng = r_scatter)
spots1 = set(spots0, "scale", random(lo = 0.6, hi = 1.5, rng = r_pscale))
spots = set(spots1, "orient", orient_from_euler(random_vec(lo = (0, 0, 0), hi = (0, 360, 0), rng = r_porient)))
pebbles = realize(instance_on_points(spots, source = pebble0))

cluster = merge(big3, pebbles)
output cluster
