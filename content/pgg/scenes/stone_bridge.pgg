param seed: int = 7
param len: f32 = 8.4
param width: f32 = 4.6
param arch_r: f32 = 1.1
param rise: f32 = 1.2
param course_h: f32 = 0.26
param gap: f32 = 0.03

import lib.parts
import lib.blockwork
import lib.masonry
import lib.greenery

# Каменный мост по фото-референсу (tmp/bridge): однопролётная полукруглая арка
# из сводчатых клиньев, спандрельные стены рядовой кладкой вразбежку, горбатая
# булыжная мостовая по параболе, низкие парапеты, мох в швах, трава и плети.
# 
# Конструкция — оболочка (сплошного ядра нет):
# 1. Две блочные стены (blockwork.coursed_wall_anchors + realize): арка и верх
# выбираются МАСКАМИ по якорям — радиус 2.0 от центра арки выше пяты (углы
# блоков не влезают в проём: ближайший угол 1.68 > intrados 1.6) и 1.85 ниже,
# верх — по кривой мостовой. Рваные края выборки закрывает кольцо клиньев.
# 2. Кольца вуссуаров на обеих лицевых плоскостях: три фактуры клина
# (masonry.voussoir_field, точные радиальные швы как в stone_arch), якоря по
# дуге тригонометрией в полях, roll = θ − 90° строго, джиттер только
# тангенциальный и по z. Меш одним union → @tint по островам (islands).
# 3. Свод (soffit) — sweep дуги r = arch_r − 0.02 между кольцами; он же затыкает
# радиальные швы клиньев снизу (тёмный «раствор»), сплошного бандажа не надо.
# 4. Швы кладки закрыты тёмными плитами-подложками на тех же якорях (перекрывают
# друг друга, в 3 см за лицевой плоскостью) — сквозь швы не просвечивает.
# 5. Мостовая: булыжники (cbox-варианты) по дуге с креном по уклону; под ними
# зелёная подложка (grid, согнутый по параболе) — мох в швах. Парапеты из
# укрупнённых блоков на той же дуге.
# Ось моста — X (торцы на ±len/2), ширина — Z, верх — Y, подошва на y = 0.
# --- производные размеры (константы файла) ---
half_l = len * 0.5
z_face = width * 0.5
spring_y = 0.3
end_y = 0.95
base_h = 0.3
n_vous = 15
ring_rm = arch_r + 0.15
ring_depth = 0.45
# угловая полуширина клина: половина шага минус зазор, пересчитанный в градусы
vous_half_deg = 90.0 / f32(n_vous) - degrees(gap / ring_rm)

# --- геометрия мостовой (def'ы с полями — формулы в одном месте) ---
def deck_y(x: field<f32>, y0: f32, hump: f32, hl: f32) -> (y: field<f32>) {
    """Высота мостовой над точкой x: парабола через y0 на торцах (±hl) и y0+hump в середине."""
    y = y0 + hump * (1.0 - (x / hl) * (x / hl))
}

def deck_slope(x: field<f32>, hump: f32, hl: f32) -> (s: field<f32>) {
    """Уклон мостовой dy/dx в точке x (для крена блоков по дуге)."""
    s = 0.0 - 2.0 * hump * x / (hl * hl)
}

# --- кладка / мостовая / парапет по якорям ---
def lay_courses(rows: geo<points>, blk: vec3, rng: rng) -> (out: geo<mesh>) {
    """Кладка по якорям coursed_wall_anchors: четыре длины блока (¼/½/¾/полный —
    @variant раскладки), ровный светлый @tint, микроджиттер, realize. Группа stone."""
    a0 = parts.cbox(size = blk * vec3(0.25, 1.0, 1.0), k = 0.14)
    a1 = parts.cbox(size = blk * vec3(0.5, 1.0, 1.0), k = 0.14)
    a2 = parts.cbox(size = blk * vec3(0.75, 1.0, 1.0), k = 0.14)
    a3 = parts.cbox(size = blk, k = 0.14)
    shade = random(lo = 0.86, hi = 1.1, rng = split_rng(rng, key = "tint"))
    p1 = set(rows, "tint", vec3(shade * 1.03, shade, shade * 0.97))
    p2 = set_position(p1, offset = random_vec(lo = vec3(-0.008, -0.008, -0.015), hi = vec3(0.008, 0.008, 0.015), rng = split_rng(rng, key = "jitter")))
    out = mark(realize(instance_on_points(p2, source = a3, variants = [a0, a1, a2, a3])), "stone", where = true, domain = faces)
}

def mortar_skin(rows: geo<points>, z_off: f32, tile_h: f32, x_max: f32) -> (out: geo<mesh>) {
    """Тёмная подложка-«раствор» за кладкой: плоские плитки на тех же якорях со
    смещением z_off вглубь; плитки шире шага и перекрываются — сплошная мембрана.
    Якоря с |x| > x_max отбрасываются, чтобы плитки не вылезали за торцы."""
    tile = box(size = vec3(0.72, tile_h, 0.05))
    kept = delete(rows, where = abs(dot(@P, (1, 0, 0))) > x_max)
    out = mark(realize(instance_on_points(set_position(remove_attr(kept, "variant"), offset = vec3(0, 0, z_off)), source = tile)), "mortar", where = true, domain = faces)
}

def voussoir_ring(z: f32, n: int, rm: f32, y0: f32, half_deg: f32, depth: f32, rng: rng) -> (out: geo<mesh>) {
    """Кольцо арки из n сводчатых клиньев на лицевой плоскости z: якоря по дуге
    (полевая тригонометрия от @index), roll = θ − 90° строго — крен не джиттерится
    (сдвинул бы радиальные плоскости на ±rm·sin δ ≫ gap, урок stone_arch); джиттер
    тангенциальный вдоль дуги и по z. Три фактуры клина по @index % 3, один
    mesh_from_sdf на union, @tint по островам. Группы: stone, moss (верхние грани)."""
    ang = radians(180.0 * (f32(@index) + 0.5) / f32(n))
    p0 = set_position(mesh_line(count = n, length = 0.0), pos = vec3(cos(ang) * rm, y0 + sin(ang) * rm, z))
    p1 = set(p0, "orient", orient_from_euler(vec3(0, 0, degrees(ang) - 90.0)), domain = points)
    jt = random(lo = -0.005, hi = 0.005, rng = split_rng(rng, key = "j_t"))
    jz = random(lo = -0.012, hi = 0.012, rng = split_rng(rng, key = "j_z"))
    p2 = set_position(p1, offset = vec3(0.0 - sin(ang), cos(ang), 0) * jt + vec3(0, 0, 1) * jz)
    f0 = masonry.voussoir_field(radius = rm, height = 0.3, depth = depth, half_deg = half_deg, rng = split_rng(rng, key = "f0"))
    f1 = masonry.voussoir_field(radius = rm, height = 0.3, depth = depth, half_deg = half_deg, rng = split_rng(rng, key = "f1"))
    f2 = masonry.voussoir_field(radius = rm, height = 0.3, depth = depth, half_deg = half_deg, rng = split_rng(rng, key = "f2"))
    s0 = delete(p2, where = @index % 3 != 0)
    s1 = delete(p2, where = @index % 3 != 1)
    s2 = delete(p2, where = @index % 3 != 2)
    u01 = sdf_union(sdf_instance_on_points(s0, source = f0), sdf_instance_on_points(s1, source = f1))
    u = sdf_union(u01, sdf_instance_on_points(s2, source = f2))
    shaped = compute_normals(mesh_from_sdf(u, voxel = 0.012))
    mossy = mark(shaped, "moss", where = (dot(@N, (0, 1, 0)) > 0.75) & (fbm(scale = 3.0, rng = split_rng(rng, key = "moss")) > 0.25), domain = faces)
    ids = promote(islands(mossy), "island_id", from = faces, to = points, mode = first)
    sh = random(lo = 0.88, hi = 1.1, rng = split_rng(rng, key = "tint"), counter = @island_id)
    out = mark(remove_attr(set(ids, "tint", vec3(sh * 1.03, sh, sh * 0.97), domain = points), "island_id"), "stone", where = true, domain = faces)
}

def deck_pavers(rows: geo<points>, blk: vec3, rng: rng) -> (out: geo<mesh>) {
    """Булыжная мостовая по согнутым якорям (крен по уклону уже в @orient): три
    длины, @tint, осадка по высоте. Группа stone."""
    a0 = parts.cbox(size = blk, k = 0.16)
    a1 = parts.cbox(size = blk * vec3(1.15, 1.0, 1.0), k = 0.16)
    a2 = parts.cbox(size = blk * vec3(0.85, 1.0, 1.0), k = 0.16)
    shade = random(lo = 0.88, hi = 1.12, rng = split_rng(rng, key = "tint"))
    p1 = set(rows, "tint", vec3(shade * 1.03, shade, shade * 0.97))
    p2 = set(p1, "variant", random_int(n = 3, rng = split_rng(rng, key = "var")))
    p3 = set_position(p2, offset = random_vec(lo = vec3(0, -0.012, -0.018), hi = vec3(0, 0.004, 0.018), rng = split_rng(rng, key = "settle")))
    laid = mark(realize(instance_on_points(p3, source = a0, variants = [a0, a1, a2])), "stone", where = true, domain = faces)
    out = mark(laid, "moss", where = (dot(@N, (0, 1, 0)) > 0.8) & (fbm(scale = 8.0, octaves = 2, rng = split_rng(rng, key = "moss")) > 0.52), domain = faces)
}

def block_row(anchors: geo<points>, blk: vec3, n_var: int, rng: rng) -> (out: geo<mesh>) {
    """Ряд укрупнённых блоков (парапет, цоколь): n_var длин через @variant,
    @tint, микроджиттер. Группа stone."""
    a0 = parts.cbox(size = blk, k = 0.12)
    a1 = parts.cbox(size = blk * vec3(1.1, 1.0, 1.0), k = 0.12)
    shade = random(lo = 0.86, hi = 1.08, rng = split_rng(rng, key = "tint"))
    p1 = set(anchors, "tint", vec3(shade * 1.03, shade, shade * 0.97))
    p2 = set(p1, "variant", random_int(n = n_var, rng = split_rng(rng, key = "var")))
    p3 = set_position(p2, offset = random_vec(lo = vec3(-0.006, -0.006, -0.01), hi = vec3(0.006, 0.006, 0.01), rng = split_rng(rng, key = "jitter")))
    laid = mark(realize(instance_on_points(p3, source = a0, variants = [a0, a1])), "stone", where = true, domain = faces)
    out = mark(laid, "moss", where = (dot(@N, (0, 1, 0)) > 0.8) & (fbm(scale = 8.0, octaves = 2, rng = split_rng(rng, key = "moss")) > 0.62), domain = faces)
}

# --- rng ---
world_rng = rng_from_seed(seed)
r_wall_f = split_rng(world_rng, key = "wall_f")
r_wall_b = split_rng(world_rng, key = "wall_b")
r_ring_f = split_rng(world_rng, key = "ring_f")
r_ring_b = split_rng(world_rng, key = "ring_b")
r_pav = split_rng(world_rng, key = "pavers")
r_par_f = split_rng(world_rng, key = "parapet_f")
r_par_b = split_rng(world_rng, key = "parapet_b")
r_top_f = split_rng(world_rng, key = "top_f")
r_top_b = split_rng(world_rng, key = "top_b")
r_base_f = split_rng(world_rng, key = "base_f")
r_base_b = split_rng(world_rng, key = "base_b")
r_end_l = split_rng(world_rng, key = "end_l")
r_end_r = split_rng(world_rng, key = "end_r")
r_grass = split_rng(world_rng, key = "grass")
r_vine = split_rng(world_rng, key = "vines")
r_paint = split_rng(world_rng, key = "paint")
r_ao = split_rng(world_rng, key = "ao")

# --- спандрельные стены: якоря кладки + маски арки и мостовой ---
ax = dot(@P, (1, 0, 0))
ay = dot(@P, (0, 1, 0))
arch_d = sqrt(ax * ax + (ay - spring_y) * (ay - spring_y))
arch_hole = ay > spring_y ? arch_d < arch_r + 0.4 : arch_d < arch_r + 0.25
above_deck = ay > deck_y(ax, end_y, rise, half_l) - 0.08
slab_hole = arch_d < arch_r + 0.45 | ay > deck_y(ax, end_y, rise, half_l) - 0.05

wa_f = blockwork.coursed_wall_anchors(S = len, n_rows = 9, course_h = course_h, y0 = base_h, z = z_face - 0.13, L = 0.55, g0 = 0.022)
wa_b = blockwork.coursed_wall_anchors(S = len, n_rows = 9, course_h = course_h, y0 = base_h, z = 0.0 - z_face + 0.13, L = 0.55, g0 = 0.022)
wall_f = lay_courses(delete(wa_f, where = arch_hole | above_deck), blk = vec3(0.55, course_h - 0.02, 0.26), rng = r_wall_f)
wall_b = lay_courses(delete(wa_b, where = arch_hole | above_deck), blk = vec3(0.55, course_h - 0.02, 0.26), rng = r_wall_b)
slab_f = mortar_skin(delete(wa_f, where = slab_hole), z_off = -0.19, tile_h = course_h + 0.05, x_max = half_l - 0.35)
slab_b = mortar_skin(delete(wa_b, where = slab_hole), z_off = 0.19, tile_h = course_h + 0.05, x_max = half_l - 0.35)

# --- кольца вуссуаров и свод ---
ring_f = voussoir_ring(z = z_face - ring_depth * 0.5 + 0.03, n = n_vous, rm = ring_rm, y0 = spring_y, half_deg = vous_half_deg, depth = ring_depth, rng = r_ring_f)
ring_b = voussoir_ring(z = 0.0 - z_face + ring_depth * 0.5 - 0.03, n = n_vous, rm = ring_rm, y0 = spring_y, half_deg = vous_half_deg, depth = ring_depth, rng = r_ring_b)
sang = radians(180.0 * f32(@index) / 16.0)
soffit_prof = set_position(mesh_line(count = 17, length = 0.0), pos = vec3(cos(sang) * (arch_r - 0.02), spring_y + sin(sang) * (arch_r - 0.02), 0))
soffit_path = transform(mesh_line(count = 2, length = 2.0 * (z_face - 0.28), dir = (0, 0, 1)), translate = vec3(0, 0, 0.0 - z_face + 0.28))
soffit = mark(compute_normals(sweep(soffit_path, profile = soffit_prof, profile_closed = false, cap = false)), "mortar", where = true, domain = faces)

# --- мостовая: ряды булыжника по дуге (foreach по точкам-модели рядов) ---
prow = transform(mesh_line(count = 10, length = 3.78, dir = (0, 0, 1)), translate = vec3(0, 0, -1.89))
paver_anchors = foreach row in prow {
    odd = @piece_index % 2
    cnt = 17 - odd
    r0 = mesh_line(count = cnt, length = f32(cnt - 1) * 0.5, dir = (1, 0, 0))
    r1 = transform(r0, translate = vec3(-4.0 + f32(odd) * 0.25, 0, dot(value(@P, on = row), (0, 0, 1))))
    px = dot(@P, (1, 0, 0))
    pz = dot(@P, (0, 0, 1))
    r2 = set_position(r1, pos = vec3(px, deck_y(px, end_y, rise, half_l) + 0.05, pz))
    row = set(r2, "orient", orient_from_euler(vec3(0, 0, degrees(atan(deck_slope(px, rise, half_l))))), domain = points)
}
pavers = deck_pavers(paver_anchors, blk = vec3(0.44, 0.12, 0.37), rng = r_pav)

# Зелёная подложка под булыжником: мох в швах (виден в зазорах между камнями).
ux = dot(@P, (1, 0, 0))
und0 = grid(size = vec2(len + 0.1, width - 0.5), res = (48, 14))
und1 = set_position(und0, pos = vec3(ux, deck_y(ux, end_y, rise, half_l) - 0.04, dot(@P, (0, 0, 1))))
underlay = mark(und1, "moss", where = true, domain = faces)

# --- верхний ряд кладки по дуге (закрывает ступеньку между рядами и парапетом) ---
tx = dot(@P, (1, 0, 0))
top0 = transform(mesh_line(count = 15, length = 7.84, dir = (1, 0, 0)), translate = vec3(-3.92, 0, 0))
top1 = set_position(top0, pos = vec3(tx, deck_y(tx, end_y, rise, half_l) - 0.12, 0))
top_anc = set(top1, "orient", orient_from_euler(vec3(0, 0, degrees(atan(deck_slope(tx, rise, half_l))))), domain = points)
top_f = block_row(transform(top_anc, translate = vec3(0, 0, z_face - 0.13)), blk = vec3(0.52, 0.24, 0.26), n_var = 2, rng = r_top_f)
top_b = block_row(transform(top_anc, translate = vec3(0, 0, 0.0 - z_face + 0.13)), blk = vec3(0.52, 0.24, 0.26), n_var = 2, rng = r_top_b)

# --- парапеты по дуге ---
kx = dot(@P, (1, 0, 0))
par0 = transform(mesh_line(count = 15, length = 7.84, dir = (1, 0, 0)), translate = vec3(-3.92, 0, 0))
par1 = set_position(par0, pos = vec3(kx, deck_y(kx, end_y, rise, half_l) + 0.13, 0))
par2 = set(par1, "orient", orient_from_euler(vec3(0, 0, degrees(atan(deck_slope(kx, rise, half_l))))), domain = points)
par_f = block_row(transform(par2, translate = vec3(0, 0, z_face - 0.14)), blk = vec3(0.52, 0.3, 0.28), n_var = 2, rng = r_par_f)
par_b = block_row(transform(par2, translate = vec3(0, 0, 0.0 - z_face + 0.14)), blk = vec3(0.52, 0.3, 0.28), n_var = 2, rng = r_par_b)

# --- цокольный ряд крупных блоков (с выборкой арки) ---
bx = dot(@P, (1, 0, 0))
by = dot(@P, (0, 1, 0))
base_hole = sqrt(bx * bx + (by - spring_y) * (by - spring_y)) < arch_r + 0.25
base0 = transform(mesh_line(count = 12, length = 7.48, dir = (1, 0, 0)), translate = vec3(-3.74, 0.15, 0))
base_kept = delete(base0, where = base_hole)
base_f = block_row(transform(base_kept, translate = vec3(0, 0, z_face - 0.15)), blk = vec3(0.62, 0.3, 0.3), n_var = 2, rng = r_base_f)
base_b = block_row(transform(base_kept, translate = vec3(0, 0, 0.0 - z_face + 0.15)), blk = vec3(0.62, 0.3, 0.3), n_var = 2, rng = r_base_b)

# --- торцевые стены (короткие, до линии мостовой на торцах) ---
ewa = blockwork.coursed_wall_anchors(S = width - 0.56, n_rows = 4, course_h = course_h, y0 = base_h, z = 0, L = 0.55, g0 = 0.022)
ew_kept = delete(ewa, where = dot(@P, (0, 1, 0)) > end_y + 0.05)
ew_l = transform(lay_courses(ew_kept, blk = vec3(0.55, course_h - 0.02, 0.26), rng = r_end_l), rotate = vec3(0, 90, 0), translate = vec3(0.0 - half_l + 0.13, 0, 0))
ew_r = transform(lay_courses(ew_kept, blk = vec3(0.55, course_h - 0.02, 0.26), rng = r_end_r), rotate = vec3(0, 90, 0), translate = vec3(half_l - 0.13, 0, 0))
es_l = transform(mortar_skin(ew_kept, z_off = -0.16, tile_h = course_h + 0.05, x_max = (width - 0.56) * 0.5 - 0.35), rotate = vec3(0, 90, 0), translate = vec3(0.0 - half_l + 0.16, 0, 0))
es_r = transform(mortar_skin(ew_kept, z_off = -0.16, tile_h = course_h + 0.05, x_max = (width - 0.56) * 0.5 - 0.35), rotate = vec3(0, 90, 0), translate = vec3(half_l - 0.16, 0, 0))

# --- растительность: пучки травы на парапетах и у подножия, плети на стенах ---
g1 = greenery.grass_clump(at = vec3(-3.85, deck_y(-3.85, end_y, rise, half_l) + 0.32, z_face - 0.16), rng = split_rng(r_grass, key = 1))
g2 = greenery.grass_clump(at = vec3(3.88, deck_y(3.88, end_y, rise, half_l) + 0.3, 0.0 - z_face + 0.18), rng = split_rng(r_grass, key = 2))
g3 = greenery.grass_clump(at = vec3(-3.55, deck_y(-3.55, end_y, rise, half_l) + 0.05, 0.0 - z_face + 0.35), rng = split_rng(r_grass, key = 3))
g4 = greenery.grass_clump(at = vec3(3.5, deck_y(3.5, end_y, rise, half_l) + 0.05, z_face - 0.4), rng = split_rng(r_grass, key = 4))
g5 = greenery.grass_clump(at = vec3(-1.2, deck_y(-1.2, end_y, rise, half_l) + 0.04, 0.3), rng = split_rng(r_grass, key = 5))
g6 = greenery.grass_clump(at = vec3(1.7, deck_y(1.7, end_y, rise, half_l) + 0.04, -0.55), rng = split_rng(r_grass, key = 6))
grass = merge(g1, g2, g3, g4, g5, g6)
v1 = transform(greenery.vine(len = 0.8, sway = 0.08, rng = split_rng(r_vine, key = 1)), translate = vec3(1.35, 1.5, z_face + 0.03))
v2 = transform(greenery.vine(len = 0.6, sway = -0.07, rng = split_rng(r_vine, key = 2)), translate = vec3(-1.5, 1.35, z_face + 0.03))
v3 = transform(transform(greenery.vine(len = 0.85, sway = 0.06, rng = split_rng(r_vine, key = 3)), rotate = vec3(0, 180, 0)), translate = vec3(0.5, 1.85, 0.0 - z_face - 0.03))
vines = merge(v1, v2, v3)

# --- сборка и окраска ---
walls = merge(wall_f, wall_b, slab_f, slab_b)
rings = merge(ring_f, ring_b, soffit)
deck = merge(pavers, underlay, par_f, par_b, top_f, top_b)
ends = merge(ew_l, ew_r, es_l, es_r)
bridge_raw = merge(walls, rings, deck, base_f, base_b, ends, grass, vines)

# Светлый известняк: базовый цвет × per-block @tint × низкочастотный fbm; фаски
# (группа edge из cbox) светлее — кромка, по которой читается объём блока.
stone_c = mix(vec3(0.68, 0.66, 0.62), vec3(0.52, 0.5, 0.46), fbm(scale = 1.6, octaves = 3, rng = split_rng(r_paint, key = "stone"))) * @tint
moss_c = mix(vec3(0.14, 0.26, 0.05), vec3(0.3, 0.42, 0.1), fbm(scale = 5.0, octaves = 2, rng = split_rng(r_paint, key = "moss")))
leaf_c = mix(vec3(0.04, 0.16, 0.03), vec3(0.1, 0.34, 0.05), fbm(scale = 6.0, octaves = 2, rng = split_rng(r_paint, key = "leaf"))) * @tint
c1 = ingroup("moss") ? moss_c : stone_c
c2 = ingroup("mortar") ? vec3(0.14, 0.13, 0.115) : c1
c3 = ingroup("grass") ? vec3(0.3, 0.42, 0.07) : c2
c4 = ingroup("leaf") ? leaf_c : c3
edge_mul = ingroup("edge") ? vec3(1.22, 1.2, 1.14) : vec3(1.0)
bridge_col = set(bridge_raw, "Cd", c4 * edge_mul, domain = faces)
bridge = bake_ao(bridge_col, rays = 12, distance = 0.6, rng = r_ao, domain = points)
output bridge
