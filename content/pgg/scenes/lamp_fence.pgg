param pier_side: f32 = 0.9
param pier_rows: int = 6
param course_h: f32 = 0.2
param span: f32 = 2.2
param pickets: int = 5
param arm_half: f32 = 1.2
param seed: int = 3

import lib.blockwork
import lib.ironwork

# Кованая ограда с фонарём: два столба грубой
# каменной кладки, между ними пролёт штакетника с копьями и двумя прогонами на
# клёпках, на левом столбе — чугунный фонарный столб с поперечиной, S-завитками и
# подвесным шестигранным фонарём. Ограда вдоль X (левый столб в 0), лицо — +Z.
#
# Материалы — группы faces: stone (кладка), iron (ковка), lamp (стёкла фонаря),
# bulb (лампа внутри), edge (фаски боксов — краевой износ, светлее).

root_rng = rng_from_seed(seed)
pier_h = f32(pier_rows) * course_h
pier_b_x = pier_side + span

pier_a = blockwork.stone_pier(side = pier_side, n_rows = pier_rows, course_h = course_h, rng = split_rng(root_rng, key = "pier_a"))
pier_b = transform(blockwork.stone_pier(side = pier_side, n_rows = pier_rows, course_h = course_h, rng = split_rng(root_rng, key = "pier_b")), translate = vec3(pier_b_x, 0, 0))

# Штакетник: прогоны на 0.1 входят в столбы; стойки от 0.10 до 1.0, острия ~1.46.
fence = ironwork.picket_fence(x0 = pier_side * 0.5 - 0.1, x1 = pier_b_x - pier_side * 0.5 + 0.1, n = pickets, y_shaft0 = 0.10, y_shaft1 = 1.0, rail_y_lo = 0.48, rail_y_hi = 0.97)

# Фонарный столб на левом пьедестале: поперечина на 2.15 над верхом кладки, фонарь
# слева (над улицей), правое плечо свободное — как на референсе.
post = ironwork.lamp_post(base_y = pier_h, arm_y = pier_h + 2.15, arm_half = arm_half, lantern_x = 0.0 - arm_half * 0.83)

scene_raw = merge(pier_a, pier_b, fence, post)

# --- окраска: @Cd по группам (faces) ------------------------------------------------
paint_rng = split_rng(root_rng, key = "paint")
stone_col = mix(vec3(0.17, 0.145, 0.12), vec3(0.085, 0.075, 0.07), fbm(scale = 2.0, octaves = 3, rng = split_rng(paint_rng, key = "stone"))) * @tint
iron_col = mix(vec3(0.030, 0.030, 0.034), vec3(0.060, 0.055, 0.050), fbm(scale = 4.0, octaves = 2, rng = split_rng(paint_rng, key = "iron")))
c1 = ingroup("stone") ? stone_col : vec3(1.0, 0.0, 1.0)
c2 = ingroup("iron") ? iron_col : c1
c3 = ingroup("lamp") ? vec3(1.0, 0.62, 0.22) : c2
c4 = ingroup("bulb") ? vec3(1.0, 0.92, 0.6) : c3
edge_mul = ingroup("edge") ? vec3(1.5, 1.45, 1.35) : vec3(1.0)
scene_col = set(scene_raw, "Cd", c4 * edge_mul, domain = faces)
scene = bake_ao(scene_col, rays = 16, distance = 0.8, rng = split_rng(root_rng, key = "ao"), domain = points)
output scene
