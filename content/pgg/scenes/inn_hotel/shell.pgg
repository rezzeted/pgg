# Оболочка корпуса отеля: кирпичные стены прямых участков, межэтажные
# пояски-«скоростные линии», светлые угловые лопатки-пилястры и плоские
# продолжения штукатурной облицовки эркера на прямые фасады.
#
# Важно: круглый угол в стенах НЕ закрывается. Его закрывают межэтажные пояски
# (сплошные plan_prism по всему периметру), штукатурные простенки и оконные ленты
# из inn_hotel/windows.pgg — только так за стеклом остаётся глубина под
# освещённый интерьер, а не сплошная кладка вплотную к стеклу.
import lib.parts
import lib.plan as plan
import inn_hotel.common as common

def straight_walls(bw: f32, bd: f32, cr: f32, y0: f32, y1: f32, grp: string, t: f32 = 0.44) -> (out: geo<mesh>) {
    """Стены по четырём прямым участкам плана толщиной t; круглый угол оставлен
    открытым. Участки +X и +Z доходят до точек касания дуги."""
    expect y1 > y0: "straight_walls: y1 должен быть выше y0"
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    hy = (y0 + y1) * 0.5
    h = y1 - y0
    w_x = parts.piece(size = vec3(t, h, cz + bd * 0.5), pos = vec3(bw * 0.5 - t * 0.5, hy, (cz - bd * 0.5) * 0.5), grp = grp)
    w_z = parts.piece(size = vec3(cx + bw * 0.5, h, t), pos = vec3((cx - bw * 0.5) * 0.5, hy, bd * 0.5 - t * 0.5), grp = grp)
    w_bx = parts.piece(size = vec3(t, h, bd), pos = vec3(t * 0.5 - bw * 0.5, hy, 0), grp = grp)
    w_bz = parts.piece(size = vec3(bw, h, t), pos = vec3(0, hy, t * 0.5 - bd * 0.5), grp = grp)
    out = merge(w_x, w_z, w_bx, w_bz)
}

def brick_skin(w: f32, h: f32, cell: f32, rng: rng) -> (out: geo<mesh>) {
    """Кирпичная облицовка стены: подразделённая плита (grid, повёрнутая из XZ в XY —
    лицо +Z, центр в 0) с лёгким fbm-рельефом по нормали. Смысл подразделения —
    окраска: `fbm` в assemble считается по грани, и на одной большой грани стена
    заливается ровным цветом; на сетке из ячеек ~cell тот же шум даёт фактуру
    кладки. Честная кладка боксами на стену 12 м стоила бы сотни тысяч треугольников."""
    expect cell > 0.05: "brick_skin: ячейка мельче 5 см — сетка не оправдывает цену"
    nx = int(w / cell)
    ny = int(h / cell)
    g0 = grid(size = vec2(w, h), res = vec2(f32(nx), f32(ny)))
    g1 = transform(g0, rotate = vec3(90, 0, 0))
    out = mark(compute_normals(g1, mode = smooth), "brick", where = true, domain = faces)
}

def brick_courses(w: f32, h: f32, ch: f32, rng: rng) -> (out: geo<mesh>) {
    """Ряды кладки поверх плиты brick_skin — обёртка plan.brick_courses."""
    out = plan.brick_courses(w = w, h = h, ch = ch, rng = rng, protrude = 0.018)
}

def brick_skins(bw: f32, bd: f32, cr: f32, y0: f32, y1: f32, rng: rng) -> (out: geo<mesh>) {
    """Облицовка двух уличных кирпичных участков — фасадов +Z (слева от эркера) и
    +X (справа от него). Дальние стены не облицовываются: их не видно."""
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    h = y1 - y0
    yc = (y0 + y1) * 0.5
    w_z = cx + bw * 0.5
    w_x = cz + bd * 0.5
    wall_z = merge(brick_skin(w = w_z, h = h, cell = 0.24, rng = split_rng(rng, key = "z")), brick_courses(w = w_z, h = h, ch = 0.24, rng = split_rng(rng, key = "cz")))
    wall_x = merge(brick_skin(w = w_x, h = h, cell = 0.24, rng = split_rng(rng, key = "x")), brick_courses(w = w_x, h = h, ch = 0.24, rng = split_rng(rng, key = "cx")))
    sk_z = transform(wall_z, translate = vec3((cx - bw * 0.5) * 0.5, yc, bd * 0.5 + 0.012))
    sk_x = transform(transform(wall_x, rotate = vec3(0, 90, 0)), translate = vec3(bw * 0.5 + 0.012, yc, (cz - bd * 0.5) * 0.5))
    out = merge(sk_z, sk_x)
}

def bay_returns(bw: f32, bd: f32, cr: f32, y0: f32, y1: f32, ext: f32 = 0.80) -> (out: geo<mesh>) {
    """Плоские продолжения штукатурной облицовки эркера на прямые фасады: полосы,
    примыкающие к точкам касания дуги, чтобы светлое поле эркера не обрывалось на
    ребре, а заходило на кирпич — как в референсе."""
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    on_x = parts.piece(size = vec3(0.12, y1 - y0, ext), pos = vec3(bw * 0.5 + 0.04, (y0 + y1) * 0.5, cz - ext * 0.5), grp = "stucco")
    on_z = parts.piece(size = vec3(ext, y1 - y0, 0.12), pos = vec3(cx - ext * 0.5, (y0 + y1) * 0.5, bd * 0.5 + 0.04), grp = "stucco")
    out = merge(on_x, on_z)
}

def pilasters(bw: f32, bd: f32, y0: f32, y1: f32, pw: f32 = 0.52) -> (out: geo<mesh>) {
    """Светлые вертикальные лопатки на трёх прямых углах корпуса (круглый угол занят
    эркером): по две плоские полосы на угол, лицом на каждый из фасадов."""
    hy = (y0 + y1) * 0.5
    h = y1 - y0
    xs = bw * 0.5
    zs = bd * 0.5
    a_z = parts.piece(size = vec3(pw, h, 0.11), pos = vec3(0.0 - xs + pw * 0.5, hy, zs + 0.035), grp = "trim")
    a_x = parts.piece(size = vec3(0.11, h, pw), pos = vec3(0.0 - xs - 0.035, hy, zs - pw * 0.5), grp = "trim")
    b_x = parts.piece(size = vec3(0.11, h, pw), pos = vec3(xs + 0.035, hy, 0.0 - zs + pw * 0.5), grp = "trim")
    b_z = parts.piece(size = vec3(pw, h, 0.11), pos = vec3(xs - pw * 0.5, hy, 0.0 - zs - 0.035), grp = "trim")
    c_x = parts.piece(size = vec3(0.11, h, pw), pos = vec3(0.0 - xs - 0.035, hy, 0.0 - zs + pw * 0.5), grp = "trim")
    c_z = parts.piece(size = vec3(pw, h, 0.11), pos = vec3(0.0 - xs + pw * 0.5, hy, 0.0 - zs - 0.035), grp = "trim")
    out = merge(a_z, a_x, b_x, b_z, c_x, c_z)
}

def upper_shell(bw: f32, bd: f32, cr: f32, y0: f32, y1: f32, band_ys: geo<points>, band_h: f32, rng: rng) -> (out: geo<mesh>) {
    """Жилая часть: кирпичные стены прямых участков с фактурной облицовкой, угловые
    лопатки, продолжения облицовки эркера и пояски на отметках band_ys (модель
    строк — точки-высоты, делегат — foreach по ним §5.4)."""
    walls = straight_walls(bw = bw, bd = bd, cr = cr, y0 = y0, y1 = y1, grp = "brick")
    skins = brick_skins(bw = bw, bd = bd, cr = cr, y0 = y0, y1 = y1, rng = rng)
    ret = bay_returns(bw = bw, bd = bd, cr = cr, y0 = y0, y1 = y1)
    pil = pilasters(bw = bw, bd = bd, y0 = y0, y1 = y1)
    bands = foreach lvl in band_ys {
        lvl = common.band(w = bw, d = bd, r = cr, y = dot(value(@P, on = lvl), (0, 1, 0)), h = band_h)
    }
    out = merge(walls, skins, ret, pil, bands)
}
