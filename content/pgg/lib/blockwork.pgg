# Кладка из отдельных боксов-камней: якоря рядов вразбежку, стена с подрезкой
# торцов `clip`, угловые квойны. Стена собирается в локальной системе (x вдоль
# стены, центр в 0, z наружу) и ставится на место внешним transform; проёмы —
# удалением якорей маской до вызова stone_wall. Группы: stone, cut (крышки срезов).
# Рядовая кладка v2 (coursed_*): торцы ряда всегда кратны ¼ блока, остаток пролёта
# прячется в швах (course_layout), торцы точные по раскладке — clip не нужен.

import lib.parts

def bond_anchors(len: f32, cols: int, n_rows: int, course_h: f32, y0: f32, z: f32) -> (out: geo<points>) {
    """Якоря кладки вразбежку в локальной системе стены (x вдоль, центр в 0): модель
    строк — точки-ряды (`mesh_line` по y), делегат — `foreach` по ним (§5.4): ряд
    генерируется с запасом на блок за каждый край (шаг pitch = len / cols), нечётные ряды
    сдвинуты на полшага (перевязка), номер ряда — `@piece_index`, высота ряда — из `@P` модели."""
    pitch = len / f32(cols)
    rows = mesh_line(count = n_rows, length = f32(n_rows - 1) * course_h, dir = (0, 1, 0))
    out = foreach row in rows {
        odd = f32(@piece_index % 2)
        r0 = mesh_line(count = cols + 2, length = f32(cols + 1) * pitch, dir = (1, 0, 0))
        row = transform(r0, translate = vec3(0.0 - len * 0.5 - pitch * 0.5 + odd * pitch * 0.5, y0 + course_h * 0.5 + dot(value(@P, on = row), (0, 1, 0)), z))
    }
}

def stone_wall(rows: geo<points>, len: f32, blk: vec3, rng: rng) -> (out: geo<mesh>) {
    """Кладка одной стены в локальной системе (x вдоль стены, центр в 0): ряды якорей
    → блок с центром за краем не кладётся → @scale/@variant (три длины blk × 1 / 1.1 / 1.2 — не длиннее шага ряда, чтобы соседи не сливались в плиту)
    → почти серый @tint → джиттер → realize → подрезка торцов плоскостями x = ±len/2
    (`clip`, крышки срезов в группе `cut`). Ставится на место внешним transform."""
    a0 = parts.cbox(size = blk, k = 0.16)
    a1 = parts.cbox(size = blk * vec3(1.1, 1, 1), k = 0.16)
    a2 = parts.cbox(size = blk * vec3(1.2, 1, 1), k = 0.16)
    kept = delete(rows, where = abs(dot(@P, (1, 0, 0))) > len * 0.5 + 0.02)
    p1 = set(kept, "scale", random(lo = 0.92, hi = 1.08, rng = split_rng(rng, key = "scale")))
    p2 = set(p1, "variant", random_int(n = 3, rng = split_rng(rng, key = "var")))
    shade = random(lo = 0.7, hi = 1.25, rng = split_rng(rng, key = "tint"))
    p3 = set(p2, "tint", vec3(shade * 1.04, shade, shade * 0.96))
    p4 = set_position(p3, offset = random_vec(lo = vec3(-0.03, -0.01, -0.01), hi = vec3(0.03, 0.01, 0.07), rng = split_rng(rng, key = "jitter")))
    m = realize(instance_on_points(p4, source = a0, variants = [a0, a1, a2]))
    c1 = clip(m, origin = vec3(0.0 - len * 0.5, 0, 0), normal = vec3(1, 0, 0), cap_group = "cut")
    out = clip(c1, origin = vec3(len * 0.5, 0, 0), normal = vec3(-1, 0, 0), cap_group = "cut")
}

def quoin_corner_local(h: f32, L: f32, W: f32, y: f32, q: f32, k: int, m: int) -> (out: geo<mesh>) {
    """Один угол ряда колонны сечением «в k + m/2 блока» (k ≥ 1 полных + m ∈ {0, 1}
    половинка; лицо ряда = k·L + m·W) в локальной системе: грани колонны — плоскости
    x = 0 и z = 0, тело в октанте −x/−z. Угловой блок a при q = 0 длиной вдоль X
    (ложок на грани z, тычок на грани x), при q = 1 — вдоль Z. Плечо вдоль оси a:
    k−1 полных блоков + m половинок; перпендикулярное плечо, чей первый блок
    стыкуется торцом с длинной гранью a: k−1+m полных; при m = 0 добавляется короткий
    добор длиной L−W (аналог четвертки в кладке углов с целым числом кирпичей).
    Плечи — repeat-зоны, iterations = 0 отдаёт вход как есть (§5.4)."""
    da = q * (L - W)
    sa = da * 0.5
    a = transform(parts.cbox(size = vec3(L - da, h, W + da), k = 0.12), translate = vec3(0.0 - (L * 0.5 - sa), y, 0.0 - (W * 0.5 + sa)))
    arm_p = repeat (a, iterations = k - 1) |acc| {
        ui = L * (1.5 + f32(@iteration))
        blk = transform(parts.cbox(size = vec3(L - da, h, W + da), k = 0.12), translate = vec3(0.0 - (ui * (1.0 - q) + W * 0.5 * q), y, 0.0 - (W * 0.5 * (1.0 - q) + ui * q)))
        acc = merge(acc, blk)
    }
    arm_h = repeat (arm_p, iterations = m) |acc| {
        uh = f32(k) * L + W * 0.5
        hlf = transform(parts.cbox(size = vec3(W, h, W), k = 0.12), translate = vec3(0.0 - (uh * (1.0 - q) + W * 0.5 * q), y, 0.0 - (W * 0.5 * (1.0 - q) + uh * q)))
        acc = merge(acc, hlf)
    }
    arm_q = repeat (arm_h, iterations = k - 1 + m) |acc| {
        vj = W + L * (0.5 + f32(@iteration))
        blq = transform(parts.cbox(size = vec3(W + da, h, L - da), k = 0.12), translate = vec3(0.0 - (W * 0.5 * (1.0 - q) + vj * q), y, 0.0 - (vj * (1.0 - q) + W * 0.5 * q)))
        acc = merge(acc, blq)
    }
    out = repeat (arm_q, iterations = 1 - m) |acc| {
        ds = L - 2.0 * W
        vs = W + f32(k - 1) * L + (L - W) * 0.5
        sht = transform(parts.cbox(size = vec3(W + q * ds, h, L - W - q * ds), k = 0.12), translate = vec3(0.0 - (W * 0.5 * (1.0 - q) + vs * q), y, 0.0 - (vs * (1.0 - q) + W * 0.5 * q)))
        acc = merge(acc, sht)
    }
}

def quoin_course(w: f32, d: f32, h: f32, L: f32, W: f32, p: f32, y: f32, q: f32, k: int, m: int) -> (out: geo<mesh>) {
    """Ряд угловой кладки на четырёх углах дома w×d (центр ряда на высоте y; грани
    колонн выпущены на p за сердцевину): один локальный угол + повороты 0/90/180/270° —
    хиральность кладки одна, как у реальных кирпичей. Группа stone."""
    corner = quoin_corner_local(h = h, L = L, W = W, y = y, q = q, k = k, m = m)
    c1 = transform(corner, translate = vec3(w * 0.5 + p, 0.0, d * 0.5 + p))
    c2 = transform(transform(corner, rotate = vec3(0.0, 180.0, 0.0)), translate = vec3(0.0 - w * 0.5 - p, 0.0, 0.0 - d * 0.5 - p))
    c3 = transform(transform(corner, rotate = vec3(0.0, 90.0, 0.0)), translate = vec3(w * 0.5 + p, 0.0, 0.0 - d * 0.5 - p))
    c4 = transform(transform(corner, rotate = vec3(0.0, 270.0, 0.0)), translate = vec3(0.0 - w * 0.5 - p, 0.0, d * 0.5 + p))
    out = mark(merge(c1, c2, c3, c4), "stone", where = true, domain = faces)
}

def quoin_stack(w: f32, d: f32, n_rows: int, course_h: f32, bricks: f32 = 1.5) -> (out: geo<mesh>) {
    """Угловая кладка дома w×d (квойны): колонны сечением «в bricks блоков» на четырёх
    углах, n_rows рядов с шагом course_h. bricks — от 1.0 с шагом 0.5 (1, 1.5, 2, 2.5…);
    классика — 1.5 (угловой блок + примыкающий торцом в его длинную грань + половинка).
    Направление углового блока чередуется по рядам — торец плеча одного ряда стыкуется
    с длинной гранью следующего (перевязка угла, как у кирпичного столба), заодно квойны
    прячут торцы рядов кладки стен. Ряд 0 — угловой длиной вдоль X. Группа stone."""
    expect bricks >= 1.0 & bricks * 2.0 == f32(int(bricks * 2.0)): "quoin_stack: bricks — от 1.0 с шагом 0.5 (1, 1.5, 2, 2.5, ...)"
    k = int(bricks)
    m = int(bricks * 2.0) - 2 * k
    L = 0.62
    W = 0.32
    p = 0.2
    h = course_h * 0.9
    row0 = quoin_course(w = w, d = d, h = h, L = L, W = W, p = p, y = course_h * 0.5, q = 0.0, k = k, m = m)
    out = repeat (row0, iterations = n_rows - 1) |acc| {
        kr = f32(@iteration) + 1.0
        q = kr - 2.0 * floor(kr * 0.5)
        course = quoin_course(w = w, d = d, h = h, L = L, W = W, p = p, y = (kr + 0.5) * course_h, q = q, k = k, m = m)
        acc = merge(acc, course)
    }
}

def course_layout(S: f32, L: f32, g0: f32, odd: int) -> (e: f32, cls: int, k: int, g: f32) {
    """Раскладка одного ряда кладки вразбежку на пролёте S (блок длиной L, номинальный
    шов g0): e — торцевой добор (одинаковый с двух концов, всегда кратен L/4 — узких
    срезов не бывает), cls — его длина в четвертях блока (1..4), k — число полных
    блоков, g — фактический шов. Чётный ряд (odd = 0): кладём максимум полных блоков
    при минимальном доборе L/4, затем поднимаем добор четвертями — в том числе последний
    подъём «вперёд» (остаток уходит в минус, швы чуть сжимаются), если шов после него
    не уже 0.6·g0 и ближе к g0, чем без подъёма; иначе хвост чуть меньше L/2 раздувал
    бы швы всего ряда. Остаток равномерно размазываем по k+1 швам. Нечётный ряд
    (odd = 1) смещён на L/2: его добор жёстко (e + L/2) mod L, поэтому остаток пролёта
    прячется выбором числа полных блоков с швом ближе к g0 (шов может чуть сжаться,
    но не уже 0.6·g0)."""
    expect S >= 2.0 * L: "course_layout: пролёт короче двух блоков"
    k0 = int((S - 0.5 * L - g0) / (L + g0))
    d0 = S - 0.5 * L - f32(k0) * L - f32(k0 + 1) * g0
    bumps = int(d0 / (0.5 * L))
    dev_f = (d0 - f32(bumps) * 0.5 * L) / f32(k0 + 1)
    dev_c = (d0 - f32(bumps + 1) * 0.5 * L) / f32(k0 + 1)
    bump_up = g0 + dev_c >= 0.6 * g0 & 0.0 - dev_c <= dev_f
    bumps0 = bump_up ? bumps + 1 : bumps
    cls0 = 1 + bumps0
    e0 = f32(cls0) * 0.25 * L
    ge = g0 + (d0 - f32(bumps0) * 0.5 * L) / f32(k0 + 1)
    cls1 = (cls0 + 1) % 4 + 1
    e1 = f32(cls1) * 0.25 * L
    k1 = int((S - 2.0 * e1 - g0) / (L + g0))
    d1 = S - 2.0 * e1 - f32(k1) * L - f32(k1 + 1) * g0
    d1b = d1 - (L + g0)
    g_up = g0 + d1 / f32(k1 + 1)
    g_dn = g0 + d1b / f32(k1 + 2)
    take_up = d1 / f32(k1 + 1) <= 0.0 - d1b / f32(k1 + 2) | g_dn < 0.6 * g0
    k1f = take_up ? k1 : k1 + 1
    g1 = take_up ? g_up : g_dn
    e = odd == 1 ? e1 : e0
    cls = odd == 1 ? cls1 : cls0
    k = odd == 1 ? k1f : k0
    g = odd == 1 ? g1 : ge
}

def course_anchors(S: f32, L: f32, g0: f32, odd: int, z: f32) -> (out: geo<points>) {
    """Якоря одного ряда раскладки course_layout на высоте y = 0 (x вдоль ряда, центр
    в 0, z — вынос наружу): точки с @variant = классу длины куска (0 = L/4, 1 = L/2,
    2 = 3L/4, 3 = полный). Ряд: добор e слева, k полных, добор e справа; швы g."""
    e, cls, k, g = course_layout(S = S, L = L, g0 = g0, odd = odd)
    p0 = transform(mesh_line(count = 1, length = 0.0, dir = (1, 0, 0)), translate = vec3(0.0 - S * 0.5 + e * 0.5, 0.0, z))
    out = repeat (set(p0, "variant", cls - 1, domain = points), iterations = k + 1) |acc| {
        i = @iteration + 1
        xi = i > k ? S * 0.5 - e * 0.5 : 0.0 - S * 0.5 + e + g + (f32(i) - 1.0) * (L + g) + L * 0.5
        ci = i > k ? cls - 1 : 3
        pi = transform(mesh_line(count = 1, length = 0.0, dir = (1, 0, 0)), translate = vec3(xi, 0.0, z))
        acc = merge(acc, set(pi, "variant", ci, domain = points))
    }
}

def coursed_wall_anchors(S: f32, n_rows: int, course_h: f32, y0: f32, z: f32, L: f32, g0: f32) -> (out: geo<points>) {
    """Якоря всех рядов стены пролётом S: два прототипа рядов (чётный/нечётный,
    половинное смещение) расставлены по высоте; модель строк — точки-ряды mesh_line,
    делегат — foreach (§5.4), высота ряда из @P модели. Проёмы — удалением якорей
    маской до вызова coursed_wall."""
    ev = course_anchors(S = S, L = L, g0 = g0, odd = 0, z = z)
    od = course_anchors(S = S, L = L, g0 = g0, odd = 1, z = z)
    n_even = (n_rows + 1) / 2
    n_odd = n_rows / 2
    rows_e = mesh_line(count = n_even, length = f32(n_even - 1) * 2.0 * course_h, dir = (0, 1, 0))
    rows_o = mesh_line(count = n_odd, length = f32(n_odd - 1) * 2.0 * course_h, dir = (0, 1, 0))
    we = foreach re in rows_e {
        re = transform(ev, translate = vec3(0.0, y0 + course_h * 0.5 + dot(value(@P, on = re), (0, 1, 0)), 0.0))
    }
    wo = foreach ro in rows_o {
        ro = transform(od, translate = vec3(0.0, y0 + course_h * 1.5 + dot(value(@P, on = ro), (0, 1, 0)), 0.0))
    }
    out = merge(we, wo)
}

def coursed_wall(rows: geo<points>, blk: vec3, rng: rng) -> (out: geo<mesh>) {
    """Кладка по якорям coursed_wall_anchors: четыре варианта длины (¼/½/¾/полный —
    @variant от coursed_anchors), почти серый @tint на блок, микроджиттер (по x слабый —
    швы точные), realize. Торцы рядов точные по раскладке — clip не нужен."""
    a0 = parts.cbox(size = blk * vec3(0.25, 1.0, 1.0), k = 0.16)
    a1 = parts.cbox(size = blk * vec3(0.5, 1.0, 1.0), k = 0.16)
    a2 = parts.cbox(size = blk * vec3(0.75, 1.0, 1.0), k = 0.16)
    a3 = parts.cbox(size = blk, k = 0.16)
    shade = random(lo = 0.7, hi = 1.25, rng = split_rng(rng, key = "tint"))
    p1 = set(rows, "tint", vec3(shade * 1.04, shade, shade * 0.96))
    p2 = set_position(p1, offset = random_vec(lo = vec3(-0.01, -0.01, -0.01), hi = vec3(0.01, 0.01, 0.07), rng = split_rng(rng, key = "jitter")))
    out = realize(instance_on_points(p2, source = a3, variants = [a0, a1, a2, a3]))
}

def brick_veneer_rows(len: f32, h: f32, L: f32 = 0.17, ch: f32 = 0.12, g0: f32 = 0.008, z: f32 = 0.03) -> (out: geo<points>) {
    """Якоря мелкой кирпичной облицовки вразбежку: ложок L, ряд ch, шов g0.
    Локально: x вдоль, низ y=0, лицо +Z, вынос z. Проёмы не дырявят якоря —
    сплошной ряд, затем masonry.clip_*_hole подрезает кирпичи по контуру."""
    n_rows = int(h / ch)
    out = coursed_wall_anchors(S = len, n_rows = n_rows, course_h = ch, y0 = 0.0, z = z, L = L, g0 = g0)
}

def brick_veneer(rows: geo<points>, rng: rng, L: f32 = 0.17, bh: f32 = 0.104, t: f32 = 0.046, k: f32 = 0.14, grp: string = "brick") -> (out: geo<mesh>) {
    """Мелкие кирпичи по якорям brick_veneer_rows: ¼/½/¾/полный ложок, лёгкий @tint
    и джиттер, группа grp. Фаска k — светлая кромка edge."""
    a0 = parts.cbox(size = vec3(L * 0.25, bh, t), k = k)
    a1 = parts.cbox(size = vec3(L * 0.5, bh, t), k = k)
    a2 = parts.cbox(size = vec3(L * 0.75, bh, t), k = k)
    a3 = parts.cbox(size = vec3(L, bh, t), k = k)
    shade = random(lo = 0.84, hi = 1.16, rng = split_rng(rng, key = "tint"))
    p1 = set(rows, "tint", vec3(shade * 1.06, shade * 0.98, shade * 0.92))
    p2 = set_position(p1, offset = random_vec(lo = vec3(-0.003, -0.002, -0.003), hi = vec3(0.003, 0.002, 0.006), rng = split_rng(rng, key = "jit")))
    out = mark(realize(instance_on_points(p2, source = a3, variants = [a0, a1, a2, a3])), grp, where = true, domain = faces)
}

def core_prism(w: f32, d: f32, h: f32, y0: f32, grp: string = "mortar") -> (out: geo<mesh>) {
    """Прямой объём w×d высотой h, низ на y0. Без фаски: cbox/piece скос считает
    от min(размера), и на этаже это ~0.12·h — грани визуально загибаются.
    Сердцевина под облицовкой brick_veneer — группа mortar (раствор в швах)."""
    body = compute_normals(box(size = vec3(w, h, d)), mode = flat)
    out = mark(transform(body, translate = vec3(0, y0 + h * 0.5, 0)), grp, where = true, domain = faces)
}

def stone_pier(side: f32, n_rows: int, course_h: f32, rng: rng) -> (out: geo<mesh>) {
    """Отдельно стоящий квадратный столб кладки side×side (центр в 0, низ на y = 0,
    верх на n_rows·course_h): каждый ряд — четыре угловых блока quoin_course с
    w = d = 0 и выпуском p = side/2 (блок L = side/2, W ≈ 0.49 L), направление
    углового блока чередуется по рядам — перевязка, как у quoin_stack; середина ряда
    (квадрат L − W) — сердцевина piece. Оттенок @tint и сдвиг-джиттер (±1–3 см) — свои
    на блок (random по @island_id, promote на points — домен как у кладки из realize).
    Группа stone. Пример: blockwork.stone_pier(0.9, 6, 0.2, r)"""
    expect side > 0.3: "stone_pier: столб уже 0.3 м — блоки тоньше швов"
    expect n_rows >= 1: "stone_pier: хотя бы один ряд"
    L = side * 0.5
    W = L * 0.49
    h = course_h * 0.9
    row0 = quoin_course(w = 0.0, d = 0.0, h = h, L = L, W = W, p = L, y = course_h * 0.5, q = 0.0, k = 1, m = 0)
    rows = repeat (row0, iterations = n_rows - 1) |acc| {
        kr = f32(@iteration) + 1.0
        q = kr - 2.0 * floor(kr * 0.5)
        course = quoin_course(w = 0.0, d = 0.0, h = h, L = L, W = W, p = L, y = (kr + 0.5) * course_h, q = q, k = 1, m = 0)
        acc = merge(acc, course)
    }
    core = parts.piece(size = vec3(side - 2.0 * W + 0.04, f32(n_rows) * course_h - 0.02, side - 2.0 * W + 0.04), pos = vec3(0, f32(n_rows) * course_h * 0.5, 0), grp = "stone")
    # @tint — на points, как у кладки через realize (иначе merge с ней — E609).
    blocks = promote(islands(merge(rows, core)), "island_id", from = faces, to = points, mode = first)
    shade = random(lo = 0.65, hi = 1.25, rng = split_rng(rng, key = "tint"), counter = @island_id)
    tinted = set(blocks, "tint", vec3(shade * 1.04, shade, shade * 0.96), domain = points)
    # Грубая кладка: каждый блок целиком (по @island_id) сдвинут на ±1–3 см.
    rough = set_position(tinted, offset = random_vec(lo = vec3(-0.015, -0.008, -0.03), hi = vec3(0.015, 0.008, 0.03), rng = split_rng(rng, key = "jitter"), counter = @island_id))
    out = remove_attr(rough, "island_id")
}

def quoin_pier(n_rows: int, course_h: f32, bricks: f32 = 1.5) -> (out: geo<mesh>) {
    """Отдельная угловая колонна (стенды/проверки): один угол в локальной системе
    quoin_corner_local (грани — плоскости x = 0 и z = 0, тело в −x/−z), n_rows рядов
    с перевязкой. Группа stone."""
    expect bricks >= 1.0 & bricks * 2.0 == f32(int(bricks * 2.0)): "quoin_pier: bricks — от 1.0 с шагом 0.5 (1, 1.5, 2, 2.5, ...)"
    kp = int(bricks)
    mp = int(bricks * 2.0) - 2 * kp
    pier0 = quoin_corner_local(h = course_h * 0.9, L = 0.62, W = 0.32, y = course_h * 0.5, q = 0.0, k = kp, m = mp)
    out = repeat (mark(pier0, "stone", where = true, domain = faces), iterations = n_rows - 1) |acc| {
        kpier = f32(@iteration) + 1.0
        qpier = kpier - 2.0 * floor(kpier * 0.5)
        acc = merge(acc, mark(quoin_corner_local(h = course_h * 0.9, L = 0.62, W = 0.32, y = (kpier + 0.5) * course_h, q = qpier, k = kp, m = mp), "stone", where = true, domain = faces))
    }
}
