# Фахверковый второй этаж коттеджа: оштукатуренный объём со свесом (jetty),
# угловые столбы, обвязки и плиты, торцы балок перекрытия, стойки/рельсы/раскосы
# по стенам и фахверк обоих фронтонов. Материалы: wall (штукатурка), wood.

import lib.parts

def upper_floor(width: f32, depth: f32, stone_h: f32, upper_h: f32, jetty: f32, ridge_y: f32, roof_t: f32) -> (out: geo<mesh>) {
    """Второй этаж над каменным (низ на stone_h, высота upper_h), выступающий на jetty
    с каждой стороны; фронтоны поднимаются до конька ridge_y минус толщина кровли roof_t.
    Детерминирован (rng не нужен). Фасад (+Z) несёт стойки по бокам большого окна
    фронтона и раскосы в крайних панелях; фронтон — королевская стойка, воротная
    балка, две стойки и раскосы «от балки вверх-внутрь к стойке»."""
    uw = width + 2.0 * jetty
    ud = depth + 2.0 * jetty
    wall_top = stone_h + upper_h
    tf_z = ud * 0.5
    upper = parts.piece(size = vec3(uw, upper_h, ud), pos = vec3(0, stone_h + upper_h * 0.5, 0), grp = "wall")
    mid_y = stone_h + upper_h * 0.5
    rail_y = stone_h + upper_h * 0.5
    # угловые столбы
    post_fl = parts.piece(size = vec3(0.22, upper_h, 0.22), pos = vec3(0.0 - uw * 0.5 + 0.1, mid_y, tf_z - 0.1), grp = "wood")
    post_fr = parts.piece(size = vec3(0.22, upper_h, 0.22), pos = vec3(uw * 0.5 - 0.1, mid_y, tf_z - 0.1), grp = "wood")
    post_bl = parts.piece(size = vec3(0.22, upper_h, 0.22), pos = vec3(0.0 - uw * 0.5 + 0.1, mid_y, 0.0 - tf_z + 0.1), grp = "wood")
    post_br = parts.piece(size = vec3(0.22, upper_h, 0.22), pos = vec3(uw * 0.5 - 0.1, mid_y, 0.0 - tf_z + 0.1), grp = "wood")
    # нижние обвязки (по свесу; перекрывают верх кладки) и верхние плиты
    sill_f = parts.piece(size = vec3(uw + 0.18, 0.26, 0.28), pos = vec3(0, stone_h + 0.02, tf_z), grp = "wood")
    sill_b = parts.piece(size = vec3(uw + 0.18, 0.26, 0.28), pos = vec3(0, stone_h + 0.02, 0.0 - tf_z), grp = "wood")
    sill_l = parts.piece(size = vec3(0.28, 0.26, ud + 0.18), pos = vec3(0.0 - uw * 0.5, stone_h + 0.02, 0), grp = "wood")
    sill_r = parts.piece(size = vec3(0.28, 0.26, ud + 0.18), pos = vec3(uw * 0.5, stone_h + 0.02, 0), grp = "wood")
    plate_f = parts.piece(size = vec3(uw + 0.18, 0.2, 0.24), pos = vec3(0, wall_top - 0.1, tf_z), grp = "wood")
    plate_b = parts.piece(size = vec3(uw + 0.18, 0.2, 0.24), pos = vec3(0, wall_top - 0.1, 0.0 - tf_z), grp = "wood")
    plate_l = parts.piece(size = vec3(0.24, 0.2, ud + 0.18), pos = vec3(0.0 - uw * 0.5, wall_top - 0.1, 0), grp = "wood")
    plate_r = parts.piece(size = vec3(0.24, 0.2, ud + 0.18), pos = vec3(uw * 0.5, wall_top - 0.1, 0), grp = "wood")
    # торцы балок перекрытия под свесом (фасад и тыл)
    joist = parts.piece(size = vec3(0.16, 0.16, 0.5), pos = vec3(0, 0, 0), grp = "wood")
    n_joists = int(width / 0.62)
    joist_len = f32(n_joists - 1) * 0.62
    joist_pts0 = mesh_line(count = n_joists, length = joist_len, dir = (1, 0, 0))
    joist_pts_f = transform(joist_pts0, translate = vec3(0.0 - joist_len * 0.5, stone_h - 0.19, depth * 0.5 + 0.12))
    joist_pts_b = transform(joist_pts0, translate = vec3(0.0 - joist_len * 0.5, stone_h - 0.19, 0.0 - depth * 0.5 - 0.12))
    joists = mark(realize(instance_on_points(merge(joist_pts_f, joist_pts_b), source = joist)), "wood", where = true, domain = faces)
    # фасад: стойки по бокам большого окна, средние рельсы и раскосы в крайних панелях
    stud_f1 = parts.piece(size = vec3(0.16, upper_h - 0.4, 0.18), pos = vec3(0.0 - 0.85, mid_y, tf_z), grp = "wood")
    stud_f2 = parts.piece(size = vec3(0.16, upper_h - 0.4, 0.18), pos = vec3(0.85, mid_y, tf_z), grp = "wood")
    bay = uw * 0.5 - 0.2 - 0.93
    bay_c = 0.93 + bay * 0.5
    rail_fl = parts.piece(size = vec3(bay, 0.14, 0.18), pos = vec3(0.0 - bay_c, rail_y, tf_z), grp = "wood")
    rail_fr = parts.piece(size = vec3(bay, 0.14, 0.18), pos = vec3(bay_c, rail_y, tf_z), grp = "wood")
    brace_len = 1.05 * 1.35
    brace_fl0 = transform(parts.piece(size = vec3(0.14, brace_len, 0.17), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 0.0 - 42))
    brace_fl = transform(brace_fl0, translate = vec3(0.0 - bay_c, stone_h + upper_h * 0.25 + 0.05, tf_z))
    brace_fr0 = transform(parts.piece(size = vec3(0.14, brace_len, 0.17), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 42))
    brace_fr = transform(brace_fr0, translate = vec3(bay_c, stone_h + upper_h * 0.25 + 0.05, tf_z))
    brace_fl1 = transform(brace_fr0, translate = vec3(0.0 - bay_c, stone_h + upper_h * 0.75 - 0.05, tf_z))
    brace_fr1 = transform(brace_fl0, translate = vec3(bay_c, stone_h + upper_h * 0.75 - 0.05, tf_z))
    # тыл: стойки, рельс, раскосы
    stud_b1 = parts.piece(size = vec3(0.16, upper_h - 0.4, 0.18), pos = vec3(0.0 - 1.5, mid_y, 0.0 - tf_z), grp = "wood")
    stud_b2 = parts.piece(size = vec3(0.16, upper_h - 0.4, 0.18), pos = vec3(1.5, mid_y, 0.0 - tf_z), grp = "wood")
    rail_b = parts.piece(size = vec3(uw - 0.3, 0.14, 0.18), pos = vec3(0, rail_y, 0.0 - tf_z), grp = "wood")
    brace_bl = transform(brace_fl0, translate = vec3(0.0 - bay_c - 0.2, stone_h + upper_h * 0.25 + 0.05, 0.0 - tf_z))
    brace_br = transform(brace_fr0, translate = vec3(bay_c + 0.2, stone_h + upper_h * 0.25 + 0.05, 0.0 - tf_z))
    # боковые стены: стойка у окна, рельс, раскосы (в плоскости YZ — поворот вокруг X)
    rail_l = parts.piece(size = vec3(0.18, 0.14, ud - 0.3), pos = vec3(0.0 - uw * 0.5, rail_y, 0), grp = "wood")
    rail_r = parts.piece(size = vec3(0.18, 0.14, ud - 0.3), pos = vec3(uw * 0.5, rail_y, 0), grp = "wood")
    stud_l1 = parts.piece(size = vec3(0.18, upper_h - 0.4, 0.16), pos = vec3(0.0 - uw * 0.5, mid_y, 0.62), grp = "wood")
    stud_l2 = parts.piece(size = vec3(0.18, upper_h - 0.4, 0.16), pos = vec3(0.0 - uw * 0.5, mid_y, 0.0 - 0.62), grp = "wood")
    stud_r1 = parts.piece(size = vec3(0.18, upper_h - 0.4, 0.16), pos = vec3(uw * 0.5, mid_y, 0.62), grp = "wood")
    stud_r2 = parts.piece(size = vec3(0.18, upper_h - 0.4, 0.16), pos = vec3(uw * 0.5, mid_y, 0.0 - 0.62), grp = "wood")
    sbay = ud * 0.5 - 0.2 - 0.7
    sbay_c = 0.7 + sbay * 0.5
    sbrace_len = 1.05 * 1.25
    sbrace_a0 = transform(parts.piece(size = vec3(0.17, sbrace_len, 0.14), pos = (0, 0, 0), grp = "wood"), rotate = vec3(40, 0, 0))
    sbrace_b0 = transform(parts.piece(size = vec3(0.17, sbrace_len, 0.14), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0.0 - 40, 0, 0))
    brace_l1 = transform(sbrace_b0, translate = vec3(0.0 - uw * 0.5, stone_h + upper_h * 0.25 + 0.05, sbay_c))
    brace_l2 = transform(sbrace_a0, translate = vec3(0.0 - uw * 0.5, stone_h + upper_h * 0.25 + 0.05, 0.0 - sbay_c))
    brace_r1 = transform(sbrace_b0, translate = vec3(uw * 0.5, stone_h + upper_h * 0.25 + 0.05, sbay_c))
    brace_r2 = transform(sbrace_a0, translate = vec3(uw * 0.5, stone_h + upper_h * 0.25 + 0.05, 0.0 - sbay_c))

    posts_all = merge(post_fl, post_fr, post_bl, post_br)
    sills_all = merge(sill_f, sill_b, sill_l, sill_r)
    plates_all = merge(plate_f, plate_b, plate_l, plate_r)
    front_tf = merge(stud_f1, stud_f2, rail_fl, rail_fr, brace_fl, brace_fr, brace_fl1, brace_fr1)
    back_tf = merge(stud_b1, stud_b2, rail_b, brace_bl, brace_br)
    side_tf = merge(rail_l, rail_r, stud_l1, stud_l2, stud_r1, stud_r2, brace_l1, brace_l2, brace_r1, brace_r2)
    timber = merge(posts_all, sills_all, plates_all, joists, front_tf, back_tf, side_tf)

    # Фахверк фронтона (+Z): королевская стойка, воротная балка, раскосы, стойки.
    apex_y = ridge_y - roof_t - 0.01
    gable_z = tf_z + 0.05
    gable_h = apex_y - wall_top
    collar_y = wall_top + gable_h * 0.42
    king = parts.piece(size = vec3(0.18, gable_h - 0.12, 0.18), pos = vec3(0, (wall_top + apex_y) * 0.5 - 0.06, gable_z), grp = "wood")
    collar_w = (apex_y - collar_y) * 2.0 - 0.3
    collar = parts.piece(size = vec3(collar_w, 0.16, 0.17), pos = vec3(0, collar_y, gable_z), grp = "wood")
    gstud_l = parts.piece(size = vec3(0.14, collar_y - wall_top - 0.1, 0.16), pos = vec3(0.0 - collar_w * 0.5 + 0.35, (wall_top + collar_y) * 0.5, gable_z), grp = "wood")
    gstud_r = parts.piece(size = vec3(0.14, collar_y - wall_top - 0.1, 0.16), pos = vec3(collar_w * 0.5 - 0.35, (wall_top + collar_y) * 0.5, gable_z), grp = "wood")
    # Раскосы: от воротной балки вверх-внутрь к королевской стойке (40° от вертикали);
    # нижний конец на балке, верхний — под коньком у стойки, целиком под скатом.
    gstrut_dy = apex_y - 0.55 - collar_y - 0.08
    gstrut_len = gstrut_dy / 0.76604444
    gstrut_dx = gstrut_len * 0.64278761
    gstrut_cx = 0.12 + gstrut_dx * 0.5
    gstrut_cy = collar_y + 0.08 + gstrut_dy * 0.5
    gstrut_l0 = transform(parts.piece(size = vec3(0.13, gstrut_len, 0.15), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 0.0 - 40))
    gstrut_l = transform(gstrut_l0, translate = vec3(0.0 - gstrut_cx, gstrut_cy, gable_z))
    gstrut_r0 = transform(parts.piece(size = vec3(0.13, gstrut_len, 0.15), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 40))
    gstrut_r = transform(gstrut_r0, translate = vec3(gstrut_cx, gstrut_cy, gable_z))
    gable_timber_f = merge(king, collar, gstud_l, gstud_r, gstrut_l, gstrut_r)
    # Тыльный фронтон — королевская стойка, балка и две стойки.
    king_b = parts.piece(size = vec3(0.18, gable_h - 0.12, 0.18), pos = vec3(0, (wall_top + apex_y) * 0.5 - 0.06, 0.0 - gable_z), grp = "wood")
    collar_b = parts.piece(size = vec3(collar_w, 0.16, 0.17), pos = vec3(0, collar_y, 0.0 - gable_z), grp = "wood")
    gstud_bl = parts.piece(size = vec3(0.14, collar_y - wall_top - 0.1, 0.16), pos = vec3(0.0 - collar_w * 0.5 + 0.35, (wall_top + collar_y) * 0.5, 0.0 - gable_z), grp = "wood")
    gstud_br = parts.piece(size = vec3(0.14, collar_y - wall_top - 0.1, 0.16), pos = vec3(collar_w * 0.5 - 0.35, (wall_top + collar_y) * 0.5, 0.0 - gable_z), grp = "wood")
    gable_timber = merge(gable_timber_f, king_b, collar_b, gstud_bl, gstud_br)

    out = merge(upper, timber, gable_timber)
}
