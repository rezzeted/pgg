# Оконные блоки викторианского дома: параметрическое арочное окно в каменном
# обрамлении (наличник, замковый камень, подоконник, рама, остекление) и раскладка
# по фасадам конвейером lib/arch (A7): план → фасады → полосы (цоколь | этаж |
# пояс | этаж) → оси паттернами; один паттерн на обе полосы этажей — общая ось
# окон автоматически; отклонение (парадный вход 1-го этажа) — слот K_DOOR.
import lib.parts
import lib.architecture
import lib.layout.scope as ls
import lib.layout.split as lsp
import lib.arch.kinds as k
import lib.arch.plan as ap
import lib.arch.facade as af

def stone_arch_window(w: f32, h: f32) -> (out: geo<mesh>) {
    """Арочное окно в каменном обрамлении: наличник с замковым камнем, подоконная плита
    (sill), утопленная рама со стеклом. Низ в 0, центр по X в 0."""
    frame = transform(architecture.arch_frame(w = w, h = h, bar = 0.11, depth = 0.16, grp = "stone"), translate = vec3(0, 0, 0.08))
    sill = parts.piece(size = vec3(w + 0.18, 0.12, 0.22), pos = vec3(0, 0.06, 0.11), grp = "stone")
    keystone = parts.piece(size = vec3(0.18, 0.24, 0.20), pos = vec3(0, h + 0.05, 0.10), grp = "stone")
    glass_h = h - 0.08
    r = (w - 0.22) * 0.5
    straight = max(glass_h - r - 0.11, 0.1)
    sash_b = parts.piece(size = vec3(w - 0.18, straight, 0.04), pos = vec3(0, 0.11 + straight * 0.5, 0.02), grp = "wood")
    gl_b = parts.piece(size = vec3(w - 0.26, straight - 0.08, 0.02), pos = vec3(0, 0.11 + straight * 0.5, 0.035), grp = "glass")
    arch_pan = transform(architecture.arch_panel(w = w - 0.18, h = glass_h, t = 0.04, grp = "glass"), translate = vec3(0, 0, 0.015))
    bar_v = parts.piece(size = vec3(0.04, glass_h - 0.1, 0.05), pos = vec3(0, 0.11 + (glass_h - 0.1) * 0.5, 0.03), grp = "wood")
    bar_h = parts.piece(size = vec3(w - 0.20, 0.04, 0.05), pos = vec3(0, 0.11 + straight, 0.03), grp = "wood")
    out = merge(frame, sill, keystone, sash_b, gl_b, arch_pan, bar_v, bar_h)
}

def wing_pattern(L: f32, wing_x: f32, win_step: f32, n_wing: int, win_w: f32, door: bool) -> (out: geo<points>) {
    """Паттерн фасада/тыла: по n_wing окон win_w с шагом win_step на крыло, ближайшее
    к центру на ±wing_x; средний пролёт (эркер/башня) — flex-стена. door = true —
    первый слот правого крыла становится K_DOOR (парадный вход 1-го этажа фасада;
    сама дверь — модуль door, здесь только резервируется ось)."""
    expect n_wing >= 1: "wing_pattern: хотя бы одно окно на крыло"
    x_n = wing_x + f32(n_wing - 1) * win_step
    m0 = L * 0.5 - x_n - win_w * 0.5
    gap = win_step - win_w
    p0 = lsp.pattern_add(pat = lsp.pattern_empty(), size = m0, kind = k.K_WALL())
    p1 = lsp.pattern_add(pat = p0, size = win_w, kind = k.K_WINDOW())
    p2 = repeat (p1, iterations = n_wing - 1) |acc| {
        a1 = lsp.pattern_add(pat = acc, size = gap, kind = k.K_WALL())
        acc = lsp.pattern_add(pat = a1, size = win_w, kind = k.K_WINDOW())
    }
    p3 = lsp.pattern_add(pat = p2, size = 1.0, kind = k.K_WALL(), flex = true)
    p4 = lsp.pattern_add(pat = p3, size = win_w, kind = door ? k.K_DOOR() : k.K_WINDOW())
    p5 = repeat (p4, iterations = n_wing - 1) |acc| {
        a1 = lsp.pattern_add(pat = acc, size = gap, kind = k.K_WALL())
        acc = lsp.pattern_add(pat = a1, size = win_w, kind = k.K_WINDOW())
    }
    out = lsp.pattern_add(pat = p5, size = m0, kind = k.K_WALL())
}

def side_pattern(L: f32, wing_z: f32, win_w: f32) -> (out: geo<points>) {
    """Паттерн боковой стены: два окна на ±wing_z (бок не удлиняется с шириной дома)."""
    out = lsp.pattern_row(n = 2, pitch = wing_z * 2.0, size = win_w, kind = k.K_WINDOW(), x0 = 0.0 - wing_z, len = L)
}

def tf(bnds: geo<points>, facade: int, floor: int, pat: geo<points>, slot_h: f32, slot_y: f32) -> (out: geo<points>) {
    """Полосы одного фасада и этажа, разложенные паттерном (сокращение раскладки)."""
    fb = delete(bnds, where = (@facade != facade) | (@floor != floor))
    out = af.tiles(bands_in = fb, pattern = pat, slot_h = slot_h, slot_y = slot_y)
}

def wall_windows(width: f32, depth: f32, plinth_h: f32, floor1_h: f32, belt_h: f32, floor2_h: f32, wing_x: f32, n_wing: int = 1, win_step: f32 = 1.65) -> (out: geo<mesh>) {
    """Все стеновые окна здания конвейером lib/arch: план → фасады → полосы → оси:
    - фасад (1) и тыл (3): по n_wing окон на крыло от ±wing_x с шагом win_step,
      1-й этаж фасада — с дверным слотом на +wing_x;
    - боковые стены (0 = левая, 2 = правая): по два окна на этаж на ±wing_z.
    Подоконная отметка — 0.35 от низа полосы этажа; терминал — stone_arch_window."""
    win_w = 0.72
    win_h = 2.15
    sill = 0.35
    f2_top = plinth_h + floor1_h + belt_h + floor2_h
    outer_x = wing_x + f32(n_wing - 1) * win_step
    wing_z = depth * 0.5 - (width * 0.5 - outer_x)
    plan = ap.plan_rect(w = width, d = depth)
    faces = af.facades(plan = plan, y0 = 0.0, y1 = f2_top, t = 0.3)
    bp0 = lsp.pattern_add(pat = lsp.pattern_empty(), size = plinth_h, kind = k.K_PLINTH_BAND())
    bp1 = lsp.pattern_add(pat = bp0, size = floor1_h, kind = k.K_FLOOR_BAND())
    bp2 = lsp.pattern_add(pat = bp1, size = belt_h, kind = k.K_WALL())
    bp = lsp.pattern_add(pat = bp2, size = floor2_h, kind = k.K_FLOOR_BAND())
    bnds = af.bands(faces = faces, pattern = bp)
    pf_door = wing_pattern(L = width, wing_x = wing_x, win_step = win_step, n_wing = n_wing, win_w = win_w, door = true)
    pf = wing_pattern(L = width, wing_x = wing_x, win_step = win_step, n_wing = n_wing, win_w = win_w, door = false)
    ps = side_pattern(L = depth, wing_z = wing_z, win_w = win_w)
    t0 = tf(bnds, 1, 1, pf_door, win_h, sill)
    t1 = tf(bnds, 1, 3, pf, win_h, sill)
    t2 = tf(bnds, 3, 1, pf, win_h, sill)
    t3 = tf(bnds, 3, 3, pf, win_h, sill)
    t4 = tf(bnds, 0, 1, ps, win_h, sill)
    t5 = tf(bnds, 0, 3, ps, win_h, sill)
    t6 = tf(bnds, 2, 1, ps, win_h, sill)
    t7 = tf(bnds, 2, 3, ps, win_h, sill)
    slots = merge(t0, t1, t2, t3, t4, t5, t6, t7)
    # Вынос на горизонт стены: 0.05 наружу по нормали фасада.
    proud = set_position(slots, pos = @P + vec3(sin(radians(@yaw)), 0.0, cos(radians(@yaw))) * 0.05)
    out = foreach s in ls.pick(scopes = proud, kind = k.K_WINDOW()) {
        s = ls.place(g = stone_arch_window(w = ls.frame_w(s), h = ls.frame_h(s)), s = s)
    }
}
