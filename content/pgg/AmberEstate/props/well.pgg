param well_r: f32 = 0.55
param wall_h: f32 = 0.58
param seed: int = 9

import lib.parts
import lib.shapes
import lib.ironwork
import lib.fixtures
import common

# Колодец по референсу props/well.jpg.
# Три ряда клиньев-камней, столбы, двускатная дранка, ворот, открытая кадка на верёвке.
# Верх +Y, ворот на −X. Именованные узлы: stones, frame, bucket, scene.

def stone_wedge(r_in: f32, r_out: f32, n: int, ch: f32) -> (out: geo<mesh>) {
    """Один камень кольца: усечённая пирамида, апофемы r_in/r_out, грань в +Z.
    Бока по радиусам ±π/n — соседи стыкуются без щелей."""
    expect n >= 8: "stone_wedge: мало"
    expect r_out > r_in: "stone_wedge: толщина"
    theta = 3.14159265 / f32(n)
    w_in = 2.0 * r_in * tan(theta)
    w_out = 2.0 * r_out * tan(theta)
    thick = r_out - r_in
    path0 = mesh_line(count = 2, length = thick, dir = (0, 0, 1))
    path = set(transform(path0, translate = vec3(0, 0, r_in)), "profile_scale", @index == 0 ? vec2(w_in, ch) : vec2(w_out, ch), domain = points)
    sq = transform(circle(sides = 4, radius = 0.70710678), rotate = vec3(0, 0, 45))
    body = sweep(path, profile = sq)
    edged = bevel(body, width = 0.010, bevel_group = "edge")
    out = mark(compute_normals(edged, mode = flat), "stone", where = true, domain = faces)
}

def stone_course(y: f32, r_in: f32, r_out: f32, n: int, ch: f32, yaw: f32, rng: rng) -> (out: geo<mesh>) {
    """Кольцо n клиньев, низ на y, перевязка yaw. @tint на якоре: крем / серый / тёплый."""
    wedge = stone_wedge(r_in = r_in, r_out = r_out, n = n, ch = ch)
    ring = transform(circle(sides = n, radius = 1.0), rotate = vec3(90, 0, 0))
    yaw_p = degrees(atan2(dot(@P, (1, 0, 0)), dot(@P, (0, 0, 1)))) + yaw
    p1 = set(ring, "orient", orient_from_euler(vec3(0, yaw_p, 0)))
    p2 = set_position(p1, offset = vec3(0, y + ch * 0.5, 0) - @P)
    kind = random_int(n = 5, rng = split_rng(rng, key = "kind"))
    cream = vec3(1.04, 1.01, 0.96)
    grey = vec3(0.68, 0.73, 0.75)
    warm = vec3(0.88, 0.76, 0.58)
    t = kind >= 4 ? warm : (kind >= 3 ? grey : cream)
    p3 = set(p2, "tint", t)
    out = realize(instance_on_points(p3, source = wedge))
}

def make_stones(r: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Три ряда клиньев: внутри вровень, верхний ряд нависает снаружи + пол."""
    n = 16
    ch = h / 3.0
    t = 0.16
    r_in = r - t
    over = 0.05
    step = 180.0 / f32(n)
    c0 = stone_course(y = 0.0, r_in = r_in, r_out = r, n = n, ch = ch, yaw = 0, rng = split_rng(rng, key = "c0"))
    c1 = stone_course(y = ch, r_in = r_in, r_out = r, n = n, ch = ch, yaw = step, rng = split_rng(rng, key = "c1"))
    c2 = stone_course(y = 2.0 * ch, r_in = r_in, r_out = r + over, n = n, ch = ch, yaw = 0, rng = split_rng(rng, key = "c2"))
    floor = common.wood_disc(y = 0.0, r = r_in - 0.01, h = 0.04, grp = "wood_dark")
    out = merge(c0, c1, c2, floor)
}

def make_frame(r: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Два столба на кладке, широкий конёк, дранка вразбежку, ворот слева."""
    post_h = 0.92
    post_w = 0.12
    post_d = post_w * 2.0
    y0 = h - 0.03
    r_in = r - 0.16
    r_out = r + 0.05
    px = (r_in + r_out) * 0.5
    p_l = parts.piece(size = vec3(post_w, post_h, post_d), pos = vec3(0.0 - px, y0 + post_h * 0.5, 0), grp = "wood")
    p_r = parts.piece(size = vec3(post_w, post_h, post_d), pos = vec3(px, y0 + post_h * 0.5, 0), grp = "wood")
    hw = r * 1.18
    beam = parts.piece(size = vec3(2.0 * px + 0.22, 0.10, 0.12), pos = vec3(0, y0 + post_h + 0.04, 0), grp = "wood")
    ridge_y = y0 + post_h + 0.12
    ridge_cap = parts.piece(size = vec3(2.0 * hw + 0.06, 0.12, 0.20), pos = vec3(0, ridge_y + 0.04, 0), grp = "wood")
    tl = 0.26
    th = 0.016
    pv = tl * 0.75
    tilt = degrees(atan2(th, pv))
    n_rows = 5
    n_a = 7
    n_b = 8
    seam = 0.006
    pu_a = (2.0 * hw) / f32(n_a)
    pu_b = (2.0 * hw) / f32(n_b)
    wa = pu_a - seam
    wb = pu_b - seam
    hang = vec3(0, 0, 0.0 - tl * 0.5)
    # Верх плитки на доске, низ на ряде ниже: наклон вокруг конькового края, не y_step.
    flat_a = transform(parts.cbox(size = vec3(wa, th, tl), k = 0.16), translate = hang)
    flat_b = transform(parts.cbox(size = vec3(wb, th, tl), k = 0.16), translate = hang)
    src_a = transform(flat_a, rotate = vec3(tilt, 0, 0))
    src_b = transform(flat_b, rotate = vec3(tilt, 0, 0))
    a0 = mark(src_a, "wood", where = true, domain = faces)
    a1 = mark(src_a, "roof", where = true, domain = faces)
    a2 = mark(src_a, "wood_light", where = true, domain = faces)
    b0 = mark(src_b, "wood", where = true, domain = faces)
    b1 = mark(src_b, "roof", where = true, domain = faces)
    b2 = mark(src_b, "wood_light", where = true, domain = faces)
    empty = empty_points()
    # Чёт/нечет — разный шаг (5 и 6 целых досок на ширину ската), без бокового clip.
    anchors_a = repeat (empty, iterations = (n_rows + 1) / 2) |acc| {
        k = f32(@iteration) * 2.0
        row0 = mesh_line(count = n_a, length = f32(n_a - 1) * pu_a, dir = (1, 0, 0))
        row = transform(row0, translate = vec3(0.0 - f32(n_a - 1) * pu_a * 0.5, th * 0.5, pv - k * pv))
        acc = merge(acc, row)
    }
    anchors_b = repeat (empty, iterations = n_rows / 2) |acc| {
        k = f32(@iteration) * 2.0 + 1.0
        row0 = mesh_line(count = n_b, length = f32(n_b - 1) * pu_b, dir = (1, 0, 0))
        row = transform(row0, translate = vec3(0.0 - f32(n_b - 1) * pu_b * 0.5, th * 0.5, pv - k * pv))
        acc = merge(acc, row)
    }
    pts_a = set(anchors_a, "variant", random_int(n = 3, rng = split_rng(rng, key = "ta")))
    pts_b = set(anchors_b, "variant", random_int(n = 3, rng = split_rng(rng, key = "tb")))
    raw_a = realize(instance_on_points(pts_a, source = a0, variants = [a0, a1, a2]))
    raw_b = realize(instance_on_points(pts_b, source = b0, variants = [b0, b1, b2]))
    raw = merge(raw_a, raw_b)
    # Клип дальше нуля: после −pitch верхний ряд оказывается под коньком, не ниже.
    c_top = clip(raw, origin = vec3(0, 0, 0.05), normal = vec3(0, 0, 0.0 - 1.0), cap_group = "wood")
    field = compute_normals(c_top, mode = flat)
    z_eave = pv - f32(n_rows - 1) * pv - tl
    bw = 0.070
    bh = 0.104
    y_under = 0.0 - bh * 0.52
    x_b = hw - bw * 0.5
    z_lo = z_eave
    z_hi = 0.0 - 0.05
    span_z = z_hi - z_lo
    z_mid = (z_hi + z_lo) * 0.5
    barge_l = parts.piece(size = vec3(bw, bh, span_z), pos = vec3(0.0 - x_b, y_under, z_mid), grp = "wood")
    barge_r = parts.piece(size = vec3(bw, bh, span_z), pos = vec3(x_b, y_under, z_mid), grp = "wood")
    fascia_e = parts.piece(size = vec3(2.0 * hw, bh, bw), pos = vec3(0, y_under, z_lo + bw * 0.5), grp = "wood")
    fascia_r = parts.piece(size = vec3(2.0 * hw, bh, bw), pos = vec3(0, y_under, z_hi - bw * 0.5), grp = "wood")
    deck = merge(field, barge_l, barge_r, fascia_e, fascia_r)
    slope = 42.0
    # Ряды от конька в −Z; −pitch опускает скат (иначе получается ендова).
    pitched = transform(deck, rotate = vec3(0.0 - slope, 0, 0))
    front = transform(pitched, translate = vec3(0, ridge_y, 0))
    back = transform(transform(pitched, rotate = vec3(0, 180, 0)), translate = vec3(0, ridge_y, 0))
    wy = y0 + post_h * 0.58
    face = 0.0 - px - post_w * 0.5
    wt = 0.085
    wheel = mark(unmark(ironwork.spool(p0 = vec3(face - wt, wy, 0), p1 = vec3(face + 0.004, wy, 0), r0 = 0.16, r1 = 0.16, sides = 16), "iron"), "wood", where = true, domain = faces)
    hub = ironwork.spool(p0 = vec3(face - wt - 0.016, wy, 0), p1 = vec3(0.0 - px + post_w * 0.5 + 0.02, wy, 0), r0 = 0.04, r1 = 0.04, sides = 8)
    axle = ironwork.spool(p0 = vec3(face - wt - 0.032, wy, 0), p1 = vec3(0.0 - px + post_w * 0.5 + 0.03, wy, 0), r0 = 0.018, r1 = 0.018, sides = 8)
    out = merge(p_l, p_r, beam, ridge_cap, front, back, wheel, hub, axle)
}

def bucket_hoop(y: f32, r: f32, h: f32, n: int) -> (out: geo<mesh>) {
    """Железный пояс: n брусков вокруг Y, чтобы не заткнуть полость сплошным диском."""
    expect n >= 8: "bucket_hoop: мало"
    w = 2.0 * r * sin(3.14159265 / f32(n)) * 1.02
    one = parts.piece(size = vec3(w, h, 0.018), pos = vec3(0, y + h * 0.5, r), grp = "iron")
    out = shapes.polar_array(one, n = n)
}

def make_bucket(r: f32, h: f32) -> (out: geo<mesh>) {
    """Открытая кадка: клёпки, полость, два обруча, дужка с кольцом и крюком, верёвка к балке."""
    n = 12
    bh = 0.34
    r_bot = r * 0.245
    r_top = r * 0.32
    thick = 0.028
    by = h * 0.74
    path0 = mesh_line(count = 2, length = bh, dir = (0, 1, 0))
    path = set(transform(path0, translate = vec3(0, by, 0)), "profile_scale", @index == 0 ? vec2(r_bot, r_bot) : vec2(r_top, r_top), domain = points)
    wall = mark(compute_normals(sweep(path, profile = circle(sides = n, radius = 1.0), cap = false), mode = flat), "wood", where = true, domain = faces)
    path_i0 = mesh_line(count = 2, length = bh - 0.014, dir = (0, 1, 0))
    path_i = set(transform(path_i0, translate = vec3(0, by, 0)), "profile_scale", @index == 0 ? vec2(r_bot - thick, r_bot - thick) : vec2(r_top - thick, r_top - thick), domain = points)
    liner = mark(compute_normals(sweep(path_i, profile = circle(sides = n, radius = 1.0), cap = false), mode = flat), "wood_dark", where = true, domain = faces)
    floor = common.wood_disc(y = by, r = r_bot - thick * 0.35, h = 0.022, grp = "wood_dark")
    rim_y = by + bh
    lip_w = 2.0 * r_top * sin(3.14159265 / f32(n)) * 1.02
    lip_one = parts.piece(size = vec3(lip_w, 0.014, thick + 0.004), pos = vec3(0, rim_y - 0.006, r_top - thick * 0.5), grp = "wood_light")
    lip = shapes.polar_array(lip_one, n = n)
    y_lo = by + bh * 0.10
    y_hi = by + bh * 0.68
    r_lo = mix(r_bot, r_top, (y_lo - by) / bh) + 0.006
    r_hi = mix(r_bot, r_top, (y_hi - by) / bh) + 0.006
    ho0 = bucket_hoop(y = y_lo, r = r_lo, h = 0.034, n = n)
    ho1 = bucket_hoop(y = y_hi, r = r_hi, h = 0.034, n = n)
    rx = r_top * 0.98
    bail = fixtures.rod(p0 = vec3(rx, rim_y - 0.016, 0), p1 = vec3(rx * 0.18, rim_y + 0.13, 0), p2 = vec3(0.0 - rx * 0.18, rim_y + 0.13, 0), p3 = vec3(0.0 - rx, rim_y - 0.016, 0), r = 0.015, n = 14)
    ear_l = ironwork.spool(p0 = vec3(rx - 0.01, rim_y - 0.028, 0), p1 = vec3(rx + 0.02, rim_y - 0.028, 0), r0 = 0.015, r1 = 0.015, sides = 8)
    ear_r = ironwork.spool(p0 = vec3(0.0 - rx - 0.02, rim_y - 0.028, 0), p1 = vec3(0.0 - rx + 0.01, rim_y - 0.028, 0), r0 = 0.015, r1 = 0.015, sides = 8)
    hang = fixtures.ring(center = vec3(0, rim_y + 0.145, 0), radius = 0.032, r = 0.008, yaw_deg = 90)
    hook = fixtures.rod(p0 = vec3(0, rim_y + 0.26, 0), p1 = vec3(0.038, rim_y + 0.17, 0), p2 = vec3(0.006, rim_y + 0.10, 0), p3 = vec3(0.0 - 0.028, rim_y + 0.145, 0), r = 0.008, n = 12)
    rope = mark(unmark(ironwork.spool(p0 = vec3(0, rim_y + 0.26, 0), p1 = vec3(0, h + 0.92, 0), r0 = 0.012, r1 = 0.013, sides = 6), "iron"), "wood", where = true, domain = faces)
    out = merge(wall, liner, floor, lip, ho0, ho1, bail, ear_l, ear_r, hang, hook, rope)
}

def paint(raw: geo<mesh>, rng: rng) -> (out: geo<mesh>) {
    """Окрас колодца: камень, дерево, черепица, железо."""
    stone_col = vec3(0.82, 0.76, 0.66) * @tint
    wood_col = vec3(0.62, 0.38, 0.16) * @tint
    wood_lt = vec3(0.84, 0.58, 0.30) * @tint
    wood_dk = vec3(0.22, 0.12, 0.06)
    iron_col = vec3(0.28, 0.30, 0.32)
    roof_col = vec3(0.86, 0.42, 0.16) * @tint
    c0 = ingroup("stone") ? stone_col : vec3(1.0, 0.0, 1.0)
    c1 = ingroup("wood") ? wood_col : c0
    c2 = ingroup("wood_light") ? wood_lt : c1
    c3 = ingroup("wood_dark") ? wood_dk : c2
    c4 = ingroup("iron") ? iron_col : c3
    c5 = ingroup("roof") ? roof_col : c4
    edge_mul = ingroup("edge") ? vec3(1.16, 1.12, 1.06) : vec3(1.0)
    out = common.ao(set(raw, "Cd", c5 * edge_mul, domain = faces), rng = rng)
}

def assemble(r: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Колодец: камни, навес, ведро, окраска."""
    out = paint(merge(make_stones(r = r, h = h, rng = split_rng(rng, key = "st")), make_frame(r = r, h = h, rng = split_rng(rng, key = "frame")), make_bucket(r = r, h = h)), rng = rng)
}

root_rng = rng_from_seed(seed)
stones = make_stones(r = well_r, h = wall_h, rng = split_rng(root_rng, key = "st"))
frame = make_frame(r = well_r, h = wall_h, rng = split_rng(root_rng, key = "frame"))
bucket = make_bucket(r = well_r, h = wall_h)
scene = paint(merge(stones, frame, bucket), rng = split_rng(root_rng, key = "ao"))
output scene
