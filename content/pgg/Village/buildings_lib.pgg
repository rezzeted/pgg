# Village building factories (village_geometry_generator S6): def-версии
# ассетов buildings/*.pgg. Используются сценогенератором
# VillageGeometryGeneratorCli (--emit-pgg): сцена вызывает defs с биндингами
# участка и ставит через transform. Контракт тот же, что у файловых ассетов:
# фасад +Z, база y=0, группы на faces; цвет @Cd ставится на faces сразу
# (E305: ingroup работает только по существующим группам, общий colorize
# по палитре невозможен).

import lib.shapes as shapes

# Палитра материалов (значения — vec3 RGB 0..1).
# wall  (0.84, 0.79, 0.68)  штукатурка
# roof  (0.45, 0.20, 0.13)  черепица
# wood  (0.40, 0.28, 0.16)  дерево
# stone (0.55, 0.54, 0.50)  камень

# --- общие кусочки ---------------------------------------------------------

def gable_roof(w: f32, d: f32, y: f32, rise: f32, ov: f32) -> (out: geo<mesh>) {
    """Двускатная крыша: треугольный профиль, свип вдоль X (конёк вдоль X)."""
    hd = d * 0.5 + ov
    prof = set_position(mesh_line(count = 3, length = 0.0), pos = @index == 0 ? vec3(0.0 - hd, 0.0 - 0.12, 0) : (@index == 1 ? vec3(hd, 0.0 - 0.12, 0) : vec3(0, rise, 0)))
    path = transform(mesh_line(count = 2, length = w + 2.0 * ov, dir = (1, 0, 0)), translate = vec3(0.0 - (w * 0.5 + ov), y, 0))
    m = mark(compute_normals(sweep(path, profile = prof), mode = flat), "roof", where = true, domain = faces)
    out = set(m, "Cd", vec3(0.45, 0.20, 0.13), domain = faces)
}

def block(size: vec3, pos: vec3, grp: string, col: vec3) -> (out: geo<mesh>) {
    """Бокс размером size с центром в pos: грани в группе grp, цвет col."""
    m = mark(transform(box(size = size), translate = pos), grp, where = true, domain = faces)
    out = set(m, "Cd", col, domain = faces)
}

def probe_pt() -> (out: geo<points>) {
    """Одиночная точка для value(random(...)) редукций."""
    out = mesh_line(count = 1, length = 0.0)
}

# --- постройки (фасад +Z, база y=0, центр XZ) -------------------------------

def b_house(w: f32, d: f32, rng: rng) -> (out: geo<mesh>) {
    """Дом-массинг: коробка стен + двускатная крыша + дверь."""
    bw = min(w * 0.55, 7.0)
    bd = min(d * 0.45, 6.0)
    bh = 2.7 + value(random(lo = 0.0, hi = 0.5, rng = split_rng(rng, key = "h"), counter = 0), on = probe_pt())
    body = block(size = vec3(bw, bh, bd), pos = vec3(0, bh * 0.5, 0), grp = "wall", col = vec3(0.84, 0.79, 0.68))
    roof = gable_roof(w = bw, d = bd, y = bh, rise = bd * 0.45, ov = 0.35)
    door = block(size = vec3(0.9, 2.0, 0.1), pos = vec3(0.0 - bw * 0.2, 1.0, bd * 0.5), grp = "wood", col = vec3(0.40, 0.28, 0.16))
    out = merge(merge(body, roof), door)
}

def b_bakery(w: f32, d: f32, rng: rng) -> (out: geo<mesh>) {
    """Пекарня: дом + каменный дымоход + пристройка-печь сбоку."""
    bw = min(w * 0.5, 6.5)
    bd = min(d * 0.4, 5.5)
    bh = 2.7 + value(random(lo = 0.0, hi = 0.3, rng = split_rng(rng, key = "h"), counter = 0), on = probe_pt())
    body = block(size = vec3(bw, bh, bd), pos = vec3(0, bh * 0.5, 0), grp = "wall", col = vec3(0.84, 0.79, 0.68))
    rise = bd * 0.45
    roof = gable_roof(w = bw, d = bd, y = bh, rise = rise, ov = 0.35)
    chim_h = bh + rise + 1.1
    chimney = block(size = vec3(0.7, chim_h, 0.7), pos = vec3(bw * 0.3, chim_h * 0.5, 0.0 - bd * 0.25), grp = "stone", col = vec3(0.55, 0.54, 0.50))
    annex = block(size = vec3(1.6, 1.8, 2.2), pos = vec3(0.0 - bw * 0.5 - 0.8, 0.9, 0.0 - bd * 0.1), grp = "stone", col = vec3(0.55, 0.54, 0.50))
    door = block(size = vec3(0.9, 2.0, 0.1), pos = vec3(0.0 - bw * 0.2, 1.0, bd * 0.5), grp = "wood", col = vec3(0.40, 0.28, 0.16))
    out = merge(merge(merge(body, roof), merge(chimney, annex)), door)
}

def b_tavern(w: f32, d: f32, rng: rng) -> (out: geo<mesh>) {
    """Таверна: широкий двухэтажный массинг + крыша + дверь + вывеска."""
    bw = min(w * 0.62, 9.0)
    bd = min(d * 0.5, 7.0)
    bh = 5.2 + value(random(lo = 0.0, hi = 0.4, rng = split_rng(rng, key = "h"), counter = 0), on = probe_pt())
    body = block(size = vec3(bw, bh, bd), pos = vec3(0, bh * 0.5, 0), grp = "wall", col = vec3(0.84, 0.79, 0.68))
    roof = gable_roof(w = bw, d = bd, y = bh, rise = bd * 0.45, ov = 0.4)
    door = block(size = vec3(1.2, 2.3, 0.12), pos = vec3(0, 1.15, bd * 0.5), grp = "wood", col = vec3(0.40, 0.28, 0.16))
    bracket = block(size = vec3(0.08, 0.08, 0.9), pos = vec3(bw * 0.28, 3.1, bd * 0.5 + 0.4), grp = "wood", col = vec3(0.40, 0.28, 0.16))
    sign = block(size = vec3(0.7, 0.5, 0.06), pos = vec3(bw * 0.28, 2.7, bd * 0.5 + 0.75), grp = "wood", col = vec3(0.52, 0.36, 0.14))
    out = merge(merge(merge(body, roof), door), merge(bracket, sign))
}

def mill_blade(angle_deg: f32, len: f32, hh: f32, hz: f32) -> (out: geo<mesh>) {
    """Одно крыло мельницы: планка от хаба вверх, повёрнутая вокруг Z."""
    b0 = box(size = vec3(0.22, len, 0.08))
    b1 = transform(b0, translate = vec3(0, len * 0.5 + 0.3, 0))
    b2 = transform(b1, rotate = vec3(0, 0, angle_deg))
    m = mark(transform(b2, translate = vec3(0, hh, hz)), "wood", where = true, domain = faces)
    out = set(m, "Cd", vec3(0.40, 0.28, 0.16), domain = faces)
}

def b_mill(w: f32, d: f32, rng: rng) -> (out: geo<mesh>) {
    """Мельница: сужающаяся 8-гранная башня, конус, 4 крыла над фасадом."""
    tower_h = 7.5 + value(random(lo = 0.0, hi = 1.5, rng = split_rng(rng, key = "h"), counter = 0), on = probe_pt())
    r0 = min(w, d) * 0.16 + 0.8
    r1 = r0 * 0.62
    tower0 = shapes.ngon_frustum(y0 = 0.0, y1 = tower_h, r0 = r0, r1 = r1, sides = 8, grp = "wall")
    tower = set(tower0, "Cd", vec3(0.84, 0.79, 0.68), domain = faces)
    cap0 = shapes.ngon_frustum(y0 = tower_h - 0.05, y1 = tower_h + 1.6, r0 = r1 + 0.35, r1 = 0.12, sides = 8, grp = "roof")
    cap = set(cap0, "Cd", vec3(0.45, 0.20, 0.13), domain = faces)
    blade_len = r0 * 2.2
    hub_h = tower_h + 0.6
    hub_z = r1 + 0.55
    angle0 = value(random(lo = 0.0, hi = 45.0, rng = split_rng(rng, key = "blades"), counter = 0), on = probe_pt())
    b0 = mill_blade(angle_deg = angle0, len = blade_len, hh = hub_h, hz = hub_z)
    b1 = mill_blade(angle_deg = angle0 + 90.0, len = blade_len, hh = hub_h, hz = hub_z)
    b2 = mill_blade(angle_deg = angle0 + 180.0, len = blade_len, hh = hub_h, hz = hub_z)
    b3 = mill_blade(angle_deg = angle0 + 270.0, len = blade_len, hh = hub_h, hz = hub_z)
    hub = block(size = vec3(0.4, 0.4, 0.9), pos = vec3(0, hub_h, hub_z - 0.3), grp = "wood", col = vec3(0.40, 0.28, 0.16))
    door = block(size = vec3(0.9, 1.9, 0.1), pos = vec3(0, 0.95, r0 * 0.95), grp = "wood", col = vec3(0.40, 0.28, 0.16))
    out = merge(merge(merge(tower, cap), merge(merge(b0, b1), merge(b2, b3))), merge(hub, door))
}

def b_well(w: f32, d: f32, rng: rng) -> (out: geo<mesh>) {
    """Колодец: каменное кольцо, два столбика, двускатный навес."""
    ring0 = shapes.ngon_frustum(y0 = 0.0, y1 = 0.9, r0 = 0.85, r1 = 0.75, sides = 8, grp = "stone")
    ring = set(ring0, "Cd", vec3(0.55, 0.54, 0.50), domain = faces)
    post_l = block(size = vec3(0.14, 1.9, 0.14), pos = vec3(0.0 - 0.8, 0.95, 0), grp = "wood", col = vec3(0.40, 0.28, 0.16))
    post_r = block(size = vec3(0.14, 1.9, 0.14), pos = vec3(0.8, 0.95, 0), grp = "wood", col = vec3(0.40, 0.28, 0.16))
    roof = gable_roof(w = 2.0, d = 1.9, y = 1.9, rise = 0.5, ov = 0.1)
    out = merge(merge(ring, roof), merge(post_l, post_r))
}
