param w: f32 = 8.0
param d: f32 = 10.0
param rng_seed: int = 1

import Village.buildings_lib as vb

# Village building asset (village_geometry_generator S6): mill — тонкая
# обёртка над vb.b_mill . Контракт: фасад +Z, база y=0,
# центр XZ; w/d — габариты участка в метрах. Выход: mesh (geo<mesh>),
# группы faces: wall, roof, wood, stone.

mesh = vb.b_mill(w = w, d = d, rng = rng_from_seed(rng_seed))
output mesh
