param w: f32 = 8.0
param d: f32 = 10.0
param rng_seed: int = 1

# Village building asset (village_geometry_generator S6): bakery — house
# massing + stone chimney + side oven annex. Contract: facade +Z, base y=0,
# centered in XZ; w/d — parcel front/depth in meters.
# Groups (faces): wall, roof, wood, stone.
# Output: mesh (geo<mesh>).

root_rng = rng_from_seed(rng_seed)
probe = mesh_line(count = 1, length = 0.0)

bw = min(w * 0.5, 6.5)
bd = min(d * 0.4, 5.5)
bh = 2.7 + value(random(lo = 0.0, hi = 0.3, rng = split_rng(root_rng, key = "h"), counter = 0), on = probe)
ov = 0.35

body = mark(transform(box(size = vec3(bw, bh, bd)), translate = vec3(0, bh * 0.5, 0)), "wall", where = true, domain = faces)

rise = bd * 0.45
hd = bd * 0.5 + ov
prof = set_position(mesh_line(count = 3, length = 0.0), pos = @index == 0 ? vec3(0.0 - hd, 0.0 - 0.12, 0) : (@index == 1 ? vec3(hd, 0.0 - 0.12, 0) : vec3(0, rise, 0)))
path = transform(mesh_line(count = 2, length = bw + 2.0 * ov, dir = (1, 0, 0)), translate = vec3(0.0 - (bw * 0.5 + ov), bh, 0))
roof = mark(compute_normals(sweep(path, profile = prof), mode = flat), "roof", where = true, domain = faces)

# Stone chimney: tall stack at the back-right gable.
chim_h = bh + rise + 1.1
chimney = mark(transform(box(size = vec3(0.7, chim_h, 0.7)), translate = vec3(bw * 0.3, chim_h * 0.5, 0.0 - bd * 0.25)), "stone", where = true, domain = faces)

# Oven annex: low box on the left side wall.
annex = mark(transform(box(size = vec3(1.6, 1.8, 2.2)), translate = vec3(0.0 - bw * 0.5 - 0.8, 0.9, 0.0 - bd * 0.1)), "stone", where = true, domain = faces)

door = mark(transform(box(size = vec3(0.9, 2.0, 0.1)), translate = vec3(0.0 - bw * 0.2, 1.0, bd * 0.5)), "wood", where = true, domain = faces)

mesh = merge(merge(merge(body, roof), merge(chimney, annex)), door)
output mesh
