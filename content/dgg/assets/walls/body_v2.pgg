# DungeonGeometryGenerator slot asset: wall_body v2 (slots §2.2). Mortar-core beam between pillar
# faces with clipped door openings (lintels above), crowned by a cap band of
# big beveled stones (lib.parts.cbox, ashlar palette): per-stone length/height/
# depth jitter opens dark mortar joints down to the beam top. The beam is
# shortened to H - cap_h + 0.02 so every cap embeds 0.02 into it, and cap side
# faces stand 20 mm proud of the v2 facing blocks — no coplanar face pairs.
# The band owns [H - 0.24, H]; the facing/node cornice rows live just below.

import codes as c
import ashlar as a
import lib.parts as parts

def slot_version() -> (out: int) {
    out = 1
}

def carve(g: geo<mesh>, origin_a: vec3, origin_b: vec3, axis: vec3, open_h: f32) -> (out: geo<mesh>) {
    """Cut one opening [origin_a, origin_b] x [0, open_h]: sides + lintel."""
    neg = axis * (0.0 - 1.0)
    left = clip(g, origin = origin_a, normal = neg)
    right = clip(g, origin = origin_b, normal = axis)
    m0 = clip(g, origin = origin_a, normal = axis)
    midsl = clip(m0, origin = origin_b, normal = neg)
    lintel = clip(midsl, origin = vec3(0.0, open_h, 0.0), normal = vec3(0.0, 1.0, 0.0))
    out = merge(left, right, lintel)
}

param seg: geo<points>
param thick: f32 = 0.6
param h_a: f32 = 3.0
param h_b: f32 = 3.0
param style: int = 1
param style_a: int = 0
param style_b: int = 0
param cuts: geo<points>
param rng_seed: int = 7


p0 = value(@P, on = delete(seg, where = @index != 0))
p1 = value(@P, on = delete(seg, where = @index != 1))
side_a = style_a > 0 ? style_a : style
side_b = style_b > 0 ? style_b : style
dir = p1 - p0
L = length(dir)
u = dir / L
H = max(h_a, h_b)
cap_h = 0.24
beam_h = H - cap_h + 0.02
mid = (p0 + p1) * 0.5
yaw = degrees(atan2(0.0 - dot(dir, (0, 0, 1)), dot(dir, (1, 0, 0))))
# Split the mortar-core beam longitudinally into two halves (-Z = side_a,
# +Z = side_b) with a 2 mm gap at z=0 so each side's open mortar joints reveal
# its own room's mortar color and F11/elements sees two distinct styled elements.
half_t = (thick - 0.002) * 0.5
beam_a = set(set(transform(box(size = vec3(L, beam_h, half_t), res = 1), translate = vec3(L * 0.5, beam_h * 0.5, 0.0 - (half_t * 0.5 + 0.001))), "style", side_a, domain = points), "Cd", a.mortar_color(style = side_a, mot = 0.45), domain = points)
beam_b = set(set(transform(box(size = vec3(L, beam_h, half_t), res = 1), translate = vec3(L * 0.5, beam_h * 0.5, half_t * 0.5 + 0.001)), "style", side_b, domain = points), "Cd", a.mortar_color(style = side_b, mot = 0.45), domain = points)
beam = transform(merge(beam_a, beam_b), rotate = vec3(0.0, yaw, 0.0), translate = vec3(dot(p0, (1, 0, 0)), 0.0, dot(p0, (0, 0, 1))))

carved = repeat (beam, iterations = count(cuts) / 2) |acc| {
    i = @iteration
    pa = delete(cuts, where = @index != 2 * i)
    pb = delete(cuts, where = @index != 2 * i + 1)
    qa = value(@P, on = pa)
    qb = value(@P, on = pb)
    oh = value(@h, on = pa)
    la = dot(qa - p0, u)
    lb = dot(qb - p0, u)
    lo = min(la, lb)
    hi = max(la, lb)
    acc = carve(g = acc, origin_a = p0 + u * lo, origin_b = p0 + u * hi, axis = u, open_h = oh)
}

# Cap band: hewn stones ~1.1 m long (much bigger than the 0.5 m facing
# blocks), tops uneven by jitter; bottoms embed 0.02 into the beam. First
# stone starts 2+ cm into the node cap volume — intersecting, not coplanar.
# When the wall separates two rooms with different styles (side_a != side_b),
# each cap course is split longitudinally into two side-styled coping stones.
probe = mesh_line(count = 1, length = 0.0)
root = rng_from_seed(rng_seed)
ncap = max(1, int(L / 1.1))
cw = L / f32(ncap)
caps_l = repeat (empty_mesh(), iterations = ncap) |acc| {
    i = @iteration
    erng = split_rng(root, key = 500 + i)
    sj = value(random(0.91, 0.97, rng = split_rng(erng, key = "sx")), on = probe)
    hj = value(random(0.90, 1.0, rng = split_rng(erng, key = "sy")), on = probe)
    dj = value(random(0.0, 0.025, rng = split_rng(erng, key = "sz")), on = probe)
    shade = value(random(0.82, 1.15, rng = split_rng(erng, key = "shade")), on = probe)
    mot = value(0.5 + 0.5 * fbm(scale = 1.6, octaves = 2, rng = split_rng(erng, key = "mot")), on = probe)
    hh = cap_h * hj
    full_d = thick + 0.18 + dj
    stone_single = set(set(transform(parts.cbox(size = vec3(cw * sj, hh, full_d), k = 0.0, k_abs = 0.022), translate = vec3(cw * (f32(i) + 0.5), H - cap_h + hh * 0.5, 0.0)), "Cd", a.trim_color(style = side_a, shade = shade, mot = mot), domain = points), "style", side_a, domain = points)
    half_d = (full_d - 0.012) * 0.5
    stone_a = set(set(transform(parts.cbox(size = vec3(cw * sj, hh, half_d), k = 0.0, k_abs = 0.018), translate = vec3(cw * (f32(i) + 0.5), H - cap_h + hh * 0.5, 0.0 - (half_d * 0.5 + 0.006))), "Cd", a.trim_color(style = side_a, shade = shade, mot = mot), domain = points), "style", side_a, domain = points)
    stone_b = set(set(transform(parts.cbox(size = vec3(cw * sj, hh, half_d), k = 0.0, k_abs = 0.018), translate = vec3(cw * (f32(i) + 0.5), H - cap_h + hh * 0.5, half_d * 0.5 + 0.006)), "Cd", a.trim_color(style = side_b, shade = shade, mot = mot), domain = points), "style", side_b, domain = points)
    stp = select(side_a == side_b, a = stone_single, b = merge(stone_a, stone_b))
    acc = merge(acc, stp)
}
caps = transform(caps_l, rotate = vec3(0.0, yaw, 0.0), translate = vec3(dot(p0, (1, 0, 0)), 0.0, dot(p0, (0, 0, 1))))

joint = unmark(merge(carved, caps), "edge")
flat0 = compute_normals(remove_attr(joint, "N"), mode = flat)
ao0 = bake_ao(flat0, rays = 8, distance = 0.35, rng = split_rng(root, key = "ao"), domain = corners)
ao1 = set(ao0, "ao_f", mix(0.36, 1.0, @ao * @ao), domain = faces)
ao2 = remove_attr(remove_attr(set(ao1, "Cd", clamp(@Cd * @ao_f, vec3(0.02), vec3(1.0)), domain = points), "ao_f"), "ao")
mesh = compute_normals(compute_normals(ao2, mode = smooth), mode = flat)
anchors = empty_points()

output mesh
output anchors
