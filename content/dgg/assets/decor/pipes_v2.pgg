# DungeonGeometryGenerator slot asset: decor pipes v2 (slots §2.6) — copper/cast-iron wall
# steam and water pipes with forged wall brackets, bolted flanges, a valve
# housing with a red/brass handwheel and a pressure gauge.
# Mounted on wall candidates (at y ~= 1.9 m, 0.08 m off the wall face, @n =
# inward room normal). Every part plane is staggered by >= 1.5 mm or buried in
# neighbour volumes so F11/elements sees zero coincident faces; @style = 0 so
# F11/opening_voids treats it as a prop.

import codes as c
import lib.parts as parts
import lib.fixtures as fixtures
import lib.ironwork as iron

def slot_version() -> (out: int) {
    out = 1
}

param p: geo<points>
param style: int = 1
param tag: int = 3
param rng_seed: int = 7


at = value(@P, on = p)
mn = normalize(value(@n, on = p))
yaw = degrees(atan2(dot(mn, (1, 0, 0)), dot(mn, (0, 0, 1))))
root = rng_from_seed(rng_seed)
probe = mesh_line(count = 1, length = 0.0)
wheel_ang = value(random(10.0, 50.0, rng = split_rng(root, key = "wheel")), on = probe)
patina_v = value(random(0.0, 1.0, rng = split_rng(root, key = "patina")), on = probe)

# Local frame: wall face is around z = -0.01 (since anchor is 0.08 m off the
# wall and we translate by at - mn * 0.07, so local z = 0 sits 1 cm in front
# of the wall face; wall brackets embed to z = -0.025).
# Vertical main riser at x = -0.14, z = 0.08, running from y = -1.85 (floor)
# to y = 0.55. Secondary copper line at x = 0.14, z = 0.065, running from
# y = -1.85 to y = 0.42, with a horizontal cross-bridge at y = -0.22.

iron_dark = vec3(0.11, 0.115, 0.128)
copper_col = mix(vec3(0.58, 0.33, 0.18), vec3(0.28, 0.46, 0.38), patina_v * 0.45)
brass_col = vec3(0.74, 0.56, 0.22)
red_wheel = vec3(0.68, 0.14, 0.10)
dial_face = vec3(0.86, 0.83, 0.74)

# Main cast-iron riser (x = -0.14, z = 0.08) and flanges
riser_main = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 1.84, 0.08), p1 = vec3(0.0 - 0.14, 0.54, 0.08), r0 = 0.042, r1 = 0.042, sides = 12), "Cd", copper_col, domain = points)
cap_top_a = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.535, 0.08), p1 = vec3(0.0 - 0.14, 0.58, 0.08), r0 = 0.054, r1 = 0.046, sides = 12), "Cd", brass_col, domain = points)
flange_a1 = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 1.20, 0.08), p1 = vec3(0.0 - 0.14, 0.0 - 1.15, 0.08), r0 = 0.064, r1 = 0.064, sides = 12), "Cd", iron_dark, domain = points)
flange_a2 = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 0.48, 0.08), p1 = vec3(0.0 - 0.14, 0.0 - 0.43, 0.08), r0 = 0.064, r1 = 0.064, sides = 12), "Cd", iron_dark, domain = points)
flange_a3 = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.18, 0.08), p1 = vec3(0.0 - 0.14, 0.23, 0.08), r0 = 0.064, r1 = 0.064, sides = 12), "Cd", iron_dark, domain = points)
floor_col_a = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 1.88, 0.08), p1 = vec3(0.0 - 0.14, 0.0 - 1.80, 0.08), r0 = 0.072, r1 = 0.058, sides = 12), "Cd", iron_dark, domain = points)

# Secondary copper pipe (x = 0.14, z = 0.065)
riser_sec = set(iron.spool(p0 = vec3(0.14, 0.0 - 1.84, 0.065), p1 = vec3(0.14, 0.40, 0.065), r0 = 0.028, r1 = 0.028, sides = 10), "Cd", brass_col, domain = points)
cap_top_b = set(iron.spool(p0 = vec3(0.14, 0.395, 0.065), p1 = vec3(0.14, 0.435, 0.065), r0 = 0.038, r1 = 0.032, sides = 10), "Cd", iron_dark, domain = points)
flange_b1 = set(iron.spool(p0 = vec3(0.14, 0.0 - 0.95, 0.065), p1 = vec3(0.14, 0.0 - 0.91, 0.065), r0 = 0.045, r1 = 0.045, sides = 10), "Cd", iron_dark, domain = points)
flange_b2 = set(iron.spool(p0 = vec3(0.14, 0.05, 0.065), p1 = vec3(0.14, 0.09, 0.065), r0 = 0.045, r1 = 0.045, sides = 10), "Cd", iron_dark, domain = points)
floor_col_b = set(iron.spool(p0 = vec3(0.14, 0.0 - 1.88, 0.065), p1 = vec3(0.14, 0.0 - 1.81, 0.065), r0 = 0.052, r1 = 0.042, sides = 10), "Cd", iron_dark, domain = points)

# Cross-manifold connecting the two pipes at y = -0.22
cross_pipe = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 0.22, 0.072), p1 = vec3(0.14, 0.0 - 0.22, 0.072), r0 = 0.024, r1 = 0.024, sides = 10), "Cd", copper_col, domain = points)
tee_a = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 0.27, 0.08), p1 = vec3(0.0 - 0.14, 0.0 - 0.17, 0.08), r0 = 0.052, r1 = 0.052, sides = 12), "Cd", brass_col, domain = points)
tee_b = set(iron.spool(p0 = vec3(0.14, 0.0 - 0.26, 0.065), p1 = vec3(0.14, 0.0 - 0.18, 0.065), r0 = 0.038, r1 = 0.038, sides = 10), "Cd", brass_col, domain = points)

# Wall clamp brackets (3 levels: y = -1.45, y = -0.68, y = 0.02)
brk_lo = set(parts.cbox(size = vec3(0.42, 0.048, 0.095), k = 0.0, k_abs = 0.006), "Cd", iron_dark, domain = points)
brk1 = transform(brk_lo, translate = vec3(0.0, 0.0 - 1.45, 0.022))
brk2 = transform(brk_lo, translate = vec3(0.0, 0.0 - 0.68, 0.022))
brk3 = transform(brk_lo, translate = vec3(0.0, 0.02, 0.022))
brackets = merge(brk1, brk2, brk3)

# Valve assembly on the main riser at y = -0.82: bulbous body + stem + red wheel
valve_body = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 0.89, 0.08), p1 = vec3(0.0 - 0.14, 0.0 - 0.75, 0.08), r0 = 0.058, r1 = 0.058, sides = 12), "Cd", brass_col, domain = points)
valve_stem = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 0.82, 0.08), p1 = vec3(0.0 - 0.14, 0.0 - 0.82, 0.195), r0 = 0.018, r1 = 0.014, sides = 10), "Cd", brass_col, domain = points)
wheel_rim = set(fixtures.ring(center = vec3(0.0 - 0.14, 0.0 - 0.82, 0.195), radius = 0.095, r = 0.014, yaw_deg = 0.0), "Cd", red_wheel, domain = points)
spoke_a0 = parts.cbox(size = vec3(0.18, 0.014, 0.014), k = 0.0, k_abs = 0.002)
spoke_b0 = parts.cbox(size = vec3(0.014, 0.18, 0.014), k = 0.0, k_abs = 0.002)
spoke_a = set(transform(spoke_a0, rotate = vec3(0.0, 0.0, wheel_ang), translate = vec3(0.0 - 0.14, 0.0 - 0.82, 0.193)), "Cd", red_wheel, domain = points)
spoke_b = set(transform(spoke_b0, rotate = vec3(0.0, 0.0, wheel_ang), translate = vec3(0.0 - 0.14, 0.0 - 0.82, 0.197)), "Cd", red_wheel, domain = points)
wheel_nut = set(iron.spool(p0 = vec3(0.0 - 0.14, 0.0 - 0.82, 0.188), p1 = vec3(0.0 - 0.14, 0.0 - 0.82, 0.212), r0 = 0.024, r1 = 0.020, sides = 8), "Cd", brass_col, domain = points)

# Pressure gauge on the cross-manifold at x = 0.02, y = -0.10
gauge_stem = set(iron.spool(p0 = vec3(0.02, 0.0 - 0.22, 0.072), p1 = vec3(0.02, 0.0 - 0.12, 0.095), r0 = 0.010, r1 = 0.010, sides = 8), "Cd", brass_col, domain = points)
gauge_case = set(iron.spool(p0 = vec3(0.02, 0.0 - 0.10, 0.082), p1 = vec3(0.02, 0.0 - 0.10, 0.118), r0 = 0.056, r1 = 0.056, sides = 14), "Cd", brass_col, domain = points)
gauge_dial = set(iron.spool(p0 = vec3(0.02, 0.0 - 0.10, 0.116), p1 = vec3(0.02, 0.0 - 0.10, 0.123), r0 = 0.044, r1 = 0.044, sides = 14), "Cd", dial_face, domain = points)
gauge_needle = set(transform(parts.cbox(size = vec3(0.007, 0.036, 0.005), k = 0.0, k_abs = 0.001), rotate = vec3(0.0, 0.0, -32.0), translate = vec3(0.026, 0.0 - 0.094, 0.125)), "Cd", red_wheel, domain = points)

raw0 = merge(riser_main, cap_top_a, flange_a1, flange_a2, flange_a3, floor_col_a, riser_sec, cap_top_b, flange_b1, flange_b2, floor_col_b, cross_pipe, tee_a, tee_b, brackets, valve_body, valve_stem, wheel_rim, spoke_a, spoke_b, wheel_nut, gauge_stem, gauge_case, gauge_dial, gauge_needle)
placed = transform(raw0, rotate = vec3(0.0, yaw, 0.0), translate = at - mn * 0.07)
styled = set(placed, "style", 0, domain = points)
norm = unmark(unmark(styled, "iron"), "edge")
clean0 = remove_attr(remove_attr(remove_attr(norm, "uv"), "t"), "N")
flat0 = compute_normals(clean0, mode = flat)
ao0 = bake_ao(flat0, rays = 8, distance = 0.25, rng = split_rng(root, key = "ao"), domain = corners)
ao1 = set(ao0, "ao_f", mix(0.35, 1.0, @ao * @ao), domain = faces)
ao2 = remove_attr(remove_attr(set(ao1, "Cd", clamp(@Cd * @ao_f, vec3(0.02), vec3(1.0)), domain = points), "ao_f"), "ao")
mesh = compute_normals(compute_normals(ao2, mode = smooth), mode = flat)
anchors = empty_points()

output mesh
output anchors
