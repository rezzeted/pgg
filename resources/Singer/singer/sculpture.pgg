# Singer — скульптура и стеклянный барабан башни. Силуэт, не портрет.
# Низ каждой фигуры на y = 0, лицо в +Z, если не сказано иное.
# Глобус — сфера радиуса GLOBE_D/2.

import lib.parts
import lib.fixtures
import singer.common as sc

def s1() -> (out: geo<mesh>) {
    """S1 — валькирия: драпировка, поднятая рука, крылья, у ног коробка-машинка.
    Вторая фигура пары — зеркало scale (−1, 1, 1). Высота около 3 м."""
    machine = parts.slab(size = vec3(0.46, 0.32, 0.36), pos = vec3(0.10, 0.16, 0.16), grp = "bronze")
    wheel = mark(transform(ico_sphere(subdiv = 1, radius = 0.10), translate = vec3(0.22, 0.18, 0.32)), "bronze", where = true, domain = faces)
    skirt = parts.slab(size = vec3(0.62, 1.35, 0.34), pos = vec3(0, 0.32 + 0.675, 0.02), grp = "bronze")
    torso = parts.slab(size = vec3(0.40, 0.85, 0.26), pos = vec3(0, 1.67 + 0.425, 0.0), grp = "bronze")
    head = mark(transform(ico_sphere(subdiv = 1, radius = 0.14), translate = vec3(0, 2.72, 0.02)), "bronze", where = true, domain = faces)
    arm = transform(parts.slab(size = vec3(0.10, 0.95, 0.10), pos = vec3(0, 0.48, 0), grp = "bronze"), rotate = vec3(0, 0, 28))
    arm_p = transform(arm, translate = vec3(0.28, 2.15, 0.06))
    spear = parts.slab(size = vec3(0.04, 1.35, 0.04), pos = vec3(0.55, 2.55, 0.08), grp = "bronze")
    blade = parts.slab(size = vec3(0.95, 0.78, 0.07), pos = vec3(0.42, 0.10, 0), grp = "bronze")
    wing_l = transform(transform(blade, rotate = vec3(0, 22, 18)), translate = vec3(0.0 - 0.22, 2.05, 0.0 - 0.06))
    wing_r = transform(wing_l, scale = vec3(-1, 1, 1))
    out = merge(machine, wheel, skirt, torso, head, arm_p, spear, wing_l, wing_r)
}

def d2() -> (out: geo<mesh>) {
    """D2 — бронзовый картуш ребра барабана, один модуль. Лицо в +Z, низ на y = 0."""
    back = parts.slab(size = vec3(0.55, 0.78, 0.06), pos = vec3(0, 0.42, 0.0), grp = "bronze")
    frame = parts.slab(size = vec3(0.42, 0.62, 0.08), pos = vec3(0, 0.44, 0.05), grp = "bronze")
    boss = mark(transform(ico_sphere(subdiv = 1, radius = 0.10), translate = vec3(0, 0.46, 0.12)), "bronze", where = true, domain = faces)
    top = parts.slab(size = vec3(0.28, 0.16, 0.10), pos = vec3(0, 0.86, 0.04), grp = "bronze")
    out = merge(back, frame, boss, top)
}

def drum(r: f32 = 2.55, h: f32 = 4.70) -> (out: geo<mesh>) {
    """Стеклянный барабан: панели между бронзовыми рёбрами, каменный пояс снизу
    и бронзовый обруч сверху. Ось Y, низ на y = 0. Не купол dome() — тот глухой."""
    expect r > 0.8 & h > 1.5: "drum: радиус и высота"
    n = 12
    chord = 2.0 * r * sin(3.14159265 / f32(n))
    glass = parts.slab(size = vec3(chord * 0.82, h * 0.90, 0.04), pos = vec3(0, h * 0.50, r - 0.02), grp = "glass")
    rib = parts.slab(size = vec3(0.07, h, 0.08), pos = vec3(chord * 0.48, h * 0.50, r + 0.02), grp = "bronze")
    shell = repeat (empty_mesh(), iterations = n) |acc| {
        ang = f32(@iteration) * 30.0
        acc = merge(acc, transform(glass, rotate = vec3(0, ang, 0)), transform(rib, rotate = vec3(0, ang, 0)))
    }
    hoop_b = parts.to_group(g = transform(fixtures.ring(center = vec3(0, 0, 0), radius = r + 0.05, r = 0.06, yaw_deg = 0), rotate = vec3(90, 0, 0), translate = vec3(0, 0.12, 0)), src = "iron", dst = "bronze")
    hoop_t = parts.to_group(g = transform(fixtures.ring(center = vec3(0, 0, 0), radius = r + 0.06, r = 0.055, yaw_deg = 0), rotate = vec3(90, 0, 0), translate = vec3(0, h - 0.08, 0)), src = "iron", dst = "bronze")
    out = merge(shell, hoop_b, hoop_t)
}

def s2(span: f32 = 4.80) -> (out: geo<mesh>) {
    """S2 — орлан: тело, щит, два крыла, гирлянда. Размах span почти равен
    диаметру барабана. Низ тела на y = 0, грудь в +Z."""
    expect span > 2.0: "s2: размах"
    body = parts.slab(size = vec3(0.55, 0.42, 1.05), pos = vec3(0, 0.55, 0.10), grp = "bronze")
    head = mark(transform(ico_sphere(subdiv = 1, radius = 0.16), translate = vec3(0, 0.78, 0.55)), "bronze", where = true, domain = faces)
    beak = parts.slab(size = vec3(0.06, 0.05, 0.18), pos = vec3(0, 0.76, 0.74), grp = "bronze")
    half = span * 0.5 - 0.20
    wing = transform(parts.slab(size = vec3(half, 0.08, 0.55), pos = vec3(half * 0.5, 0, 0), grp = "bronze"), rotate = vec3(0, 0, 12))
    wing_r = transform(wing, translate = vec3(0.15, 0.72, 0.0))
    wing_l = transform(wing, scale = vec3(-1, 1, 1), translate = vec3(0.0 - 0.15, 0.72, 0.0))
    shield = parts.slab(size = vec3(0.42, 0.52, 0.06), pos = vec3(0, 0.48, 0.62), grp = "stone")
    band_h = parts.slab(size = vec3(0.42, 0.08, 0.04), pos = vec3(0, 0.48, 0.66), grp = "granite_red")
    band_v = parts.slab(size = vec3(0.08, 0.52, 0.04), pos = vec3(0, 0.48, 0.66), grp = "granite_red")
    garland = parts.to_group(g = transform(fixtures.ring(center = vec3(0, 0, 0), radius = 0.70, r = 0.045, yaw_deg = 0), rotate = vec3(90, 0, 0), translate = vec3(0, 0.18, 0.15)), src = "iron", dst = "bronze")
    out = merge(body, head, beak, wing_r, wing_l, shield, band_h, band_v, garland)
}

def cone_folds(r0: f32, r1: f32, h: f32) -> (out: geo<mesh>) {
    """Усечённый конус из граней — складки под группой глобуса. Низ на y = 0."""
    expect r0 > r1 & r1 > 0.05 & h > 0.2: "cone_folds: сужение вверх"
    path0 = mesh_line(count = 2, length = h, dir = (0, 1, 0))
    path = set(path0, "profile_scale", @index == 0 ? vec2(1, 1) : vec2(r1 / r0, r1 / r0), domain = points)
    skin = sweep(path, profile = circle(sides = 12, radius = r0))
    out = mark(compute_normals(skin, mode = flat), "bronze", where = true, domain = faces)
}

def s3() -> (out: geo<mesh>) {
    """S3 — группа глобуса: складчатый конус, три фигуры объёмами, сфера диаметра
    GLOBE_D и кольца меридианов. Низ конуса на y = 0."""
    r = sc.GLOBE_D() * 0.5
    cone = cone_folds(r0 = 1.25, r1 = 0.55, h = 1.45)
    fig = merge(parts.slab(size = vec3(0.28, 0.95, 0.22), pos = vec3(0, 0.55, 0), grp = "bronze"), mark(transform(ico_sphere(subdiv = 1, radius = 0.12), translate = vec3(0, 1.15, 0)), "bronze", where = true, domain = faces))
    arm = parts.slab(size = vec3(0.08, 0.70, 0.08), pos = vec3(0.16, 1.35, 0), grp = "bronze")
    one = merge(fig, arm)
    radial = transform(one, translate = vec3(0.62, 1.35, 0))
    figs = repeat (empty_mesh(), iterations = 3) |acc| {
        ang = f32(@iteration) * 120.0
        acc = merge(acc, transform(radial, rotate = vec3(0, ang, 0)))
    }
    cy = 4.15
    globe = mark(transform(ico_sphere(subdiv = 2, radius = r), translate = vec3(0, cy, 0)), "glass", where = true, domain = faces)
    cage = parts.to_group(g = transform(fixtures.ring(center = vec3(0, 0, 0), radius = r + 0.06, r = 0.035, yaw_deg = 0), rotate = vec3(90, 0, 0), translate = vec3(0, cy, 0)), src = "iron", dst = "bronze")
    mer = parts.to_group(g = transform(fixtures.ring(center = vec3(0, 0, 0), radius = r + 0.06, r = 0.028, yaw_deg = 0), translate = vec3(0, cy, 0)), src = "iron", dst = "bronze")
    mers = repeat (empty_mesh(), iterations = 3) |acc| {
        ang = f32(@iteration) * 60.0
        acc = merge(acc, transform(mer, rotate = vec3(0, ang, 0)))
    }
    out = merge(cone, figs, globe, cage, mers)
}
