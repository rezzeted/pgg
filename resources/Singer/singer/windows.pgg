# Singer — окна (analysis.md, коды W*). Низ проёма в origin, лицо стены z = 0.
# Прямоугольный проём в стене режет сборка. Полуциркуль W2 закрывает пазухи
# прямоугольного проёма своими spandrel.

import lib.parts
import lib.fixtures
import singer.common as sc

def sash(w: f32, h: f32, fan: f32, bar: f32 = 0.07, depth: f32 = 0.08) -> (out: geo<mesh>) {
    """Прямоугольный деревянный блок w×h: коробка, фрамуга высотой fan, один средник.
    Лицо коробки на z = 0, тело в −z. Стекло утоплено."""
    expect h > fan + 0.3: "sash: фрамуга ниже створки"
    zc = 0.0 - depth * 0.5
    left = parts.slab(size = vec3(bar, h, depth), pos = vec3(0.0 - (w - bar) * 0.5, h * 0.5, zc), grp = "wood")
    right = parts.slab(size = vec3(bar, h, depth), pos = vec3((w - bar) * 0.5, h * 0.5, zc), grp = "wood")
    bot = parts.slab(size = vec3(w, bar * 1.2, depth), pos = vec3(0, bar * 0.6, zc), grp = "wood")
    top = parts.slab(size = vec3(w, bar, depth), pos = vec3(0, h - bar * 0.5, zc), grp = "wood")
    tr_y = h - fan
    trans = parts.slab(size = vec3(w, bar * 0.9, depth), pos = vec3(0, tr_y, zc), grp = "wood")
    mull = parts.slab(size = vec3(bar * 0.85, h, depth * 0.85), pos = vec3(0, h * 0.5, zc), grp = "wood")
    glass = parts.slab(size = vec3(w - 0.02, h - 0.02, 0.012), pos = vec3(0, h * 0.5, 0.0 - depth * 0.65), grp = "glass")
    out = merge(left, right, bot, top, trans, mull, glass)
}

def w1(w: f32 = 1.45, h: f32 = 2.20) -> (out: geo<mesh>) {
    """W1 — рядовое окно серого тела: деревянный блок в четверти 0.14 (две створки
    и фрамуга около четверти высоты), гранитный подоконник и плоская перемычка
    с выносом 4 см. Косяки — сама стена и лопатки, не наличник."""
    expect w > 0.6 & h > 1.2: "w1: проём от 0.6×1.2 м"
    rev = 0.14
    fan = h * 0.26
    frame = transform(sash(w = w, h = h, fan = fan), translate = vec3(0, 0, 0.0 - rev))
    sill = parts.slab(size = vec3(w + 0.28, 0.08, rev + 0.16), pos = vec3(0, 0.0 - 0.02, (0.16 - rev) * 0.5), grp = "granite_gray")
    lintel = parts.slab(size = vec3(w + 0.16, 0.12, 0.05), pos = vec3(0, h + 0.06, 0.025), grp = "granite_gray")
    out = merge(frame, sill, lintel)
}

def w2(w: f32 = 2.70, h: f32 = 4.40) -> (out: geo<mesh>) {
    """W2 — витрина красного низа: полуциркуль (подъём w/2) высотой h до шелыги.
    Пазухи прямоугольного проёма — гранит. Архивольт с выносом 9 см, бронзовая
    четверть, стекло, импост на линии пят и вертикальный средник в прямой части."""
    expect h > w * 0.5 + 1.2: "w2: прямая часть арки от 1.2 м"
    f = w * 0.5
    y_s = h - f
    n = 14
    rev = 0.18
    t = 0.55
    sp = sc.spandrel(w = w, y_s = y_s, n = n, z0 = 0.0 - t, z1 = 0.0, grp = "granite_red")
    hood = sc.arch_band(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, q0 = vec3(0.0, 0.0, 0), q1 = vec3(0.09, 0.0, 0), q2 = vec3(0.09, 0.0 - 0.22, 0), q3 = vec3(0.0, 0.0 - 0.22, 0), grp = "granite_red")
    lip = sc.arch_band(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, q0 = vec3(0.0 - 0.02, 0.045, 0), q1 = vec3(0.0 - rev, 0.045, 0), q2 = vec3(0.0 - rev, 0.0, 0), q3 = vec3(0.0 - 0.02, 0.0, 0), grp = "bronze")
    glass = sc.arch_slab(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, z0 = 0.0 - rev - 0.04, z1 = 0.0 - rev - 0.028, grp = "glass")
    mull = parts.slab(size = vec3(0.06, y_s, 0.05), pos = vec3(0, y_s * 0.5, 0.0 - rev), grp = "bronze")
    imp = parts.slab(size = vec3(w, 0.07, 0.05), pos = vec3(0, y_s, 0.0 - rev), grp = "bronze")
    rail = parts.slab(size = vec3(w, 0.05, 0.04), pos = vec3(0, y_s * 0.55, 0.0 - rev), grp = "bronze")
    sill = parts.slab(size = vec3(w + 0.36, 0.10, 0.22), pos = vec3(0, 0.0 - 0.02, 0.04), grp = "granite_red")
    out = merge(sp, hood, lip, glass, mull, imp, rail, sill)
}

def w3(w: f32 = 1.70, h: f32 = 4.10) -> (out: geo<mesh>) {
    """W3 — окно угловой башни: высокий проём с полуциркульной головой. Серые пазухи,
    гранитный архивольт, деревянная коробка по контуру, средник и две перекладины,
    в шелыге деревянный картуш с бронзовым кольцом. Балкончик D3 ставит сборка."""
    expect h > w * 0.5 + 1.6: "w3: прямая часть от 1.6 м"
    f = w * 0.5
    y_s = h - f
    n = 12
    rev = 0.16
    sp = sc.spandrel(w = w, y_s = y_s, n = n, z0 = -0.55, z1 = 0.0, grp = "granite_gray")
    hood = sc.arch_band(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, q0 = vec3(0.0, 0.0, 0), q1 = vec3(0.07, 0.0, 0), q2 = vec3(0.07, -0.18, 0), q3 = vec3(0.0, -0.18, 0), grp = "granite_gray")
    box = sc.arch_band(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, q0 = vec3(0.0 - rev - 0.07, 0.055, 0), q1 = vec3(0.0 - rev, 0.055, 0), q2 = vec3(0.0 - rev, 0.0, 0), q3 = vec3(0.0 - rev - 0.07, 0.0, 0), grp = "wood")
    glass = sc.arch_slab(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, z0 = 0.0 - rev - 0.05, z1 = 0.0 - rev - 0.038, grp = "glass")
    cy = y_s + f * 0.42
    cart_h = 0.62
    mull_h = cy - cart_h * 0.5 - 0.03
    mull = parts.slab(size = vec3(0.055, mull_h, 0.05), pos = vec3(0, mull_h * 0.5, 0.0 - rev), grp = "wood")
    bar1 = parts.slab(size = vec3(w, 0.05, 0.05), pos = vec3(0, y_s * 0.42, 0.0 - rev), grp = "wood")
    bar2 = parts.slab(size = vec3(w, 0.05, 0.05), pos = vec3(0, y_s * 0.78, 0.0 - rev), grp = "wood")
    cart = parts.slab(size = vec3(0.42, cart_h, 0.04), pos = vec3(0, cy, 0.0 - 0.02), grp = "wood")
    ring = parts.to_group(g = fixtures.ring(center = vec3(0, cy, 0.02), radius = 0.15, r = 0.016, yaw_deg = 0), src = "iron", dst = "bronze")
    sill = parts.slab(size = vec3(w + 0.24, 0.08, 0.20), pos = vec3(0, -0.02, 0.03), grp = "granite_gray")
    out = merge(sp, hood, box, glass, mull, bar1, bar2, cart, ring, sill)
}

def w4(w: f32 = 1.48, h: f32 = 2.42) -> (out: geo<mesh>) {
    """W4 — окно второго этажа в красном русте. Тот же деревянный блок, что у W1,
    но подоконник и перемычка красного гранита: проём сидит ещё в полированном низе."""
    expect w > 0.6 & h > 1.2: "w4: проём от 0.6×1.2 м"
    rev = 0.14
    fan = h * 0.26
    frame = transform(sash(w = w, h = h, fan = fan), translate = vec3(0, 0, 0.0 - rev))
    sill = parts.slab(size = vec3(w + 0.28, 0.08, rev + 0.16), pos = vec3(0, 0.0 - 0.02, (0.16 - rev) * 0.5), grp = "granite_red")
    lintel = parts.slab(size = vec3(w + 0.16, 0.12, 0.05), pos = vec3(0, h + 0.06, 0.025), grp = "granite_red")
    out = merge(frame, sill, lintel)
}

def shop_gate(w: f32, h: f32) -> (out: geo<mesh>) {
    """Решётка входа в нижней части витрины: бронзовые прутья и обвязка.
    Ставится в проём W2, низ на y = 0."""
    expect w > 0.8 & h > 1.2: "shop_gate: размер двери"
    n = max(int(w / 0.16), 5)
    pitch = (w - 0.12) / f32(n - 1)
    bar = parts.slab(size = vec3(0.035, h - 0.16, 0.035), pos = vec3(0, h * 0.5, 0.0 - 0.02), grp = "bronze")
    pts = transform(mesh_line(count = n, length = f32(n - 1) * pitch, dir = (1, 0, 0)), translate = vec3(0.0 - f32(n - 1) * pitch * 0.5, 0, 0))
    bars = realize(instance_on_points(pts, source = bar))
    head = parts.slab(size = vec3(w, 0.08, 0.06), pos = vec3(0, h - 0.04, 0.0 - 0.02), grp = "bronze")
    foot = parts.slab(size = vec3(w, 0.06, 0.06), pos = vec3(0, 0.04, 0.0 - 0.02), grp = "bronze")
    out = merge(bars, head, foot)
}
