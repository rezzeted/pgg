# Singer — отметки, материалы и хелперы дома Зингера.
# Разбор — resources/Singer/analysis.md.
#
# Конвенция терминалов: низ проёма в origin, лицо +Z, вверх +Y. Плоскость z = 0 —
# лицо стены. Рельеф (лопатки, карнизы, архивольты) — в +z, переплёты и стекло
# утоплены в −z. Группы: granite_red, granite_gray, bronze, wood, glass, stone.

import lib.parts
import lib.masonry as masonry

def GLOBE_D() -> (out: f32) {
    """Диаметр стеклянного глобуса, м."""
    out = 2.8
}

def NEVSKY_L() -> (out: f32) {
    """Фасад по Невскому, м (14 саженей, до виртуального угла)."""
    out = 29.87
}

def CANAL_L() -> (out: f32) {
    """Фасад по каналу Грибоедова, м (до виртуального угла)."""
    out = 53.34
}

def CORNER_DEG() -> (out: f32) {
    """Внутренний угол клина у башни, градусы. Снят с контура OSM, не с догадки 65°."""
    out = 92.5
}

