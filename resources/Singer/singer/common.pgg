    """Верх карниза = линия балюстрады. Предел 23,5 м."""
    out = 23.50
}

def ARCH_W() -> (out: f32) {
    """Ширина витрины W2. Одна на ось; на Невском таких осей три, на канале пять."""
    out = 6.55
}

def ARCH_H() -> (out: f32) {
    """Высота витрины до шелыги."""
    out = 5.15
}

