# Singer — участки фасада во всю высоту улицы. Рамка как у особняка: низ-центр
# на земле, вдоль X ширина w, лицо z = 0, тело стены в −z.
# Ось — один пролёт витрины: тройные окна W1/W4 по вертикали, не три этажа одного окна.
# door — решётка в витрине (вход). crown — шестой этаж с аркой W3 и парой S1.

import lib.parts
import singer.common as sc
import singer.windows as sw
import singer.belts as sb
import singer.sculpture as ss

def at(g: geo<mesh>, x: f32, y: f32, z: f32 = 0.0) -> (out: geo<mesh>) {
    """Сдвиг куска в точку участка."""
    out = transform(g, translate = vec3(x, y, z))
}

def pier_at(cx: f32, pw: f32, y0: f32, y1: f32, grp: string, rust: bool) -> (out: geo<mesh>) {
    """Вертикальный простенок ширины pw, центр по X в cx. rust — руст, иначе гладкая стена."""
    expect pw > 0.05 & y1 > y0: "pier_at: размеры"
    smooth = sc.wall_patch(w = pw, y0 = y0, y1 = y1, grp = grp)
    banded = sc.wall_rust(w = pw, y0 = y0, y1 = y1, course = 0.42, gap = 0.025, proj = 0.028, grp = grp)
    body = select(rust, a = banded, b = smooth)
    out = at(g = body, x = cx, y = 0.0)
}

def opening_wall(host_w: f32, y0: f32, y1: f32, grp: string, rust: bool) -> (out: geo<mesh>) {
    """Простенки тройного окна: два боковых и два средника между светами WIN_W/WIN_PITCH.
    Проёмы пустые — их закрывает переплёт."""
    expect host_w * 0.5 - (sc.WIN_PITCH() + sc.WIN_W() * 0.5) > 0.12: "opening_wall: ось уже тройного окна"
    ww = sc.WIN_W()
    pitch = sc.WIN_PITCH()
    outer = pitch + ww * 0.5
    side_w = host_w * 0.5 - outer
    mull_w = pitch - ww
    left = pier_at(cx = 0.0 - (host_w - side_w) * 0.5, pw = side_w, y0 = y0, y1 = y1, grp = grp, rust = rust)
    right = pier_at(cx = (host_w - side_w) * 0.5, pw = side_w, y0 = y0, y1 = y1, grp = grp, rust = rust)
    m1 = pier_at(cx = 0.0 - pitch * 0.5, pw = mull_w, y0 = y0, y1 = y1, grp = grp, rust = rust)
    m2 = pier_at(cx = pitch * 0.5, pw = mull_w, y0 = y0, y1 = y1, grp = grp, rust = rust)
    out = merge(left, right, m1, m2)
}

def triple_wins(y: f32, red: bool) -> (out: geo<mesh>) {
    """Три света с шагом WIN_PITCH. red — W4 (красный подоконник), иначе W1."""
    ww = sc.WIN_W()
    hh = sc.WIN_H()
    pitch = sc.WIN_PITCH()
    a = sw.w4(w = ww, h = hh)
    b = sw.w1(w = ww, h = hh)
    win = select(red, a = a, b = b)
    out = merge(at(g = win, x = 0.0 - pitch, y = y), at(g = win, x = 0.0, y = y), at(g = win, x = pitch, y = y))
}

def floor_pack(w: f32, y0: f32, y1: f32, sill: f32, balcony: bool) -> (out: geo<mesh>) {
    """Серый этаж: подоконная лента, простенки, перемычка, тройное W1, по желанию балкон D3."""
    hh = sc.WIN_H()
    head = sill + hh
    apron = sc.wall_patch(w = w, y0 = y0, y1 = sill, grp = "granite_gray")
    piers = opening_wall(host_w = w, y0 = sill, y1 = head, grp = "granite_gray", rust = false)
    lintel = sc.wall_patch(w = w, y0 = head, y1 = y1, grp = "granite_gray")
    wins = triple_wins(y = sill, red = false)
    bal = select(balcony, a = at(g = sb.d3(len = 3.40), x = 0.0, y = sill - 0.04), b = empty_mesh())
    out = merge(apron, piers, lintel, wins, bal)
}

def red_story(w: f32) -> (out: geo<mesh>) {
    """Красный низ оси: рустованные боковые пилоны, витрина W2, второй этаж тройным W4."""
    expect (w - sc.ARCH_W()) * 0.5 > 0.25: "red_story: пилон витрины"
    aw = sc.ARCH_W()
    ah = sc.ARCH_H()
    pw = (w - aw) * 0.5
    cx = (aw + pw) * 0.5
    left = pier_at(cx = 0.0 - cx, pw = pw, y0 = 0.0, y1 = sc.Y_RED(), grp = "granite_red", rust = true)
    right = pier_at(cx = cx, pw = pw, y0 = 0.0, y1 = sc.Y_RED(), grp = "granite_red", rust = true)
    sill = 5.58
    head = sill + sc.WIN_H()
    above = sc.wall_patch(w = aw, y0 = ah, y1 = sill, grp = "granite_red")
    mid = opening_wall(host_w = aw, y0 = sill, y1 = head, grp = "granite_red", rust = true)
    top = sc.wall_patch(w = aw, y0 = head, y1 = sc.Y_RED(), grp = "granite_red")
    wins = triple_wins(y = sill, red = true)
    shop = sw.w2(w = aw, h = ah)
    mask = at(g = sb.d4(), x = 0.0, y = ah - 0.55, z = 0.10)
    out = merge(left, right, above, mid, top, wins, shop, mask)
}

def crown_floor(w: f32) -> (out: geo<mesh>) {
    """Шестой этаж парадной оси: одна арка W3 и пара валькирий по сторонам."""
    ww = 2.55
    hh = 3.15
    y = 19.80
    side = (w - ww) * 0.5
    left = pier_at(cx = 0.0 - (ww + side) * 0.5, pw = side, y0 = y, y1 = sc.Y_CROWN(), grp = "granite_gray", rust = false)
    right = pier_at(cx = (ww + side) * 0.5, pw = side, y0 = y, y1 = sc.Y_CROWN(), grp = "granite_gray", rust = false)
    win = at(g = sw.w3(w = ww, h = hh), x = 0.0, y = y)
    rail = at(g = sb.d3(len = ww + 0.20), x = 0.0, y = y + 0.70)
    dx = ww * 0.5 + 0.95
    s_l = at(g = ss.s1(), x = 0.0 - dx, y = y)
    s_r = at(g = transform(ss.s1(), scale = vec3(-1, 1, 1)), x = dx, y = y)
    out = merge(left, right, win, rail, s_l, s_r)
}

def street_bay(w: f32, door: bool = false, crown: bool = false) -> (out: geo<mesh>) {
    """Рядовая ось улицы. door — решётка входа в витрине. crown — W3 и валькирии на 6-м."""
    expect w > 8.0: "street_bay: ось от 8 м"
    red = red_story(w = w)
    gate = select(door, a = at(g = sw.shop_gate(w = 2.60, h = 2.75), x = 0.0, y = 0.12, z = 0.02), b = empty_mesh())
    belt_back = sc.wall_patch(w = w, y0 = sc.Y_RED(), y1 = sc.Y_GRAY(), grp = "granite_gray")
    belt = at(g = sb.c1(len = w), x = 0.0, y = sc.Y_RED())
    f3 = floor_pack(w = w, y0 = 9.60, y1 = 13.00, sill = 10.08, balcony = false)
    f4 = floor_pack(w = w, y0 = 13.00, y1 = 16.40, sill = 13.48, balcony = true)
    f5 = floor_pack(w = w, y0 = 16.40, y1 = 19.80, sill = 16.88, balcony = true)
    plain6 = floor_pack(w = w, y0 = 19.80, y1 = sc.Y_CROWN(), sill = 20.10, balcony = false)
    hero6 = crown_floor(w = w)
    f6 = select(crown, a = hero6, b = plain6)
    corn = at(g = sb.c2(len = w), x = 0.0, y = sc.Y_CROWN())
    ph = sc.Y_CROWN() - sc.Y_GRAY()
    inset = w * 0.5 - 0.30
    p_l = at(g = sb.d1(h = ph), x = 0.0 - inset, y = sc.Y_GRAY())
    p_r = at(g = sb.d1(h = ph), x = inset, y = sc.Y_GRAY())
    low = merge(red, gate, belt_back, belt)
    mid = merge(f3, f4, f5, f6)
    out = merge(low, mid, corn, p_l, p_r)
}

def party_wall(w: f32) -> (out: geo<mesh>) {
    """Глухой брандмауэр: красный руст, серое тело, пояса, без окон и декора."""
    expect w > 1.0: "party_wall: длина"
    red = sc.wall_rust(w = w, y0 = 0.0, y1 = sc.Y_RED(), course = 0.42, gap = 0.025, proj = 0.028, grp = "granite_red")
    seam = sc.wall_patch(w = w, y0 = sc.Y_RED(), y1 = sc.Y_GRAY(), grp = "granite_gray")
    gray = sc.wall_patch(w = w, y0 = sc.Y_GRAY(), y1 = sc.Y_EAVE(), grp = "granite_gray")
    belt = at(g = sb.c1(len = w), x = 0.0, y = sc.Y_RED())
    corn = at(g = sb.c2(len = w), x = 0.0, y = sc.Y_CROWN())
    out = merge(red, seam, gray, belt, corn)
}

def corner_block(w: f32 = 2.90) -> (out: geo<mesh>) {
    """Угловой блок на фаске: высокая арка W3, пара S1, барабан, картуши, орлан, глобус.
    Барабан шире фаски и сидит на её середине. Низ на y = 0, лицо +Z."""
    expect w > 2.2: "corner_block: фаска"
    red = sc.wall_rust(w = w, y0 = 0.0, y1 = sc.Y_RED(), course = 0.42, gap = 0.025, proj = 0.028, grp = "granite_red")
    belt = at(g = sb.c1(len = w), x = 0.0, y = sc.Y_RED())
    gray = sc.wall_patch(w = w, y0 = sc.Y_GRAY(), y1 = 18.70, grp = "granite_gray")
    ww = 1.85
    hh = 4.30
    y = 18.70
    side = (w - ww) * 0.5
    left = pier_at(cx = 0.0 - (ww + side) * 0.5, pw = side, y0 = y, y1 = 23.40, grp = "granite_gray", rust = false)
    right = pier_at(cx = (ww + side) * 0.5, pw = side, y0 = y, y1 = 23.40, grp = "granite_gray", rust = false)
    win = at(g = sw.w3(w = ww, h = hh), x = 0.0, y = y)
    rail = at(g = sb.d3(len = ww + 0.10), x = 0.0, y = y + 0.85)
    s_l = at(g = ss.s1(), x = 0.0 - 1.35, y = y - 0.20)
    s_r = at(g = transform(ss.s1(), scale = vec3(-1, 1, 1)), x = 1.35, y = y - 0.20)
    tower = at(g = ss.drum(r = 2.55, h = 4.70), x = 0.0, y = 24.05)
    cart0 = at(g = ss.d2(), x = 0.0, y = 24.55, z = 2.72)
    carts = repeat (empty_mesh(), iterations = 4) |acc| {
        ang = f32(@iteration) * 90.0
        acc = merge(acc, transform(cart0, rotate = vec3(0, ang, 0)))
    }
    eagle = at(g = ss.s2(span = 4.80), x = 0.0, y = 26.20, z = 3.05)
    globe = at(g = ss.s3(), x = 0.0, y = 28.75)
    wall = merge(red, belt, gray, left, right, win, rail, s_l, s_r)
    out = merge(wall, tower, carts, eagle, globe)
}

def court_cell(step: f32) -> (out: geo<mesh>) {
    """Одна ось дворовой стены: три W1 друг над другом, без маскаронов и валькирий."""
    expect step > 2.2: "court_cell: шаг"
    ww = 1.35
    wh = 2.15
    side = (step - ww) * 0.5
    top = 13.60
    left = at(g = sc.wall_patch(w = side, y0 = 0.0, y1 = top, grp = "granite_gray"), x = 0.0 - (step - side) * 0.5, y = 0.0)
    right = at(g = sc.wall_patch(w = side, y0 = 0.0, y1 = top, grp = "granite_gray"), x = (step - side) * 0.5, y = 0.0)
    b0 = sc.wall_patch(w = ww, y0 = 0.0, y1 = 1.10, grp = "granite_gray")
    b1 = sc.wall_patch(w = ww, y0 = 3.25, y1 = 4.50, grp = "granite_gray")
    b2 = sc.wall_patch(w = ww, y0 = 6.65, y1 = 7.90, grp = "granite_gray")
    b3 = sc.wall_patch(w = ww, y0 = 10.05, y1 = top, grp = "granite_gray")
    win = sw.w1(w = ww, h = wh)
    wa = at(g = win, x = 0.0, y = 1.10)
    wb = at(g = win, x = 0.0, y = 4.50)
    wc = at(g = win, x = 0.0, y = 7.90)
    out = merge(left, right, b0, b1, b2, b3, wa, wb, wc)
}

def court_wing(len: f32, n: int) -> (out: geo<mesh>) {
    """Дворовой фасад длины len из n осей W1. Лицо +Z, низ на y = 0."""
    expect n >= 1 & len > 2.0: "court_wing: длина и число осей"
    step = len / f32(n)
    cell = court_cell(step = step)
    out = repeat (empty_mesh(), iterations = n) |acc| {
        x = 0.0 - len * 0.5 + step * (f32(@iteration) + 0.5)
        acc = merge(acc, at(g = cell, x = x, y = 0.0))
    }
}
