# Singer — стенд простых элементов: каждый на куске стены.
# Узлы *_unit — кадры elements.views.json.

import lib.parts
import singer.common as sc
import singer.windows as sw
import singer.belts as sb
import singer.sculpture as ss
import singer.units as su

# --- W1: рядовое окно серого тела -------------------------------------------------
w1_w = 1.45
w1_h = 2.20
w1_win = sw.w1(w = w1_w, h = w1_h)
w1_wall = sc.wall_with_hole(w = w1_w + 1.7, y0 = -0.45, y1 = w1_h + 0.85, hw = w1_w, hh = w1_h, grp = "granite_gray")
w1_unit = sc.paint(merge(w1_wall, w1_win))

# --- W2: полуциркульная витрина в русте -------------------------------------------
w2_w = 2.70
w2_h = 4.40
w2_win = sw.w2(w = w2_w, h = w2_h)
w2_wall = sc.wall_rust_hole(w = w2_w + 1.8, y0 = -0.55, y1 = w2_h + 0.7, hw = w2_w, hh = w2_h, course = 0.32, gap = 0.02, proj = 0.028, grp = "granite_red")
w2_unit = sc.paint(merge(w2_wall, w2_win))

# --- C1 и D1: красный низ, пояс, серая стена, лопатка слева -----------------------
bl = 3.2
red_solid = sc.wall_rust(w = bl, y0 = -1.6, y1 = 0.0, course = 0.32, gap = 0.02, proj = 0.028, grp = "granite_red")
gray = sc.wall_patch(w = bl, y0 = 0.50, y1 = 3.3, grp = "granite_gray")
belt = sb.c1(len = bl)
pier = transform(sb.d1(h = 2.8), translate = vec3(-1.05, 0.50, 0))
belts_unit = sc.paint(merge(red_solid, belt, gray, pier))

# --- W3: окно башни с картушем и балкончиком D3 -----------------------------------
w3_w = 1.70
w3_h = 4.10
w3_win = sw.w3(w = w3_w, h = w3_h)
w3_wall = sc.wall_with_hole(w = w3_w + 1.5, y0 = -0.4, y1 = w3_h + 0.7, hw = w3_w, hh = w3_h, grp = "granite_gray")
w3_rail = transform(sb.d3(len = w3_w + 0.15), translate = vec3(0, 1.25, 0))
w3_unit = sc.paint(merge(w3_wall, w3_win, w3_rail))

# --- ряд: окно, витрина, пояс ------------------------------------------------------
elements_row = merge(transform(w1_unit, translate = vec3(-4.4, 0, 0)), w2_unit, transform(belts_unit, translate = vec3(4.8, 0, 0)))

# --- новые листья --------------------------------------------------------------------
c2_unit = sc.paint(merge(sc.wall_patch(w = 3.4, y0 = -0.4, y1 = 0.15, grp = "granite_gray"), sb.c2(len = 3.4)))
c3_unit = sc.paint(merge(sc.wall_patch(w = 3.2, y0 = -0.5, y1 = 0.05, grp = "granite_gray"), sb.c3(len = 3.2)))
c4_unit = sc.paint(merge(sc.wall_patch(w = 2.2, y0 = -0.3, y1 = 1.7, grp = "granite_gray"), sb.c4(w = 1.7)))
d4_unit = sc.paint(merge(sc.wall_patch(w = 1.4, y0 = -0.2, y1 = 1.3, grp = "granite_red"), sb.d4()))
w4_w = 1.48
w4_h = 2.42
w4_unit = sc.paint(merge(sc.wall_rust_hole(w = w4_w + 1.4, y0 = -0.4, y1 = w4_h + 0.7, hw = w4_w, hh = w4_h, course = 0.32, gap = 0.02, proj = 0.028, grp = "granite_red"), sw.w4(w = w4_w, h = w4_h)))
s1_l = transform(ss.s1(), translate = vec3(-1.65, 0.05, 0))
s1_r = transform(transform(ss.s1(), scale = vec3(-1, 1, 1)), translate = vec3(1.65, 0.05, 0))
s1_unit = merge(w3_unit, sc.paint(merge(s1_l, s1_r)))
rib = parts.slab(size = vec3(0.12, 1.3, 0.10), pos = vec3(0, 0.55, -0.02), grp = "bronze")
d2_unit = sc.paint(merge(rib, ss.d2()))
drum_unit = sc.paint(ss.drum())
s2_unit = sc.paint(ss.s2())
s3_unit = sc.paint(ss.s3())
bay_unit = sc.paint(su.street_bay(w = 9.26))
door_unit = sc.paint(su.street_bay(w = 10.25, door = true))
corner_unit = sc.paint(su.corner_block(w = 2.90))

output w1_unit
output w2_unit
output w3_unit
output belts_unit
output elements_row
output c2_unit
output c3_unit
output c4_unit
output d4_unit
output w4_unit
output s1_unit
output d2_unit
output drum_unit
output s2_unit
output s3_unit
output bay_unit
output door_unit
output corner_unit
