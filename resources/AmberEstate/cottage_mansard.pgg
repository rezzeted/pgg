param width: f32 = 5.6
param depth: f32 = 4.6
param stone_h: f32 = 2.5
param upper_h: f32 = 2.4
param jetty: f32 = 0.18
param overhang: f32 = 0.45
param quoin_bricks: f32 = 1.5
param seed: int = 7

import cottage.roof
import cottage.chimney
import cottage.assemble

# Мансардный вариант коттеджа: тот же дом, что cottage.pgg, но крыша —
# многощипцовая (roof.multi_gable): поперечный щипец через всю ширину дома даёт
# освещённую мансарду, его торцы с окнами со ставнями смотрят на ±X, стыки скатов
# накрыты ендовами. Труба сдинута по правому скату к тылу (z = −1.8): дефолтная
# позиция (z = −0.9) задевала бы ендову.
#
# Этот файл — параметры, выбор варианта крыши и позиция трубы. Раскладка, элементы,
# сборка и окраска — cottage/assemble.pgg (заголовок — карта материалов), логические
# элементы — модули cottage/*.pgg, переиспользуемые части — lib/*.pgg.

uw = width + 2.0 * jetty
eave_y = stone_h + upper_h - 0.1
ridge_y = eave_y + uw * 0.5 + overhang

root_rng = rng_from_seed(seed)
roof_all = roof.multi_gable(width = width, depth = depth, stone_h = stone_h, upper_h = upper_h, jetty = jetty, overhang = overhang, rng = split_rng(root_rng, key = "tiles"))
chimney_all = chimney.chimney(x = 1.35, z = 0.0 - 1.8, ridge_y = ridge_y, rng = split_rng(root_rng, key = "chimney"))
house = assemble.assemble(width = width, depth = depth, stone_h = stone_h, upper_h = upper_h, jetty = jetty, quoin_bricks = quoin_bricks, ridge_y = ridge_y, root_rng = root_rng, roof_all = roof_all, chimney_all = chimney_all)
output house
