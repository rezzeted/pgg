param width: f32 = 5.6
param depth: f32 = 4.6
param stone_h: f32 = 2.5
param upper_h: f32 = 2.4
param jetty: f32 = 0.18
param overhang: f32 = 0.45
param quoin_bricks: f32 = 1.5
param seed: int = 7

import cottage.roof
import cottage.chimney
import cottage.assemble
import lib.arch.elements as ae

# Стилизованный фахверковый коттедж: узкий высокий
# дом — каменный первый этаж, фахверковый второй со свесом, арочная дверь с фонарями,
# клумба под окном фронтона, труба на правом скате. Вариант крыши — двускатная 45°
# (многощипцовый мансардный — cottage_mansard.pgg).
#
# Этот файл — параметры, выбор варианта крыши и позиция трубы. Раскладка, элементы,
# сборка и окраска — cottage/assemble.pgg (заголовок — карта материалов), логические
# элементы — модули cottage/*.pgg, переиспользуемые части — lib/*.pgg.
#
# Верх — ось Y, фасад с дверью и фронтоном смотрит в +Z, конёк вдоль Z.

uw = width + 2.0 * jetty
eave_y = stone_h + upper_h - 0.1
ridge_y = eave_y + uw * 0.5 + overhang

root_rng = rng_from_seed(seed)
roof_all, roof_edges = roof.gable(width = width, depth = depth, stone_h = stone_h, upper_h = upper_h, jetty = jetty, overhang = overhang, rng = split_rng(root_rng, key = "tiles"))
# Верх трубы — правилом конька: не ниже ridge_y + 1.25 (эстетика) и не ниже самого
# высокого конька + 0.5 (норматив; срабатывает само при смене крыши/уклона).
chim_top = ae.chimney_rule(edges = roof_edges, h_min = ridge_y + 1.25)
chimney_all = chimney.chimney(x = 1.35, z = 0.0 - 0.9, top = chim_top, rng = split_rng(root_rng, key = "chimney"))
house = assemble.assemble(width = width, depth = depth, stone_h = stone_h, upper_h = upper_h, jetty = jetty, quoin_bricks = quoin_bricks, ridge_y = ridge_y, root_rng = root_rng, roof_all = roof_all, chimney_all = chimney_all)
output house
