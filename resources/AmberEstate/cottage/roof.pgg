# Крыши коттеджа — два варианта над общим вторым этажом, на слое arch/roof (A3):
# gable — двускатная 45° (панели + подшивка из roof_rect, сланцевая черепица по
# якорям tile_anchors, колпаки конька из рёбер, фронтоны-заполнение, ветровые
# доски и шпильки); multi_gable — многощипцовая (крестовая) для мансарды:
# roof_cross (два крыла крестом, ендовы 45°), те же покрытие и фурнитура.
# Собираются в локальной системе (главный конёк вдоль X, скаты на ±Z) и поворачиваются
# на 90° вокруг Y — главный конёк дома идёт вдоль Z. У multi_gable крыло B
# (главное) уже идёт коньком вдоль Z — поворот не нужен.
# Материалы: roof (настил), tile (черепица, колпаки), wall (фронтоны/щипцы), wood
# (ветровые доски, рамы, ставни), glass, iron (ендовы-желоба).

import lib.parts
import lib.shapes
import lib.fixtures
import lib.layout.scope as ls
import lib.layout.edges as lse
import lib.arch.kinds as k
import lib.arch.roof as ar
import lib.arch.terminals_basic as tb

def slate_anchors(slopes: geo<mesh>, planes: geo<points>, rng: rng) -> (out: geo<points>) {
    """Якоря сланцевой черепицы коттеджа: tile_anchors + микро-джиттер против
    копланарных граней и per-tile @tint (как у старого tile_field)."""
    anc0 = ar.tile_anchors(slopes = slopes, planes = planes, row_pitch = 0.28, col_pitch = 0.32, lift = 0.02, top = 0.10)
    anc1 = set_position(anc0, offset = random_vec(lo = vec3(-0.004, -0.003, -0.004), hi = vec3(0.004, 0.003, 0.004), rng = split_rng(rng, key = "jit")))
    shade = random(lo = 0.75, hi = 1.35, rng = split_rng(rng, key = "tint"))
    out = set(anc1, "tint", vec3(shade * 0.97, shade, shade * 1.06))
}

def ridge_caps_e(len: f32) -> (out: geo<mesh>) {
    """Плоские колпаки-уголки 0.3 вдоль конька: от origin вдоль +Z на длину len
    (терминал на ребре, place_edge), намеренно не доходят до торцов (там ветровые
    доски). Группа tile."""
    cap_src = transform(parts.piece(size = vec3(0.3, 0.26, 0.26), pos = (0, 0, 0), grp = "tile"), rotate = vec3(45, 0, 0))
    n = max(int(len / 0.3), 1)
    pts = transform(mesh_line(count = n, length = f32(n - 1) * 0.3, dir = (0, 0, 1)), translate = vec3(0, 0.03, (len - f32(n - 1) * 0.3) * 0.5))
    out = mark(realize(instance_on_points(pts, source = cap_src)), "tile", where = true, domain = faces)
}

def valley_strip(p0: vec3, p1: vec3) -> (out: geo<mesh>) {
    """Ендова-желоб: квадратный брус 0.16 (профиль circle(4) повёрнут на 45°, стороны по
    осям), протянутый sweep'ем по прямой p0→p1. Лежит поверх настила по линии стыка
    скатов, края уходят под отступы черепицы. Группа iron."""
    d = p1 - p0
    len = length(d)
    path0 = mesh_line(count = 2, length = len, dir = d * (1.0 / len))
    path = transform(path0, translate = p0)
    sq = transform(circle(sides = 4, radius = 0.11313708), rotate = vec3(0, 0, 45))
    out = mark(compute_normals(sweep(path, profile = sq), mode = flat), "iron", where = true, domain = faces)
}

def barge_main(eave_z: f32, rl: f32, eave_y: f32, ridge_y: f32, slope_len: f32) -> (out: geo<mesh>) {
    """Ветровые доски главных фронтонов и шпильки на концах главного конька — в МИРОВОЙ
    системе (ставить после поворота крыши): доски по краям фронтонов z = ±rl/2 идут от
    карниза до конька (+0.2 запаса у конька, где две доски сходятся): центр — середина
    ската, сдвинутая вверх по скату на 0.1. Группа wood."""
    barg_len = slope_len + 0.2
    barg_cx = eave_z * 0.5 - 0.07
    barg_cy = (eave_y + ridge_y) * 0.5 + 0.07 + 0.1
    barg_r0 = transform(parts.piece(size = vec3(barg_len, 0.26, 0.08), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 135))
    barg_rf = transform(barg_r0, translate = vec3(barg_cx, barg_cy, rl * 0.5 + 0.02))
    barg_rb = transform(barg_r0, translate = vec3(barg_cx, barg_cy, 0.0 - rl * 0.5 - 0.02))
    barg_l0 = transform(parts.piece(size = vec3(barg_len, 0.26, 0.08), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 45))
    barg_lf = transform(barg_l0, translate = vec3(0.0 - barg_cx, barg_cy, rl * 0.5 + 0.02))
    barg_lb = transform(barg_l0, translate = vec3(0.0 - barg_cx, barg_cy, 0.0 - rl * 0.5 - 0.02))
    fin_f = parts.piece(size = vec3(0.14, 0.4, 0.14), pos = vec3(0, ridge_y + 0.22, rl * 0.5 - 0.05), grp = "wood")
    fin_b = parts.piece(size = vec3(0.14, 0.4, 0.14), pos = vec3(0, ridge_y + 0.22, 0.0 - rl * 0.5 + 0.05), grp = "wood")
    out = merge(barg_rf, barg_rb, barg_lf, barg_lb, fin_f, fin_b)
}

def gable(width: f32, depth: f32, stone_h: f32, upper_h: f32, jetty: f32, overhang: f32, rng: rng) -> (out: geo<mesh>, edges: geo<points>) {
    """Двускатная крыша 45° над вторым этажом (uw = width + 2·jetty, ud = depth + 2·jetty):
    карниз на eave_y = stone_h + upper_h − 0.1, свес overhang по всем сторонам. Панели
    и якоря — arch/roof; колпаки конька — из ребра R_RIDGE; фронтоны-заполнение —
    стеновой материал; ветровые доски — barge_main. edges — модель рёбер крыши
    (локальная система: конёк вдоль X; высоты @y1 — мировые, для chimney_rule)."""
    uw = width + 2.0 * jetty
    ud = depth + 2.0 * jetty
    wall_top = stone_h + upper_h
    eave_y = wall_top - 0.1
    ridge_y = eave_y + uw * 0.5 + overhang
    roof_t = 0.12
    rl = ud + 2.0 * overhang
    sd = uw
    # панели: конёк вдоль локального X, скаты на ±Z (поворот 90° в конце — как раньше)
    sl, ed, pl = ar.roof_rect(w = ud, d = sd, kind = gable, pitch = 45.0, overhang = overhang, y0 = eave_y)
    under = ar.underside(slopes = sl, y0 = eave_y, drop = roof_t)
    anc = slate_anchors(slopes = sl, planes = pl, rng = rng)
    tiles = ls.stamp(scopes = anc, source = tb.tile_plain())
    ridge = foreach e in lse.pick_role(edges = ed, role = k.R_RIDGE()) {
        e = lse.place_edge(g = ridge_caps_e(len = lse.edge_len(e)), e = e)
    }
    # Фронтоны под кровлей (стеновой материал).
    gable_sdf = shapes.gable_prism(ridge_y = ridge_y, drop = roof_t + 0.01, w = ud, d = sd - 0.02, floor_y = wall_top - 0.05)
    gables = mark(compute_normals(mesh_from_sdf(gable_sdf, voxel = 0.05), mode = auto, angle = 35), "wall", where = true, domain = faces)
    roof_local = merge(sl, under, tiles, ridge, gables)
    roof_world = transform(roof_local, rotate = vec3(0, 90, 0))
    eave_z = sd * 0.5 + overhang
    barge = barge_main(eave_z = eave_z, rl = rl, eave_y = eave_y, ridge_y = ridge_y, slope_len = eave_z * 1.4142136)
    out = merge(roof_world, barge)
    edges = ed
}

def multi_gable(width: f32, depth: f32, stone_h: f32, upper_h: f32, jetty: f32, overhang: f32, rng: rng) -> (out: geo<mesh>, edges: geo<points>) {
    """Многощипцовая (крестовая) крыша 45° для мансарды: roof_cross — главное крыло
    (конёк вдоль Z, пролёт uw) и поперечный щипец (конёк вдоль X, пролёт ud, ниже на
    (uw − ud)/2); ендовы — из модели рёбер, колпаки — на видимых пролётах коньков.
    Торцы щипца — треугольные стены (wall) с окнами мансарды. edges — модель рёбер
    крыши (мировая система), для правил размещения (chimney_rule)."""
    uw = width + 2.0 * jetty
    ud = depth + 2.0 * jetty
    wall_top = stone_h + upper_h
    eave_y = wall_top - 0.1
    ridge_y = eave_y + uw * 0.5 + overhang
    roof_t = 0.12
    rl = ud + 2.0 * overhang
    sd = uw
    eave_z = sd * 0.5 + overhang
    slope_len = eave_z * 1.4142136
    # Крыло щипца (для торцов, досок и окон)
    hs = ud * 0.5 + overhang
    ridge_w = eave_y + hs
    slope_w = hs * 1.4142136
    # Панели + подшивка + покрытие (ендовы выколочены на якорях)
    sl, ed, pl = ar.roof_cross(w = sd, d = ud, pitch = 45.0, overhang = overhang, y0 = eave_y)
    under = ar.underside(slopes = sl, y0 = eave_y, drop = roof_t)
    anc = slate_anchors(slopes = sl, planes = pl, rng = rng)
    tiles = ls.stamp(scopes = anc, source = tb.tile_plain())
    # Коньки и ендовы — терминалы на рёбрах из модели
    ridges = foreach e in lse.pick_role(edges = ed, role = k.R_RIDGE()) {
        e = lse.place_edge(g = ridge_caps_e(len = lse.edge_len(e)), e = e)
    }
    valleys = foreach e in lse.pick_role(edges = ed, role = k.R_VALLEY()) {
        e = valley_strip(p0 = value(@p0, on = e), p1 = value(@p1, on = e))
    }
    # Фронтоны-заполнение: главные + торцы щипца на плоскостях боковых стен.
    gable_sdf = shapes.gable_prism(ridge_y = ridge_y, drop = roof_t + 0.01, w = ud, d = sd - 0.02, floor_y = wall_top - 0.05)
    wing_sdf = shapes.gable_prism_z(ridge_y = ridge_w, drop = roof_t + 0.01, w = uw, d = ud - 0.02, floor_y = wall_top - 0.05)
    fills = mark(merge(compute_normals(mesh_from_sdf(gable_sdf, voxel = 0.05), mode = auto, angle = 35), compute_normals(mesh_from_sdf(wing_sdf, voxel = 0.05), mode = auto, angle = 35)), "wall", where = true, domain = faces)
    # Окна мансарды на торцах щипца (щипцовые стены смотрят на ±Z локально).
    win_y = wall_top + 0.95
    win_r = parts.place(fixtures.shuttered_window(w = 0.75, h = 0.85, off = 0.08, rng = split_rng(rng, key = "wr")), yaw_deg = 0.0, at = vec3(0, win_y, uw * 0.5 + 0.06))
    win_l = parts.place(fixtures.shuttered_window(w = 0.75, h = 0.85, off = 0.08, rng = split_rng(rng, key = "wl")), yaw_deg = 180.0, at = vec3(0, win_y, 0.0 - uw * 0.5 - 0.06))
    # Ветровые доски по краям торцов щипца и шпильки на вершинах.
    barg_len_w = slope_w + 0.2
    barg_wcx = hs * 0.5 - 0.07
    barg_wcy = (eave_y + ridge_w) * 0.5 + 0.17
    wbr_0 = transform(parts.piece(size = vec3(barg_len_w, 0.26, 0.08), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 135))
    wbr_f = transform(wbr_0, translate = vec3(barg_wcx, barg_wcy, eave_z + 0.02))
    wbr_b = transform(wbr_0, translate = vec3(barg_wcx, barg_wcy, 0.0 - eave_z - 0.02))
    wbl_0 = transform(parts.piece(size = vec3(barg_len_w, 0.26, 0.08), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 45))
    wbl_f = transform(wbl_0, translate = vec3(0.0 - barg_wcx, barg_wcy, eave_z + 0.02))
    wbl_b = transform(wbl_0, translate = vec3(0.0 - barg_wcx, barg_wcy, 0.0 - eave_z - 0.02))
    fin_wf = parts.piece(size = vec3(0.14, 0.4, 0.14), pos = vec3(0, ridge_w + 0.22, eave_z - 0.05), grp = "wood")
    fin_wb = parts.piece(size = vec3(0.14, 0.4, 0.14), pos = vec3(0, ridge_w + 0.22, 0.0 - eave_z + 0.05), grp = "wood")
    barge_w = merge(wbr_f, wbr_b, wbl_f, wbl_b, fin_wf, fin_wb)
    barge = barge_main(eave_z = eave_z, rl = rl, eave_y = eave_y, ridge_y = ridge_y, slope_len = slope_len)
    out = merge(sl, under, tiles, ridges, valleys, fills, win_r, win_l, barge_w, barge)
    edges = ed
}
