# Парадная дверь: арочный каменный портал, деревянное филёнчатое полотно,
# полуциркульная остеклённая фрамуга, поперечный брус, латунная фурнитура и каменный порог.
import lib.parts
import lib.architecture

def entrance_door(door_x: f32, facade_z: f32, plinth_h: f32, rng: rng) -> (out: geo<mesh>) {
    """Парадный дверной блок в викторианском стиле:
    - Каменный арочный портал с замковым камнем;
    - Филёнчатое полотно двери из тёмного дерева (4 доски/филёнки);
    - Полукруглая стеклянная фрамуга над импостом;
    - Поперечный деревянный брус-импост;
    - Точёный латунный кноб-ручка и замочная планка;
    - Массивный выступающий каменный порог."""
    dw = 1.05
    dh = 2.35
    r = dw * 0.5
    straight = dh - r
    d_frame = transform(architecture.arch_frame(w = dw, h = dh, bar = 0.14, depth = 0.18, grp = "stone"), translate = vec3(door_x, plinth_h, facade_z + 0.06))
    leaf = transform(parts.plank_panel(w = dw - 0.06, h = straight - 0.25, t = 0.08, n = 4, rng = split_rng(rng, key = "leaf")), translate = vec3(door_x, plinth_h + (straight - 0.25) * 0.5 + 0.02, facade_z + 0.02))
    fan = transform(architecture.arch_panel(w = dw - 0.06, h = dh - 0.02, t = 0.06, grp = "glass"), translate = vec3(door_x, plinth_h + 0.01, facade_z - 0.02))
    t_bar = parts.piece(size = vec3(dw, 0.08, 0.10), pos = vec3(door_x, plinth_h + straight - 0.22, facade_z + 0.03), grp = "wood")
    knob = mark(transform(ico_sphere(subdiv = 1, radius = 0.045), translate = vec3(door_x + 0.32, plinth_h + 1.05, facade_z + 0.11)), "brass", where = true, domain = faces)
    plate = parts.piece(size = vec3(0.06, 0.20, 0.02), pos = vec3(door_x + 0.32, plinth_h + 1.05, facade_z + 0.08), grp = "brass")
    thresh = parts.piece(size = vec3(dw + 0.36, 0.10, 0.26), pos = vec3(door_x, plinth_h + 0.05, facade_z + 0.09), grp = "stone")
    out = merge(d_frame, leaf, fan, t_bar, knob, plate, thresh)
}
