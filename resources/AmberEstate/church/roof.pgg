# Кровли: двускат нефа и односкаты приделов. Настил — призмы church/common
# (gable_volume/shed_volume — терминалы-настилы здания, без изменений); черепица
# и конёк — на конвейере lib/arch (A7): панели/рёбра/плоскости от roof_rect (неф,
# gable) и roof_wavefront (приделы, shed с тремя фронтонами), якоря tile_anchors
# с той же сеткой 0.22 × 0.175 и @tint, что у старого tile_field, конёк —
# терминал на ребре R_RIDGE (бывший ridge_caps_z, place_edge). Шпили — towers.

import lib.parts
import lib.layout.scope as ls
import lib.layout.edges as lse
import lib.arch.kinds as k
import lib.arch.plan as ap
import lib.arch.roof as ar
import church.common as common

def church_tile() -> (out: geo<mesh>) {
    """Черепичка церкви (как у tile_field): плоская плитка 0.24 × 0.028 × 0.28,
    низ-центр в origin, лежит в XZ, лицо +Y, штампуется по якорям tile_anchors.
    Группа roof."""
    out = mark(compute_normals(box(size = vec3(0.24, 0.028, 0.28)), mode = flat), "roof", where = true, domain = faces)
}

def tile_anchors_tint(anc0: geo<points>, rng: rng) -> (out: geo<points>) {
    """Якоря + джиттер ±1 мм и per-tile @tint (как у tile_field)."""
    anc1 = set_position(anc0, offset = random_vec(lo = vec3(-0.001, -0.001, -0.001), hi = vec3(0.001, 0.001, 0.001), rng = split_rng(rng, key = "jit")))
    shade = random(lo = 0.80, hi = 1.22, rng = split_rng(rng, key = "tint"))
    out = set(anc1, "tint", vec3(shade * 0.97, shade, shade * 1.05))
}

def ridge_caps_e(len: f32) -> (out: geo<mesh>) {
    """Колпаки конька: уголок 45° в плоскости XY от origin вдоль +Z (терминал на
    ребре, place_edge), намеренно не доходят до торцов на 0.20, подъём на 0.04
    над настилом. Группа roof."""
    cap0 = parts.piece(size = vec3(0.14, 0.12, 0.16), pos = vec3(0, 0, 0), grp = "roof")
    cap = transform(cap0, rotate = vec3(0, 0, 45))
    len_c = len - 0.20
    n = max(int(len_c / 0.15), 1)
    span = f32(n - 1) * 0.15
    pts0 = mesh_line(count = n, length = span, dir = (0, 0, 1))
    pts = transform(pts0, translate = vec3(0, 0.04, (len - span) * 0.5))
    out = mark(realize(instance_on_points(pts, source = cap)), "roof", where = true, domain = faces)
}

def nave_roof(nave_w: f32, nave_len: f32, tower_w: f32, nave_h: f32, nave_rise: f32, rng: rng) -> (out: geo<mesh>) {
    """Двускат нефа: настил-призма (gable_volume), черепица по якорям tile_anchors
    (панели roof_rect gable с уклоном настила), колпаки на ребре R_RIDGE. Конёк вдоль Z."""
    total_d = tower_w + nave_len
    oh = 0.28
    eave = nave_w * 0.5 + oh
    deck_rise = nave_rise + 0.04
    pitch = degrees(atan2(deck_rise, eave))
    along = total_d + 0.18
    deck = common.gable_volume(w = nave_w + oh * 2.0, d = total_d + 0.12, y0 = nave_h - 0.04, rise = deck_rise, grp = "roof")
    # Панели/якоря/капсы собираются в локали roof_rect (конёк вдоль X, скаты на ±Z)
    # и поворачиваются на 90° вокруг Y — конёк церкви идёт вдоль Z (как у deck).
    sl, ed, pl = ar.roof_rect(w = along, d = nave_w + oh * 2.0, kind = gable, pitch = pitch, overhang = 0.0, y0 = nave_h - 0.04)
    anc = tile_anchors_tint(anc0 = ar.tile_anchors(slopes = sl, planes = pl, row_pitch = 0.175, col_pitch = 0.22, lift = 0.010, margin = 0.04, top = 0.03, eave_over = 0.02), rng = split_rng(rng, key = "nv"))
    tiles = ls.stamp(scopes = anc, source = church_tile())
    caps = foreach e in lse.pick_role(edges = ed, role = k.R_RIDGE()) {
        e = lse.place_edge(g = ridge_caps_e(len = lse.edge_len(e)), e = e)
    }
    covers = transform(merge(tiles, caps), rotate = vec3(0, 90, 0))
    out = merge(deck, covers)
}

def aisle_one(nave_w: f32, nave_len: f32, aisle_w: f32, aisle_h: f32, aisle_rise: f32, side: f32, aisle_cz: f32, rng: rng) -> (out: geo<mesh>) {
    """Один придел (side = +1 юг, −1 север): односкат к нефу. Настил shed_volume;
    панели — roof_wavefront на прямоугольнике с тремя фронтонами (@pitch = 90)
    и одним скатным ребром (низкий край), якоря tile_anchors."""
    oh = 0.20
    run = aisle_w + oh
    deck_rise = aisle_rise + 0.06
    pitch = degrees(atan2(deck_rise, run))
    along = nave_len + 0.12
    outline0 = ap.plan_rect(w = run, d = along)
    outline = set(outline0, "pitch", @index == 2 ? pitch : 90.0, domain = points)
    sl, ed, top_cut, pl = roof_wavefront(outline = outline, pitch = pitch, y0 = aisle_h - 0.04)
    anc = tile_anchors_tint(anc0 = ar.tile_anchors(slopes = sl, planes = pl, row_pitch = 0.175, col_pitch = 0.22, lift = 0.010, margin = 0.04, top = 0.03, eave_over = 0.02), rng = rng)
    tiles = ls.stamp(scopes = anc, source = church_tile())
    deck = common.shed_volume(run = run, along = nave_len + 0.10, y0 = aisle_h - 0.04, rise = deck_rise, grp = "roof")
    cz = aisle_cz + 0.0 * f32(count(top_cut) + count(ed))
    # deck — локаль x∈[0, run] (высокий край на x=0 к нефу), tiles — центрированный
    # outline x∈[−run/2, run/2]: свои сдвиги, зеркало севера поворотом 180°.
    deck_t = select(side > 0.0, a = transform(deck, translate = vec3(nave_w * 0.5, 0, cz)), b = transform(transform(deck, rotate = vec3(0, 180, 0)), translate = vec3(0.0 - nave_w * 0.5, 0, cz)))
    tiles_t = select(side > 0.0, a = transform(tiles, translate = vec3(nave_w * 0.5 + run * 0.5, 0, cz)), b = transform(transform(tiles, rotate = vec3(0, 180, 0)), translate = vec3(0.0 - nave_w * 0.5 - run * 0.5, 0, cz)))
    out = merge(deck_t, tiles_t)
}

def aisle_roofs(nave_w: f32, nave_len: f32, tower_w: f32, aisle_w: f32, aisle_h: f32, aisle_rise: f32, rng: rng) -> (out: geo<mesh>) {
    """Односкаты приделов: высокий край к нефу."""
    total_d = tower_w + nave_len
    aisle_cz = 0.0 - total_d * 0.5 + nave_len * 0.5
    south = aisle_one(nave_w = nave_w, nave_len = nave_len, aisle_w = aisle_w, aisle_h = aisle_h, aisle_rise = aisle_rise, side = 1.0, aisle_cz = aisle_cz, rng = split_rng(rng, key = "s"))
    north = aisle_one(nave_w = nave_w, nave_len = nave_len, aisle_w = aisle_w, aisle_h = aisle_h, aisle_rise = aisle_rise, side = 0.0 - 1.0, aisle_cz = aisle_cz, rng = split_rng(rng, key = "n"))
    out = merge(south, north)
}

def roofs(nave_w: f32, nave_len: f32, tower_w: f32, aisle_w: f32, nave_h: f32, aisle_h: f32, nave_rise: f32, aisle_rise: f32, rng: rng) -> (out: geo<mesh>) {
    """Неф + приделы. Шпили — в towers."""
    out = merge(nave_roof(nave_w = nave_w, nave_len = nave_len, tower_w = tower_w, nave_h = nave_h, nave_rise = nave_rise, rng = split_rng(rng, key = "nave")), aisle_roofs(nave_w = nave_w, nave_len = nave_len, tower_w = tower_w, aisle_w = aisle_w, aisle_h = aisle_h, aisle_rise = aisle_rise, rng = split_rng(rng, key = "aisle")))
}
