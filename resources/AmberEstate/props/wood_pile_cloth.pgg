param log_len: f32 = 0.62
param n_rows: int = 4
param seed: int = 5

import wood_pile as logs

# Та же стопка, что wood_pile.scene, плюс ткань на одной половине.
# Поленья сначала укладывает rigid_settle; ткань генерируется сверху
# и падает уже на застывшую кучу (cloth_drape). Накрыта сторона +X.
root = rng_from_seed(seed)
pile = logs.assemble(len = log_len, rows = n_rows, rng = split_rng(root, key = "pile"))
ground = transform(box(size = (2.2, 0.2, 2.2)), translate = (0, -0.1, 0))
sheet0 = grid(size = (0.48, 1.30), res = (18, 32))
rippled = set_position(sheet0, offset = (0, fbm(scale = 7, octaves = 3, rng = split_rng(root, key = "cloth")) * 0.04, 0))
sheet = transform(rippled, translate = (0.12, 0.48, 0))
draped = cloth_drape(sheet, collider = merge(pile, ground), steps = 240, friction = 1.2)
tarp = set(compute_normals(draped), "Cd", vec3(0.55, 0.47, 0.34), domain = faces)
scene = merge(pile, tarp)
output scene
