import lib.parts
import lib.shapes
import lib.ironwork

# Общая палитра и точёные заготовки для пропов AmberEstate.
# import common из соседнего файла в props/.
def ao(raw: geo<mesh>, rng: rng) -> (out: geo<mesh>) {
    """Короткий AO в стыках. @Cd пишет вызывающий — только по группам этого меша."""
    out = bake_ao(raw, rays = 12, distance = 0.45, rng = rng, domain = points)
}

def lathe_wood(y0: f32, y1: f32, r_end: f32, r_mid: f32, sides: int) -> (out: geo<mesh>) {
    """Бочка/кадка:  n-гранный lathe, тонкие торцы, выпуклый экватор. sides — клёпки."""
    expect y1 > y0: "lathe_wood: высота"
    expect r_mid > r_end: "lathe_wood: выпуклость"
    n = 9
    h = y1 - y0
    path0 = mesh_line(count = n, length = h, dir = (0, 1, 0))
    t = f32(@index) / f32(n - 1)
    k = mix(r_end, r_mid, sin(3.14159265 * t))
    path = set(transform(path0, translate = vec3(0, y0, 0)), "profile_scale", vec2(k, k), domain = points)
    body = sweep(path, profile = circle(sides = sides, radius = 1.0))
    out = mark(compute_normals(body, mode = flat), "wood", where = true, domain = faces)
}

def hoop_band(y: f32, r: f32, h: f32) -> (out: geo<mesh>) {
    """Железный обруч: короткий цилиндр радиуса r, высота h, низ на y."""
    expect h > 0.008: "hoop_band: тонкий"
    out = ironwork.spool(p0 = vec3(0, y, 0), p1 = vec3(0, y + h, 0), r0 = r, r1 = r, sides = 16)
}

def rivet_ring(y: f32, r: f32, n: int, riv: f32) -> (out: geo<mesh>) {
    """n заклёпок на окружности радиуса r в плоскости XZ, высота y."""
    expect n >= 4: "rivet_ring: мало"
    one = transform(ico_sphere(subdiv = 1, radius = riv), translate = vec3(0, y, r))
    out = mark(shapes.polar_array(one, n = n), "iron", where = true, domain = faces)
}

def wood_disc(y: f32, r: f32, h: f32, grp: string) -> (out: geo<mesh>) {
    """Крышка-диск: короткий цилиндр, низ на y, группа grp."""
    body = ironwork.spool(p0 = vec3(0, y, 0), p1 = vec3(0, y + h, 0), r0 = r, r1 = r, sides = 16)
    out = mark(unmark(body, "iron"), grp, where = true, domain = faces)
}

def log_sector_profile(r: f32, a0: f32, a1: f32, lift: f32, warp: f32, n: int) -> (out: geo<points>) {
    """Неровный сектор со срубленной сердцевиной и живой дугой a0..a1."""
    expect n >= 8: "log_sector_profile: мало точек дуги"
    first = @index == 0
    last = @index == n + 1
    j = @index - 1
    t = f32(j) / f32(n - 1)
    a = radians(a0 + (a1 - a0) * t)
    edge = 1.0 + warp * (0.55 * sin(a * 3.0) + 0.45 * cos(a * 5.0))
    core = r * (0.10 + warp)
    skew = vec3(r * warp * 0.35, r * warp * 0.12, 0)
    inner0 = vec3(core * cos(radians(a0)), core * sin(radians(a0)) + lift, 0) + skew
    inner1 = vec3(core * cos(radians(a1)), core * sin(radians(a1)) + lift, 0) + skew
    arc = vec3(r * edge * cos(a), r * edge * sin(a) + lift, 0)
    p = first ? inner0 : (last ? inner1 : arc)
    out = set_position(mesh_line(count = n + 2, length = 0.0), pos = p)
}

def log_bark_profile(r_in: f32, r_out: f32, a0: f32, a1: f32, lift: f32, warp: f32, n: int) -> (out: geo<points>) {
    """Неровный кольцевой сектор коры: n точек наружу, n обратно."""
    expect r_out > r_in: "log_bark_profile: толщина коры"
    expect n >= 8: "log_bark_profile: мало точек дуги"
    fwd = @index < n
    j = fwd ? @index : @index - n
    t = f32(j) / f32(n - 1)
    a = fwd ? radians(a0 + (a1 - a0) * t) : radians(a1 + (a0 - a1) * t)
    edge = 1.0 + warp * (0.55 * sin(a * 3.0) + 0.45 * cos(a * 5.0))
    rr = (fwd ? r_out : r_in) * edge
    out = set_position(mesh_line(count = 2 * n, length = 0.0), pos = vec3(rr * cos(a), rr * sin(a) + lift, 0))
}

def split_log(len: f32, r: f32, bite: f32) -> (out: geo<mesh>) {
    """Колотое полено: неровный сектор с лёгким изгибом, сужением и скруткой вдоль X."""
    expect len > 0.15: "split_log: короткое"
    expect r > 0.03: "split_log: тонкое"
    expect bite >= 80.0 & bite <= 140.0: "split_log: выкус 15–20 минут"
    n = 20
    a0 = 90.0 - bite * 0.5
    a1 = 90.0 + bite * 0.5
    bt = r * 0.10
    r_out = r + bt
    character = (bite - 108.0) / 32.0
    warp = 0.035 + 0.018 * character
    path0 = mesh_line(count = 5, length = len, dir = (1, 0, 0))
    u = f32(@index) / 4.0
    x = len * (u - 0.5)
    bend_y = r * 0.030 * sin(3.14159265 * u)
    bend_z = r * (0.030 * sin(6.2831853 * u + character) + 0.018 * character * (u - 0.5))
    path1 = set_position(path0, pos = vec3(x, bend_y, bend_z))
    taper_x = 0.965 + 0.035 * sin(3.14159265 * u) + 0.018 * character * (u - 0.5)
    taper_y = 0.975 + 0.025 * sin(3.14159265 * u + 0.7) - 0.012 * character * (u - 0.5)
    path2 = set(path1, "profile_scale", vec2(taper_x, taper_y), domain = points)
    path = set(path2, "twist", f32(2.2 * character * (u - 0.5)), domain = points)
    profile_wood = log_sector_profile(r = r, a0 = a0, a1 = a1, lift = 0, warp = warp, n = n)
    profile_bark = log_bark_profile(r_in = r * 0.98, r_out = r_out, a0 = a0, a1 = a1, lift = 0, warp = warp, n = n)
    wood0 = sweep(path, profile = profile_wood)
    bark0 = sweep(path, profile = profile_bark)
    wood = mark(compute_normals(wood0, mode = flat), "wood_light", where = true, domain = faces)
    bark = mark(compute_normals(bark0, mode = auto, angle = 28), "bark", where = true, domain = faces)
    out = set(merge(wood, bark), "tint", vec3(1.0, 1.0, 1.0), domain = faces)
}

def post(w: f32, h: f32, at: vec3, grp: string) -> (out: geo<mesh>) {
    """Квадратный столб сечения w, высоты h, низ в at.y, центр по xz = at.xz."""
    out = parts.piece(size = vec3(w, h, w), pos = vec3(dot(at, (1, 0, 0)), dot(at, (0, 1, 0)) + h * 0.5, dot(at, (0, 0, 1))), grp = grp)
}
