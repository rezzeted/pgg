# Фонарный столб по референсу tmp/ObhGv.jpg: ступенчатое каменное основание
# (три яруса из отдельных боксов), деревянный столб из вертикальных досок
# с двумя железными поясами на клёпках, латунная капитель с патиной и
# четырёхскатная черепичная крыша (кана — полукруглые ряды, коньковые
# уголки, вертикальная черепица-вершина). Сбоку — кованая консоль с цепью и
# подвесным фонарём: крыша-шатёр, стёкла, свеча.
# Верх +Y, фонарь на +Z. Именованные узлы: base, column, roof, arm, lantern, scene.

import lib.blockwork
import lib.parts
import lib.shapes
import lib.fixtures
import lib.ironwork
import lib.roofing
import common

# --- Каменное основание --------------------------------------------------------

def base(rng: rng) -> (out: geo<mesh>) {
    """Три яруса кладки: 0.95 → 0.68 → 0.48, ряды по 0.20; верх на y = 1.0."""
    t0 = blockwork.stone_pier(side = 0.95, n_rows = 2, course_h = 0.20, rng = split_rng(rng, key = "t0"))
    t1 = transform(blockwork.stone_pier(side = 0.68, n_rows = 2, course_h = 0.20, rng = split_rng(rng, key = "t1")), translate = vec3(0, 0.40, 0))
    t2 = transform(blockwork.stone_pier(side = 0.48, n_rows = 1, course_h = 0.20, rng = split_rng(rng, key = "t2")), translate = vec3(0, 0.80, 0))
    out = merge(t0, t1, t2)
}

# --- Деревянный столб с поясами --------------------------------------------------

def band(y: f32, h: f32, s: f32, rng: rng) -> (out: geo<mesh>) {
    """Железный пояс: четыре пластины вокруг столба (ширина s) плюс клёпки
    по две на каждую грань (polar_array из пары на лицевой)."""
    yc = y + h * 0.5
    zf = s * 0.5 + 0.0225
    f = parts.piece(size = vec3(s + 0.08, h, 0.045), pos = vec3(0, yc, 0.0 - zf), grp = "iron")
    b = parts.piece(size = vec3(s + 0.08, h, 0.045), pos = vec3(0, yc, zf), grp = "iron")
    r = parts.piece(size = vec3(0.045, h, s + 0.08), pos = vec3(zf, yc, 0), grp = "iron")
    l = parts.piece(size = vec3(0.045, h, s + 0.08), pos = vec3(0.0 - zf, yc, 0), grp = "iron")
    rv0 = mark(transform(ico_sphere(subdiv = 1, radius = 0.014), translate = vec3(0.12, yc + h * 0.28, zf + 0.012)), "iron", where = true, domain = faces)
    rv1 = mark(transform(ico_sphere(subdiv = 1, radius = 0.014), translate = vec3(0.12, yc - h * 0.28, zf + 0.012)), "iron", where = true, domain = faces)
    rivets = shapes.polar_array(merge(rv0, rv1), n = 4)
    out = merge(f, b, r, l, rivets)
}

def column(rng: rng) -> (out: geo<mesh>) {
    """Столб 0.34 от y = 1.0 до y = 2.95: щит из 4 вертикальных досок на
    четыре стены (around_box), пояса внизу и наверху."""
    panel = parts.plank_panel(w = 0.36, h = 1.95, t = 0.05, n = 4, rng = split_rng(rng, key = "wood"))
    post = transform(shapes.around_box(panel, w = 0.34, d = 0.34), translate = vec3(0, 1.975, 0))
    b_lo = band(y = 1.05, h = 0.16, s = 0.34, rng = split_rng(rng, key = "b0"))
    b_hi = band(y = 2.79, h = 0.16, s = 0.34, rng = split_rng(rng, key = "b1"))
    # Латунная капитель под кровлей: две ступени, верх 3.145.
    cap0 = parts.piece(size = vec3(0.58, 0.10, 0.58), pos = vec3(0, 3.00, 0), grp = "bronze")
    cap1 = parts.piece(size = vec3(0.50, 0.10, 0.50), pos = vec3(0, 3.095, 0), grp = "bronze")
    out = merge(post, b_lo, b_hi, cap0, cap1)
}

# --- Черепичная крыша ------------------------------------------------------------

def tile_profile(r: f32, n: int) -> (out: geo<points>) {
    """Полукруглое сечение каны в XY: от (r, 0) по дуге до (−r, 0); замкнутый
    sweep даёт полутрубу с плоским дном (дно на y = 0, выпуклость +Y)."""
    a = radians(180.0 * f32(@index) / f32(n))
    out = set_position(mesh_line(count = n + 1, length = 0.0), pos = vec3(r * cos(a), r * sin(a), 0.0))
}

def tile_cana(r: f32, len: f32, n: int) -> (out: geo<mesh>) {
    """Одна кана: полутруба радиуса r длиной len вдоль −Z (начало — свес)."""
    path = mesh_line(count = 2, length = len, dir = (0, 0, -1))
    body = sweep(path, profile = tile_profile(r = r, n = n))
    out = mark(compute_normals(body, mode = flat), "tile", where = true, domain = faces)
}

def tile_slope(len_bot: f32, slope_len: f32, rng: rng) -> (out: geo<mesh>) {
    """Кановое поле одной грани пирамиды в локальной системе ската (x поперёк,
    низ у карниза z = 0, подъём в −Z; сужение к вершине — трапеция): ряды
    вразбежку, нахлёст pv < tl, отступ по нормали константный. Якоря за краями
    трапеции и за вершиной не кладутся."""
    r = 0.042
    pu = 0.098
    pv = 0.14
    tl = 0.20
    lift = r * 0.72
    cana = tile_cana(r = r, len = tl, n = 9)
    n_rows = int((slope_len + 0.15) / pv)
    n_cols = int(len_bot / pu) + 1
    empty = mesh_line(count = 0, length = 0.0)
    anchors_all = repeat (empty, iterations = n_rows) |acc| {
        k = f32(@iteration)
        odd = f32(@iteration % 2)
        row0 = mesh_line(count = n_cols, length = f32(n_cols - 1) * pu, dir = (1, 0, 0))
        row = transform(row0, translate = vec3(0.0 - f32(n_cols - 1) * pu * 0.5 + odd * pu * 0.5, lift, 0.05 - k * pv))
        acc = merge(acc, row)
    }
    hw_at = len_bot * 0.5 * (1.0 + dot(@P, (0, 0, 1)) / slope_len)
    a1 = delete(anchors_all, where = abs(dot(@P, (1, 0, 0))) > hw_at + pu * 0.5)
    anchors = delete(a1, where = dot(@P, (0, 0, 1)) + tl < 0.0 - slope_len + 0.02)
    jit = set_position(anchors, offset = random_vec(lo = vec3(-0.004, -0.002, -0.004), hi = vec3(0.004, 0.002, 0.004), rng = split_rng(rng, key = "jit")))
    shade = random(lo = 0.80, hi = 1.22, rng = split_rng(rng, key = "tint"))
    tinted = set(jit, "tint", vec3(shade * 0.97, shade, shade * 1.05))
    out = mark(realize(instance_on_points(tinted, source = cana)), "tile", where = true, domain = faces)
}

def roof(rng: rng) -> (out: geo<mesh>) {
    """Пирамидальная крыша: настил-усечённый, четыре кановых ската (угол
    ската ~55°), коньковые уголки по вальмам, вертикальная черепица-вершина."""
    eave_y = 3.145
    hw = 0.38
    rise = 0.55
    slope_len = sqrt(hw * hw + rise * rise)
    pitch = degrees(atan2(rise, hw))
    # Настил: квадратный sweep от карниза к вершине (апофема hw → масштаб hw·√2).
    path0 = mesh_line(count = 2, length = rise, dir = (0, 1, 0))
    path = set(path0, "profile_scale", @index == 0 ? vec2(hw * 1.41421, hw * 1.41421) : vec2(0.03, 0.03), domain = points)
    sq = transform(circle(sides = 4, radius = 1.0), rotate = vec3(0, 0, 45))
    deck0 = mark(compute_normals(sweep(path, profile = sq), mode = flat), "roof", where = true, domain = faces)
    deck = transform(deck0, translate = vec3(0, eave_y, 0))
    # Четыре ската: локальный +Z-скат наклоняется на pitch, встаёт на переднюю
    # грань, затем доворачивается вокруг Y в центр (идиома spire_house/roof.pgg).
    f0 = tile_slope(len_bot = hw * 2.0, slope_len = slope_len, rng = split_rng(rng, key = "f"))
    sf = transform(transform(f0, rotate = vec3(pitch, 0, 0)), translate = vec3(0, eave_y, hw))
    b0 = tile_slope(len_bot = hw * 2.0, slope_len = slope_len, rng = split_rng(rng, key = "b"))
    sb = transform(transform(transform(b0, rotate = vec3(pitch, 0, 0)), translate = vec3(0, eave_y, hw)), rotate = vec3(0, 180, 0))
    r0 = tile_slope(len_bot = hw * 2.0, slope_len = slope_len, rng = split_rng(rng, key = "r"))
    sr = transform(transform(transform(r0, rotate = vec3(pitch, 0, 0)), translate = vec3(0, eave_y, hw)), rotate = vec3(0, 90, 0))
    l0 = tile_slope(len_bot = hw * 2.0, slope_len = slope_len, rng = split_rng(rng, key = "l"))
    sl = transform(transform(transform(l0, rotate = vec3(pitch, 0, 0)), translate = vec3(0, eave_y, hw)), rotate = vec3(0, 270, 0))
    apex = vec3(0, eave_y + rise, 0)
    hip1 = roofing.hip_caps(p0 = vec3(hw, eave_y, hw), p1 = apex, rng = split_rng(rng, key = "h1"), half = 42.0, lift = 0.05, cap_w = 0.10, cap_l = 0.16, y_step = 0.006)
    hip2 = roofing.hip_caps(p0 = vec3(0.0 - hw, eave_y, hw), p1 = apex, rng = split_rng(rng, key = "h2"), half = 42.0, lift = 0.05, cap_w = 0.10, cap_l = 0.16, y_step = 0.006)
    hip3 = roofing.hip_caps(p0 = vec3(hw, eave_y, 0.0 - hw), p1 = apex, rng = split_rng(rng, key = "h3"), half = 42.0, lift = 0.05, cap_w = 0.10, cap_l = 0.16, y_step = 0.006)
    hip4 = roofing.hip_caps(p0 = vec3(0.0 - hw, eave_y, 0.0 - hw), p1 = apex, rng = split_rng(rng, key = "h4"), half = 42.0, lift = 0.05, cap_w = 0.10, cap_l = 0.16, y_step = 0.006)
    # Вершина: короткая вертикальная кана-конёк (профиль по XZ, ось Y).
    fin0 = transform(tile_cana(r = 0.045, len = 0.22, n = 8), rotate = vec3(90, 0, 0))
    fin = transform(fin0, translate = vec3(0, eave_y + rise - 0.05, 0))
    out = merge(deck, sf, sb, sr, sl, hip1, hip2, hip3, hip4, fin)
}

# --- Кованая консоль и подвесной фонарь --------------------------------------------

def lantern() -> (out: geo<mesh>) {
    """Подвесной фонарь в локальной системе: origin — точка подвеса (верх шишки),
    вниз: шишка, шатёр, обвязка, четыре стёкла (lamp), свеча (wax) с огнём (bulb),
    дно с капелькой. Низ на y = −0.68."""
    knob = mark(transform(ico_sphere(subdiv = 1, radius = 0.026), translate = vec3(0, -0.026, 0)), "iron", where = true, domain = faces)
    cap = fixtures.pyramid_cap(base = vec3(0, -0.15, 0), half = 0.185, h = 0.135, tip = 0.028)
    rim = parts.piece(size = vec3(0.40, 0.035, 0.40), pos = vec3(0, -0.162, 0), grp = "iron")
    pa = parts.piece(size = vec3(0.026, 0.40, 0.026), pos = vec3(0.17, -0.385, 0.17), grp = "iron")
    pb = parts.piece(size = vec3(0.026, 0.40, 0.026), pos = vec3(-0.17, -0.385, 0.17), grp = "iron")
    pc = parts.piece(size = vec3(0.026, 0.40, 0.026), pos = vec3(0.17, -0.385, -0.17), grp = "iron")
    pd = parts.piece(size = vec3(0.026, 0.40, 0.026), pos = vec3(-0.17, -0.385, -0.17), grp = "iron")
    tf = parts.piece(size = vec3(0.36, 0.024, 0.024), pos = vec3(0, -0.185, 0.17), grp = "iron")
    tb = parts.piece(size = vec3(0.36, 0.024, 0.024), pos = vec3(0, -0.185, -0.17), grp = "iron")
    tl = parts.piece(size = vec3(0.024, 0.024, 0.36), pos = vec3(-0.17, -0.185, 0), grp = "iron")
    tr = parts.piece(size = vec3(0.024, 0.024, 0.36), pos = vec3(0.17, -0.185, 0), grp = "iron")
    bf = parts.piece(size = vec3(0.36, 0.024, 0.024), pos = vec3(0, -0.585, 0.17), grp = "iron")
    bb = parts.piece(size = vec3(0.36, 0.024, 0.024), pos = vec3(0, -0.585, -0.17), grp = "iron")
    bl = parts.piece(size = vec3(0.024, 0.024, 0.36), pos = vec3(-0.17, -0.585, 0), grp = "iron")
    br = parts.piece(size = vec3(0.024, 0.024, 0.36), pos = vec3(0.17, -0.585, 0), grp = "iron")
    kf = mark(transform(ico_sphere(subdiv = 1, radius = 0.021), translate = vec3(0.17, -0.16, 0.17)), "iron", where = true, domain = faces)
    kb = mark(transform(ico_sphere(subdiv = 1, radius = 0.021), translate = vec3(-0.17, -0.16, 0.17)), "iron", where = true, domain = faces)
    kl = mark(transform(ico_sphere(subdiv = 1, radius = 0.021), translate = vec3(0.17, -0.16, -0.17)), "iron", where = true, domain = faces)
    kr = mark(transform(ico_sphere(subdiv = 1, radius = 0.021), translate = vec3(-0.17, -0.16, -0.17)), "iron", where = true, domain = faces)
    gf = parts.piece(size = vec3(0.315, 0.375, 0.012), pos = vec3(0, -0.385, 0.158), grp = "lamp")
    gb = parts.piece(size = vec3(0.315, 0.375, 0.012), pos = vec3(0, -0.385, -0.158), grp = "lamp")
    gl = parts.piece(size = vec3(0.012, 0.375, 0.315), pos = vec3(-0.158, -0.385, 0), grp = "lamp")
    gr = parts.piece(size = vec3(0.012, 0.375, 0.315), pos = vec3(0.158, -0.385, 0), grp = "lamp")
    wax0 = ironwork.spool(p0 = vec3(0, -0.52, 0), p1 = vec3(0, -0.41, 0), r0 = 0.042, r1 = 0.036, sides = 10)
    wax = mark(unmark(wax0, "iron"), "wax", where = true, domain = faces)
    bulb = mark(transform(ico_sphere(subdiv = 2, radius = 0.022), translate = vec3(0, -0.385, 0)), "bulb", where = true, domain = faces)
    plate = parts.piece(size = vec3(0.38, 0.03, 0.38), pos = vec3(0, -0.60, 0), grp = "iron")
    drop = fixtures.pyramid_cap(base = vec3(0, -0.615, 0), half = 0.11, h = -0.06, tip = 0.008)
    out = merge(knob, cap, rim, pa, pb, pc, pd, tf, tb, tl, tr, bf, bb, bl, br, kf, kb, kl, kr, gf, gb, gl, gr, wax, bulb, plate, drop)
}

def arm(rng: rng) -> (out: geo<mesh>) {
    """Консоль на +Z-грань: пластина, гнутый прут (безье: вбок, вниз на конце),
    подкос-завиток, кольцо, два звена цепи и фонарь под (0, 2.12, 0.62)."""
    plate = parts.piece(size = vec3(0.12, 0.22, 0.03), pos = vec3(0, 2.36, 0.19), grp = "iron")
    bar = fixtures.rod(p0 = vec3(0, 2.34, 0.21), p1 = vec3(0, 2.40, 0.36), p2 = vec3(0, 2.40, 0.56), p3 = vec3(0, 2.26, 0.62), r = 0.022, n = 16)
    brace = fixtures.rod(p0 = vec3(0, 2.20, 0.21), p1 = vec3(0, 2.26, 0.34), p2 = vec3(0, 2.30, 0.47), p3 = vec3(0, 2.245, 0.50), r = 0.012, n = 12)
    eye = mark(transform(ico_sphere(subdiv = 1, radius = 0.026), translate = vec3(0, 2.26, 0.62)), "iron", where = true, domain = faces)
    link1 = fixtures.ring(center = vec3(0, 2.20, 0.62), radius = 0.035, r = 0.008, yaw_deg = 0)
    link2 = fixtures.ring(center = vec3(0, 2.155, 0.62), radius = 0.030, r = 0.008, yaw_deg = 90)
    lamp = transform(lantern(), translate = vec3(0, 2.12, 0.62))
    out = merge(plate, bar, brace, eye, link1, link2, lamp)
}

param seed: int = 7

root_rng = rng_from_seed(seed)

base_g = base(rng = split_rng(root_rng, key = "base"))
column_g = column(rng = split_rng(root_rng, key = "col"))
roof_g = roof(rng = split_rng(root_rng, key = "roof"))
arm_g = arm(rng = split_rng(root_rng, key = "arm"))

# --- Окраска ---------------------------------------------------------------------

def paint(raw: geo<mesh>, rng: rng) -> (out: geo<mesh>) {
    """Палитра по референсу: тёплый светлый камень, тёмное дерево, почти чёрное
    железо, патинированная бронза, терракота кан, тёплое стекло и свеча."""
    stone_col = vec3(0.80, 0.74, 0.63) * @tint
    wood_col = vec3(0.30, 0.19, 0.11) * @tint
    iron_col = mix(vec3(0.055, 0.055, 0.062), vec3(0.11, 0.10, 0.09), 0.5 + 0.5 * fbm(scale = 3.0, octaves = 2, rng = split_rng(rng, key = "iron")))
    bronze_col = mix(vec3(0.13, 0.15, 0.13), vec3(0.20, 0.22, 0.18), 0.5 + 0.5 * fbm(scale = 2.5, octaves = 2, rng = split_rng(rng, key = "bronze")))
    tile_col = vec3(0.72, 0.36, 0.20) * @tint
    roof_col = vec3(0.35, 0.18, 0.11)
    c1 = ingroup("stone") ? stone_col : vec3(1.0, 0.0, 1.0)
    c2 = ingroup("wood") ? wood_col : c1
    c3 = ingroup("iron") ? iron_col : c2
    c4 = ingroup("bronze") ? bronze_col : c3
    c5 = ingroup("tile") ? tile_col : c4
    c6 = ingroup("roof") ? roof_col : c5
    c7 = ingroup("wax") ? vec3(0.92, 0.88, 0.78) : c6
    c8 = ingroup("lamp") ? vec3(1.0, 0.62, 0.25) : c7
    c9 = ingroup("bulb") ? vec3(1.0, 0.90, 0.55) : c8
    edge_mul = ingroup("edge") ? vec3(1.25, 1.20, 1.10) : vec3(1.0)
    out = common.ao(set(raw, "Cd", c9 * edge_mul, domain = faces), rng = rng)
}

scene_raw = merge(base_g, column_g, roof_g, arm_g)
scene = paint(scene_raw, rng = split_rng(root_rng, key = "paint"))
output scene
