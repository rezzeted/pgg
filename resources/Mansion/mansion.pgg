# Mansion — особняк целиком (analysis.md; референсы — reference/*.jpg). Верхний
# уровень иерархии «элементы → участки → фасады → здание» на слое lib/layout +
# lib/arch: план-прямоугольник → facades (scope на ребро) → split каждого фасада
# своим паттерном участков (@variant — вид участка) → участки mansion/units в рамки
# (ls.place). Угловой объём с эркером и шатром — на углу (+X, +Z), где сходятся
# боковой (сторона front, лицо +Z) и входной (сторона right, лицо +X) фасады. Крыша — прямой
# скелет контура с выступами ризалитов: рёбра фронтонов @pitch = 90 дают щипцы,
# rise_max — плоская палуба; покрытие — ромбовидный шифер по якорям tile_anchors.
# Стенд элементов и участков по отдельности — elements.pgg.

param roof_pitch: f32 = 60.0
param detail: int = 1
param ao: int = 1

import lib.parts
import lib.layout.scope as ls
import lib.layout.split as lsp
import lib.layout.edges as lse
import lib.arch.kinds as k
import lib.arch.plan as ap
import lib.arch.facade as af
import lib.arch.roof as ar
import lib.arch.terminals_basic as tb
import mansion.common as mc
import mansion.units as mu

# --- габариты плана ------------------------------------------------------------------
# Боковой фасад (front, от дальнего угла к эркеру): простенок 0.5 | три окна 3.9 |
# ризалит 4.2 | ось 3.4 | угловой объём 3.0. Входной (right, от эркера): угол 3.0 |
# узкая ось 2.6 | ризалит с порталом 4.2 | две оси по 3.0 | простенок 0.5.
W = 15.0
D = 16.3
hw = W * 0.5
hd = D * 0.5
rp = 0.25
ris = 4.2
rh = ris * 0.5
xs = 0.0 - hw + 0.5 + 3.9 + rh
zs = hd - 3.0 - 2.6 - rh

# --- фасады и участки ----------------------------------------------------------------
# Виды участков (@variant): 1 — простенок слева, 2 — простенок справа, 3 — ось бокового
# фасада (W1 1.25, три створки), 4 — ось входного и дворовых фасадов (W1n 0.95),
# 5 — три окна, 6 — лестничный ризалит, 7 — входной ризалит, 8 — место углового объёма.
kw = k.K_WALL()
def seq_axes(pat: geo<points>, n: int) -> (out: geo<points>) {
    """n равных осей W1n (flex) в конец паттерна — дворовые фасады."""
    out = repeat (pat, iterations = n) |acc| {
        acc = lsp.pattern_add(pat = acc, size = 1.0, kind = k.K_WALL(), flex = true, variant = 4)
    }
}
def ends(n: int) -> (out: geo<points>) {
    """Дворовой фасад: простенок | n осей | простенок."""
    p0 = lsp.pattern_add(pat = lsp.pattern_empty(), size = 0.5, kind = k.K_WALL(), variant = 1)
    out = lsp.pattern_add(pat = seq_axes(pat = p0, n = n), size = 0.5, kind = k.K_WALL(), variant = 2)
}
s0 = lsp.pattern_add(pat = lsp.pattern_empty(), size = 0.5, kind = kw, variant = 1)
s1 = lsp.pattern_add(pat = s0, size = 3.9, kind = kw, variant = 5)
s2 = lsp.pattern_add(pat = s1, size = ris, kind = kw, variant = 6)
s3 = lsp.pattern_add(pat = s2, size = 3.4, kind = kw, variant = 3)
pat_side = lsp.pattern_add(pat = s3, size = 3.0, kind = kw, variant = 8)
e0 = lsp.pattern_add(pat = lsp.pattern_empty(), size = 3.0, kind = kw, variant = 8)
e1 = lsp.pattern_add(pat = e0, size = 2.6, kind = kw, variant = 4)
e2 = lsp.pattern_add(pat = e1, size = ris, kind = kw, variant = 7)
e3 = lsp.pattern_add(pat = e2, size = 3.0, kind = kw, variant = 4)
e4 = lsp.pattern_add(pat = e3, size = 3.0, kind = kw, variant = 4)
pat_entr = lsp.pattern_add(pat = e4, size = 0.5, kind = kw, variant = 2)

plan = ap.plan_rect(w = W, d = D)
faces = af.facades(plan = plan, y0 = 0.0, y1 = mc.Y_EAVE(), t = mc.WALL_T())
bays_l = lsp.split(scopes = delete(faces, where = @facade != ap.rect_side(side = left)), pattern = ends(n = 5))
bays_s = lsp.split(scopes = delete(faces, where = @facade != ap.rect_side(side = front)), pattern = pat_side)
bays_e = lsp.split(scopes = delete(faces, where = @facade != ap.rect_side(side = right)), pattern = pat_entr)
bays_r = lsp.split(scopes = delete(faces, where = @facade != ap.rect_side(side = back)), pattern = ends(n = 4))
bays = merge(bays_l, bays_s, bays_e, bays_r)

g_end_l = foreach s in delete(bays, where = @variant != 1) {
    s = ls.place(g = mu.end_pier(w = ls.frame_w(s), detail = detail), s = s)
}
g_end_r = foreach s in delete(bays, where = @variant != 2) {
    s = ls.place(g = mu.end_pier(w = ls.frame_w(s), right = true, detail = detail), s = s)
}
g_axis_s = foreach s in delete(bays, where = @variant != 3) {
    s = ls.place(g = mu.axis_bay(w = ls.frame_w(s), detail = detail), s = s)
}
g_axis_e = foreach s in delete(bays, where = @variant != 4) {
    s = ls.place(g = mu.axis_bay(w = ls.frame_w(s), win_w = 0.95, win_h = 2.05, cols = 2, detail = detail), s = s)
}
g_triple = foreach s in delete(bays, where = @variant != 5) {
    s = ls.place(g = mu.triple_bay(w = ls.frame_w(s), detail = detail), s = s)
}
g_ris_s = foreach s in delete(bays, where = @variant != 6) {
    s = ls.place(g = mu.risalit_side(w = ls.frame_w(s), rp = rp, detail = detail), s = s)
}
g_ris_e = foreach s in delete(bays, where = @variant != 7) {
    s = ls.place(g = mu.risalit_entr(w = ls.frame_w(s), rp = rp, detail = detail), s = s)
}
walls = merge(g_end_l, g_end_r, g_axis_s, g_axis_e, g_triple, g_ris_s, g_ris_e)

# --- угловой объём и шатёр -----------------------------------------------------------
corner = transform(mu.corner_block(lc = 3.0, p = 0.25, detail = detail), translate = vec3(hw, 0, hd))
tent = transform(mu.turret(lc = 3.0, p = 0.25, detail = detail), translate = vec3(hw, mc.Y_EAVE(), hd))

# --- крыша ---------------------------------------------------------------------------
# Контур кровли — план с выступами ризалитов (CCW): рёбра 3 и 9 — лица щипцов.
# Свес ov даёт roof_wavefront(overhang); y0 опущен на свес, чтобы скат проходил
# через верх C3 по лицу стены.
def pt(x: f32, z: f32) -> (out: geo<points>) {
    """Одна вершина контура кровли."""
    out = set_position(mesh_line(count = 1, length = 0.0), pos = vec3(x, 0.0, z))
}
# Угол (+X, +Z) срезан по диагонали основания шатра (срез эркера c2 = 1.4 плюс вынос
# шатра 0.16): вальма уходит под шатёр, а не торчит перед его диагональной гранью.
# Свес сдвигает и диагональ — срез контура больше на ov·√2.
ov = 0.2
ch = 1.4 - 2.0 * 0.25 - 0.16 * 1.41421 + ov * 1.41421
o0 = merge(pt(x = -hw, z = -hd), pt(x = -hw, z = hd), pt(x = xs - rh, z = hd), pt(x = xs - rh, z = hd + rp), pt(x = xs + rh, z = hd + rp), pt(x = xs + rh, z = hd), pt(x = hw - ch, z = hd), pt(x = hw, z = hd - ch))
o1 = merge(o0, pt(x = hw, z = zs + rh), pt(x = hw + rp, z = zs + rh), pt(x = hw + rp, z = zs - rh), pt(x = hw, z = zs - rh), pt(x = hw, z = -hd))
g_s = 3
g_e = 9
outline = set(ap.plan_finish(pts = o1), "pitch", (@index == g_s) | (@index == g_e) ? 90.0 : roof_pitch, domain = points)
tp = tan(radians(roof_pitch))
y_roof = mc.Y_EAVE() - ov * tp
rise = 4.2
sl0, ed, top, pl0 = roof_wavefront(outline = outline, pitch = roof_pitch, rise_max = rise, y0 = y_roof, overhang = ov)
# Вертикальные панели фронтонов (островки g_s, g_e) — это стены щипцов, их строит
# mu.gable: панели и их карнизные плоскости (источник якорей) убраны, граничные
# плоскости оставлены — они подрезают шифер соседних скатов по свесу щипца.
sl = delete(sl0, where = (@island_id == g_s) | (@island_id == g_e), domain = faces)
pl = delete(pl0, where = (@eave == true) & ((@island_id == g_s) | (@island_id == g_e)))
panels = mark(sl, "slate", where = true, domain = faces)
inset = rise / tp - ov
deck = mc.plan_slab(p0 = vec3(0.0 - hw + inset, 0, 0.0 - hd + inset), p1 = vec3(0.0 - hw + inset, 0, hd - inset), p2 = vec3(hw - inset, 0, hd - inset), p3 = vec3(hw - inset, 0, 0.0 - hd + inset), y0 = y_roof + rise - 0.06, y1 = y_roof + rise + 0.01, grp = "tin")
# Ромбовидный шифер: квадратная плитка, повёрнутая на 45° в плоскости ската.
slate0 = transform(parts.slab(size = vec3(0.27, 0.025, 0.27), pos = vec3(0, 0.0125, 0), grp = "slate"), rotate = vec3(0, 45, 0))
anchors = ar.tile_anchors(slopes = sl, planes = pl, row_pitch = 0.19, col_pitch = 0.38, lift = 0.01, margin = 0.06, top = 0.15)
slates = select(detail > 0, a = ls.stamp(scopes = anchors, source = slate0), b = empty_mesh())
hips = foreach e in merge(lse.pick_role(edges = ed, role = k.R_HIP()), lse.pick_role(edges = ed, role = k.R_RIDGE()), lse.pick_role(edges = ed, role = k.R_VALLEY())) {
    e = lse.place_edge(g = parts.to_group(g = tb.ridge_cap(len = lse.edge_len(e), r = 0.07), src = "roof", dst = "tin"), e = e)
}
roof = merge(panels, deck, slates, hips)

# --- слуховые окна, трубы, водостоки -------------------------------------------------
# Лицо слухового окна — в u от плоскости стены, низ — на скате.
u_d = 0.9
y_d = mc.Y_EAVE() + u_d * tp
dw = mu.w5(w = 1.5, h = 1.15, dep = 1.2, detail = detail)
dg = transform(mu.tent_dormer(w = 1.1, h = 1.5, dep = 1.4), translate = vec3(0, 0, 0.0 - 0.7))
dw_s = merge(transform(dw, translate = vec3(hw - 3.0 - 1.7, y_d, hd - u_d)), transform(dw, translate = vec3(0.0 - hw + 0.5 + 1.95, y_d, hd - u_d)))
# Входной фасад — сторона right: рамка ребра даёт поворот и направление вдоль стены
# (от угла эркера, вершина (hw, hd)) без ручного вывода yaw.
e_o, _, e_t, e_n, e_yaw, _ = ap.edge_frame(plan = plan, i = ap.rect_side(side = right))
e_in = e_o - e_n * u_d + vec3(0, y_d, 0)
dw_e = merge(transform(dw, rotate = vec3(0, e_yaw, 0), translate = e_in + e_t * 4.3), transform(dg, rotate = vec3(0, e_yaw, 0), translate = e_in + e_t * (hd - zs + rh + 1.5)))
dormers = merge(dw_s, dw_e)
chim0 = mc.as_group(g = tb.chimney_stack(w = 0.78, d = 0.64, h = 3.6), grp = "redbrick")
chim = merge(transform(chim0, translate = vec3(0.0 - 3.6, 12.4, 4.6)), transform(chim0, translate = vec3(1.6, 12.4, 0.0 - 5.3)), transform(chim0, translate = vec3(4.6, 12.4, 0.0 - 1.2)), transform(chim0, translate = vec3(0.0 - 4.4, 12.4, 0.0 - 3.4)))
pipe = tb.downspout(h = mc.Y_EAVE() - 0.05, r = 0.06, elbow = 0.16)
pipes = merge(transform(pipe, translate = vec3(xs - rh - 0.14, 0, hd + 0.12)), transform(pipe, translate = vec3(xs + rh + 0.14, 0, hd + 0.12)), transform(pipe, rotate = vec3(0, 90, 0), translate = vec3(hw + 0.12, 0, zs + rh + 0.14)), transform(pipe, rotate = vec3(0, 90, 0), translate = vec3(hw + 0.12, 0, zs - rh - 0.14)))

# --- здание, окраска ------------------------------------------------------------------
house_raw = merge(walls, corner, tent, roof, dormers, chim, pipes)
house_col = mc.paint(g = house_raw)
house = select(ao > 0, a = bake_ao(house_col, rays = 12, distance = 1.0, rng = rng_from_seed(3), domain = points), b = house_col)

output house
output bays
output outline
output top
