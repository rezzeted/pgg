# Mansion — окна особняка (analysis.md §3, коды W*). Терминал = проём с обрамлением
# в конвенции mansion/common: низ проёма в origin, лицо стены z = 0, лицо +Z.
# Проём в стене режет сборка (clip_rect_hole по w×h). Арочные терминалы (W2) сами
# закрывают пазухи между прямоугольным проёмом и дугой — обкладкой по контуру.

import lib.parts
import lib.arch.terminals_victorian as tv
import mansion.common as mc

def w1(w: f32 = 1.25, h: f32 = 1.85, cols: int = 3, fan_k: f32 = 0.27, detail: int = 1) -> (out: geo<mesh>) {
    """W1 — рядовое окно: прямоугольный проём w×h в оранжевом наличнике.
    Наличник (terra, рельеф 4–6 см): подоконная полоса, косяки шириной 0.32 с зубчатым
    («штрабным») наружным краем через ряд, плоское поле над проёмом и лучковая арка
    из радиальных кирпичей с «ушами», подрезанными по ширине наличника. Жестяной
    отлив, оконный блок в четверти 0.14 (cols = 3 — узкая|широкая|узкая, 2 — две створки;
    фрамуга fan_k·h, 0 — без фрамуги). Варианты: W1n — узкое 2-створчатое (0.95×2.05),
    W1b — низкое широкое без фрамуги (1.45×1.05), W4 — окно щипца (detail = 0)."""
    expect w > 0.5 & h > 0.8: "w1: проём от 0.5×0.8 м"
    b = 0.32
    ww = w + 2.0 * b
    rel = 0.045
    sub_h = 0.16
    field = 0.16
    rise = 0.20
    arch_t = 0.26
    rev = 0.14
    course = mc.COURSE()
    y_s = h + field
    strip = parts.slab(size = vec3(ww, sub_h, rel), pos = vec3(0, 0.0 - sub_h * 0.5, rel * 0.5), grp = "terra")
    jamb_l = parts.slab(size = vec3(b, y_s, rel), pos = vec3(0.0 - (w + b) * 0.5, y_s * 0.5, rel * 0.5), grp = "terra")
    jamb_r = parts.slab(size = vec3(b, y_s, rel), pos = vec3((w + b) * 0.5, y_s * 0.5, rel * 0.5), grp = "terra")
    fld = parts.slab(size = vec3(ww, field + rise, rel * 0.8), pos = vec3(0, h + (field + rise) * 0.5, rel * 0.4), grp = "terra")
    arch = transform(mc.segment_arch(span = ww, rise = rise, t = arch_t, z0 = 0.0, z1 = rel + 0.015, n = 11, joint = 0.012, grp = "terra", clip_hw = ww * 0.5), translate = vec3(0, y_s, 0))
    n_t = int((y_s + sub_h) / (2.0 * course))
    tp0 = mesh_line(count = n_t, length = f32(n_t - 1) * 2.0 * course, dir = (0, 1, 0))
    tp = merge(transform(tp0, translate = vec3(0.0 - ww * 0.5 - 0.0325, course * 0.5 - sub_h, 0)), transform(tp0, translate = vec3(ww * 0.5 + 0.0325, course * 0.5 - sub_h, 0)))
    tooth = parts.slab(size = vec3(0.065, course, rel), pos = vec3(0, 0, rel * 0.5), grp = "terra")
    teeth = select(detail > 0, a = realize(instance_on_points(tp, source = tooth)), b = empty_mesh())
    frame = transform(mc.sash(w = w, h = h, cols = cols, fan = h * fan_k), translate = vec3(0, 0, 0.0 - rev))
    sill0 = parts.slab(size = vec3(w + 0.14, 0.05, rev + 0.12), pos = vec3(0, 0.0, 0.0 - (rev + 0.12) * 0.5), grp = "tin")
    sill = transform(sill0, rotate = vec3(8, 0, 0), translate = vec3(0, 0.02, 0.12))
    out = merge(strip, jamb_l, jamb_r, fld, arch, teeth, frame, sill)
}

def w2(w: f32 = 1.30, h: f32 = 2.45, rise_k: f32 = 0.64, detail: int = 1) -> (out: geo<mesh>) {
    """W2 — стрельчатое окно ризалитов (2-й этаж): проём w, высота до вершины h,
    пониженная двухцентровая арка с подъёмом rise_k·w. Обрамление terra по контуру:
    обкладка откоса (закрывает пазухи прямоугольного проёма в стене), внутренний
    скошенный уступ и наружная тяга-архивольт с фасками. Коробка по контуру, средники
    узкая|широкая|узкая до дуги, импост на линии пят и нижняя перекладина. Массивный
    жестяной отлив на подоконной полосе terra."""
    expect w > 0.6 & h > w * rise_k + 0.8: "w2: проём от 0.6 м, прямая часть от 0.8 м"
    f = w * rise_k
    y_s = h - f
    rev = 0.16
    n = 10
    lining = mc.arch_band(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, q0 = vec3(0.0 - rev, 0.006, 0), q1 = vec3(0.0 - 0.004, 0.006, 0), q2 = vec3(0.0 - 0.004, 0.0 - 0.40, 0), q3 = vec3(0.0 - rev, 0.0 - 0.40, 0), grp = "terra")
    splay = mc.arch_band(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, q0 = vec3(0.0 - 0.07, 0.0, 0), q1 = vec3(0.035, 0.0 - 0.12, 0), q2 = vec3(0.035, 0.0 - 0.13, 0), q3 = vec3(0.0 - 0.07, 0.0 - 0.13, 0), grp = "terra")
    hood = mc.arch_band(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, q0 = vec3(0.0, 0.0 - 0.12, 0), q1 = vec3(0.075, 0.0 - 0.14, 0), q2 = vec3(0.075, 0.0 - 0.27, 0), q3 = vec3(0.0, 0.0 - 0.31, 0), grp = "terra")
    zf = 0.0 - rev
    box_f = mc.arch_band(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, q0 = vec3(zf - 0.07, 0.06, 0), q1 = vec3(zf, 0.06, 0), q2 = vec3(zf, 0.0, 0), q3 = vec3(zf - 0.07, 0.0, 0), grp = "wood")
    bot = parts.slab(size = vec3(w, 0.08, 0.07), pos = vec3(0, 0.04, zf - 0.035), grp = "wood")
    glass = mc.arch_slab(s = w, f = f, y0 = 0.0, y_s = y_s, n = n, z0 = zf - 0.05, z1 = zf - 0.04, grp = "glass")
    mx = w * 0.26
    hm = mc.arch_y(s = w, f = f, y_s = y_s, x = mx)
    m_l = parts.slab(size = vec3(0.045, hm, 0.05), pos = vec3(0.0 - mx, hm * 0.5, zf - 0.035), grp = "wood")
    m_r = parts.slab(size = vec3(0.045, hm, 0.05), pos = vec3(mx, hm * 0.5, zf - 0.035), grp = "wood")
    imp = parts.slab(size = vec3(w, 0.05, 0.05), pos = vec3(0, y_s, zf - 0.035), grp = "wood")
    imp2 = parts.slab(size = vec3(w, 0.04, 0.05), pos = vec3(0, y_s - h * 0.12, zf - 0.035), grp = "wood")
    low = parts.slab(size = vec3(w, 0.04, 0.05), pos = vec3(0, h * 0.14, zf - 0.035), grp = "wood")
    sill = parts.slab(size = vec3(w + 0.40, 0.10, rev + 0.16), pos = vec3(0, 0.0 - 0.04, (0.16 - rev) * 0.5), grp = "tin")
    sub = parts.slab(size = vec3(w + 0.62, 0.16, 0.045), pos = vec3(0, 0.0 - 0.17, 0.0225), grp = "terra")
    out = merge(lining, splay, hood, box_f, bot, glass, m_l, m_r, imp, imp2, low, sill, sub)
}

def w3(w: f32 = 0.62, h: f32 = 1.85, detail: int = 1) -> (out: geo<mesh>) {
    """W3 — окно углового эркера: узкий прямоугольный проём w×h (двухстворчатый блок
    с фрамугой) под полуциркульным люнетом: перемычка-полочка над проёмом, тимпан
    с веером рёбер-«раковиной» (detail > 0) и полуциркульная тяга-архивольт.
    Каменный подоконник на двух ступенчатых консольках. Стена эркера — terra."""
    expect w > 0.4 & h > 0.8: "w3: проём от 0.4×0.8 м"
    rev = 0.14
    frame = transform(mc.sash(w = w, h = h, cols = 2, fan = h * 0.26, bar = 0.05), translate = vec3(0, 0, 0.0 - rev))
    lintel = parts.slab(size = vec3(w + 0.26, 0.10, 0.05), pos = vec3(0, h + 0.05, 0.025), grp = "terra")
    d = w + 0.12
    y_s = h + 0.10
    tymp = mc.arch_slab(s = d, f = d * 0.5, y0 = y_s - 0.02, y_s = y_s, n = 10, z0 = 0.0, z1 = 0.018, grp = "terra")
    hood = mc.arch_band(s = d, f = d * 0.5, y0 = y_s - 0.02, y_s = y_s, n = 12, q0 = vec3(0.0, 0.0, 0), q1 = vec3(0.065, 0.0 - 0.01, 0), q2 = vec3(0.065, 0.0 - 0.08, 0), q3 = vec3(0.0, 0.0 - 0.10, 0), grp = "terra")
    rib = parts.slab(size = vec3(0.025, d * 0.36, 0.03), pos = vec3(0, d * 0.10 + d * 0.18, 0.02), grp = "terra")
    rp0 = set_position(mesh_line(count = 7, length = 0.0), pos = vec3(0, y_s, 0))
    rp = set(rp0, "orient", orient_from_euler(vec3(0, 0, 72.0 - f32(@index) * 24.0)))
    ribs = select(detail > 0, a = realize(instance_on_points(rp, source = rib)), b = empty_mesh())
    boss = transform(parts.slab(size = vec3(0.10, 0.06, 0.035), pos = (0, 0.03, 0.02), grp = "terra"), translate = vec3(0, y_s, 0))
    sill = parts.slab(size = vec3(w + 0.22, 0.09, rev + 0.13), pos = vec3(0, 0.0 - 0.035, (0.13 - rev) * 0.5), grp = "tin")
    cb = tv.corbel(w = 0.13, d = 0.12, h = 0.16, grp = "terra", steps = 3)
    cbs = merge(transform(cb, translate = vec3(0.0 - w * 0.5 + 0.02, 0.0 - 0.24, 0)), transform(cb, translate = vec3(w * 0.5 - 0.02, 0.0 - 0.24, 0)))
    out = merge(frame, lintel, tymp, hood, ribs, boss, sill, cbs)
}

def w6(w: f32 = 0.55, h: f32 = 0.62) -> (out: geo<mesh>) {
    """W6 — окно полуподвала: проём в штукатурном цоколе без обрамления, в глубине
    тёмный щит (wood) и три прута решётки (iron)."""
    expect w > 0.3 & h > 0.3: "w6: проём от 0.3×0.3 м"
    board = parts.slab(size = vec3(w, h, 0.03), pos = vec3(0, h * 0.5, 0.0 - 0.16), grp = "wood")
    bar = parts.slab(size = vec3(0.02, h, 0.02), pos = vec3(0, h * 0.5, 0.0 - 0.07), grp = "iron")
    bars = merge(transform(bar, translate = vec3(0.0 - w * 0.25, 0, 0)), bar, transform(bar, translate = vec3(w * 0.25, 0, 0)))
    out = merge(board, bars)
}
