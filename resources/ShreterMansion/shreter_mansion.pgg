param w: f32 = 19.0
param d: f32 = 15.0
param chamfer: f32 = 2.8
param plinth_h: f32 = 1.20
param floor1_h: f32 = 3.70
param belt_h: f32 = 0.35
param floor2_h: f32 = 3.50
param crown_h: f32 = 0.65
param low_h: f32 = 1.70
param low_run: f32 = 1.40
param up_h: f32 = 0.90
param up_run: f32 = 2.60
param tower_side: f32 = 3.20
param cube_h: f32 = 3.40
param spire_h: f32 = 7.60
param gable_x_pos: f32 = 6.8
param gable_z: f32 = 2.9
param detail: int = 1
param seed: int = 42

# Особняк В. А. Шретера (наб. Мойки 114 / ул. Писарева 2, Санкт-Петербург, 1890–1891,
# арх. В. А. Шретер) — «кирпичный стиль», предвестник модерна.
# - Угловой участок: срезанный под 45° угол-эркер с башенкой и высоким шатром
#   в чешуйчатой черепице, кованой короной и флюгером;
# - Два этажа поверх штукатуренного цоколя, полихромия: жёлтый облицовочный
#   кирпич поля + терракотовый декор (лопатки, тяги, аркатурные пояса);
# - Мансардная серая кровля с двумя остроконечными щипцами, слуховыми окнами
#   и высокими кирпичными трубами;
# - Вход с Писарева: стрельчатый ордерный портал под балконом на консолях,
#   над ним большое готическое окно и щипец (модуль portal/openings).
#
# Декомпозиция: shreter_mansion/*.pgg (common, body, roof, tower, assemble).
# Именованные узлы: body_all, roof_all, tower_all, house.
import lib.parts
import shreter_mansion.body as body
import shreter_mansion.roof as roof
import shreter_mansion.tower as tower
import shreter_mansion.openings as openings
import shreter_mansion.portal as portal
import shreter_mansion.assemble as assemble

root_rng = rng_from_seed(seed)

# Сетка высот
f1_top = plinth_h + floor1_h
b1_top = f1_top + belt_h
f2_top = b1_top + floor2_h
crown_top = f2_top + crown_h
# Ось башни: угол куба tower_side лежит на плоскости среза (x+z = w/2−c + d/2)
tower_c = (w * 0.5 + d * 0.5 - chamfer - tower_side) * 0.5
gable_x = 0.0 - gable_x_pos

body_all = body.body(w = w, d = d, c = chamfer, plinth_h = plinth_h, floor1_h = floor1_h, belt_h = belt_h, floor2_h = floor2_h, crown_h = crown_h, detail = detail, rng = split_rng(root_rng, key = "body"))
roof_all = roof.roof_all(w = w, d = d, c = chamfer, crown_top = crown_top, low_h = low_h, low_run = low_run, up_h = up_h, up_run = up_run, gable_x = gable_x, gable_z = gable_z, detail = detail, rng = split_rng(root_rng, key = "roof"))
tower_all = tower.tower_all(tcx = tower_c, tcz = tower_c, s = tower_side, base_y = f2_top, cube_h = cube_h, spire_h = spire_h, detail = detail, rng = split_rng(root_rng, key = "tower"))
openings_all = openings.openings_all(w = w, d = d, c = chamfer, plinth_h = plinth_h, f1_top = f1_top, b1_top = b1_top, f2_top = f2_top, crown_top = crown_top, gable_x = gable_x, gable_z = gable_z)
f2_y = b1_top + 0.50
portal_unit = portal.portal_unit(door_w = 1.50, door_h = 2.70, y0 = 0.55, f2_y = f2_y, rng = split_rng(root_rng, key = "portal"))
portal_all = parts.place(g = portal_unit, yaw_deg = 90.0, at = vec3(w * 0.5 + 0.02, 0, gable_z))

house = assemble.assemble(body_all = body_all, roof_all = roof_all, tower_all = tower_all, openings_all = openings_all, portal_all = portal_all, root_rng = root_rng)

output house
