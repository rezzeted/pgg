# Кровля особняка: мансарда с фальцевой серой кровлей, два остроконечных щипца
# с ветровыми тягами и навершиями, слуховые окна на нижнем скате, высокие
# кирпичные трубы, полукруглые кованые балкончики мансардных окон.

import lib.parts
import lib.arch.terminals_victorian as victorian
import lib.arch.terminals_basic as tb
import lib.plan as plan
import lib.ironwork
import shreter_mansion.common as common

def chamfer_cut(g: geo<mesh>, w: f32, d: f32, c: f32) -> (out: geo<mesh>) {
    """Срез угла (+X,+Z) плоскостью 45° — кровля уступает место угловой башне."""
    out = clip(g, origin = vec3(w * 0.5, 0, d * 0.5 - c), normal = vec3(0.0 - 1.0, 0, 0.0 - 1.0))
}

def mansard(w: f32, d: f32, y0: f32, low_h: f32, low_run: f32, up_h: f32, up_run: f32) -> (out: geo<mesh>) {
    """Мансардная кровля w×d от y0: нижний крутой скат (low_h/low_run),
    верхний пологий (up_h/up_run), плоская палуба сверху."""
    low = common.hip_band(w0 = w + 0.6, d0 = d + 0.6, w1 = w + 0.6 - low_run * 2.0, d1 = d + 0.6 - low_run * 2.0, y0 = y0, y1 = y0 + low_h, grp = "roof")
    w1 = w + 0.6 - low_run * 2.0
    d1 = d + 0.6 - low_run * 2.0
    up = common.hip_band(w0 = w1, d0 = d1, w1 = w1 - up_run * 2.0, d1 = d1 - up_run * 2.0, y0 = y0 + low_h, y1 = y0 + low_h + up_h, grp = "roof")
    deck = parts.slab(size = vec3(w1 - up_run * 2.0 + 0.2, 0.10, d1 - up_run * 2.0 + 0.2), pos = vec3(0, y0 + low_h + up_h + 0.05, 0), grp = "roof")
    out = merge(low, up, deck)
}

def gable_prism(w: f32, y0: f32, t: f32) -> (out: geo<mesh>) {
    """Остроконечный щипец (стена-треугольник): ширина w, низ на y0, толщина t.
    Поле — кирпич, ветровые тяги и ступенчатые зубцы по скатам — терракота."""
    rise = w * 0.72 + 0.30
    body_raw = parts.slab(size = vec3(w, rise, t), pos = vec3(0, y0 + rise * 0.5, 0), grp = "brick")
    body = victorian.pointed_clip(g = body_raw, w = w, h = rise, y0 = y0)
    # Ветровые тяги по скатам: от пружин (±w/2, y0+0.30) к вершине (0, y0+rise)
    sl = length(vec3(w * 0.5, w * 0.72, 0))
    ang = degrees(atan2(w * 0.72, w * 0.5))
    bar0 = parts.slab(size = vec3(sl + 0.10, 0.16, 0.10), pos = vec3(0, 0, 0), grp = "deco")
    bar_l = transform(bar0, rotate = vec3(0, 0, ang), translate = vec3(0.0 - w * 0.25, y0 + w * 0.36 + 0.30, t * 0.5))
    bar_r = transform(bar0, rotate = vec3(0, 0, 180.0 - ang), translate = vec3(w * 0.25, y0 + w * 0.36 + 0.30, t * 0.5))
    bars = merge(bar_l, bar_r, transform(bar_l, translate = vec3(0, 0, 0.0 - t)), transform(bar_r, translate = vec3(0, 0, 0.0 - t)))
    # Ступенчатые зубцы под ветровыми тягами (оба ската, обе стороны)
    n_st = 6
    tooth0 = parts.slab(size = vec3(0.30, 0.14, 0.14), pos = vec3(0, 0, 0), grp = "deco")
    teeth_lr = repeat (tooth0, iterations = n_st) |acc| {
        k = f32(@iteration)
        tx = (k + 0.5) * (w * 0.5 / f32(n_st))
        ty = y0 + 0.30 + tx * 1.44 - 0.10
        left = transform(tooth0, rotate = vec3(0, 0, ang), translate = vec3(0.0 - w * 0.5 + tx, ty, t * 0.5 + 0.02))
        right = transform(tooth0, rotate = vec3(0, 0, 0.0 - ang), translate = vec3(w * 0.5 - tx, ty, t * 0.5 + 0.02))
        acc = merge(acc, left, right)
    }
    teeth = merge(teeth_lr, transform(teeth_lr, translate = vec3(0, 0, 0.0 - t - 0.04)))
    # Навершие: шар и шпиц
    ball = mark(transform(ico_sphere(subdiv = 1, radius = 0.11), translate = vec3(0, y0 + rise + 0.10, 0)), "iron", where = true, domain = faces)
    spike = ironwork.spool(p0 = vec3(0, y0 + rise + 0.16, 0), p1 = vec3(0, y0 + rise + 0.85, 0), r0 = 0.05, r1 = 0.005, sides = 8)
    out = merge(body, bars, teeth, ball, spike)
}

def attic_balcony(r: f32) -> (out: geo<mesh>) {
    """Полукруглый балкончик мансардного окна: полудиск-площадка (вынос в +Z),
    кованая дуга ограждения, консоль по центру. Низ на y = 0."""
    plate = plan.arc_shell(cx = 0.0, cz = 0.0, r_in = 0.03, r_out = r, a0 = 0.0 - 90.0, a1 = 90.0, y0 = 0.0, y1 = 0.12, grp = "deco", n = 18)
    rail = tb.rail_arc(r = r - 0.03, a0 = 0.0 - 88.0, a1 = 88.0, h = 0.85)
    corb = transform(victorian.corbel(w = 0.30, d = r * 0.8, h = 0.5, grp = "deco", steps = 3), translate = vec3(0, 0.0 - 0.5, r * 0.15))
    out = merge(plate, rail, corb)
}

def dormer(w: f32, h: f32, dep: f32) -> (out: geo<mesh>) {
    """Слуховое окно на скате: коробка (лицо +Z, низ y = 0), стрельчатое окошко,
    свой четырёхскатный козырёк. Тело — roof, рамка — deco."""
    body = parts.slab(size = vec3(w, h, dep), pos = vec3(0, h * 0.5, 0), grp = "roof")
    cap = common.hip_band(w0 = w + 0.24, d0 = dep + 0.24, w1 = 0.06, d1 = dep * 0.4, y0 = h, y1 = h + w * 0.42, grp = "roof")
    frame = transform(victorian.pointed_panel(w = w * 0.5 + 0.24, h = h * 0.62 + 0.14, t = 0.10, grp = "deco"), translate = vec3(0, h * 0.11, dep * 0.5 - 0.02))
    glass = transform(victorian.pointed_panel(w = w * 0.5, h = h * 0.62, t = 0.05, grp = "glass"), translate = vec3(0, h * 0.16, dep * 0.5 + 0.04))
    out = merge(body, cap, frame, glass)
}

def chimney(w: f32, d: f32, h: f32) -> (out: geo<mesh>) {
    """Высокая труба из красного кирпича (deco): ствол, два напускных пояса, крышка."""
    shaft = parts.slab(size = vec3(w, h, d), pos = vec3(0, h * 0.5, 0), grp = "deco")
    b1 = parts.slab(size = vec3(w + 0.18, 0.16, d + 0.18), pos = vec3(0, h - 0.62, 0), grp = "deco")
    b2 = parts.slab(size = vec3(w + 0.30, 0.16, d + 0.30), pos = vec3(0, h - 0.34, 0), grp = "deco")
    cap = parts.slab(size = vec3(w + 0.42, 0.12, d + 0.42), pos = vec3(0, h - 0.06, 0), grp = "deco")
    out = merge(shaft, b1, b2, cap)
}

def roof_all(w: f32, d: f32, c: f32, crown_top: f32, low_h: f32, low_run: f32, up_h: f32, up_run: f32, gable_x: f32, gable_z: f32, detail: int, rng: rng) -> (out: geo<mesh>) {
    """Вся кровля: мансарда (со срезом под угловую башню), два щипца,
    слуховые окна на фасадах, три трубы, два балкончика мансарды."""
    hw = w * 0.5
    hd = d * 0.5
    man = mansard(w = w, d = d, y0 = crown_top, low_h = low_h, low_run = low_run, up_h = up_h, up_run = up_run)
    man_c = chamfer_cut(g = man, w = w + 0.6, d = d + 0.6, c = c + 1.15)
    # Щипцы: на фасаде +Z (ось gable_x) и на фасаде +X (ось gable_z)
    g1 = transform(gable_prism(w = 4.9, y0 = crown_top - 0.65, t = 0.70), translate = vec3(gable_x, 0, hd))
    g2 = transform(transform(gable_prism(w = 4.6, y0 = crown_top - 0.65, t = 0.70), rotate = vec3(0, 90, 0)), translate = vec3(hw, 0, gable_z))
    # Слуховые окна на нижнем скате: два на +Z, одно на +X (detail)
    d_y = crown_top + 0.55
    d_off = hd + 0.30 - low_run * (d_y - crown_top + 0.5) / low_h + 0.34
    dor1 = transform(dormer(w = 0.95, h = 1.30, dep = 0.85), translate = vec3(1.8, d_y, d_off))
    dor2 = transform(dormer(w = 0.95, h = 1.30, dep = 0.85), translate = vec3(0.0 - 3.1, d_y, d_off))
    dor3 = transform(transform(dormer(w = 0.95, h = 1.30, dep = 0.85), rotate = vec3(0, 90, 0)), translate = vec3(hw + 0.30 - low_run * (d_y - crown_top + 0.5) / low_h + 0.34, d_y, 0.0 - 2.2))
    dorms = select(detail > 0, a = merge(dor1, dor2, dor3), b = empty_mesh())
    # Трубы вдоль конька палубы
    ch_y = crown_top + low_h + up_h - 0.4
    ch1 = transform(chimney(w = 0.85, d = 0.85, h = 3.1), translate = vec3(0.0 - 2.2, ch_y, 0.3))
    ch2 = transform(chimney(w = 1.35, d = 0.85, h = 3.4), translate = vec3(3.2, ch_y, 0.0 - 0.5))
    ch3 = transform(chimney(w = 0.85, d = 0.85, h = 2.9), translate = vec3(0.0 - 6.5, ch_y, 0.0 - 1.2))
    # Балкончики мансардных окон под щипцами (площадка на отметке crown_top+0.35)
    bal1 = transform(attic_balcony(r = 0.80), translate = vec3(gable_x, crown_top + 0.35, hd + 0.25))
    bal2 = transform(transform(attic_balcony(r = 0.80), rotate = vec3(0, 90, 0)), translate = vec3(hw + 0.25, crown_top + 0.35, gable_z))
    out = merge(man_c, g1, g2, dorms, ch1, ch2, ch3, bal1, bal2)
}
