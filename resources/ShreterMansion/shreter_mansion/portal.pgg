# Парадный вход с улицы Писарева: стрельчатый ордерный портал из терракотового
# кирпича с двустворчатой филёнчатой дверью и ступенями; над ним балкон на
# трёх ступенчатых консолях с кованым ограждением (большое готическое окно
# за балконом — openings.win_gothic). Локально: стена z = 0, лицо +Z.

import lib.parts
import shreter_mansion.common as common

def door_leaf(w: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Створка двери из вертикальных филёнок (wood), низ на y = 0."""
    out = parts.plank_panel(w = w, h = h, t = 0.07, n = 4, rng = rng)
}

def portal_unit(door_w: f32, door_h: f32, y0: f32, f2_y: f32, rng: rng) -> (out: geo<mesh>) {
    """Портал + балкон целиком, низ двери на y0:
    - Три ордера стрельчатых рам терракоты и тёмная ниша;
    - Две створки под стрельчатой фрамугой;
    - Три ступени снаружи;
    - Балкон на трёх консолях с кованым ограждением на отметке f2_y."""
    # Ордерный портал
    outer = transform(common.pointed_panel(w = door_w + 0.95, h = door_h + 0.45, t = 0.24, grp = "deco"), translate = vec3(0, y0, 0.0))
    mid = transform(common.pointed_panel(w = door_w + 0.52, h = door_h + 0.20, t = 0.18, grp = "deco"), translate = vec3(0, y0 + 0.02, 0.13))
    inner = transform(common.pointed_panel(w = door_w + 0.16, h = door_h + 0.02, t = 0.13, grp = "deco"), translate = vec3(0, y0 + 0.04, 0.24))
    dark = transform(common.pointed_panel(w = door_w, h = door_h - 0.04, t = 0.05, grp = "glass"), translate = vec3(0, y0 + 0.06, 0.30))
    # Створки под фрамугой (выступают из ниши, ручки-шары)
    leaf_h = door_h - door_w * 0.72 - 0.10
    leaf0 = door_leaf(w = door_w * 0.46, h = leaf_h, rng = rng)
    l0 = transform(leaf0, translate = vec3(0.0 - door_w * 0.24, y0 + 0.06, 0.375))
    l1 = transform(leaf0, translate = vec3(door_w * 0.24, y0 + 0.06, 0.375))
    knob0 = mark(transform(ico_sphere(subdiv = 1, radius = 0.045), translate = vec3(0.0 - 0.09, y0 + 0.06 + leaf_h * 0.45, 0.43)), "iron", where = true, domain = faces)
    knob1 = mark(transform(ico_sphere(subdiv = 1, radius = 0.045), translate = vec3(0.09, y0 + 0.06 + leaf_h * 0.45, 0.43)), "iron", where = true, domain = faces)
    # Ступени (три, верх на y0)
    s0 = common.slab(size = vec3(door_w + 1.3, 0.18, 0.34), pos = vec3(0, y0 - 0.09, 0.55), grp = "deco")
    s1 = common.slab(size = vec3(door_w + 1.1, 0.18, 0.34), pos = vec3(0, y0 - 0.27, 0.72), grp = "deco")
    s2 = common.slab(size = vec3(door_w + 0.9, 0.18, 0.34), pos = vec3(0, y0 - 0.45, 0.89), grp = "deco")
    # Балкон: плита, три консоли, кованое ограждение
    b_w = door_w + 1.35
    b_d = 1.05
    slab_b = common.slab(size = vec3(b_w, 0.13, b_d), pos = vec3(0, f2_y - 0.065, b_d * 0.5 - 0.05), grp = "deco")
    corb0 = common.corbel(w = 0.34, d = 0.80, h = 0.95, grp = "deco", steps = 4)
    cb0 = transform(corb0, translate = vec3(0.0 - b_w * 0.36, f2_y - 0.13 - 0.95, 0.0))
    cb1 = transform(corb0, translate = vec3(0, f2_y - 0.13 - 0.95, 0.0))
    cb2 = transform(corb0, translate = vec3(b_w * 0.36, f2_y - 0.13 - 0.95, 0.0))
    rail_f = transform(common.rail_run(len = b_w - 0.06, h = 0.85), translate = vec3(0, f2_y, b_d - 0.10))
    side0 = transform(common.rail_run(len = b_d - 0.12, h = 0.85), rotate = vec3(0, 90, 0))
    rail_l = transform(side0, translate = vec3(0.0 - b_w * 0.5 + 0.03, f2_y, 0.40))
    rail_r = transform(side0, translate = vec3(b_w * 0.5 - 0.03, f2_y, 0.40))
    out = merge(outer, mid, inner, dark, l0, l1, knob0, knob1, s0, s1, s2, slab_b, cb0, cb1, cb2, rail_f, rail_l, rail_r)
}
