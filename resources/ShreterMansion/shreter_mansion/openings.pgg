# Проёмы особняка Шретера (накладные, лицо +Z, низ на y = 0, если не сказано):
# прямоугольные окна с сегментной перемычкой, арочные окна, стрельчатые ланцеты,
# парные арочные окна эркера под общим тимпаном, большое готическое окно над
# входом, подвальные окна, терракотовый медальон (знак Общества архитекторов).
# Прозрачности в превью нет — glass почти чёрный, переплёт — iron.

import lib.parts
import lib.arch.terminals_victorian as victorian
import lib.ironwork
import lib.fixtures
import shreter_mansion.common as common

def win_flat(w: f32, h: f32) -> (out: geo<mesh>) {
    """Прямоугольное окно с сегментной перемычкой: тёмное стекло утоплено,
    косяки и дуга-перемычка терракота, крест-переплёт iron, подоконник."""
    glass = parts.slab(size = vec3(w, h, 0.05), pos = vec3(0, h * 0.5, 0.03), grp = "glass")
    jamb_l = parts.slab(size = vec3(0.15, h, 0.11), pos = vec3(0.0 - w * 0.5 - 0.075, h * 0.5, 0.05), grp = "deco")
    jamb_r = parts.slab(size = vec3(0.15, h, 0.11), pos = vec3(w * 0.5 + 0.075, h * 0.5, 0.05), grp = "deco")
    lintel = transform(common.seg_arch(w = w + 0.30, rise = 0.24, band = 0.24, t = 0.10, grp = "deco"), translate = vec3(0, h, 0.0))
    sill = parts.slab(size = vec3(w + 0.36, 0.11, 0.24), pos = vec3(0, 0.0 - 0.055, 0.06), grp = "deco")
    mull = parts.slab(size = vec3(0.045, h - 0.06, 0.05), pos = vec3(0, h * 0.5, 0.06), grp = "iron")
    trans = parts.slab(size = vec3(w - 0.04, 0.045, 0.05), pos = vec3(0, h * 0.68, 0.06), grp = "iron")
    out = merge(glass, jamb_l, jamb_r, lintel, sill, mull, trans)
}

def win_arch(w: f32, h: f32) -> (out: geo<mesh>) {
    """Полуциркульное арочное окно: стекло-арка утоплено, полукольцо и косяки
    терракота, замковый камень, средник и импост iron, подоконник."""
    r = w * 0.5
    straight = h - r
    glass = transform(common.seg_disc(w = w, rise = r, t = 0.05, grp = "glass"), translate = vec3(0, straight, 0.0))
    glass_b = parts.slab(size = vec3(w, straight, 0.05), pos = vec3(0, straight * 0.5, 0.025), grp = "glass")
    jamb_l = parts.slab(size = vec3(0.15, straight, 0.11), pos = vec3(0.0 - r - 0.075, straight * 0.5, 0.05), grp = "deco")
    jamb_r = parts.slab(size = vec3(0.15, straight, 0.11), pos = vec3(r + 0.075, straight * 0.5, 0.05), grp = "deco")
    ring = transform(common.seg_arch(w = w + 0.30, rise = (w + 0.30) * 0.5, band = 0.17, t = 0.10, grp = "deco"), translate = vec3(0, straight, 0.0))
    key = parts.slab(size = vec3(0.16, 0.34, 0.14), pos = vec3(0, h + 0.12, 0.06), grp = "deco")
    sill = parts.slab(size = vec3(w + 0.36, 0.11, 0.24), pos = vec3(0, 0.0 - 0.055, 0.06), grp = "deco")
    mull = parts.slab(size = vec3(0.045, h - 0.06, 0.05), pos = vec3(0, h * 0.48, 0.055), grp = "iron")
    trans = parts.slab(size = vec3(w - 0.04, 0.045, 0.05), pos = vec3(0, straight * 0.72, 0.055), grp = "iron")
    out = merge(glass, glass_b, jamb_l, jamb_r, ring, key, sill, mull, trans)
}

def win_lancet(w: f32, h: f32) -> (out: geo<mesh>) {
    """Стрельчатое окно-ланцет: терракотовая рама, тёмная ниша, средник iron."""
    frame = victorian.pointed_panel(w = w + 0.32, h = h + 0.14, t = 0.13, grp = "deco")
    infill = transform(victorian.pointed_panel(w = w, h = h, t = 0.05, grp = "glass"), translate = vec3(0, 0.04, 0.09))
    straight = h - w * 0.72
    mull = parts.slab(size = vec3(0.045, straight * 0.9, 0.05), pos = vec3(0, straight * 0.48, 0.115), grp = "iron")
    sill = parts.slab(size = vec3(w + 0.46, 0.11, 0.26), pos = vec3(0, 0.0 - 0.055, 0.06), grp = "deco")
    out = merge(frame, infill, mull, sill)
}

def win_pair(w: f32, h: f32) -> (out: geo<mesh>) {
    """Парное арочное окно эркера под общим тимпаном: два узких арочных окна,
    колонна посередине, сплошной полудиск-тимпан и наружное полукольцо терракоты.
    w — ширина одного окна; низ на y = 0, ось симметрии x = 0."""
    gap = 0.30
    span = w + gap
    total = w * 2.0 + gap
    win0 = win_arch(w = w, h = h)
    wl = transform(win0, translate = vec3(0.0 - span * 0.5, 0, 0))
    wr = transform(win0, translate = vec3(span * 0.5, 0, 0))
    col = ironwork.spool(p0 = vec3(0, 0, 0.02), p1 = vec3(0, h - w * 0.5, 0.02), r0 = 0.075, r1 = 0.065, sides = 10)
    col_d = parts.to_group(g = col, src = "iron", dst = "deco")
    straight = h - w * 0.5
    tymp = transform(common.seg_disc(w = total + 0.20, rise = (total + 0.20) * 0.5, t = 0.05, grp = "deco"), translate = vec3(0, straight + 0.10, 0.0))
    ring = transform(common.seg_arch(w = total + 0.40, rise = (total + 0.40) * 0.5, band = 0.20, t = 0.10, grp = "deco"), translate = vec3(0, straight + 0.10, 0.0))
    sill = parts.slab(size = vec3(total + 0.50, 0.12, 0.28), pos = vec3(0, 0.0 - 0.06, 0.06), grp = "deco")
    out = merge(wl, wr, col_d, tymp, ring, sill)
}

def win_gothic(w: f32, h: f32) -> (out: geo<mesh>) {
    """Большое готическое окно над входом: широкая стрельчатая рама терракоты,
    два средника и импост iron, подоконник."""
    frame = victorian.pointed_panel(w = w + 0.40, h = h + 0.18, t = 0.15, grp = "deco")
    infill = transform(victorian.pointed_panel(w = w, h = h, t = 0.05, grp = "glass"), translate = vec3(0, 0.05, 0.10))
    straight = h - w * 0.72
    mull_l = parts.slab(size = vec3(0.05, straight * 0.92, 0.05), pos = vec3(0.0 - w * 0.25, straight * 0.48, 0.12), grp = "iron")
    mull_r = parts.slab(size = vec3(0.05, straight * 0.92, 0.05), pos = vec3(w * 0.25, straight * 0.48, 0.12), grp = "iron")
    trans = parts.slab(size = vec3(w - 0.04, 0.05, 0.05), pos = vec3(0, straight * 0.62, 0.12), grp = "iron")
    sill = parts.slab(size = vec3(w + 0.56, 0.12, 0.30), pos = vec3(0, 0.0 - 0.06, 0.06), grp = "deco")
    out = merge(frame, infill, mull_l, mull_r, trans, sill)
}

def win_basement(w: f32, h: f32) -> (out: geo<mesh>) {
    """Подвальное окошко в цоколе: простая тяга-рамка и тёмное стекло."""
    frame = parts.slab(size = vec3(w + 0.20, h + 0.20, 0.08), pos = vec3(0, h * 0.5, 0.02), grp = "deco")
    glass = parts.slab(size = vec3(w, h, 0.05), pos = vec3(0, h * 0.5, 0.06), grp = "glass")
    out = merge(frame, glass)
}

def plaque(s: f32) -> (out: geo<mesh>) {
    """Терракотовый медальон-знак (треугольник с циркулем — стилизовано):
    квадратная плита, кольцо, треугольник из трёх тяг. Центр в origin, лицо +Z."""
    plate = parts.slab(size = vec3(s, s, 0.08), pos = vec3(0, 0, 0), grp = "deco")
    ring = parts.to_group(g = fixtures.ring(center = vec3(0, 0, 0.05), radius = s * 0.30, r = 0.045, yaw_deg = 0.0), src = "iron", dst = "deco")
    t = s * 0.05
    h_tri = s * 0.56
    a_l = transform(parts.slab(size = vec3(t, h_tri, t), pos = vec3(0, 0, 0.05), grp = "deco"), rotate = vec3(0, 0, 26.0), translate = vec3(0.0 - h_tri * 0.22, 0.02, 0))
    a_r = transform(parts.slab(size = vec3(t, h_tri, t), pos = vec3(0, 0, 0.05), grp = "deco"), rotate = vec3(0, 0, 0.0 - 26.0), translate = vec3(h_tri * 0.22, 0.02, 0))
    base = parts.slab(size = vec3(s * 0.52, t, t), pos = vec3(0, 0.0 - h_tri * 0.26, 0.05), grp = "deco")
    out = merge(plate, ring, a_l, a_r, base)
}

def place_row(n: int, xs0: f32, step: f32, y: f32, fixed: f32, yaw: f32, w: f32, h: f32, along_z: int) -> (out: geo<mesh>) {
    """n прямоугольных окон win_flat вдоль оси: s0 + k·step; along_z = 0 — ряд вдоль
    X (фиксирован z = fixed), 1 — вдоль Z (фиксирован x = fixed)."""
    a0 = along_z == 1 ? vec3(fixed, y, xs0) : vec3(xs0, y, fixed)
    u0 = parts.place(g = win_flat(w = w, h = h), yaw_deg = yaw, at = a0)
    out = repeat (u0, iterations = n - 1) |acc| {
        s = xs0 + (f32(@iteration) + 1.0) * step
        ak = along_z == 1 ? vec3(fixed, y, s) : vec3(s, y, fixed)
        acc = merge(acc, parts.place(g = win_flat(w = w, h = h), yaw_deg = yaw, at = ak))
    }
}

def place_row_basement(n: int, xs0: f32, step: f32, y: f32, fixed: f32, yaw: f32, w: f32, h: f32, along_z: int) -> (out: geo<mesh>) {
    """n подвальных окошек win_basement вдоль оси: s0 + k·step (как place_row)."""
    a0 = along_z == 1 ? vec3(fixed, y, xs0) : vec3(xs0, y, fixed)
    u0 = parts.place(g = win_basement(w = w, h = h), yaw_deg = yaw, at = a0)
    out = repeat (u0, iterations = n - 1) |acc| {
        s = xs0 + (f32(@iteration) + 1.0) * step
        ak = along_z == 1 ? vec3(fixed, y, s) : vec3(s, y, fixed)
        acc = merge(acc, parts.place(g = win_basement(w = w, h = h), yaw_deg = yaw, at = ak))
    }
}

def place_win(kind: int, w: f32, h: f32, at: vec3, yaw: f32) -> (out: geo<mesh>) {
    """Поставить окно: kind 0 = flat, 1 = arch, 2 = lancet, 3 = basement. yaw 0 = +Z."""
    g0 = win_flat(w = w, h = h)
    g1 = win_arch(w = w, h = h)
    g2 = win_lancet(w = w, h = h)
    g3 = win_basement(w = w, h = h)
    g = select(kind == 3, a = g3, b = select(kind == 2, a = g2, b = select(kind == 1, a = g1, b = g0)))
    out = parts.place(g = g, yaw_deg = yaw, at = at)
}

def openings_all(w: f32, d: f32, c: f32, plinth_h: f32, f1_top: f32, b1_top: f32, f2_top: f32, crown_top: f32, gable_x: f32, gable_z: f32) -> (out: geo<mesh>) {
    """Все проёмы по фасадам: 6 осей на +Z (Мойка), 3 оси + вход на +X (Писарева),
    парные окна эркера, тыловые стены, подвал, мансардные окна щипцов, медальон."""
    hw = w * 0.5
    hd = d * 0.5
    proud = 0.05
    f1_y = plinth_h + 0.55
    f2_y = b1_top + 0.50
    win_w = 1.05
    # +Z фасад (Мойка): оси −8.0 −5.58 −3.16 −0.74 1.68 4.10; под щипцом высокое арочное
    fz1 = place_row(n = 6, xs0 = 0.0 - 8.0, step = 2.42, y = f1_y, fixed = hd + proud, yaw = 0.0, w = win_w, h = 2.35, along_z = 0)
    fz2a = place_row(n = 4, xs0 = 0.0 - 3.16, step = 2.42, y = f2_y, fixed = hd + proud, yaw = 0.0, w = win_w, h = 2.20, along_z = 0)
    fz2b = place_win(kind = 1, w = 1.30, h = 2.60, at = vec3(gable_x, f2_y - 0.05, hd + proud), yaw = 0.0)
    # +X фасад (Писарева): 3 оси окон + большое готическое окно над входом
    fx1 = place_row(n = 3, xs0 = 0.2, step = 0.0 - 2.45, y = f1_y, fixed = hw + proud, yaw = 90.0, w = win_w, h = 2.35, along_z = 1)
    fx2 = place_row(n = 3, xs0 = 0.2, step = 0.0 - 2.45, y = f2_y, fixed = hw + proud, yaw = 90.0, w = win_w, h = 2.20, along_z = 1)
    goth = place_win(kind = 2, w = 1.55, h = 2.65, at = vec3(hw + proud, f2_y - 0.05, gable_z), yaw = 90.0)
    # Эркер: парные окна под тимпанами на обоих этажах (диагональная грань, yaw 45)
    bay1 = parts.place(g = win_pair(w = 0.62, h = 2.10), yaw_deg = 45.0, at = vec3(hw - c * 0.5, f1_y + 0.05, hd - c * 0.5))
    bay2 = parts.place(g = win_pair(w = 0.62, h = 2.00), yaw_deg = 45.0, at = vec3(hw - c * 0.5, f2_y, hd - c * 0.5))
    # Тыловые стены: редкие прямоугольные окна
    bk1 = place_row(n = 4, xs0 = 0.0 - 6.0, step = 4.0, y = f1_y, fixed = 0.0 - hd - proud, yaw = 180.0, w = win_w, h = 2.35, along_z = 0)
    bk2 = place_row(n = 4, xs0 = 0.0 - 6.0, step = 4.0, y = f2_y, fixed = 0.0 - hd - proud, yaw = 180.0, w = win_w, h = 2.20, along_z = 0)
    lf1 = place_row(n = 3, xs0 = 0.0 - 4.0, step = 4.0, y = f1_y, fixed = 0.0 - hw - proud, yaw = 270.0, w = win_w, h = 2.35, along_z = 1)
    lf2 = place_row(n = 3, xs0 = 0.0 - 4.0, step = 4.0, y = f2_y, fixed = 0.0 - hw - proud, yaw = 270.0, w = win_w, h = 2.20, along_z = 1)
    # Подвал: маленькие окошки по обоим фасадам (цоколь выступает на 0.10)
    bs1 = place_row_basement(n = 6, xs0 = 0.0 - 8.0, step = 2.42, y = 0.38, fixed = hd + 0.12, yaw = 0.0, w = 0.55, h = 0.50, along_z = 0)
    bs2 = place_row_basement(n = 3, xs0 = 0.2, step = 0.0 - 2.45, y = 0.38, fixed = hw + 0.12, yaw = 90.0, w = 0.55, h = 0.50, along_z = 1)
    # Мансардные арочные окна в щипцах
    at1 = place_win(kind = 1, w = 1.15, h = 1.75, at = vec3(gable_x, crown_top + 0.42, hd + 0.36), yaw = 0.0)
    at2 = place_win(kind = 1, w = 1.15, h = 1.75, at = vec3(hw + 0.36, crown_top + 0.42, gable_z), yaw = 90.0)
    # Медальон-знак между этажами на фасаде Мойки
    med = parts.place(g = plaque(s = 0.72), yaw_deg = 0.0, at = vec3(0.0 - 8.0, b1_top + 0.85, hd + proud))
    out = merge(fz1, fz2a, fz2b, fx1, fx2, goth, bay1, bay2, bk1, bk2, lf1, lf2, bs1, bs2, at1, at2, med)
}
