# Угловая башенка особняка: кирпичный куб над карнизом с лопатками и аркатурным
# поясом, тёмная юбка-карниз, высокий шатёр в чешуйчатой черепице со слуховым
# окном и кованой короной с пиками и флюгером.

import lib.parts
import lib.ironwork
import lib.roofing
import lib.shapes as shapes
import lib.layout.edges as lse
import lib.arch.kinds as ak
import lib.arch.plan as ap
import lib.arch.elements as ae
import lib.arch.terminals_basic as tb
import shreter_mansion.common as common
import shreter_mansion.roof as roof

def scale_spire(s: f32, top_s: f32, h: f32, y0: f32, detail: int, rng: rng) -> (out: geo<mesh>) {
    """Квадратный шатёр в чешуе: сплошное ядро (hip_band) + четыре грани честной
    черепицы tile_face_tri (перемечена roof→spire, tint запечён вариацией) +
    черепичные коньки-рёбра по четырём углам."""
    run = (s - top_s) * 0.5
    body = common.hip_band(w0 = s, d0 = s, w1 = top_s, d1 = top_s, y0 = y0, y1 = y0 + h, grp = "spire")
    slope_len = sqrt(h * h + run * run) + 0.14
    pitch = degrees(atan2(h, run))
    face0 = lib_roof_face(s = s, top_s = top_s, slope_len = slope_len, rng = rng)
    face_on = transform(transform(face0, rotate = vec3(pitch, 0, 0)), translate = vec3(0, y0, s * 0.5))
    tiles = shapes.polar_array(g = face_on, n = 4, step_deg = 90)
    tiles_sp = parts.to_group(g = tiles, src = "roof", dst = "spire")
    # Коньки по рёбрам: от угла основания к углу вершины
    p0 = vec3(s * 0.5, y0, s * 0.5)
    v1 = vec3(top_s * 0.5, y0 + h, top_s * 0.5)
    d_rib = v1 - p0
    p1 = v1 + d_rib * (0.20 / length(d_rib))
    rib0 = roofing.hip_caps(p0 = p0, p1 = p1, rng = split_rng(rng, key = "hip"), half = 40.0, lift = 0.10, cap_w = 0.24, cap_l = 0.34, y_step = 0.006)
    ribs = shapes.polar_array(g = rib0, n = 4, step_deg = 90)
    ribs_sp = parts.to_group(g = ribs, src = "roof", dst = "spire")
    det = select(detail > 0, a = merge(tiles_sp, ribs_sp), b = empty_mesh())
    out = merge(body, det)
}

def lib_roof_face(s: f32, top_s: f32, slope_len: f32, rng: rng) -> (out: geo<mesh>) {
    """Одна грань чешуи шатра — обёртка roofing.tile_face_tri (ширины s → top_s)."""
    out = roofing.tile_face_tri(r0 = s, r1 = top_s, slope_len = slope_len, rng = rng, apex_clip = 0.02)
}

def crown(top_s: f32, y0: f32) -> (out: geo<mesh>) {
    """Кованая корона на вершине шатра: площадка, ограждение по четырём сторонам,
    четыре угловых пики-копья и центральный флюгер-стрела с крестовиной.
    Ограда — терминал rail_run (terminals_basic) на рёбрах R_RAIL периметра
    площадки; пролёты на 0.02 длиннее стороны ребра с каждого конца (стык внахлёст)."""
    plat = parts.slab(size = vec3(top_s + 0.30, 0.10, top_s + 0.30), pos = vec3(0, y0 + 0.05, 0), grp = "iron")
    e = (top_s + 0.30) * 0.5
    rplan = set_position(ap.plan_rect(w = 2.0 * (e - 0.02), d = 2.0 * (e - 0.02)), offset = vec3(0, y0 + 0.10, 0))
    redges = lse.edges_of_polygon(plan = rplan, role = ak.R_RAIL())
    rails = foreach re in redges {
        re = lse.place_edge(g = transform(tb.rail_run(len = lse.edge_len(re) + 0.04, h = 0.52, pitch = 0.30, rail_s = 0.045, bot_y = 0.10, gap = 0.10, bevel = false), translate = vec3(0, 0, 0.0 - 0.02)), e = re)
    }
    sp0 = ironwork.spearhead(base = vec3(0, 0, 0), h = 0.95, w = 0.16)
    sp1 = transform(sp0, translate = vec3(e - 0.03, y0 + 0.10, e - 0.03))
    sp2 = transform(sp0, translate = vec3(0.0 - e + 0.03, y0 + 0.10, e - 0.03))
    sp3 = transform(sp0, translate = vec3(e - 0.03, y0 + 0.10, 0.0 - e + 0.03))
    sp4 = transform(sp0, translate = vec3(0.0 - e + 0.03, y0 + 0.10, 0.0 - e + 0.03))
    vane = ironwork.spool(p0 = vec3(0, y0 + 0.10, 0), p1 = vec3(0, y0 + 1.55, 0), r0 = 0.045, r1 = 0.008, sides = 8)
    cross_a = parts.slab(size = vec3(0.52, 0.035, 0.035), pos = vec3(0, y0 + 1.10, 0), grp = "iron")
    cross_b = parts.slab(size = vec3(0.36, 0.035, 0.035), pos = vec3(0, y0 + 1.34, 0), grp = "iron")
    ball = mark(transform(ico_sphere(subdiv = 1, radius = 0.07), translate = vec3(0, y0 + 0.72, 0)), "iron", where = true, domain = faces)
    out = merge(plat, rails, sp1, sp2, sp3, sp4, vane, cross_a, cross_b, ball)
}

def tower_all(tcx: f32, tcz: f32, s: f32, base_y: f32, cube_h: f32, spire_h: f32, detail: int, rng: rng) -> (out: geo<mesh>) {
    """Башня целиком на отметке base_y: куб с лопатками и аркатурой, юбка,
    чешуйчатый шатёр со слуховым окном, кованая корона."""
    hs = s * 0.5
    top_y = base_y + cube_h
    # Куб: кирпичное тело, терракотовые лопатки по углам, аркатурный пояс, карниз
    cube = parts.slab(size = vec3(s, cube_h, s), pos = vec3(0, base_y + cube_h * 0.5, 0), grp = "brick")
    pil0 = parts.slab(size = vec3(0.40, cube_h, 0.40), pos = vec3(hs, base_y + cube_h * 0.5, hs), grp = "deco")
    pils = shapes.polar_array(g = pil0, n = 4, step_deg = 90)
    frz0 = common.arcade_row(len = s - 0.3, y = 0.0, pitch = 0.44, grp = "deco")
    frz_f = transform(frz0, translate = vec3(0, top_y - 0.42, hs + 0.03))
    frz_all = shapes.polar_array(g = frz_f, n = 4, step_deg = 90)
    frz = select(detail > 0, a = frz_all, b = empty_mesh())
    eav = ae.belt_edges(edges = lse.edges_of_polygon(plan = set_position(ap.plan_rect(w = s, d = s), offset = vec3(0, top_y, 0)), role = ak.R_FLOOR_TOP()), h = 0.26, grp = "deco", over_lo = 0.10, over_hi = 0.20, split = 0.55, bevel = false)
    cube_all = merge(cube, pils, frz, eav)
    # Юбка: тонкий тёмный карниз на стыке куба и шатра
    skirt = common.hip_band(w0 = s + 0.52, d0 = s + 0.52, w1 = s + 0.16, d1 = s + 0.16, y0 = top_y + 0.26, y1 = top_y + 0.52, grp = "iron")
    # Шатёр с чешуёй
    sp = scale_spire(s = s, top_s = 0.55, h = spire_h, y0 = top_y, detail = detail, rng = split_rng(rng, key = "spire"))
    # Слуховое окно на грани +Z (вертикальное, врезано в скат над юбкой)
    lu_y = top_y + 0.75
    run = (s - 0.55) * 0.5
    lu_a = hs - run * (lu_y + 0.5 - top_y) / spire_h
    luc = transform(roof.dormer(w = 0.70, h = 1.05, dep = 0.70), translate = vec3(0, lu_y, lu_a - 0.30))
    # Кованая корона на вершине
    crn = crown(top_s = 0.55, y0 = top_y + spire_h - 0.06)
    tower_local = merge(cube_all, skirt, sp, luc, crn)
    out = transform(tower_local, translate = vec3(tcx, 0, tcz))
}
