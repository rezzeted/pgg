# Общий словарь особняка Шретера: четырёхскатные призмы, сегментные арки,
# кирпичная облицовка, кованые ограждения. Плиты — parts.slab, стрельчатые
# силуэты и консоли — lib.arch.terminals_victorian.
# Лицо деталей +Z, низ на y = 0, если не сказано иначе.

import lib.parts
import lib.blockwork
import lib.fixtures
import lib.ironwork
import lib.shapes as shapes
import lib.plan as plan



def hip_band(w0: f32, d0: f32, w1: f32, d1: f32, y0: f32, y1: f32, grp: string) -> (out: geo<mesh>) {
    """Четырёхскатная призма: концентрическое сечение w0×d0 на y0 → w1×d1 на y1
    (w1 ≤ w0, d1 ≤ d0). Клип бокса четырьмя плоскостями — мансарда, шатёр, юбка."""
    expect w0 >= w1 & d0 >= d1: "hip_band: верх шире низа"
    h = y1 - y0
    run_w = (w0 - w1) * 0.5
    run_d = (d0 - d1) * 0.5
    body = parts.slab(size = vec3(w0, h, d0), pos = vec3(0, (y0 + y1) * 0.5, 0), grp = grp)
    c1 = select(run_d > 0.001, a = clip(body, origin = vec3(0, y1, d1 * 0.5), normal = vec3(0, 0.0 - run_d, 0.0 - h)), b = body)
    c2 = select(run_d > 0.001, a = clip(c1, origin = vec3(0, y1, 0.0 - d1 * 0.5), normal = vec3(0, 0.0 - run_d, h)), b = c1)
    c3 = select(run_w > 0.001, a = clip(c2, origin = vec3(w1 * 0.5, y1, 0), normal = vec3(0.0 - run_w, 0.0 - h, 0)), b = c2)
    out = select(run_w > 0.001, a = clip(c3, origin = vec3(0.0 - w1 * 0.5, y1, 0), normal = vec3(run_w, 0.0 - h, 0)), b = c3)
}

def brick_prism(w: f32, d: f32, h: f32, y0: f32) -> (out: geo<mesh>) {
    """Прямой объём w×d высотой h, низ на y0 — сердцевина стены (mortar)."""
    out = blockwork.core_prism(w = w, d = d, h = h, y0 = y0, grp = "mortar")
}

def brick_rows(len: f32, h: f32) -> (out: geo<points>) {
    """Якоря мелкой кирпичной кладки — обёртка blockwork.brick_veneer_rows."""
    out = blockwork.brick_veneer_rows(len = len, h = h, L = 0.17, ch = 0.12, g0 = 0.008, z = 0.03)
}

def brick_from_rows(rows: geo<points>, rng: rng) -> (out: geo<mesh>) {
    """Мелкие кирпичи по якорям brick_rows — обёртка blockwork.brick_veneer."""
    out = blockwork.brick_veneer(rows = rows, rng = rng, L = 0.17, bh = 0.104, t = 0.046, k = 0.14, grp = "brick")
}

def belt(w: f32, d: f32, y: f32, h: f32, grp: string, over_lo: f32 = 0.16, over_hi: f32 = 0.24) -> (out: geo<mesh>) {
    """Двухступенчатый поясной карниз по периметру w×d, низ на y: нижняя ступень
    уже и толще, верхняя шире и тоньше. Вынос каждой ступени от стены на сторону."""
    lo = parts.slab(size = vec3(w + over_lo * 2.0, h * 0.55, d + over_lo * 2.0), pos = vec3(0, y + h * 0.275, 0), grp = grp)
    hi = parts.slab(size = vec3(w + over_hi * 2.0, h * 0.45, d + over_hi * 2.0), pos = vec3(0, y + h * 0.775, 0), grp = grp)
    out = merge(lo, hi)
}

def seg_arch(w: f32, rise: f32, band: f32, t: f32, grp: string) -> (out: geo<mesh>) {
    """Сегментная арочная перемычка (трубчатая полоса по дуге): ширина по хорде w,
    стрелка rise до верха полосы, толщина полосы band (лицо +Z). Низ пяты на y = 0,
    центр x = 0. При rise = w/2 даёт полукруглую арку. Торус + два клипа по пятам."""
    expect rise > 0.02 & rise <= w * 0.5 + 0.01 & band < rise * 2.0: "seg_arch: стрелка/полоса вне диапазона"
    h_c = rise - band * 0.5
    Rc = ((w * 0.5) * (w * 0.5) + h_c * h_c) / (2.0 * h_c)
    half_a = degrees(asin(w * 0.5 / Rc))
    yc = h_c - Rc
    ring0 = fixtures.ring(center = vec3(0, yc, 0), radius = Rc, r = band * 0.5, yaw_deg = 0.0)
    c1 = clip(ring0, origin = vec3(0, yc, 0), normal = vec3(0.0 - cos(radians(half_a)), sin(radians(half_a)), 0))
    c2 = clip(c1, origin = vec3(0, yc, 0), normal = vec3(cos(radians(half_a)), sin(radians(half_a)), 0))
    banded = parts.to_group(g = c2, src = "iron", dst = grp)
    y_spring = yc + (Rc - band * 0.5) * cos(radians(half_a))
    out = transform(banded, translate = vec3(0, 0.0 - y_spring, band * 0.5))
}

def seg_disc(w: f32, rise: f32, t: f32, grp: string) -> (out: geo<mesh>) {
    """Сплошной сегментный диск (тимпан): хорда w, стрелка rise, толщина t
    (лицо +Z), низ пяты на y = 0. Диск spool + те же клипы, что seg_arch."""
    expect rise > 0.02 & rise <= w * 0.5 + 0.01: "seg_disc: стрелка вне диапазона"
    Rc = ((w * 0.5) * (w * 0.5) + rise * rise) / (2.0 * rise)
    half_a = degrees(asin(w * 0.5 / Rc))
    yc = rise - Rc
    disc0 = ironwork.spool(p0 = vec3(0, yc, 0.0 - t * 0.5), p1 = vec3(0, yc, t * 0.5), r0 = Rc, r1 = Rc, sides = 24)
    c1 = clip(disc0, origin = vec3(0, yc, 0), normal = vec3(0.0 - cos(radians(half_a)), sin(radians(half_a)), 0))
    c2 = clip(c1, origin = vec3(0, yc, 0), normal = vec3(cos(radians(half_a)), sin(radians(half_a)), 0))
    banded = parts.to_group(g = c2, src = "iron", dst = grp)
    y_spring = yc + Rc * cos(radians(half_a))
    out = transform(banded, translate = vec3(0, 0.0 - y_spring, t * 0.5))
}




def rail_run(len: f32, h: f32) -> (out: geo<mesh>) {
    """Кованое ограждение длины len вдоль X: два пояска и частые пики."""
    top_r = parts.slab(size = vec3(len, 0.045, 0.045), pos = vec3(0, h, 0), grp = "iron")
    bot_r = parts.slab(size = vec3(len, 0.04, 0.04), pos = vec3(0, 0.10, 0), grp = "iron")
    n_p = max(int(len / 0.30), 2)
    pts = transform(mesh_line(count = n_p, length = f32(n_p - 1) * 0.30, dir = (1, 0, 0)), translate = vec3(0.0 - f32(n_p - 1) * 0.30 * 0.5, 0, 0))
    picket = parts.slab(size = vec3(0.025, h - 0.10, 0.025), pos = vec3(0, (h + 0.10) * 0.5, 0), grp = "iron")
    pickets = realize(instance_on_points(pts, source = picket))
    out = merge(top_r, bot_r, pickets)
}

def rail_arc(r: f32, a0: f32, a1: f32, h: f32) -> (out: geo<mesh>) {
    """Кованое ограждение по дуге (план, центр в 0): два кольцевых пояска и пики.
    Углы — градусы от направления +Z в сторону +X (дуга балкона: −88..88)."""
    top_r = plan.arc_shell(cx = 0.0, cz = 0.0, r_in = r - 0.022, r_out = r + 0.022, a0 = a0, a1 = a1, y0 = h - 0.022, y1 = h + 0.022, grp = "iron", n = 24)
    bot_r = plan.arc_shell(cx = 0.0, cz = 0.0, r_in = r - 0.020, r_out = r + 0.020, a0 = a0, a1 = a1, y0 = 0.08, y1 = 0.12, grp = "iron", n = 24)
    n_p = max(int((a1 - a0) / 14.0), 3)
    pts = set_position(mesh_line(count = n_p, length = 0.0), pos = vec3(r * sin(radians(a0 + (a1 - a0) * f32(@index) / f32(n_p - 1))), 0.0, r * cos(radians(a0 + (a1 - a0) * f32(@index) / f32(n_p - 1)))))
    picket = parts.slab(size = vec3(0.025, h - 0.10, 0.025), pos = vec3(0, (h + 0.10) * 0.5, 0), grp = "iron")
    pickets = realize(instance_on_points(pts, source = picket))
    out = merge(top_r, bot_r, pickets)
}

def arcade_row(len: f32, y: f32, pitch: f32, grp: string) -> (out: geo<mesh>) {
    """Аркатурный пояс вдоль X: ряд мелких полуциркульных арочек, низ на y."""
    n = max(int(len / pitch), 2)
    step = len / f32(n)
    pts = transform(mesh_line(count = n, length = len - step, dir = (1, 0, 0)), translate = vec3(0.0 - (len - step) * 0.5, y, 0))
    archlet = seg_arch(w = step * 0.72, rise = step * 0.30, band = step * 0.20, t = 0.07, grp = grp)
    body = parts.slab(size = vec3(step * 0.72, step * 0.34, 0.07), pos = vec3(0, step * 0.17, 0.035), grp = grp)
    piece_one = merge(archlet, body)
    out = realize(instance_on_points(pts, source = piece_one))
}
