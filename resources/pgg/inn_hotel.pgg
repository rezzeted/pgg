param body_w: f32 = 8.00
param body_d: f32 = 7.40
param corner_r: f32 = 3.25
param walk_h: f32 = 0.26
param base_h: f32 = 0.34
param floor_g: f32 = 3.55
param floor_u: f32 = 2.70
param band_h: f32 = 0.34
param n_upper: int = 3
param corn_h: f32 = 1.10
param seed: int = 7

# Угловой отель «INN» в стиле streamline moderne со стимпанк-надстройкой.
# Референс — ночная изометрия углового дома: круглый эркер, кирпичные фланги,
# витрина под стеклянным козырьком, неоновая вывеска и медная установка на кровле.
#
# - Подошва квартала: каменная терраса, бордюр, булыжная мостовая, тёплая
# предвходовая площадка веером и гнутые ступени у входа;
# - Первый этаж: светлый цокольный поясок, деревянный подзор, гнутая витрина с
# тёплым светом и силуэтами холла, входная дверь у правого конца дуги,
# стеклянный козырёк на тягах, настенные фонари и меню-борды;
# - Жилая часть: кирпичный корпус, штукатурная облицовка круглого эркера,
# межэтажные пояски-«скоростные линии» и светлые угловые лопатки;
# - Окна: гнутая лента эркера сегментами по дуге и по одному окну на фланг,
# все на единых отметках подоконников по этажам;
# - Венчание: профилированный карниз с круглым углом, плитчатая палуба и
# кованое ограждение по её краю (дуга + четыре прямых пролёта);
# - Кровля: медный аламбик, три трубы с гуськами, два манометра, машинный кожух;
# - Вывеска: неоновая «лопасть» INN на кронштейнах на фасаде +X.
#
# Ключевой приём — «план как профиль вертикального sweep» (inn_hotel/common.pgg):
# круглый угол честно огибают и корпус, и все пояски, и карниз, и терраса.
# Круглый угол смотрит в (+X, +Z) — ракурс референса: orbit = [45, 30].
#
# Именованные узлы-компоненты доступны для изолированного рендера и инспекции:
# street, ground, upper, wins, top, plant_all, sign_all, hotel.
import inn_hotel.base as base
import inn_hotel.storefront as storefront
import inn_hotel.shell as shell
import inn_hotel.windows as windows
import inn_hotel.roof as roof
import inn_hotel.plant as plant
import inn_hotel.sign as sign
import inn_hotel.assemble as assemble

root_rng = rng_from_seed(seed)

# --- координатная сетка высот ---
walk_top = walk_h
base_top = walk_top + base_h
g_top = base_top + floor_g
upper_h = f32(n_upper) * (floor_u + band_h)
corn_y = g_top + upper_h
deck_y = corn_y + corn_h * 0.62
# Углы на дуге: ось двери и угол, с которого начинается остеклённая витрина.
door_a = 9.0
glz_a0 = 26.0

# Отметки межэтажных поясков: верх первого этажа плюс шаг (этаж + поясок).
band_ys = transform(mesh_line(count = n_upper, length = f32(n_upper - 1) * (floor_u + band_h), dir = (0, 1, 0)), translate = vec3(0, g_top, 0))

# --- изолированные компоненты ---
street = base.street_base(bw = body_w, bd = body_d, cr = corner_r, walk_top = walk_top, base_top = base_top, door_a = door_a, rng = split_rng(root_rng, key = "street"))
ground = storefront.ground_floor(bw = body_w, bd = body_d, cr = corner_r, walk_top = walk_top, base_top = base_top, g_top = g_top, door_a = door_a, glz_a0 = glz_a0, rng = split_rng(root_rng, key = "ground"))
upper = shell.upper_shell(bw = body_w, bd = body_d, cr = corner_r, y0 = g_top, y1 = corn_y, band_ys = band_ys, band_h = band_h, rng = split_rng(root_rng, key = "shell"))
wins = windows.all_floors(bw = body_w, bd = body_d, cr = corner_r, g_top = g_top, floor_u = floor_u, band_h = band_h, n = n_upper, rng = split_rng(root_rng, key = "wins"))
top = roof.roof_top(bw = body_w, bd = body_d, cr = corner_r, corn_y = corn_y, corn_h = corn_h, rng = split_rng(root_rng, key = "roof"))
plant_all = plant.rooftop_plant(bw = body_w, bd = body_d, cr = corner_r, deck_y = deck_y)
sign_all = sign.inn_sign(bw = body_w, bd = body_d, y_top = corn_y - 1.30, rng = split_rng(root_rng, key = "sign"))

# --- полная сборка с окраской и запеканием AO ---
hotel = assemble.assemble(street = street, ground = ground, upper = upper, wins = wins, top = top, plant = plant_all, sign = sign_all, root_rng = root_rng)

output hotel
