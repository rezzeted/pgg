# Розетка ленточных листьев (драцена / юкка / осока): лист — это путь-жилка ×
# открытый профиль × ширина по длине; розетка — foreach по якорям с per-рядными
# параметрами (длина, наклон, скрутка). Показывает v1.23: bezier_points,
# sweep с profile_closed = false, @profile_scale/@twist на пути, @uv листа,
# grid с res = (a, b), выражения над @Cd/@uv (типизация по имени).

param leaves: int = 14
param leaf_len: f32 = 1.0
param seed: int = 7

def strap_leaf(len: f32, droop: f32, twist: f32, rng: rng) -> (out: geo<mesh>) {
    """Один лист: средняя жилка — кубический Безье от корня вверх и наружу (droop —
    насколько кончик уходит вниз), профиль — открытая дуга-желобок из 5 точек,
    ширина сужается к кончику (`@profile_scale`), кончик подкручен (`@twist`)."""
    expect len > 0.0
    rib0 = bezier_points(p0 = (0, 0, 0), p1 = vec3(0, len * 0.55, len * 0.15), p2 = vec3(0, len * 0.75, len * 0.6), p3 = vec3(0, len * (0.85 - droop), len * 0.95), count = 14)
    width = (0.16 + 0.10 * value(random(0.0, 1.0, rng = rng), on = mesh_line(count = 1, length = 0.0))) * len
    rib1 = set(rib0, "profile_scale", vec2(width * (0.35 + 0.65 * sin(@t * 3.14159)) * (1.0 - pow(@t, 3.0)), 1.0), domain = points)
    rib = set(rib1, "twist", twist * @t * @t, domain = points)
    prof0 = mesh_line(count = 5, length = 1.0, dir = (1, 0, 0))
    prof = set_position(prof0, pos = vec3(dot(@P, (1, 0, 0)) - 0.5, 0.12 * pow(2.0 * dot(@P, (1, 0, 0)) - 1.0, 2.0), 0))
    sheet = sweep(rib, prof, profile_closed = false)
    base_col = mix(vec3(0.13, 0.36, 0.10), vec3(0.55, 0.72, 0.22), pow(dot(@uv, (0, 1)), 1.5))
    edge = 1.0 - 0.25 * abs(dot(@uv, (1, 0)) - 0.5) * 2.0
    out = set(sheet, "Cd", base_col * edge, domain = points)
    ensure count(out) > 0
}

# Якоря розетки: два кольца, внутреннее — короче и круче.
ring_o = transform(circle(sides = leaves, radius = 0.05), rotate = (90, 0, 0))
ring_i = transform(circle(sides = leaves - 5, radius = 0.025), rotate = (90, 12, 0))
rng_o = rng_from_seed(seed)
rng_i = rng_from_seed(seed + 1)
outer = foreach a in ring_o {
    yaw = degrees(atan2(dot(value(@P, on = a), (1, 0, 0)), dot(value(@P, on = a), (0, 0, 1))))
    r = split_rng(rng_o, @piece_index)
    u = value(random(0.0, 1.0, rng = r), on = a)
    v = value(random(0.0, 1.0, rng = split_rng(r, 1)), on = a)
    w = value(random(-1.0, 1.0, rng = split_rng(r, 2)), on = a)
    leaf = strap_leaf(len = leaf_len * (0.85 + 0.3 * u), droop = 0.15 + 0.3 * v, twist = 60.0 * w, rng = split_rng(r, 3))
    a = transform(leaf, rotate = vec3(0, yaw, 0))
}
inner = foreach b in ring_i {
    yaw_i = degrees(atan2(dot(value(@P, on = b), (1, 0, 0)), dot(value(@P, on = b), (0, 0, 1))))
    ri = split_rng(rng_i, @piece_index)
    wi = value(random(-1.0, 1.0, rng = split_rng(ri, 2)), on = b)
    leaf_i = strap_leaf(len = leaf_len * 0.55, droop = 0.05, twist = 30.0 * wi, rng = split_rng(ri, 3))
    b = transform(leaf_i, rotate = vec3(0, yaw_i, 0))
}

# Грунт: тонкая анизотропная сетка, чуть волнистая.
soil0 = grid(size = (1.2, 1.2), res = (12, 12))
soil1 = set_position(soil0, offset = vec3(0, 0.02 * fbm(scale = 4.0, rng = rng_from_seed(1)) - 0.01, 0))
soil = set(soil1, "Cd", vec3(0.25, 0.18, 0.12) * (0.8 + 0.4 * dot(@uv, (1, 1)) * 0.5), domain = points)

plant = compute_normals(merge(outer, inner, soil), mode = smooth)
output plant
