# Парадное крыльцо: каменная площадка, лестница из 5 ступеней, массивные
# парапеты с тумбами и латунными шарами, защитный козырёк на консолях и настенный фонарь.
import lib.parts
import lib.fixtures

def entrance_porch(door_x: f32, facade_z: f32, plinth_h: f32) -> (out: geo<mesh>) {
    """Парадное крыльцо в викторианском стиле:
    - Каменная площадка крыльца (landing) шириной 1.65 м на высоте цоколя plinth_h;
    - 5 ступеней от уровня площадки к уровню земли y = 0;
    - Боковые каменные парапеты с опорными тумбами и декоративными латунными шарами;
    - Портиковый навес-козырёк на резных каменных консолях со сланцевой мини-крышей;
    - Кованый настенный фонарь слева от портала с тёплым светом (группа lamp)."""
    pw = 1.65
    landing_d = 0.65
    dw = 1.05
    dh = 2.35
    # 1. Площадка крыльца
    p_base = parts.piece(size = vec3(pw, plinth_h - 0.08, landing_d), pos = vec3(door_x, (plinth_h - 0.08) * 0.5, facade_z + landing_d * 0.5), grp = "plinth")
    p_cap = parts.piece(size = vec3(pw + 0.08, 0.10, landing_d + 0.06), pos = vec3(door_x, plinth_h - 0.05, facade_z + landing_d * 0.5 + 0.01), grp = "stone")
    # 2. Ступени (5 ступеней от plinth_h до y = 0)
    st0 = parts.piece(size = vec3(pw, 0.18, 0.28), pos = vec3(door_x, 0.81, facade_z + 0.65 + 0.14), grp = "stone")
    st1 = parts.piece(size = vec3(pw, 0.18, 0.28), pos = vec3(door_x, 0.63, facade_z + 0.65 + 0.38), grp = "stone")
    st2 = parts.piece(size = vec3(pw, 0.18, 0.28), pos = vec3(door_x, 0.45, facade_z + 0.65 + 0.62), grp = "stone")
    st3 = parts.piece(size = vec3(pw, 0.18, 0.28), pos = vec3(door_x, 0.27, facade_z + 0.65 + 0.86), grp = "stone")
    st4 = parts.piece(size = vec3(pw, 0.18, 0.28), pos = vec3(door_x, 0.09, facade_z + 0.65 + 1.10), grp = "stone")
    steps = merge(st0, st1, st2, st3, st4)
    # 3. Боковые парапеты крыльца
    lx = door_x - pw * 0.5 - 0.07
    rx = door_x + pw * 0.5 + 0.07
    par_land_l = parts.piece(size = vec3(0.15, 0.75, 0.70), pos = vec3(lx, plinth_h + 0.30, facade_z + 0.35), grp = "stone")
    par_land_r = parts.piece(size = vec3(0.15, 0.75, 0.70), pos = vec3(rx, plinth_h + 0.30, facade_z + 0.35), grp = "stone")
    par_mid_l = parts.piece(size = vec3(0.15, 0.70, 0.60), pos = vec3(lx, 0.80, facade_z + 0.95), grp = "stone")
    par_mid_r = parts.piece(size = vec3(0.15, 0.70, 0.60), pos = vec3(rx, 0.80, facade_z + 0.95), grp = "stone")
    par_low_l = parts.piece(size = vec3(0.15, 0.60, 0.65), pos = vec3(lx, 0.45, facade_z + 1.50), grp = "stone")
    par_low_r = parts.piece(size = vec3(0.15, 0.60, 0.65), pos = vec3(rx, 0.45, facade_z + 1.50), grp = "stone")
    post_l = parts.piece(size = vec3(0.22, 0.72, 0.22), pos = vec3(lx, 0.36, facade_z + 1.80), grp = "stone")
    post_r = parts.piece(size = vec3(0.22, 0.72, 0.22), pos = vec3(rx, 0.36, facade_z + 1.80), grp = "stone")
    ball_l = mark(transform(ico_sphere(subdiv = 1, radius = 0.08), translate = vec3(lx, 0.80, facade_z + 1.80)), "brass", where = true, domain = faces)
    ball_r = mark(transform(ico_sphere(subdiv = 1, radius = 0.08), translate = vec3(rx, 0.80, facade_z + 1.80)), "brass", where = true, domain = faces)
    parapets = merge(par_land_l, par_land_r, par_mid_l, par_mid_r, par_low_l, par_low_r, post_l, post_r, ball_l, ball_r)
    # 4. Козырёк на консолях над дверью
    can_y = plinth_h + dh + 0.05
    con_l = parts.piece(size = vec3(0.14, 0.42, 0.38), pos = vec3(door_x - dw * 0.5 - 0.06, can_y - 0.21, facade_z + 0.19), grp = "stone")
    con_r = parts.piece(size = vec3(0.14, 0.42, 0.38), pos = vec3(door_x + dw * 0.5 + 0.06, can_y - 0.21, facade_z + 0.19), grp = "stone")
    slab = parts.piece(size = vec3(dw + 0.60, 0.14, 0.55), pos = vec3(door_x, can_y + 0.07, facade_z + 0.27), grp = "stone")
    rooflet = parts.piece(size = vec3(dw + 0.54, 0.16, 0.48), pos = vec3(door_x, can_y + 0.22, facade_z + 0.25), grp = "roof")
    canopy = merge(con_l, con_r, slab, rooflet)
    # 5. Кованый фонарь на стене слева от двери
    lamp = fixtures.lantern(at = vec3(door_x - dw * 0.5 - 0.42, plinth_h + 1.85, facade_z))
    out = merge(p_base, p_cap, steps, parapets, canopy, lamp)
}
