# Оконные блоки викторианского дома: параметрическое арочное окно в каменном
# обрамлении (наличник, замковый камень, подоконник, рама, остекление) и координатная
# раскладка по фасадам здания с едиными высотными отметками подоконников.
import lib.parts
import lib.architecture

def stone_arch_window(w: f32, h: f32) -> (out: geo<mesh>) {
    """Арочное окно в каменном обрамлении: наличник с замковым камнем, подоконная плита
    (sill), утопленная рама со стеклом. Низ в 0, центр по X в 0."""
    frame = transform(architecture.arch_frame(w = w, h = h, bar = 0.11, depth = 0.16, grp = "stone"), translate = vec3(0, 0, 0.08))
    sill = parts.piece(size = vec3(w + 0.18, 0.12, 0.22), pos = vec3(0, 0.06, 0.11), grp = "stone")
    keystone = parts.piece(size = vec3(0.18, 0.24, 0.20), pos = vec3(0, h + 0.05, 0.10), grp = "stone")
    glass_h = h - 0.08
    r = (w - 0.22) * 0.5
    straight = max(glass_h - r - 0.11, 0.1)
    sash_b = parts.piece(size = vec3(w - 0.18, straight, 0.04), pos = vec3(0, 0.11 + straight * 0.5, 0.02), grp = "wood")
    gl_b = parts.piece(size = vec3(w - 0.26, straight - 0.08, 0.02), pos = vec3(0, 0.11 + straight * 0.5, 0.035), grp = "glass")
    arch_pan = transform(architecture.arch_panel(w = w - 0.18, h = glass_h, t = 0.04, grp = "glass"), translate = vec3(0, 0, 0.015))
    bar_v = parts.piece(size = vec3(0.04, glass_h - 0.1, 0.05), pos = vec3(0, 0.11 + (glass_h - 0.1) * 0.5, 0.03), grp = "wood")
    bar_h = parts.piece(size = vec3(w - 0.20, 0.04, 0.05), pos = vec3(0, 0.11 + straight, 0.03), grp = "wood")
    out = merge(frame, sill, keystone, sash_b, gl_b, arch_pan, bar_v, bar_h)
}

def wall_windows(width: f32, depth: f32, facade_z: f32, f1_y: f32, f2_y: f32, wing_x: f32) -> (out: geo<mesh>) {
    """Координатная раскладка всех стеновых окон здания:
    - 2-й этаж фасада (+Z): два симметричных окна на x = ±wing_x (середина простенка);
    - 1-й этаж фасада (+Z): левое окно на x = -wing_x (справа расположен парадный вход);
    - Боковые стены (+X и -X): по два окна на этаж на z = ±wing_z, тот же отступ
      от квойнов, что на фронте (от угла до оси = width/2 − wing_x);
    - Задний фасад (-Z): симметричные окна на x = ±wing_x (по 2 на этаж)."""
    win_main = stone_arch_window(w = 0.72, h = 2.15)
    wz = facade_z + 0.05
    # Тот же отступ оси от угла (и от квойнов), что у фронтальных окон.
    wing_z = depth * 0.5 - (width * 0.5 - wing_x)
    # Фасад (+Z)
    front_f2 = merge(transform(win_main, translate = vec3(0.0 - wing_x, f2_y, wz)), transform(win_main, translate = vec3(wing_x, f2_y, wz)))
    front_f1 = transform(win_main, translate = vec3(0.0 - wing_x, f1_y, wz))
    # Боковые стены (+X и -X)
    side_pos = merge(transform(win_main, translate = vec3(0.0 - wing_z, f1_y, 0)), transform(win_main, translate = vec3(wing_z, f1_y, 0)), transform(win_main, translate = vec3(0.0 - wing_z, f2_y, 0)), transform(win_main, translate = vec3(wing_z, f2_y, 0)))
    side_r = transform(transform(side_pos, rotate = vec3(0, 90, 0)), translate = vec3(width * 0.5 + 0.05, 0, 0))
    side_l = transform(transform(side_pos, rotate = vec3(0, 270, 0)), translate = vec3(0.0 - width * 0.5 - 0.05, 0, 0))
    # Задний фасад (-Z)
    back_pos = merge(transform(win_main, translate = vec3(0.0 - wing_x, f1_y, 0)), transform(win_main, translate = vec3(wing_x, f1_y, 0)), transform(win_main, translate = vec3(0.0 - wing_x, f2_y, 0)), transform(win_main, translate = vec3(wing_x, f2_y, 0)))
    back_w = transform(transform(back_pos, rotate = vec3(0, 180, 0)), translate = vec3(0, 0, 0.0 - facade_z - 0.05))
    out = merge(front_f2, front_f1, side_r, side_l, back_w)
}
