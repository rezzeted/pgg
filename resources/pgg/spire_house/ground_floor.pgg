# Первый этаж здания: гранитный цоколь с профилированной плитой,
# прямые кирпичные стены первого этажа, рустованные угловые квойны и межэтажный карниз.
import lib.parts
import lib.blockwork
import spire_house.common as common

def ground_floor(width: f32, depth: f32, plinth_h: f32, floor1_h: f32, belt_h: f32, wing_x: f32, door_x: f32, rng: rng) -> (out: geo<mesh>) {
    """Первый этаж здания:
    - Гранитный массивный цоколь с каменной крышкой-отливом;
    - Кирпичные стены 1-го этажа (сердцевина + мелкая кладка вразбежку);
    - Угловые рустованные квойны первого этажа;
    - Межэтажный профилированный поясной карниз (belt)."""
    p_base = parts.piece(size = vec3(width + 0.24, plinth_h - 0.08, depth + 0.24), pos = vec3(0, (plinth_h - 0.08) * 0.5, 0), grp = "plinth")
    p_cap = parts.piece(size = vec3(width + 0.38, 0.14, depth + 0.38), pos = vec3(0, plinth_h - 0.07, 0), grp = "plinth")
    f1_top = plinth_h + floor1_h
    wall_1 = common.brick_prism(w = width, d = depth, h = floor1_h, y0 = plinth_h)
    wing_z = depth * 0.5 - (width * 0.5 - wing_x)
    bricks_1 = common.brick_box_veneer(w = width, d = depth, h = floor1_h, y0 = plinth_h, wing_x = wing_x, wing_z = wing_z, door_x = door_x, has_door = 1, rng = split_rng(rng, key = "bricks"))
    n_rows_1 = 7
    course_h_1 = floor1_h / f32(n_rows_1)
    quoins_1 = transform(blockwork.quoin_stack(w = width, d = depth, n_rows = n_rows_1, course_h = course_h_1, bricks = 1.5), translate = vec3(0, plinth_h, 0))
    belt1 = transform(common.belt(w = width, d = depth, h = belt_h), translate = vec3(0, f1_top, 0))
    out = merge(p_base, p_cap, wall_1, bricks_1, quoins_1, belt1)
}
