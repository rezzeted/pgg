# Общие вспомогательные элементы и геометрические примитивы для spire_house:
# карнизы, дентикулы, ступенчатый корбель, восьмигранные тела, люкарны шпиля и решётки.
import lib.parts
import lib.blockwork
import lib.shapes as shapes
import lib.masonry as masonry

def to_group(g: geo<mesh>, src: string, dst: string) -> (out: geo<mesh>) {
    """Переметить грани из группы src в dst (ingroup-маска, затем снять src)."""
    out = unmark(mark(g, dst, where = ingroup(src), domain = faces), src)
}

def brick_prism(w: f32, d: f32, h: f32, y0: f32) -> (out: geo<mesh>) {
    """Прямой объём w×d высотой h, низ на y0 — обёртка blockwork.core_prism."""
    out = blockwork.core_prism(w = w, d = d, h = h, y0 = y0, grp = "mortar")
}

def brick_rows(len: f32, h: f32) -> (out: geo<points>) {
    """Якоря мелкой кирпичной кладки — обёртка blockwork.brick_veneer_rows."""
    out = blockwork.brick_veneer_rows(len = len, h = h, L = 0.17, ch = 0.12, g0 = 0.008, z = 0.03)
}

def brick_from_rows(rows: geo<points>, rng: rng) -> (out: geo<mesh>) {
    """Мелкие кирпичи по якорям brick_rows — обёртка blockwork.brick_veneer."""
    out = blockwork.brick_veneer(rows = rows, rng = rng, L = 0.17, bh = 0.104, t = 0.046, k = 0.14, grp = "brick")
}

def clip_wedge_out(g: geo<mesh>, cx: f32, cy: f32, R: f32, deg0: f32, deg1: f32) -> (out: geo<mesh>) {
    """Сектор снаружи окружности — обёртка masonry.clip_wedge_out."""
    out = masonry.clip_wedge_out(g = g, cx = cx, cy = cy, R = R, deg0 = deg0, deg1 = deg1)
}

def clip_arch_hole(g: geo<mesh>, cx: f32, y_bot: f32, win_w: f32, win_h: f32, bar: f32, gap: f32) -> (out: geo<mesh>) {
    """Арочный проём в кладке — обёртка masonry.clip_arch_hole (12 сегментов)."""
    out = masonry.clip_arch_hole(g = g, cx = cx, y_bot = y_bot, win_w = win_w, win_h = win_h, bar = bar, gap = gap, segments = 12)
}

def clip_circle_hole(g: geo<mesh>, cx: f32, cy: f32, R: f32) -> (out: geo<mesh>) {
    """Круглый вырез в кладке — обёртка masonry.clip_circle_hole (12 сегментов)."""
    out = masonry.clip_circle_hole(g = g, cx = cx, cy = cy, R = R, segments = 12)
}

def brick_box_veneer(w: f32, d: f32, h: f32, y0: f32, wing_x: f32, wing_z: f32, door_x: f32, has_door: int, rng: rng) -> (out: geo<mesh>) {
    """Облицовка четырёх стен дома мелким кирпичом между квойнами (inset 0.74
    как у cottage, bricks=1.5). Сплошная кладка, проёмы — clip_arch_hole по
    силуэту stone_arch_window / arch_frame (зазор 3 см). has_door=1 — на
    фасаде справа дверь вместо окна."""
    inset = 0.74
    span_f = w - 2.0 * inset
    span_s = d - 2.0 * inset
    win_w = 0.72
    win_h = 2.15
    win_bar = 0.11
    win_y = 0.35
    gap = 0.03
    door_w = 1.05
    door_h = 2.35
    door_bar = 0.14
    rf0 = brick_rows(len = span_f, h = h)
    rs0 = brick_rows(len = span_s, h = h)
    raw_f = brick_from_rows(rf0, rng = split_rng(rng, key = "f"))
    p_f0 = clip_arch_hole(raw_f, cx = 0.0 - wing_x, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    cx2 = has_door == 1 ? door_x : wing_x
    y2 = has_door == 1 ? 0.0 : win_y
    w2 = has_door == 1 ? door_w : win_w
    h2 = has_door == 1 ? door_h : win_h
    bar2 = has_door == 1 ? door_bar : win_bar
    p_f = clip_arch_hole(p_f0, cx = cx2, y_bot = y2, win_w = w2, win_h = h2, bar = bar2, gap = gap)
    raw_b = brick_from_rows(rf0, rng = split_rng(rng, key = "b"))
    p_b0 = clip_arch_hole(raw_b, cx = 0.0 - wing_x, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    p_b = clip_arch_hole(p_b0, cx = wing_x, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    raw_r = brick_from_rows(rs0, rng = split_rng(rng, key = "r"))
    p_r0 = clip_arch_hole(raw_r, cx = wing_z, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    p_r = clip_arch_hole(p_r0, cx = 0.0 - wing_z, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    raw_l = brick_from_rows(rs0, rng = split_rng(rng, key = "l"))
    p_l0 = clip_arch_hole(raw_l, cx = wing_z, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    p_l = clip_arch_hole(p_l0, cx = 0.0 - wing_z, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    wall_f = transform(p_f, translate = vec3(0, y0, d * 0.5))
    wall_b = transform(transform(p_b, rotate = vec3(0, 180, 0)), translate = vec3(0, y0, 0.0 - d * 0.5))
    wall_r = transform(transform(p_r, rotate = vec3(0, 90, 0)), translate = vec3(w * 0.5, y0, 0))
    wall_l = transform(transform(p_l, rotate = vec3(0, 270, 0)), translate = vec3(0.0 - w * 0.5, y0, 0))
    out = merge(wall_f, wall_b, wall_r, wall_l)
}

def hexa_brick_face(h: f32, r_in: f32, y_bot: f32, win_w: f32, win_h: f32, rng: rng, clock: bool = false, circ_r: f32 = 0.52, cy: f32 = 0.0) -> (out: geo<mesh>) {
    """Кладка одной грани шестигранника (лицо +Z, низ y=0): пролёт circumradius − 0.16
    (отступ от колоннетт). clock=false — clip_arch_hole по окну; clock=true —
    clip_circle_hole под циферблат (select пропускает невзятую ветку)."""
    r_out = shapes.ngon_circumradius(r_in, 6)
    span = r_out - 0.16
    rows = brick_rows(len = span, h = h)
    raw = brick_from_rows(rows, rng = rng)
    arch = clip_arch_hole(raw, cx = 0.0, y_bot = y_bot, win_w = win_w, win_h = win_h, bar = 0.11, gap = 0.03)
    disc = clip_circle_hole(raw, cx = 0.0, cy = cy, R = circ_r + 0.03)
    punched = select(clock, disc, arch)
    out = transform(punched, translate = vec3(0, 0, r_in))
}

def hexa_brick_clock_face(h: f32, r_in: f32, cy: f32, circ_r: f32, rng: rng) -> (out: geo<mesh>) {
    """Кладка грани с круглым вырезом под циферблат — select(clock) в hexa_brick_face."""
    out = hexa_brick_face(h = h, r_in = r_in, y_bot = 0.0, win_w = 0.55, win_h = 2.15, rng = rng, clock = true, circ_r = circ_r, cy = cy)
}

def belt(w: f32, d: f32, h: f32, over_lo: f32 = 0.22, over_hi: f32 = 0.30) -> (out: geo<mesh>) {
    """Светлый поясной карниз по периметру w×d: две ступенчатые плиты (нижняя уже
    и толще, верхняя шире и тоньше), центр в 0, низ на y = 0. over_lo / over_hi —
    вынос каждой ступени от стены на сторону (квойны quoin_stack выпускаются на
    0.20: межэтажный пояс должен чуть перекрывать их, венчающий — ещё на шаг).
    Группа stone."""
    lo = parts.piece(size = vec3(w + over_lo * 2.0, h * 0.58, d + over_lo * 2.0), pos = vec3(0, h * 0.29, 0), grp = "stone")
    hi = parts.piece(size = vec3(w + over_hi * 2.0, h * 0.42, d + over_hi * 2.0), pos = vec3(0, h * 0.79, 0), grp = "stone")
    out = merge(lo, hi)
}

def dentils(w: f32, d: f32, y: f32) -> (out: geo<mesh>) {
    """Ряд мелких сухариков (дентикулов) под венчающим карнизом по периметру w×d."""
    s = 0.18
    nx = int(w / s)
    nz = int(d / s)
    pts_fx = transform(mesh_line(count = nx, length = f32(nx - 1) * s, dir = (1, 0, 0)), translate = vec3(0.0 - f32(nx - 1) * s * 0.5, y, d * 0.5 + 0.05))
    pts_bx = transform(mesh_line(count = nx, length = f32(nx - 1) * s, dir = (1, 0, 0)), translate = vec3(0.0 - f32(nx - 1) * s * 0.5, y, 0.0 - d * 0.5 - 0.05))
    pts_lz = transform(mesh_line(count = nz, length = f32(nz - 1) * s, dir = (0, 0, 1)), translate = vec3(0.0 - w * 0.5 - 0.05, y, 0.0 - f32(nz - 1) * s * 0.5))
    pts_rz = transform(mesh_line(count = nz, length = f32(nz - 1) * s, dir = (0, 0, 1)), translate = vec3(w * 0.5 + 0.05, y, 0.0 - f32(nz - 1) * s * 0.5))
    all_pts = merge(pts_fx, pts_bx, pts_lz, pts_rz)
    dent = mark(compute_normals(box(size = vec3(0.09, 0.08, 0.09)), mode = flat), "stone", where = true, domain = faces)
    out = realize(instance_on_points(all_pts, source = dent))
}

def corbel(w: f32, d: f32, h: f32, steps: int = 5) -> (out: geo<mesh>) {
    """Ступенчатый каменный консольный сход под эркером: n ступеней сверху вниз,
    каждая следующая уже и ближе к стене. Верх консоли на y = h, низ на y = 0."""
    st_h = h / f32(steps)
    st0_frac = 1.0
    st0_w = w * st0_frac
    st0_d = d * st0_frac
    st0_y = h - st_h * 0.5
    st0_z = d * 0.5 - (d - st0_d) * 0.5
    b0 = parts.piece(size = vec3(st0_w, st_h * 0.95, st0_d), pos = vec3(0, st0_y, st0_z), grp = "stone")
    out = repeat (b0, iterations = steps - 1) |acc| {
        k = f32(@iteration) + 1.0
        frac = 1.0 - k * (0.62 / f32(steps))
        sw = w * frac
        sd = d * frac
        sy = h - (k + 0.5) * st_h
        sz = d * 0.5 - (d - sd) * 0.5
        acc = merge(acc, parts.piece(size = vec3(sw, st_h * 0.95, sd), pos = vec3(0, sy, sz), grp = "stone"))
    }
}

def octa_frustum(y0: f32, y1: f32, r0: f32, r1: f32, grp: string) -> (out: geo<mesh>) {
    """Правильная восьмигранная усечённая пирамида: r0/r1 — апофемы."""
    out = shapes.ngon_frustum(y0 = y0, y1 = y1, r0 = r0, r1 = r1, sides = 8, grp = grp)
}

def hexa_frustum(y0: f32, y1: f32, r0: f32, r1: f32, grp: string) -> (out: geo<mesh>) {
    """Правильная шестигранная усечённая призма/пирамида (грань на +Z). r0/r1 — апофемы."""
    out = shapes.ngon_frustum(y0 = y0, y1 = y1, r0 = r0, r1 = r1, sides = 6, grp = grp)
}

def hexa_corbel(y_top: f32, h: f32, r_top: f32, steps: int = 3) -> (out: geo<mesh>) {
    """Ступенчатый каменный консольный сход под шестигранным эркером:
    наклонные шестигранные усечённые пирамиды (frustums) с каменными полочками-выступами."""
    st_h = h / 3.0
    # Верхняя ступень (наиболее широкая, наклон граней внутрь)
    s0 = hexa_frustum(y0 = y_top - st_h, y1 = y_top, r0 = r_top * 0.82, r1 = r_top * 1.04, grp = "stone")
    # Средняя ступень
    s1 = hexa_frustum(y0 = y_top - st_h * 2.0, y1 = y_top - st_h, r0 = r_top * 0.54, r1 = r_top * 0.85, grp = "stone")
    # Нижняя ступень
    s2 = hexa_frustum(y0 = y_top - h, y1 = y_top - st_h * 2.0, r0 = r_top * 0.28, r1 = r_top * 0.57, grp = "stone")
    # Каплевидный наконечник-финиал
    y_bot = y_top - h
    drop_cone = hexa_frustum(y0 = y_bot - 0.24, y1 = y_bot, r0 = 0.05, r1 = r_top * 0.30, grp = "stone")
    drop_ball = mark(compute_normals(transform(ico_sphere(subdiv = 1, radius = 0.07), translate = vec3(0, y_bot - 0.28, 0)), mode = auto), "stone", where = true, domain = faces)
    out = merge(s0, s1, s2, drop_cone, drop_ball)
}

def hexa_belt(y: f32, h: f32, r: f32, over_lo: f32 = 0.22, over_hi: f32 = 0.30) -> (out: geo<mesh>) {
    """Шестигранный двухступенчатый карниз. r — апофема грани корпуса; over_* —
    вынос от грани на сторону (по нормали)."""
    out = shapes.ngon_belt(y = y, h = h, r = r, sides = 6, over_lo = over_lo, over_hi = over_hi)
}

def hexa_crown(y: f32, h: f32, r: f32) -> (out: geo<mesh>) {
    """Шестигранный венчающий профилированный карниз из 3 ступеней. r — апофема;
    выносы 0.05/0.07/… заданы в описанном радиусе и переводятся через cos(π/6)."""
    k = 0.86602540378
    s1 = hexa_frustum(y0 = y, y1 = y + h * 0.35, r0 = r + 0.05 * k, r1 = r + 0.07 * k, grp = "stone")
    s2 = hexa_frustum(y0 = y + h * 0.35, y1 = y + h * 0.70, r0 = r + 0.12 * k, r1 = r + 0.14 * k, grp = "stone")
    s3 = hexa_frustum(y0 = y + h * 0.70, y1 = y + h, r0 = r + 0.20 * k, r1 = r + 0.20 * k, grp = "stone")
    out = merge(s1, s2, s3)
}

def hexa_dentils(y: f32, r_in: f32) -> (out: geo<mesh>) {
    """Ряд сухариков (дентикулов) под венчающим карнизом шестигранной башни."""
    d0 = parts.piece(size = vec3(0.08, 0.07, 0.08), pos = vec3(0.0 - 0.36, y, r_in + 0.03), grp = "stone")
    d1 = parts.piece(size = vec3(0.08, 0.07, 0.08), pos = vec3(0.0 - 0.12, y, r_in + 0.03), grp = "stone")
    d2 = parts.piece(size = vec3(0.08, 0.07, 0.08), pos = vec3(0.12, y, r_in + 0.03), grp = "stone")
    d3 = parts.piece(size = vec3(0.08, 0.07, 0.08), pos = vec3(0.36, y, r_in + 0.03), grp = "stone")
    face_d = merge(d0, d1, d2, d3)
    out = merge(face_d, transform(face_d, rotate = vec3(0, 60, 0)), transform(face_d, rotate = vec3(0, 120, 0)), transform(face_d, rotate = vec3(0, 180, 0)), transform(face_d, rotate = vec3(0, 240, 0)), transform(face_d, rotate = vec3(0, 300, 0)))
}

def rail_run(len: f32, h: f32) -> (out: geo<mesh>) {
    """Кованое ограждение террасы/палубы заданной длины."""
    top_r = parts.piece(size = vec3(len, 0.04, 0.04), pos = vec3(0, h, 0), grp = "iron")
    bot_r = parts.piece(size = vec3(len, 0.04, 0.04), pos = vec3(0, 0.08, 0), grp = "iron")
    n_p = int(len / 0.32)
    pts = transform(mesh_line(count = n_p, length = f32(n_p - 1) * 0.32, dir = (1, 0, 0)), translate = vec3(0.0 - f32(n_p - 1) * 0.32 * 0.5, 0, 0))
    picket = parts.piece(size = vec3(0.025, h - 0.08, 0.025), pos = vec3(0, (h + 0.08) * 0.5, 0), grp = "iron")
    pickets = realize(instance_on_points(pts, source = picket))
    out = merge(top_r, bot_r, pickets)
}
