# Центральная башня: часовой ярус с часами architecture.clock_face, арочными окнами
# звонницы на трёх фасадах, угловыми колоннеттами и карнизом;
# шестигранный черепичный шпиль (поле по граням + коньки по рёбрам).
import lib.parts
import lib.architecture
import lib.ironwork
import lib.shapes as shapes
import spire_house.common as common
import spire_house.windows as windows
import spire_house.roof as roof

def clock_tier(w: f32, h: f32, clock_r: f32, crown_h: f32, rng: rng) -> (out: geo<mesh>) {
    """Часовой ярус башни (центр x/z в 0, низ y = 0, лицо +Z):
    - Правильный шестигранный кирпичный корпус (плоская грань на фасаде +Z);
    - Круглые часы architecture.clock_face на передней грани;
    - 5 арочных проёмов звонницы на остальных пяти гранях;
    - 6 угловых каменных колоннетт на рёбрах шестигранника;
    - Ряд сухариков (дентикулов) под верхним карнизом;
    - Венчающий трёхступенчатый шестигранный карниз.
    Нижний пояс яруса — не здесь: это crown дома/эркера на f2_top (высота crown_h)."""
    r_in = w * 0.5
    r_circ = shapes.ngon_circumradius(r_in, 6)
    # Подоконник над венчающим карнизом дома, который кольцом сидит на низе яруса.
    sill = crown_h + 0.10
    win_h = 2.15
    # Шестигранный кирпичный корпус яруса (апофема = r_in)
    bx = common.hexa_frustum(y0 = 0.0, y1 = h, r0 = r_in, r1 = r_in, grp = "mortar")
    # Мелкая кладка: диск под часы на +Z, арки звонницы — polar_array остальных пяти граней
    bf0 = common.hexa_brick_clock_face(h = h, r_in = r_in, cy = sill + win_h * 0.5, circ_r = clock_r, rng = split_rng(rng, key = "t0"))
    bf_plain = common.hexa_brick_face(h = h, r_in = r_in, y_bot = sill, win_w = 0.55, win_h = win_h, rng = split_rng(rng, key = "t_plain"))
    bx_bricks = merge(bf0, shapes.polar_array(transform(bf_plain, rotate = vec3(0, 60, 0)), n = 5, step_deg = 60))
    # Часы на передней грани (+Z): центр на середине арочных окон яруса
    ck = transform(architecture.clock_face(r = clock_r), translate = vec3(0, sill + win_h * 0.5, r_in + 0.03))
    # Арочные окна звонницы на остальных пяти гранях
    wn = windows.stone_arch_window(w = 0.55, h = win_h)
    wn_base = transform(wn, translate = vec3(0, sill, r_in + 0.015))
    belfry = shapes.polar_array(transform(wn_base, rotate = vec3(0, 60, 0)), n = 5, step_deg = 60)
    # 6 угловых колоннетт на вершинах шестигранника (описанный радиус)
    shaft = architecture.regroup(ironwork.spool(p0 = vec3(0, crown_h + 0.04, 0), p1 = vec3(0, h - 0.08, 0), r0 = 0.07, r1 = 0.06, sides = 8), grp = "stone")
    sh_base = transform(shaft, translate = vec3(0, 0, r_circ))
    shafts = shapes.polar_array(transform(sh_base, rotate = vec3(0, 30, 0)), n = 6, step_deg = 60)
    # Верх яруса: сухарики и венчающий карниз (низ яруса — crown эркера на f2_top)
    dt = common.hexa_dentils(y = h - 0.14, r_in = r_in)
    top = common.hexa_crown(y = h, h = 0.32, r = r_in)
    out = merge(bx, bx_bricks, ck, belfry, shafts, dt, top)
}

def roof_spire(h: f32, r0: f32, rng: rng) -> (out: geo<mesh>) {
    """Шестигранный черепичный шпиль: конус-настил, на каждой грани поле
    черепицы с подрезкой по треугольнику, коньковые уголки по шести рёбрам."""
    r_top = 0.04
    k = 0.866025
    a0 = r0 * k
    a1 = r_top * k
    slope_len = sqrt(h * h + (a0 - a1) * (a0 - a1))
    pitch = degrees(atan2(h, a0 - a1))
    body = common.hexa_frustum(y0 = 0.0, y1 = h, r0 = a0, r1 = a1, grp = "roof")
    face0 = roof.spire_tile_face(r0 = r0, r1 = r_top, slope_len = slope_len, rng = split_rng(rng, key = "face"))
    face_on = transform(transform(face0, rotate = vec3(pitch, 0, 0)), translate = vec3(0, 0, a0))
    tiles = merge(face_on, transform(face_on, rotate = vec3(0, 60, 0)), transform(face_on, rotate = vec3(0, 120, 0)), transform(face_on, rotate = vec3(0, 180, 0)), transform(face_on, rotate = vec3(0, 240, 0)), transform(face_on, rotate = vec3(0, 300, 0)))
    # Рёбра — вершины основания (yaw 30° от +Z) к вершинам верхнего шестигранника.
    p0 = vec3(r0 * 0.5, 0, a0)
    p1 = vec3(r_top * 0.5, h, a1)
    cap0 = roof.hip_caps(p0 = p0, p1 = p1, rng = split_rng(rng, key = "hip"), half = 38.0, lift = 0.12, cap_w = 0.30, cap_l = 0.38, y_step = 0.005)
    caps = merge(cap0, transform(cap0, rotate = vec3(0, 60, 0)), transform(cap0, rotate = vec3(0, 120, 0)), transform(cap0, rotate = vec3(0, 180, 0)), transform(cap0, rotate = vec3(0, 240, 0)), transform(cap0, rotate = vec3(0, 300, 0)))
    tip = common.hexa_frustum(y0 = h - 0.06, y1 = h + 0.28, r0 = 0.09 * k, r1 = 0.012 * k, grp = "roof")
    out = merge(body, tiles, caps, tip)
}

def clock_tower(tower_w: f32, tower_h: f32, spire_h: f32, tower_base: f32, spire_base: f32, tower_z: f32, crown_h: f32, rng: rng) -> (out: geo<mesh>) {
    """Полная композиция шестигранной центральной башни со шпилем:
    - Шестигранный часовой ярус на высоте tower_base;
    - Шестигранный черепичный шпиль на высоте spire_base.
    Венчающий карниз дома (crown_h) кольцом обнимает низ яруса — см. bay_window."""
    tier = transform(clock_tier(w = tower_w, h = tower_h, clock_r = 0.52, crown_h = crown_h, rng = rng), translate = vec3(0, tower_base, tower_z))
    sp = transform(roof_spire(h = spire_h, r0 = 1.65, rng = split_rng(rng, key = "spire")), translate = vec3(0, spire_base, tower_z))
    out = merge(tier, sp)
}
