param width: f32 = 7.8
param depth: f32 = 5.2
param plinth_h: f32 = 0.90
param floor1_h: f32 = 3.25
param belt_h: f32 = 0.40
param floor2_h: f32 = 3.10
param crown_h: f32 = 0.55
param roof_h: f32 = 2.30
param tower_w: f32 = 2.50
param spire_h: f32 = 6.80
param ris_w: f32 = 2.40
param seed: int = 42

# Викторианский дом со шпилем (Spire House):
# - Первый этаж: гранитный цоколь, кирпичные стены, рустованные квойны, межэтажный карниз;
# - Второй этаж: кирпичные стены, квойны, венчающий карниз с дентикулами;
# - Центральный эркер-ризалит: 5-ступенчатый консольный сход (корбель), поясок с розетками,
# колонки-тяги и арочные окна по центру граней;
# - Центральная башня: часовой ярус с циферблатом и стрелками на 10:10, восьмигранный
# черепичный ярусный шпиль с кольцами, рёбрами, слуховыми люкарнами и финиалом;
# - Черепичная мансарда: честные перекрывающиеся ряды плиток вразбежку с нахлёстом
# и вариацией @tint, коньковые уголки вальм, кованый гребень палубы;
# - Парадный вход: крыльцо из 5 ступеней с парапетами и латунными шарами на тумбах,
# навес на консолях и настенный фонарь;
# - Парадная дверь: арочный каменный портал, деревянное полотно из филёнок, остеклённая
# фрамуга, латунная ручка-кноб и массивный порог;
# - Нормализованные окна: единые подоконные отметки f1_y / f2_y, замковые камни,
# оси симметрии по всем фасадам.
# 
# Декомпозированные модули лежат в spire_house/*.pgg.
# Именованные узлы-компоненты доступны для изолированного рендера и инспекции:
# ground, upper, bay_unit, porch_unit, door_unit, windows_all, roof_all, tower_all, house.
import spire_house.ground_floor as ground_floor
import spire_house.upper_floor as upper_floor
import spire_house.bay as bay
import spire_house.windows as windows
import spire_house.porch as porch
import spire_house.door as door
import spire_house.roof as roof
import spire_house.tower as tower
import spire_house.assemble as assemble
import lib.shapes as shapes

root_rng = rng_from_seed(seed)

# Координатная сетка высот и планов
plinth_top = plinth_h
f1_top = plinth_top + floor1_h
b1_top = f1_top + belt_h
f2_top = b1_top + floor2_h
crown_top = f2_top + crown_h
tower_base = f2_top
# Часовой ярус — той же высоты, что этаж дома (floor2_h), не отдельный укороченный ярус.
tower_top = tower_base + floor2_h
spire_base = tower_top + 0.3
facade_z = depth * 0.5
tower_z = facade_z
deck_hw = width * 0.5 - 0.8
deck_hd = depth * 0.5 - 0.8
f1_y = plinth_top + 0.35
f2_y = b1_top + 0.35
# Ось окна/двери на фасаде: середина простенка между визуальным краем эркера
# (колоннетта на 90° — правый край 60° грани) и внутренним краем квойнов
# (quoin_stack bricks=1.5: лицо 0.94, выпуск p = 0.2 → 0.74 от торца стены).
quoin_in = 0.74
tower_half = shapes.ngon_circumradius(tower_w * 0.5, 6) + 0.065
wing_x = (tower_half + width * 0.5 - quoin_in) * 0.5
door_x = wing_x

# Изолированные компоненты (доступны по именам в pgg_render / PggViewer):
ground = ground_floor.ground_floor(width = width, depth = depth, plinth_h = plinth_h, floor1_h = floor1_h, belt_h = belt_h, wing_x = wing_x, door_x = door_x, rng = split_rng(root_rng, key = "ground"))
upper = upper_floor.upper_floor(width = width, depth = depth, b1_top = b1_top, floor2_h = floor2_h, crown_h = crown_h, wing_x = wing_x, rng = split_rng(root_rng, key = "upper"))
bay_unit = bay.bay_window(facade_z = facade_z, f1_top = f1_top, b1_top = b1_top, f2_top = f2_top, f2_y = f2_y, crown_h = crown_h, rng = split_rng(root_rng, key = "bay"), tower_w = tower_w, tower_z = tower_z)
porch_unit = porch.entrance_porch(door_x = door_x, facade_z = facade_z, plinth_h = plinth_h)
door_unit = door.entrance_door(door_x = door_x, facade_z = facade_z, plinth_h = plinth_h, rng = split_rng(root_rng, key = "door"))
windows_all = windows.wall_windows(width = width, depth = depth, facade_z = facade_z, f1_y = f1_y, f2_y = f2_y, wing_x = wing_x)
roof_all = roof.mansard_roof(width = width, depth = depth, crown_top = crown_top, roof_h = roof_h, deck_hw = deck_hw, deck_hd = deck_hd, rng = split_rng(root_rng, key = "roof"))
tower_all = tower.clock_tower(tower_w = tower_w, tower_h = floor2_h, spire_h = spire_h, tower_base = tower_base, spire_base = spire_base, tower_z = tower_z, crown_h = crown_h, rng = split_rng(root_rng, key = "tower"))

# Полная сборка с окраской и запеканием AO
house = assemble.assemble(ground = ground, upper = upper, bay_unit = bay_unit, porch_unit = porch_unit, door_unit = door_unit, windows_all = windows_all, roof_all = roof_all, tower_all = tower_all, root_rng = root_rng)

output house
