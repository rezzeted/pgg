param seed: int = 21

import lib.paving as pv

# Crossroad — одиночный X-перекрёсток по референсу eAWZG: две равные улицы
# под 90°, узел оформлен маленькой круглой площадкой ШИРЕ дорог (pave_junction):
# мелкое ядро, концентрические пояса с градиентом размера, тёмный плотный обод.
# Рукава — регулярная кладка вразбежку, камень ДЛИННОЙ стороной вдоль оси;
# их ряды врезаются в обод и обрываются по дуге (cull_discs) — дуга съедает
# угол стыка, поворот читается мягким. Кромки рукавов — округлый поребрик.

root_rng = rng_from_seed(seed)

W = 3.5                    # ширина улиц
HW = W * 0.5
RJ = 4.0                   # радиус площадки перекрёстка (~2.3 ширины дороги, как на референсе)
Y_SETT = 0.10
Y_BORD = 0.15
SPAN = 16.0                # рукава s ∈ [-SPAN, SPAN]

jpts = pv.jpt(0.0, 0.0, RJ)

# Рукава: прямые (amp = 0) проспекты под 0° и 90°; камень 0.16 поперёк x 0.22
# вдоль (питчи 0.19 / 0.25); выкус диска площадки.
avE = pv.cull_discs(pts = pv.pave_avenue(alpha = 0.0, amp = 0.0, lam = 40.0, ph = 0.0, s0 = 0.0 - SPAN, s1 = SPAN, hw = HW, y = Y_SETT, rng = split_rng(root_rng, key = "avE"), pitch_w = 0.19, pitch_l = 0.25), jpts = jpts, margin = 0.16)
avN = pv.cull_discs(pts = pv.pave_avenue(alpha = 90.0, amp = 0.0, lam = 40.0, ph = 0.0, s0 = 0.0 - SPAN, s1 = SPAN, hw = HW, y = Y_SETT, rng = split_rng(root_rng, key = "avN"), pitch_w = 0.19, pitch_l = 0.25), jpts = jpts, margin = 0.16)

# Площадка перекрёстка + её обод-бордюр.
core = pv.pave_junction(cx = 0.0, cz = 0.0, rj = RJ, y = Y_SETT, rng = split_rng(root_rng, key = "core"))
rim = pv.border_ring(cx = 0.0, cz = 0.0, r = RJ + 0.02, y = Y_BORD, rng = split_rng(root_rng, key = "rim"), pitch = 0.36)

# Поребрики рукавов (обрываются у обода тем же выкусом) + торцы рукавов.
brd = merge(pv.cull_discs(pts = pv.border_avenue(alpha = 0.0, amp = 0.0, lam = 40.0, ph = 0.0, s0 = 0.0 - SPAN, s1 = SPAN, off = HW + 0.10, y = Y_BORD, rng = split_rng(root_rng, key = "bE"), pitch = 0.36), jpts = jpts, margin = 0.14), pv.cull_discs(pts = pv.border_avenue(alpha = 90.0, amp = 0.0, lam = 40.0, ph = 0.0, s0 = 0.0 - SPAN, s1 = SPAN, off = HW + 0.10, y = Y_BORD, rng = split_rng(root_rng, key = "bN"), pitch = 0.36), jpts = jpts, margin = 0.14), pv.border_row(cx = SPAN, cz = 0.0, yaw = 0.0, len = W + 0.44, y = Y_BORD, rng = split_rng(root_rng, key = "teE")), pv.border_row(cx = 0.0 - SPAN, cz = 0.0, yaw = 0.0, len = W + 0.44, y = Y_BORD, rng = split_rng(root_rng, key = "teW")), pv.border_row(cx = 0.0, cz = SPAN, yaw = 90.0, len = W + 0.44, y = Y_BORD, rng = split_rng(root_rng, key = "teN")), pv.border_row(cx = 0.0, cz = 0.0 - SPAN, yaw = 90.0, len = W + 0.44, y = Y_BORD, rng = split_rng(root_rng, key = "teS")))

# Земля: однотонная нейтральная подложка без раскраски.
g0 = grid(size = vec2(36.0, 36.0), res = vec2(36.0, 36.0))
ground = set(g0, "Cd", vec3(0.45, 0.45, 0.45), domain = faces)

# Инстансинг: камень рядов 0.16 x 0.22 (длинная сторона вдоль хода/дуги),
# бордюр округлый 0.26 x 0.30.
src_sett = pv.sett_source(w = 0.16, h = 0.12, l = 0.22, grp = "sett")
src_bord = pv.sett_source(w = 0.26, h = 0.20, l = 0.30, grp = "border")
all_pts = merge(avE, avN, core, rim, brd)
paved0 = realize(instance_on_points(all_pts, source = src_sett, variants = [src_sett, src_bord]))
paved1 = set(paved0, "Cd", @Cd * @tint, domain = faces)
paved = remove_attr(remove_attr(remove_attr(remove_attr(paved1, "tint"), "orient"), "scale"), "variant")

crossroad = merge(ground, paved)
output crossroad
