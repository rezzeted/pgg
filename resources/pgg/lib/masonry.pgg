def boulder_field(size: f32 = 2.0, aspect: vec3 = (1.0, 0.9, 0.8), cracks: int = 3, rng: rng) -> (field: sdf) {
    """SDF-ядро гранёного валуна, центрированное в origin (половина высоты
    выше/ниже нуля). Вход для полевой композиции (контактные отпечатки через
    sdf_subtract раздутого соседа) и mesh_from_sdf.
    Пример: f = masonry.boulder_field(size = 1.5, rng = r)"""
    expect size > 0: "размер в метрах, положительный"
    cut_rng = split_rng(rng, key = "cut")
    yaw_rng = split_rng(rng, key = "cut_yaw")
    cut2_rng = split_rng(rng, key = "cut2")
    yaw2_rng = split_rng(rng, key = "cut2_yaw")
    shape_rng = split_rng(rng, key = "shape")
    site_rng = split_rng(rng, key = "crack_sites")
    tilt_rng = split_rng(rng, key = "crack_tilt")
    core = sdf_box(size = aspect * size)
    pivot0 = point_cloud(count = 1, bounds = (0, 0, 0), rng = cut_rng)
    pivot = set(pivot0, "orient", orient_from_euler(random_vec(lo = vec3(-20, 0, -20), hi = (20, 360, 20), rng = yaw_rng)))
    cutter = sdf_instance_on_points(pivot, source = sdf_box(size = aspect * size * 1.08))
    pivot2_0 = point_cloud(count = 1, bounds = (0, 0, 0), rng = cut2_rng)
    pivot2 = set(pivot2_0, "orient", orient_from_euler(random_vec(lo = vec3(-30, 0, -30), hi = (30, 360, 30), rng = yaw2_rng)))
    cutter2 = sdf_instance_on_points(pivot2, source = sdf_box(size = aspect * size * 1.12))
    faceted = sdf_intersect(sdf_intersect(core, cutter), cutter2)
    bumpy = sdf_displace(faceted, fbm(@P * (0.8 / size), octaves = 3, rng = shape_rng) * 0.04 * size)
    sites0 = point_cloud(count = cracks, bounds = aspect * size * 0.8, rng = site_rng)
    sites = set(sites0, "orient", orient_from_euler(random_vec(lo = (0, 0, 0), hi = (360, 360, 360), rng = tilt_rng)))
    slabs = sdf_instance_on_points(sites, source = sdf_box(size = vec3(size * 1.6, size * 1.6, size * 0.015)))
    core_inner = sdf_displace(bumpy, size * 0.03)
    field = sdf_union(sdf_subtract(bumpy, slabs), core_inner)
}

def ashlar_block(width: f32, height: f32, depth: f32, rng: rng) -> (field: sdf) {
    """Тёсаный блок (ашлар) для ТОЧНОЙ кладки без притирки: постель (±Y) и левые/
    правые грани (±X) обрезаны в точные плоскости ПОСЛЕ fbm-дисплейса, поэтому
    габарит width×height гарантирован сверху (выступов за плоскость нет —
    проникновение соседей исключено, блоки выставляются с постоянным зазором).
    Лицевые грани (±Z) со скальной fbm-фактурой и стёсанными рёбрами (пересечение
    с чуть повёрнутым боксом). Центрирован в origin.
    Пример: f = masonry.ashlar_block(0.9, 0.6, 0.78, r)"""
    expect width > 0: "ширина по X, положительная"
    expect height > 0: "высота по Y, положительная"
    expect depth > 0: "глубина по Z, положительная"
    shape_rng = split_rng(rng, key = "shape")
    edge_rng = split_rng(rng, key = "edge")
    core = sdf_box(size = vec3(width, height, depth))
    piv = set(mesh_line(count = 1, length = 0.0), "orient", orient_from_euler(random_vec(lo = vec3(-4, -4, -4), hi = (4, 4, 4), rng = edge_rng)))
    hewn = sdf_intersect(core, sdf_instance_on_points(piv, source = sdf_box(size = vec3(width, height, depth) * 1.03)))
    bumpy = sdf_displace(hewn, fbm(@P * (2.4 / width), octaves = 3, rng = shape_rng) * 0.012 * width)
    flat_y = sdf_intersect(bumpy, sdf_box(size = vec3(width * 4.0, height, depth * 4.0)))
    field = sdf_intersect(flat_y, sdf_box(size = vec3(width, height * 4.0, depth * 4.0)))
}

def voussoir_field(radius: f32, height: f32, depth: f32, half_deg: f32, rng: rng) -> (field: sdf) {
    """Сводчатый камень (клин арки) для ТОЧНОЙ раскладки без притирки: боковые
    грани — плоские радиальные плоскости под ±half_deg, проходящие через центр
    дуги (локальная точка (0, −radius, 0)), и режутся ПОСЛЕ fbm-дисплейса —
    соседи с угловым шагом 2·half_deg + шов стыкуются встык с равномерным
    радиальным зазором. Локальная +Y — наружу дуги, X — вдоль дуги. Extrados/
    intrados и торцы со скальной fbm-фактурой. Наклон граней без тригонометрии:
    канонический резец — огромный бокс, чья грань проходит через origin,
    ставится якорем с roll = ±half_deg в центр дуги. Сырьевой бокс по X с
    запасом (линейная аппроксимация tan + 15%): реальную ширину задают резцы.
    Пример: f = masonry.voussoir_field(1.75, 0.82, 0.85, 7.85, r)"""
    expect radius > 0: "радиус дуги до центра камня, положительный"
    expect height > 0: "высота вдоль радиуса, положительная"
    expect depth > 0: "глубина по Z, положительная"
    shape_rng = split_rng(rng, key = "shape")
    blank_w = (radius + height) * half_deg * 0.0401
    bumpy = sdf_displace(sdf_box(size = vec3(blank_w, height, depth)), fbm(@P * (2.4 / height), octaves = 3, rng = shape_rng) * 0.012 * height)
    big = (radius + height + depth) * 4.0
    # Канонические резцы: грань через origin, тело в +X (левый) / −X (правый).
    cut_l_src = transform(mesh_line(count = 1, length = 0.0), translate = vec3(big * 0.5, 0, 0))
    cut_r_src = transform(mesh_line(count = 1, length = 0.0), translate = vec3(0.0 - big * 0.5, 0, 0))
    cut_l_slab = sdf_instance_on_points(cut_l_src, source = sdf_box(size = vec3(big, big, big)))
    cut_r_slab = sdf_instance_on_points(cut_r_src, source = sdf_box(size = vec3(big, big, big)))
    # Якоря — в ЦЕНТРЕ дуги (0, −radius): грани резцов — точно радиальные
    # плоскости под ±half_deg независимо от ширины сырьевого бокса.
    anc_l = set(transform(mesh_line(count = 1, length = 0.0), translate = vec3(0, 0.0 - radius, 0)), "orient", orient_from_euler(vec3(0, 0, half_deg)))
    anc_r = set(transform(mesh_line(count = 1, length = 0.0), translate = vec3(0, 0.0 - radius, 0)), "orient", orient_from_euler(vec3(0, 0, 0.0 - half_deg)))
    cut_l = sdf_instance_on_points(anc_l, source = cut_l_slab)
    cut_r = sdf_instance_on_points(anc_r, source = cut_r_slab)
    field = sdf_intersect(sdf_intersect(bumpy, cut_l), cut_r)
}

def stone_from_field(f: sdf, size: f32, rng: rng) -> (out: geo<mesh>) {
    """Мешит SDF-валун (воксель пропорционален size) и мечит мох на верхних
    гранях (группа faces «moss»; fbm по мировому @P — метка после извлечения,
    атрибутный барьер §8.4).
    Пример: m = masonry.stone_from_field(f, 1.5, r_moss)"""
    raw = mesh_from_sdf(f, voxel = size * 0.015)
    shaped = compute_normals(raw)
    out = mark(shaped, "moss", where = (dot(@N, (0, 1, 0)) > 0.75) & (fbm(scale = 2.5 / size, rng = rng) > 0.2), domain = faces)
}

def clip_wedge_out(g: geo<mesh>, cx: f32, cy: f32, R: f32, deg0: f32, deg1: f32) -> (out: geo<mesh>) {
    """Сектор [deg0, deg1] снаружи окружности (cx, cy, R): между лучами и за
    касательной на биссектрисе. Крышка среза — brick (торец подрезанного ложка)."""
    th0 = radians(deg0)
    th1 = radians(deg1)
    c0 = cos(th0)
    s0 = sin(th0)
    c1 = cos(th1)
    s1 = sin(th1)
    g1 = clip(g, origin = vec3(cx, cy, 0), normal = vec3(0.0 - s0, c0, 0))
    g2 = clip(g1, origin = vec3(cx, cy, 0), normal = vec3(s1, 0.0 - c1, 0))
    thm = (th0 + th1) * 0.5
    nmx = cos(thm)
    nmy = sin(thm)
    out = clip(g2, origin = vec3(cx + R * nmx, cy + R * nmy, 0), normal = vec3(nmx, nmy, 0), cap_group = "brick")
}

def clip_arch_hole(g: geo<mesh>, cx: f32, y_bot: f32, win_w: f32, win_h: f32, bar: f32, gap: f32, segments: int = 12) -> (out: geo<mesh>) {
    """Вырезать из кладки (локально: x вдоль, y вверх) стадион окна: прямоугольник
    косяков + верхняя полуокружность. Контур = наружный силуэт арки (полуширина
    r+bar) плюс зазор gap. Кирпичи снаружи целые, на контуре подрезаны.
    segments — число клиньев на полуокружность (по умолчанию 12 × 15°)."""
    expect segments >= 3: "clip_arch_hole: segments >= 3"
    r = win_w * 0.5
    R = r + bar + gap
    straight = win_h - r
    cy = y_bot + straight
    y_sill = y_bot - gap
    y_top = cy + R + 0.10
    left = clip(g, origin = vec3(cx - R, 0, 0), normal = vec3(-1, 0, 0), cap_group = "brick")
    right = clip(g, origin = vec3(cx + R, 0, 0), normal = vec3(1, 0, 0), cap_group = "brick")
    m0 = clip(g, origin = vec3(cx - R, 0, 0), normal = vec3(1, 0, 0))
    mid = clip(m0, origin = vec3(cx + R, 0, 0), normal = vec3(-1, 0, 0))
    bot = clip(mid, origin = vec3(0, y_sill, 0), normal = vec3(0, -1, 0), cap_group = "brick")
    top = clip(mid, origin = vec3(0, y_top, 0), normal = vec3(0, 1, 0), cap_group = "brick")
    ah0 = clip(mid, origin = vec3(0, cy, 0), normal = vec3(0, 1, 0))
    ah = clip(ah0, origin = vec3(0, y_top, 0), normal = vec3(0, -1, 0))
    seg = 180.0 / f32(segments)
    w0 = clip_wedge_out(ah, cx = cx, cy = cy, R = R, deg0 = 0.0, deg1 = seg)
    wedges = repeat (w0, iterations = segments - 1) |acc| {
        i = f32(@iteration) + 1.0
        d0 = i * seg
        acc = merge(acc, clip_wedge_out(ah, cx = cx, cy = cy, R = R, deg0 = d0, deg1 = d0 + seg))
    }
    out = compute_normals(merge(left, right, bot, top, wedges), mode = flat)
}

def clip_circle_hole(g: geo<mesh>, cx: f32, cy: f32, R: f32, segments: int = 12) -> (out: geo<mesh>) {
    """Вырезать диск (cx, cy, R) из кладки: segments секторов на полный круг."""
    expect segments >= 3: "clip_circle_hole: segments >= 3"
    seg = 360.0 / f32(segments)
    w0 = clip_wedge_out(g, cx = cx, cy = cy, R = R, deg0 = 0.0, deg1 = seg)
    wedges = repeat (w0, iterations = segments - 1) |acc| {
        i = f32(@iteration) + 1.0
        d0 = i * seg
        acc = merge(acc, clip_wedge_out(g, cx = cx, cy = cy, R = R, deg0 = d0, deg1 = d0 + seg))
    }
    out = compute_normals(wedges, mode = flat)
}

def clip_rect_hole(g: geo<mesh>, cx: f32, y0: f32, w: f32, h: f32, gap: f32 = 0.03) -> (out: geo<mesh>) {
    """Прямоугольный проём в кладке (дверь/ниша без арки): полуширина w/2+gap,
    низ y0−gap, верх y0+h+gap. Крышки срезов — brick."""
    hw = w * 0.5 + gap
    y_sill = y0 - gap
    y_top = y0 + h + gap
    left = clip(g, origin = vec3(cx - hw, 0, 0), normal = vec3(-1, 0, 0), cap_group = "brick")
    right = clip(g, origin = vec3(cx + hw, 0, 0), normal = vec3(1, 0, 0), cap_group = "brick")
    m0 = clip(g, origin = vec3(cx - hw, 0, 0), normal = vec3(1, 0, 0))
    mid = clip(m0, origin = vec3(cx + hw, 0, 0), normal = vec3(-1, 0, 0))
    bot = clip(mid, origin = vec3(0, y_sill, 0), normal = vec3(0, -1, 0), cap_group = "brick")
    top = clip(mid, origin = vec3(0, y_top, 0), normal = vec3(0, 1, 0), cap_group = "brick")
    out = compute_normals(merge(left, right, bot, top), mode = flat)
}
