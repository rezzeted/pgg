def dormer(w: f32, h: f32, d: f32, grp: string, roof_grp: string = "roof_red") -> (out: geo<mesh>) {
    """Alias → victorian.dormer."""
    out = victorian.dormer(w = w, h = h, d = d, grp = grp, roof_grp = roof_grp)
