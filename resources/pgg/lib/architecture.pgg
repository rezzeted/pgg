# lib/architecture.pgg — alias на lib/arch/terminals_victorian (переходный период,
# план A7). Исторический набор «викторианско-стимпанковских» элементов перенесён
# в lib/arch/terminals_victorian.pgg; этот файл оставлен, чтобы существующие
# сцены работали без правки импортов. Новые сцены — импортируйте
# lib.arch.terminals_victorian напрямую. regroup остаётся здесь (утилита
# переметки точёных деталей — thin-обёртка parts.to_group).

import lib.parts
import lib.arch.terminals_victorian as victorian

def regroup(g: geo<mesh>, grp: string) -> (out: geo<mesh>) {
    """Снять группу iron (её ставит ironwork.spool/rod/ring) и поставить grp — для
    точёных деталей из латуни/меди/дерева."""
    out = parts.to_group(g = g, src = "iron", dst = grp)
}

def column(h: f32, r: f32, grp: string = "wood") -> (out: geo<mesh>) {
    """Alias → victorian.column."""
    out = victorian.column(h = h, r = r, grp = grp)
}

def arch_panel(w: f32, h: f32, t: f32, grp: string) -> (out: geo<mesh>) {
    """Alias → victorian.arch_panel."""
    out = victorian.arch_panel(w = w, h = h, t = t, grp = grp)
}

def arch_frame(w: f32, h: f32, bar: f32, depth: f32, grp: string) -> (out: geo<mesh>) {
    """Alias → victorian.arch_frame."""
    out = victorian.arch_frame(w = w, h = h, bar = bar, depth = depth, grp = grp)
}

def arch_window(w: f32, h: f32) -> (out: geo<mesh>) {
    """Alias → victorian.arch_window."""
    out = victorian.arch_window(w = w, h = h)
}

def arch_door(w: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Alias → victorian.arch_door."""
    out = victorian.arch_door(w = w, h = h, rng = rng)
}

