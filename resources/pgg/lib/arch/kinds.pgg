# lib/arch/kinds.pgg — коды слотов и ролей рёбер архитектурного слоя
# (docs/pgg/architecture_library_plan.md §6.1). В атрибутах @kind/@role — int
# (атрибуты не бывают enum-типом, строки в полях не читаются), поэтому коды —
# def-константы с docstring. На границе API (param/аргументы) — enum (v1.28),
# внутрь конвейера переводить в эти коды. Нумерация стабильна: новые коды —
# в конец, переиспользование номеров ломает чужие файлы зданий.

def K_WALL() -> (out: int) {
    """Глухая стена (слот без терминала: стена материализуется walls(), не слотом)."""
    out = 0
}

def K_WINDOW() -> (out: int) {
    """Оконный проём."""
    out = 1
}

def K_DOOR() -> (out: int) {
    """Дверной проём."""
    out = 2
}

def K_CORNER() -> (out: int) {
    """Угол плана (квойны/пилястры; ставить только на выпуклых — @convex)."""
    out = 3
}

def K_PLINTH_BAND() -> (out: int) {
    """Полоса цоколя (вертикальное членение)."""
    out = 4
}

def K_FLOOR_BAND() -> (out: int) {
    """Полоса этажа (вертикальное членение)."""
    out = 5
}

def K_CROWN_BAND() -> (out: int) {
    """Венчающая полоса / карнизная зона (вертикальное членение)."""
    out = 6
}

def K_SLOPE() -> (out: int) {
    """Скат крыши (face-scope, этап A3)."""
    out = 7
}

def K_DORMER() -> (out: int) {
    """Слуховое окно на скате (этап A5)."""
    out = 8
}

def K_CHIMNEY() -> (out: int) {
    """Дымовая труба (этап A5)."""
    out = 9
}

def R_RIDGE() -> (out: int) {
    """Ребро-конёк (верхняя горизонтальная грань скатов)."""
    out = 0
}

def R_HIP() -> (out: int) {
    """Ребро-вальма (наклонное ребро между скатами на выпуклом углу плана)."""
    out = 1
}

def R_VALLEY() -> (out: int) {
    """Ребро-ендова (разжелобок между скатами на вогнутом углу плана)."""
    out = 2
}

def R_EAVE() -> (out: int) {
    """Ребро-карнизный свес (низ ската)."""
    out = 3
}

def R_RAKE() -> (out: int) {
    """Ребро фронтонного края (наклонный край ската над щипцом)."""
    out = 4
}

def R_FLOOR_TOP() -> (out: int) {
    """Горизонтальное ребро «верх полосы этажа» (пояса, карнизы)."""
    out = 5
}

def R_FLOOR_BOTTOM() -> (out: int) {
    """Горизонтальное ребро «низ полосы этажа» (отливы, цокольные тяги)."""
    out = 6
}

def R_PLAN_CORNER() -> (out: int) {
    """Вертикальное ребро угла плана (квойны, лопатки)."""
    out = 7
}
