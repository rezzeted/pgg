# lib/arch/terminals_basic.pgg — терминалы по умолчанию, базовый набор
# (docs/pgg/architecture_library_plan.md §6.7). Контракт §5.6: размеры в сигнатуре
# (терминал строится под размер, не масштабируется), локальная рамка — низ-центр
# в origin, лицо +Z (терминалы на ребре — от origin вдоль +Z), группы — материальный
# словарь, @Cd не пишем, rng — только у стохастики. Библиотечные сборки наборы не
# вызывают — вызывает файл здания; набор берут целиком, частично или заменяют.

import lib.parts
import lib.ironwork

def win_flat(w: f32, h: f32) -> (out: geo<mesh>) {
    """Плоское прямоугольное окно: утопленное стекло, рама и подоконник trim,
    крест-переплёт iron. Низ на y = 0, ось симметрии x = 0, лицо +Z."""
    expect w > 0.3 & h > 0.5: "win_flat: миниатюрное окно — ширина > 0.3, высота > 0.5"
    glass = parts.slab(size = vec3(w, h, 0.05), pos = vec3(0, h * 0.5, 0.03), grp = "glass")
    jamb_l = parts.slab(size = vec3(0.12, h + 0.12, 0.10), pos = vec3(0.0 - w * 0.5 - 0.06, (h + 0.12) * 0.5, 0.04), grp = "trim")
    jamb_r = parts.slab(size = vec3(0.12, h + 0.12, 0.10), pos = vec3(w * 0.5 + 0.06, (h + 0.12) * 0.5, 0.04), grp = "trim")
    head = parts.slab(size = vec3(w + 0.24, 0.12, 0.10), pos = vec3(0, h + 0.06, 0.04), grp = "trim")
    sill = parts.slab(size = vec3(w + 0.30, 0.10, 0.22), pos = vec3(0, 0.0 - 0.05, 0.06), grp = "trim")
    mull = parts.slab(size = vec3(0.04, h - 0.06, 0.04), pos = vec3(0, h * 0.5, 0.055), grp = "iron")
    trans = parts.slab(size = vec3(w - 0.04, 0.04, 0.04), pos = vec3(0, h * 0.62, 0.055), grp = "iron")
    out = merge(glass, jamb_l, jamb_r, head, sill, mull, trans)
}

def door_plain(w: f32, h: f32) -> (out: geo<mesh>) {
    """Простая дверь: филёнчатая створка wood в раме trim, порог. Низ на y = 0,
    ось симметрии x = 0, лицо +Z."""
    expect w > 0.5 & h > 1.5: "door_plain: дверь от 0.5×1.5 м"
    leaf = parts.slab(size = vec3(w, h, 0.06), pos = vec3(0, h * 0.5, 0.03), grp = "wood")
    pan_t = parts.slab(size = vec3(w - 0.24, h * 0.38, 0.02), pos = vec3(0, h * 0.70, 0.065), grp = "trim")
    pan_b = parts.slab(size = vec3(w - 0.24, h * 0.30, 0.02), pos = vec3(0, h * 0.24, 0.065), grp = "trim")
    jamb_l = parts.slab(size = vec3(0.12, h + 0.12, 0.12), pos = vec3(0.0 - w * 0.5 - 0.06, (h + 0.12) * 0.5, 0.04), grp = "trim")
    jamb_r = parts.slab(size = vec3(0.12, h + 0.12, 0.12), pos = vec3(w * 0.5 + 0.06, (h + 0.12) * 0.5, 0.04), grp = "trim")
    head = parts.slab(size = vec3(w + 0.24, 0.12, 0.12), pos = vec3(0, h + 0.06, 0.04), grp = "trim")
    sill = parts.slab(size = vec3(w + 0.30, 0.09, 0.24), pos = vec3(0, 0.0 - 0.045, 0.07), grp = "trim")
    knob = parts.piece(size = vec3(0.05, 0.05, 0.05), pos = vec3(w * 0.5 - 0.12, h * 0.48, 0.08), grp = "iron")
    out = merge(leaf, pan_t, pan_b, jamb_l, jamb_r, head, sill, knob)
}

def cornice_run(len: f32, h: f32 = 0.30, out_n: f32 = 0.22) -> (out: geo<mesh>) {
    """Простой двухступенчатый карниз длины len: от origin вдоль +Z (терминал на ребре,
    place_edge). Нижняя ступень уже и толще, верхняя шире и тоньше; группа trim."""
    expect len > 0.0: "cornice_run: длина положительная, edge_len(e)"
    lo = parts.slab(size = vec3(out_n * 0.8, h * 0.55, len), pos = vec3(out_n * 0.4, h * 0.275, len * 0.5), grp = "trim")
    hi = parts.slab(size = vec3(out_n, h * 0.45, len), pos = vec3(out_n * 0.5, h * 0.775, len * 0.5), grp = "trim")
    out = merge(lo, hi)
}

def tile_plain(w: f32 = 0.18, l: f32 = 0.30, t: f32 = 0.02) -> (out: geo<mesh>) {
    """Плоская черепичка w×l: низ-центр в origin, лежит в плоскости XZ, лицо +Y,
    штампуется по якорям покрытия (A3). Группа tile."""
    out = parts.slab(size = vec3(w, t, l), pos = vec3(0, t * 0.5, 0), grp = "tile")
}

def ridge_cap(len: f32, r: f32 = 0.09) -> (out: geo<mesh>) {
    """Коньковый брус длины len: полукруглый валик радиуса r от origin вдоль +Z
    (терминал на ребре, place_edge). Группа roof."""
    expect len > 0.0: "ridge_cap: длина положительная, edge_len(e)"
    cyl = ironwork.spool(p0 = vec3(0, 0, 0), p1 = vec3(0, 0, len), r0 = r, r1 = r, sides = 12)
    half = clip(cyl, origin = vec3(0, 0, 0), normal = vec3(0, 1, 0))
    out = parts.to_group(g = half, src = "iron", dst = "roof")
}
