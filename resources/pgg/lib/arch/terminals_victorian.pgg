# Викторианские терминалы: стрельчатые силуэты и ступенчатые консоли.
# Терминал = лист графа, материализует scope/размер в меш с группами материалов.
# Собраны из church/common.pgg и shreter_mansion/common.pgg (A0, как есть).

import lib.parts

def pointed_clip(g: geo<mesh>, w: f32, h: f32, y0: f32) -> (out: geo<mesh>) {
    """Стрельчатый силуэт в XY: вершина (0, y0+h), пружины (±w/2, y0+h − 0.72·w).
    clip держит сторону нормали — оставляем тело под скатами."""
    rise = w * 0.72
    apex = vec3(0, y0 + h, 0)
    n_l = vec3(rise, 0.0 - w * 0.5, 0)
    n_r = vec3(0.0 - rise, 0.0 - w * 0.5, 0)
    c0 = clip(g, origin = apex, normal = n_l)
    out = clip(c0, origin = apex, normal = n_r)
}

def pointed_panel(w: f32, h: f32, t: f32, grp: string) -> (out: geo<mesh>) {
    """Стрельчатая плита: ширина w, высота h, толщина t, низ y = 0, центр x/z = 0."""
    expect h > w * 0.72 + 0.25: "pointed_panel: высота меньше стрельчатой головки"
    raw = parts.slab(size = vec3(w, h, t), pos = vec3(0, h * 0.5, 0), grp = grp)
    out = pointed_clip(g = raw, w = w, h = h, y0 = 0.0)
}

def corbel(w: f32, d: f32, h: f32, grp: string, steps: int = 4) -> (out: geo<mesh>) {
    """Ступенчатая консоль: n ступеней сверху вниз, каждая следующая уже и ближе
    к стене. Верх на y = h, низ на y = 0, лицо на +Z (вынос в +Z)."""
    st_h = h / f32(steps)
    b0 = parts.slab(size = vec3(w, st_h * 0.95, d), pos = vec3(0, h - st_h * 0.5, d * 0.5), grp = grp)
    out = repeat (b0, iterations = steps - 1) |acc| {
        k = f32(@iteration) + 1.0
        frac = 1.0 - k * (0.62 / f32(steps))
        acc = merge(acc, parts.slab(size = vec3(w * frac, st_h * 0.95, d * frac), pos = vec3(0, h - (k + 0.5) * st_h, d * frac * 0.5), grp = grp))
    }
}
