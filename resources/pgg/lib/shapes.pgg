# SDF-формы с позиционированием через одиночную точку (§8.4): бокс/сфера в точке,
# скат-полупространство, двускатная призма крыши, арочная плита портала.

def sdf_box_at(size: vec3, pos: vec3) -> (out: sdf) {
    """SDF-бокс с центром в pos (через @P одиночной точки)."""
    pt0 = mesh_line(count = 1, length = 0.0)
    pt = transform(pt0, translate = pos)
    out = sdf_instance_on_points(pt, source = sdf_box(size = size))
}

def sdf_sphere_at(r: f32, pos: vec3) -> (out: sdf) {
    """SDF-сфера с центром в pos."""
    pt0 = mesh_line(count = 1, length = 0.0)
    pt = transform(pt0, translate = pos)
    out = sdf_instance_on_points(pt, source = sdf_sphere(r = r))
}

def slab_at(ridge: vec3, tilt_deg: f32, span: f32) -> (out: sdf) {
    """Полупространство-скат под 45°: бокс span×span×span, повёрнутый на tilt_deg
    вокруг X, верхняя грань проходит через точку ridge (толщина бокса — вниз)."""
    pt0 = mesh_line(count = 1, length = 0.0)
    pt1 = set(pt0, "orient", orient_from_euler(vec3(tilt_deg, 0, 0)))
    pt = transform(pt1, translate = ridge)
    slab0 = sdf_box(size = vec3(span, span, span))
    out = sdf_instance_on_points(pt, source = slab0)
}

def gable_prism(ridge_y: f32, drop: f32, w: f32, d: f32, floor_y: f32) -> (out: sdf) {
    """Треугольная призма крыши 45°: конёк на высоте ridge_y − drop, длина конька w
    (вдоль X), скаты до floor_y. drop — сдвиг плоскостей скатов вниз (толщина кровли)."""
    span = (w + d) * 3.0
    half = span * 0.5 * 0.70710678
    right = slab_at(ridge = vec3(0, ridge_y - drop - half, half), tilt_deg = 45.0, span = span)
    left = slab_at(ridge = vec3(0, ridge_y - drop - half, 0 - half), tilt_deg = 0.0 - 45.0, span = span)
    top_y = ridge_y - drop
    # Ограничивающий бокс — ПЕРВЫЙ операнд intersect: conservative bbox
    # пересечения = bbox(a), и грид mesh_from_sdf берётся по нему, а не по
    # гигантскому скату (иначе 600³ вокселей и минуты счёта).
    bounds = sdf_box_at(size = vec3(w, top_y - floor_y, (top_y - floor_y) * 2.0 + 0.1), pos = vec3(0, (top_y + floor_y) * 0.5, 0))
    out = sdf_intersect(bounds, sdf_intersect(right, left))
}

def gable_prism_z(ridge_y: f32, drop: f32, w: f32, d: f32, floor_y: f32) -> (out: sdf) {
    """gable_prism, повёрнутая на 90° вокруг Y: конёк вдоль Z (длина конька w), скаты
    на ±X до floor_y. drop — сдвиг плоскостей скатов вниз (толщина кровли). Призма
    центрирована, поэтому знак поворота неважен. Нужна для поперечных щипцов
    многощипцовых крыш (cottage/roof.pgg, multi_gable)."""
    pt0 = mesh_line(count = 1, length = 0.0)
    pt = set(pt0, "orient", orient_from_euler(vec3(0, 90, 0)))
    out = sdf_instance_on_points(pt, source = gable_prism(ridge_y = ridge_y, drop = drop, w = w, d = d, floor_y = floor_y))
}

def arch_sdf(w: f32, straight: f32, r: f32, t: f32) -> (out: sdf) {
    """Арочная плита: бокс w×straight×t (низ на y=0, центр по x/z в 0) плюс диск
    радиуса r сверху — сфера, зажатая тонким боксом (толщина плиты t)."""
    body = sdf_box_at(size = vec3(w, straight, t), pos = vec3(0, straight * 0.5, 0))
    slab = sdf_box_at(size = vec3(r * 2.0, r * 2.0, t), pos = vec3(0, straight, 0))
    ball = sdf_sphere_at(r = r, pos = vec3(0, straight, 0))
    disc = sdf_intersect(slab, ball)
    out = sdf_union(body, disc)
}

def ngon_circumradius(apothem: f32, sides: int) -> (out: f32) {
    """Описанный радиус правильного n-угольника по апофеме (расстояние до грани)."""
    expect sides >= 3: "ngon_circumradius: sides >= 3"
    out = apothem / cos(3.14159265 / f32(sides))
}

def polar_array(g: geo<mesh>, n: int, step_deg: f32 = 0) -> (out: geo<mesh>) {
    """n копий меша вокруг +Y: нулевая копия — g как есть, дальше шаг step_deg.
    step_deg = 0 → 360/n. n = 1 возвращает g (repeat iterations = 0)."""
    expect n >= 1: "polar_array: n >= 1"
    step = abs(step_deg) < 0.0001 ? 360.0 / f32(n) : step_deg
    out = repeat (g, iterations = n - 1) |acc| {
        piece = transform(g, rotate = vec3(0, step * (f32(@iteration) + 1.0), 0))
        acc = merge(acc, piece)
    }
}

def around_box(g_front: geo<mesh>, w: f32, d: f32) -> (out: geo<mesh>) {
    """Одна «фасадная» деталь (лицо +Z, центр в 0) на четыре стены прямоугольника w×d:
    +Z, −Z, +X, −X. Низ детали остаётся на её локальном y."""
    f = transform(g_front, translate = vec3(0, 0, d * 0.5))
    b = transform(transform(g_front, rotate = vec3(0, 180, 0)), translate = vec3(0, 0, 0.0 - d * 0.5))
    r = transform(transform(g_front, rotate = vec3(0, 90, 0)), translate = vec3(w * 0.5, 0, 0))
    l = transform(transform(g_front, rotate = vec3(0, 270, 0)), translate = vec3(0.0 - w * 0.5, 0, 0))
    out = merge(f, b, r, l)
}

def ngon_frustum(y0: f32, y1: f32, r0: f32, r1: f32, sides: int, grp: string) -> (out: geo<mesh>) {
    """Правильная n-гранная усечённая пирамида от y0 до y1. r0/r1 — апофемы
    (расстояние от оси до грани), внутри пересчёт в описанный. Профиль повёрнут
    на 180/sides, чтобы плоская грань смотрела в +Z (у шестигранника — 30°)."""
    expect sides >= 3: "ngon_frustum: sides >= 3"
    c0 = r0 / cos(3.14159265 / f32(sides))
    c1 = r1 / cos(3.14159265 / f32(sides))
    h = y1 - y0
    path0 = mesh_line(count = 2, length = h, dir = (0, 1, 0))
    path = set(path0, "profile_scale", @index == 0 ? vec2(c0, c0) : vec2(c1, c1))
    spin = 180.0 / f32(sides)
    prof = transform(circle(sides = sides, radius = 1.0), rotate = vec3(0, 0, spin))
    sw = sweep(path, profile = prof)
    sw_y = transform(sw, translate = vec3(0, y0, 0))
    out = mark(compute_normals(sw_y, mode = flat), grp, where = true, domain = faces)
}

def ngon_belt(y: f32, h: f32, r: f32, sides: int, over_lo: f32 = 0.22, over_hi: f32 = 0.30) -> (out: geo<mesh>) {
    """n-гранный двухступенчатый карниз: низ 0.58·h / вынос over_lo, верх 0.42·h /
    over_hi. r — апофема корпуса; over_* — вынос от грани (по нормали). Фаска
    шириной 0.12·высота полки, группа edge."""
    lo_h = h * 0.58
    hi_h = h * 0.42
    lo = ngon_frustum(y0 = y, y1 = y + lo_h, r0 = r + over_lo, r1 = r + over_lo, sides = sides, grp = "stone")
    hi = ngon_frustum(y0 = y + lo_h, y1 = y + h, r0 = r + over_hi, r1 = r + over_hi, sides = sides, grp = "stone")
    lo_b = compute_normals(mark(bevel(lo, width = 0.12 * lo_h, bevel_group = "edge"), "stone", where = true, domain = faces), mode = flat)
    hi_b = compute_normals(mark(bevel(hi, width = 0.12 * hi_h, bevel_group = "edge"), "stone", where = true, domain = faces), mode = flat)
    out = merge(lo_b, hi_b)
}
