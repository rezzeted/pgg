# Базовые детали для «боксовой» архитектуры: брус/блок с фаской, щит из досок,
# постановка меша (place). Общие для cottage/* и lib/fixtures.pgg; все размеры
# в метрах, центр детали — в pos.

def cbox(size: vec3, k: f32, k_abs: f32 = 0) -> (out: geo<mesh>) {
    """Box с фаской (v1.24): ребро скошено на k · min(размер) (клампится bevel'ом),
    грани фаски — в группе "edge" (краевой износ: в окраске они светлее). Фасеточные
    corner-N: сварной box несёт гладкие point-@N (диагонали углов, §8.1), и в превью
    большая плоская грань шейдится «подушкой» — поэтому flat.
    k_abs > 0 — абсолютная ширина фаски в метрах, перекрывает относительный k
    (на призме этажа k·min(size) даёт десятки сантиметров и «загибает» грани)."""
    w_rel = min(min(dot(size, (1, 0, 0)), dot(size, (0, 1, 0))), dot(size, (0, 0, 1))) * k
    w = k_abs > 0.0 ? k_abs : w_rel
    out = compute_normals(bevel(box(size = size), width = w, bevel_group = "edge"), mode = flat)
}

def piece(size: vec3, pos: vec3, grp: string) -> (out: geo<mesh>) {
    """Прямоугольный брус/блок с фаской: cbox размером size с центром в pos, все грани в группе grp."""
    b = cbox(size = size, k = 0.12)
    placed = transform(b, translate = pos)
    out = mark(placed, grp, where = true, domain = faces)
}

def plank_panel(w: f32, h: f32, t: f32, n: int, rng: rng) -> (out: geo<mesh>) {
    """Щит из n вертикальных досок общей ширины w, высоты h, толщины t; центр в 0,
    лицо в +Z. Доска = box шириной (шаг − 0.008): шов-зазор, плюс на доску свой
    выступ по z (±0.006) и оттенок @tint (полутоновая полоса читается и при плоском
    свете, когда шов не виден). Доски — инстансы на mesh_line, один realize."""
    pitch = w / f32(n)
    plank = cbox(size = vec3(pitch - 0.008, h, t), k = 0.18)
    pts0 = mesh_line(count = n, length = w - pitch, dir = (1, 0, 0))
    pts1 = transform(pts0, translate = vec3(0.0 - (w - pitch) * 0.5, 0, 0))
    pts2 = set_position(pts1, offset = random_vec(lo = vec3(0, 0, -0.006), hi = vec3(0, 0, 0.006), rng = split_rng(rng, key = "z")))
    shade = random(lo = 0.78, hi = 1.22, rng = split_rng(rng, key = "tint"))
    pts3 = set(pts2, "tint", vec3(shade * 1.03, shade, shade * 0.95))
    out = mark(realize(instance_on_points(pts3, source = plank)), "wood", where = true, domain = faces)
}

def place(g: geo<mesh>, yaw_deg: f32, at: vec3) -> (out: geo<mesh>) {
    """Поворот меша вокруг Y на yaw_deg (0 = смотрит в +Z) и перенос в at."""
    r = transform(g, rotate = vec3(0, yaw_deg, 0))
    out = transform(r, translate = at)
}
