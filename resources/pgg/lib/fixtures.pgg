# Навесное оборудование дома: окна (рама, переплёт, ставни) и фонари. Детали — из
# lib/parts.pgg (брус с фаской); группы материалов: iron (кованый металл),
# lamp (светящееся стекло), wood (рамы и ставни), glass. Локальная система фонаря: стена — плоскость z = 0,
# наружу +Z, вверх +Y; `at` — точка крепления пластины на стене.

import lib.parts

def rod(p0: vec3, p1: vec3, p2: vec3, p3: vec3, r: f32, n: int) -> (out: geo<mesh>) {
    """Кованый прут: кубическая Безье по четырём точкам, протянутая круглым профилем
    радиуса r (n сегментов вдоль). Крышки на концах, нормали auto — прут читается
    круглым, торцы жёсткие. Группа iron."""
    path = bezier_points(p0 = p0, p1 = p1, p2 = p2, p3 = p3, count = n)
    tube = sweep(path, profile = circle(sides = 8, radius = r))
    out = mark(compute_normals(tube, mode = auto, angle = 50), "iron", where = true, domain = faces)
}

def ring(center: vec3, radius: f32, r: f32, yaw_deg: f32) -> (out: geo<mesh>) {
    """Кольцо (тор): окружность радиуса radius в плоскости XY (смотрит вдоль Z),
    повёрнутая на yaw_deg вокруг Y, профиль радиуса r. Звено цепи, подвес, ушко."""
    loop = circle(sides = 14, radius = radius)
    torus = sweep(loop, profile = circle(sides = 6, radius = r), closed = true)
    placed = transform(compute_normals(torus, mode = auto, angle = 50), rotate = vec3(0, yaw_deg, 0), translate = center)
    out = mark(placed, "iron", where = true, domain = faces)
}

def pyramid_cap(base: vec3, half: f32, h: f32, tip: f32) -> (out: geo<mesh>) {
    """Четырёхскатная крышка: квадрат полустороны half в основании base сводится к
    квадрату полустороны tip на высоте h (sweep квадратного профиля вверх с
    @profile_scale). Профиль — circle(4) повёрнут на 45°, чтобы стороны шли по осям."""
    path0 = mesh_line(count = 2, length = h, dir = (0, 1, 0))
    path = set(transform(path0, translate = base), "profile_scale", @index == 0 ? vec2(1, 1) : vec2(tip / half, tip / half))
    sq = transform(circle(sides = 4, radius = half * 1.41421), rotate = vec3(0, 0, 45))
    cap = sweep(path, profile = sq)
    out = mark(compute_normals(cap, mode = flat), "iron", where = true, domain = faces)
}

def lantern(at: vec3) -> (out: geo<mesh>) {
    """Настенный кованый фонарь: пластина на стене, гнутый кронштейн с подкосом-завитком,
    два звена цепи, четырёхскатная крышка с шишкой, каркас из стоек и обвязок с
    четырьмя стёклами (группа lamp — светится) и средниками, донце с капелькой.
    Корпус висит на оси z = 0.32 от стены, стекло — от y = −0.14 до y = 0.14."""
    plate = parts.piece(size = vec3(0.10, 0.18, 0.02), pos = vec3(0, 0.30, 0.01), grp = "iron")
    arm = rod(p0 = vec3(0, 0.30, 0.02), p1 = vec3(0, 0.38, 0.14), p2 = vec3(0, 0.38, 0.30), p3 = vec3(0, 0.32, 0.32), r = 0.013, n = 12)
    brace = rod(p0 = vec3(0, 0.22, 0.02), p1 = vec3(0, 0.24, 0.16), p2 = vec3(0, 0.30, 0.24), p3 = vec3(0, 0.355, 0.235), r = 0.009, n = 12)
    curl = rod(p0 = vec3(0, 0.355, 0.235), p1 = vec3(0, 0.37, 0.20), p2 = vec3(0, 0.33, 0.18), p3 = vec3(0, 0.325, 0.21), r = 0.008, n = 10)
    link1 = ring(center = vec3(0, 0.29, 0.32), radius = 0.028, r = 0.005, yaw_deg = 0)
    link2 = ring(center = vec3(0, 0.25, 0.32), radius = 0.024, r = 0.005, yaw_deg = 90)
    finial = mark(transform(ico_sphere(subdiv = 1, radius = 0.018), translate = vec3(0, 0.225, 0.32)), "iron", where = true, domain = faces)
    cap = pyramid_cap(base = vec3(0, 0.155, 0.32), half = 0.13, h = 0.07, tip = 0.02)
    rim = parts.piece(size = vec3(0.26, 0.015, 0.26), pos = vec3(0, 0.1475, 0.32), grp = "iron")
    # Каркас: четыре стойки и две квадратные обвязки (верх/низ).
    post_a = parts.piece(size = vec3(0.016, 0.29, 0.016), pos = vec3(0.10, 0.0, 0.42), grp = "iron")
    post_b = parts.piece(size = vec3(0.016, 0.29, 0.016), pos = vec3(-0.10, 0.0, 0.42), grp = "iron")
    post_c = parts.piece(size = vec3(0.016, 0.29, 0.016), pos = vec3(0.10, 0.0, 0.22), grp = "iron")
    post_d = parts.piece(size = vec3(0.016, 0.29, 0.016), pos = vec3(-0.10, 0.0, 0.22), grp = "iron")
    rail_tf = parts.piece(size = vec3(0.216, 0.016, 0.016), pos = vec3(0, 0.137, 0.42), grp = "iron")
    rail_tb = parts.piece(size = vec3(0.216, 0.016, 0.016), pos = vec3(0, 0.137, 0.22), grp = "iron")
    rail_tl = parts.piece(size = vec3(0.016, 0.016, 0.216), pos = vec3(-0.10, 0.137, 0.32), grp = "iron")
    rail_tr = parts.piece(size = vec3(0.016, 0.016, 0.216), pos = vec3(0.10, 0.137, 0.32), grp = "iron")
    rail_bf = parts.piece(size = vec3(0.216, 0.016, 0.016), pos = vec3(0, -0.137, 0.42), grp = "iron")
    rail_bb = parts.piece(size = vec3(0.216, 0.016, 0.016), pos = vec3(0, -0.137, 0.22), grp = "iron")
    rail_bl = parts.piece(size = vec3(0.016, 0.016, 0.216), pos = vec3(-0.10, -0.137, 0.32), grp = "iron")
    rail_br = parts.piece(size = vec3(0.016, 0.016, 0.216), pos = vec3(0.10, -0.137, 0.32), grp = "iron")
    # Стёкла — утоплены на 4 мм от плоскости стоек, средник — по середине каждого.
    glass_f = parts.piece(size = vec3(0.19, 0.27, 0.006), pos = vec3(0, 0.0, 0.414), grp = "lamp")
    glass_b = parts.piece(size = vec3(0.19, 0.27, 0.006), pos = vec3(0, 0.0, 0.226), grp = "lamp")
    glass_l = parts.piece(size = vec3(0.006, 0.27, 0.19), pos = vec3(-0.094, 0.0, 0.32), grp = "lamp")
    glass_r = parts.piece(size = vec3(0.006, 0.27, 0.19), pos = vec3(0.094, 0.0, 0.32), grp = "lamp")
    mull_f = parts.piece(size = vec3(0.19, 0.012, 0.012), pos = vec3(0, 0.0, 0.42), grp = "iron")
    mull_b = parts.piece(size = vec3(0.19, 0.012, 0.012), pos = vec3(0, 0.0, 0.22), grp = "iron")
    mull_l = parts.piece(size = vec3(0.012, 0.012, 0.19), pos = vec3(-0.10, 0.0, 0.32), grp = "iron")
    mull_r = parts.piece(size = vec3(0.012, 0.012, 0.19), pos = vec3(0.10, 0.0, 0.32), grp = "iron")
    # Донце с капелькой.
    base = parts.piece(size = vec3(0.24, 0.02, 0.24), pos = vec3(0, -0.155, 0.32), grp = "iron")
    drop = pyramid_cap(base = vec3(0, -0.165, 0.32), half = 0.06, h = -0.05, tip = 0.008)
    frame = merge(post_a, post_b, post_c, post_d, rail_tf, rail_tb, rail_tl, rail_tr, rail_bf, rail_bb, rail_bl, rail_br)
    glass = merge(glass_f, glass_b, glass_l, glass_r, mull_f, mull_b, mull_l, mull_r)
    hang = merge(plate, arm, brace, curl, link1, link2, finial)
    l0 = merge(hang, cap, rim, frame, glass, base, drop)
    out = transform(l0, translate = at)
}

def window(w: f32, h: f32, cols: int = 2, rows: int = 2) -> (out: geo<mesh>) {
    """Окно в начале координат, смотрит в +Z: рама w×h, стекло чуть утоплено,
    переплёт cols×rows (стойки и перекладины — инстансы на mesh_line; 1×1 — без
    переплёта), подоконник. Задняя плоскость рамы — z = −0.06."""
    expect w > 0.3 & h > 0.3: "рама 0.1 с каждой стороны — окно меньше 0.3 м не имеет стекла"
    expect cols >= 1 & rows >= 1: "переплёт: не меньше одного стекла по каждой оси"
    gw = w - 0.2
    gh = h - 0.2
    frame = parts.piece(size = vec3(w, h, 0.12), pos = (0, 0, 0), grp = "wood")
    glass = parts.piece(size = vec3(gw, gh, 0.13), pos = (0, 0, 0), grp = "glass")
    bar_v = parts.piece(size = vec3(0.07, gh, 0.16), pos = (0, 0, 0), grp = "wood")
    bar_h = parts.piece(size = vec3(gw, 0.07, 0.16), pos = (0, 0, 0), grp = "wood")
    vx0 = mesh_line(count = cols - 1, length = gw * f32(cols - 2) / f32(cols), dir = (1, 0, 0))
    vx = transform(vx0, translate = vec3(0.0 - gw * 0.5 + gw / f32(cols), 0, 0))
    hy0 = mesh_line(count = rows - 1, length = gh * f32(rows - 2) / f32(rows), dir = (0, 1, 0))
    hy = transform(hy0, translate = vec3(0, 0.0 - gh * 0.5 + gh / f32(rows), 0))
    bars_v = realize(instance_on_points(vx, source = bar_v))
    bars_h = realize(instance_on_points(hy, source = bar_h))
    sill = parts.piece(size = vec3(w + 0.24, 0.09, 0.26), pos = vec3(0, 0.0 - h * 0.5 - 0.02, 0.05), grp = "wood")
    out = merge(frame, glass, bars_v, bars_h, sill)
}

def shutter(sw: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Ставня: щит из трёх вертикальных досок плюс две поперечные планки; центр в 0, лицо в +Z."""
    panel = parts.plank_panel(w = sw, h = h, t = 0.05, n = 3, rng = rng)
    b1 = parts.piece(size = vec3(sw - 0.03, 0.06, 0.03), pos = vec3(0, h * 0.3, 0.04), grp = "wood")
    b2 = parts.piece(size = vec3(sw - 0.03, 0.06, 0.03), pos = vec3(0, 0.0 - h * 0.3, 0.04), grp = "wood")
    out = merge(panel, b1, b2)
}

def shuttered_window(w: f32, h: f32, off: f32, rng: rng, cols: int = 2, rows: int = 2) -> (out: geo<mesh>) {
    """Окно `window(w, h, cols, rows)` с двумя распахнутыми ставнями плашмя к стене по
    бокам рамы (ставня — 0.48 w, из трёх досок); off — z центра ставен относительно
    окна (у каменного этажа больше: кладка выступает до 0.2). rng — оттенки и выступы досок."""
    win = window(w = w, h = h, cols = cols, rows = rows)
    sw = w * 0.48
    sh_l = transform(shutter(sw = sw, h = h * 0.96, rng = split_rng(rng, key = "l")), translate = vec3(0.0 - w * 0.5 - sw * 0.5 - 0.03, 0, off))
    sh_r = transform(shutter(sw = sw, h = h * 0.96, rng = split_rng(rng, key = "r")), translate = vec3(w * 0.5 + sw * 0.5 + 0.03, 0, off))
    out = merge(win, sh_l, sh_r)
}
