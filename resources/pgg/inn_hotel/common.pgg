# Общий геометрический словарь углового отеля в стиле streamline moderne.
# План/дуги/валик — lib.plan; здесь только окраска групп, плитка палубы и ограждения.
import lib.parts
import lib.plan as plan

def to_group(g: geo<mesh>, src: string, dst: string) -> (out: geo<mesh>) {
    """Переметить грани из группы src в dst (ingroup-маска, затем снять src) —
    точёные и дощатые детали из библиотек приходят в своих группах."""
    out = unmark(mark(g, dst, where = ingroup(src), domain = faces), src)
}

def band(w: f32, d: f32, r: f32, y: f32, h: f32, grp: string = "trim") -> (out: geo<mesh>) {
    """Межэтажный поясок-«скоростная линия»: круглый валик по всему периметру, низ на y.
    Вынос заметно больше выноса штукатурки эркера (+0.04): поясок должен читаться
    самостоятельной тенеобразующей полкой, а не микроступенью — иначе гнутая
    поверхность рассыпается на «рустованные блоки»."""
    out = plan.roll(w = w, d = d, r = r, y = y, h = h, p = 0.34, grp = grp, n = 5)
}

def tile_deck(w: f32, d: f32, r: f32, y: f32, pitch: f32, rng: rng) -> (out: geo<mesh>) {
    """Плитка кровельной палубы: сетка плиток с шагом pitch, обрезанная контуром
    плана (кладём только плитки, чей центр внутри скругления), свой @tint на плитку."""
    nx = int(w / pitch)
    nz = int(d / pitch)
    anchors = plan.point_grid(nx = nx, nz = nz, pitch = pitch, y = y, stagger = 0.0)
    # Обрезка по скруглению: снаружи угловой четверти оставляем только то, что в радиусе.
    px = dot(@P, (1, 0, 0))
    pz = dot(@P, (0, 0, 1))
    cx = w * 0.5 - r
    cz = d * 0.5 - r
    in_corner = px > cx & pz > cz
    kept = delete(anchors, where = in_corner & (length(vec3(px - cx, 0, pz - cz)) > r))
    shade = random(lo = 0.72, hi = 1.24, rng = split_rng(rng, key = "tint"))
    tinted = set(kept, "tint", vec3(shade * 0.94, shade, shade * 1.08))
    tile = parts.cbox(size = vec3(pitch - 0.03, 0.06, pitch - 0.03), k = 0.14)
    out = mark(realize(instance_on_points(tinted, source = tile)), "roof", where = true, domain = faces)
}

def rail_arc(cx: f32, cz: f32, r: f32, y: f32, h: f32, a0: f32, a1: f32, n: int) -> (out: geo<mesh>) {
    """Кованое ограждение по дуге: гнутые верхний и нижний прогоны (arc_shell) и
    вертикальные балясины на якорях дуги."""
    top_r = plan.arc_shell(cx = cx, cz = cz, r_in = r - 0.025, r_out = r + 0.025, a0 = a0, a1 = a1, y0 = y + h - 0.05, y1 = y + h, grp = "iron", n = n + 4)
    bot_r = plan.arc_shell(cx = cx, cz = cz, r_in = r - 0.02, r_out = r + 0.02, a0 = a0, a1 = a1, y0 = y + 0.06, y1 = y + 0.10, grp = "iron", n = n + 4)
    pk = parts.cbox(size = vec3(0.05, h - 0.06, 0.05), k = 0.2)
    pts = plan.arc_mid_anchors(cx = cx, cz = cz, r = r, y = y + (h + 0.06) * 0.5, a0 = a0, a1 = a1, n = n)
    pickets = mark(realize(instance_on_points(pts, source = pk)), "iron", where = true, domain = faces)
    out = merge(top_r, bot_r, pickets)
}

def rail_run(len: f32, h: f32) -> (out: geo<mesh>) {
    """Прямой пролёт кованого ограждения вдоль X (центр в 0, низ на y = 0)."""
    expect len > 0.3: "rail_run: пролёт короче 0.3"
    top_r = parts.piece(size = vec3(len, 0.05, 0.05), pos = vec3(0, h - 0.025, 0), grp = "iron")
    bot_r = parts.piece(size = vec3(len, 0.04, 0.04), pos = vec3(0, 0.08, 0), grp = "iron")
    n_p = int(len / 0.42)
    pts = transform(mesh_line(count = n_p, length = f32(n_p - 1) * 0.42, dir = (1, 0, 0)), translate = vec3(0.0 - f32(n_p - 1) * 0.42 * 0.5, (h + 0.06) * 0.5, 0))
    pk = parts.cbox(size = vec3(0.05, h - 0.06, 0.05), k = 0.2)
    pickets = mark(realize(instance_on_points(pts, source = pk)), "iron", where = true, domain = faces)
    out = merge(top_r, bot_r, pickets)
}
