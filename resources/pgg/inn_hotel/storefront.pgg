# Первый этаж отеля: кирпичные стены прямых участков, светлый цокольный поясок,
# деревянный подзор, гнутая витрина таверны с освещённым залом за стеклом, входная
# дверь в светлом пилоне у правого конца дуги, стеклянный козырёк на тягах,
# настенные фонари и меню-борд с подсвеченными экранами.
#
# Раскладка по дуге (0° — на фасаде +X, 90° — на фасаде +Z): [−5°..door_a] —
# светлый пилон с дверью, [door_a..90°] — остеклённая витрина сегментами. Круглый
# угол в стенах открыт (shell.straight_walls), поэтому за стеклом есть настоящая
# глубина под зал.
import lib.parts
import lib.fixtures
import lib.plan as plan
import inn_hotel.shell as shell
import inn_hotel.windows as windows

def base_course(bw: f32, bd: f32, cr: f32, y0: f32, y1: f32) -> (out: geo<mesh>) {
    """Светлый каменный цокольный поясок по всему периметру — подошва фасада.
    Заодно закрывает круглый угол ниже витрины."""
    lo = plan.plan_prism(w = bw + 0.34, d = bd + 0.34, r = cr + 0.17, y0 = y0, y1 = y1 - 0.10, grp = "trim")
    cap = plan.plan_prism(w = bw + 0.46, d = bd + 0.46, r = cr + 0.23, y0 = y1 - 0.10, y1 = y1, grp = "trim")
    out = merge(lo, cap)
}

def wainscot(cx: f32, cz: f32, cr: f32, y0: f32, y1: f32, a0: f32, a1: f32) -> (out: geo<mesh>) {
    """Деревянная панель-подзор под витриной: гнутая раковина по дуге, полка-отлив
    сверху и частые вертикальные накладные рейки (филёнчатый ритм референса)."""
    shell_w = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.10, r_out = cr + 0.13, a0 = a0, a1 = a1, y0 = y0, y1 = y1, grp = "wood", n = 17)
    cap = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.12, r_out = cr + 0.19, a0 = a0, a1 = a1, y0 = y1, y1 = y1 + 0.08, grp = "wood", n = 17)
    rib = parts.piece(size = vec3(0.05, y1 - y0 - 0.12, 0.06), pos = (0, 0, 0), grp = "wood")
    ribs = mark(realize(instance_on_points(plan.arc_mid_anchors(cx = cx, cz = cz, r = cr + 0.14, y = (y0 + y1) * 0.5 - 0.02, a0 = a0, a1 = a1, n = 13), source = rib)), "wood", where = true, domain = faces)
    out = merge(shell_w, cap, ribs)
}

def tavern(cx: f32, cz: f32, cr: f32, y0: f32, y1: f32, n_seg: int, rng: rng) -> (out: geo<mesh>) {
    """Зал таверны за витриной: тёплая задняя стенка на глубине 1.5, светящийся
    потолок-подсвет и силуэты мебели по сегментам дуги — источник референсного
    тёплого свечения проёма."""
    back = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.92, r_out = cr - 0.84, a0 = -6.0, a1 = 96.0, y0 = y0 - 0.2, y1 = y1 + 0.2, grp = "warm", n = 15)
    ceil = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.86, r_out = cr - 0.12, a0 = -6.0, a1 = 96.0, y0 = y1 - 0.12, y1 = y1, grp = "warm", n = 15)
    span = (96.0 + 6.0) / f32(n_seg)
    blk = parts.piece(size = vec3(plan.chord(r = cr, span_deg = span) * 0.60, 0.66, 0.34), pos = (0, 0, 0), grp = "furn")
    pts0 = plan.arc_mid_anchors(cx = cx, cz = cz, r = cr - 0.52, y = y0 + 0.44, a0 = -6.0, a1 = 96.0, n = n_seg)
    shade = random(lo = 0.82, hi = 1.18, rng = split_rng(rng, key = "furn"))
    pts = set(pts0, "tint", vec3(shade, shade * 0.95, shade * 0.88))
    furn = mark(realize(instance_on_points(pts, source = blk)), "furn", where = true, domain = faces)
    out = merge(back, ceil, furn)
}

def glazing(cx: f32, cz: f32, cr: f32, y0: f32, y1: f32, a0: f32, a1: f32, n_seg: int) -> (out: geo<mesh>) {
    """Гнутая витрина: стёкла плоскими вставками по сегментам дуги, тёмные средники
    на границах и верхняя обвязка-импост. Радиусы от cr — линии стекла."""
    expect n_seg >= 2: "glazing: минимум два сегмента"
    span = (a1 - a0) / f32(n_seg)
    seg_w = plan.chord(r = cr, span_deg = span)
    yc = (y0 + y1) * 0.5
    # Сплошного полотна стекла нет намеренно: непрозрачная плита закрыла бы зал.
    # Витраж читается переплётом — импост по каждому сегменту и средники.
    trans = parts.piece(size = vec3(seg_w - 0.05, 0.10, 0.15), pos = vec3(0, (y1 - y0) * 0.28, 0.0), grp = "frame")
    leaves = realize(instance_on_points(plan.arc_mid_anchors(cx = cx, cz = cz, r = cr, y = yc, a0 = a0, a1 = a1, n = n_seg), source = trans))
    mull = parts.piece(size = vec3(0.11, y1 - y0, 0.24), pos = (0, 0, 0), grp = "frame")
    mulls = mark(realize(instance_on_points(plan.arc_anchors(cx = cx, cz = cz, r = cr + 0.04, y = yc, a0 = a0, a1 = a1, n = n_seg + 1), source = mull)), "frame", where = true, domain = faces)
    head = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.18, r_out = cr + 0.18, a0 = a0 - 1.5, a1 = a1 + 1.5, y0 = y1, y1 = y1 + 0.16, grp = "frame", n = 17)
    out = merge(leaves, mulls, head)
}

def door_pier(cx: f32, cz: f32, cr: f32, y0: f32, y1: f32, a0: f32, a1: f32) -> (out: geo<mesh>) {
    """Светлый пилон входа: гнутая каменная стенка на дуге от a0 до a1 во всю высоту
    первого этажа — в неё врезана дверь."""
    out = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.14, r_out = cr + 0.12, a0 = a0, a1 = a1, y0 = y0, y1 = y1, grp = "trim", n = 9)
}

def entrance(cx: f32, cz: f32, cr: f32, y0: f32, a_mid: f32, rng: rng) -> (out: geo<mesh>) {
    """Дверь в пилоне: тёмное полотно из досок со стеклянной верхней филёнкой,
    накладная светлая обналичка, латунная ручка и порог. Ставится на дугу лицом
    наружу (поворот вокруг Y на 90° − a_mid)."""
    dw = 1.10
    dh = 2.40
    ar = radians(a_mid)
    jamb_l = parts.piece(size = vec3(0.16, dh + 0.26, 0.14), pos = vec3(0.0 - dw * 0.5 - 0.08, (dh + 0.26) * 0.5, 0.02), grp = "trim")
    jamb_r = parts.piece(size = vec3(0.16, dh + 0.26, 0.14), pos = vec3(dw * 0.5 + 0.08, (dh + 0.26) * 0.5, 0.02), grp = "trim")
    lintel = parts.piece(size = vec3(dw + 0.48, 0.20, 0.17), pos = vec3(0, dh + 0.36, 0.03), grp = "trim")
    reveal = parts.piece(size = vec3(dw + 0.10, dh + 0.10, 0.07), pos = vec3(0, (dh + 0.10) * 0.5, -0.06), grp = "frame")
    leaf = transform(parts.plank_panel(w = dw - 0.06, h = dh * 0.62, t = 0.10, n = 4, rng = split_rng(rng, key = "leaf")), translate = vec3(0, dh * 0.31, -0.01))
    lite = parts.piece(size = vec3(dw - 0.24, dh * 0.28, 0.06), pos = vec3(0, dh * 0.78, -0.02), grp = "warm")
    lite_bar = parts.piece(size = vec3(0.07, dh * 0.28, 0.10), pos = vec3(0, dh * 0.78, 0.01), grp = "wood")
    rail = parts.piece(size = vec3(dw - 0.06, 0.11, 0.12), pos = vec3(0, dh * 0.62, 0.01), grp = "wood")
    knob = mark(transform(ico_sphere(subdiv = 1, radius = 0.05), translate = vec3(dw * 0.34, dh * 0.44, 0.07)), "brass", where = true, domain = faces)
    step = parts.piece(size = vec3(dw + 0.44, 0.11, 0.34), pos = vec3(0, 0.055, 0.10), grp = "trim")
    unit = merge(jamb_l, jamb_r, lintel, reveal, leaf, lite, lite_bar, rail, knob, step)
    placed = transform(unit, rotate = vec3(0, 90.0 - a_mid, 0))
    out = transform(placed, translate = vec3(cx + (cr + 0.17) * cos(ar), y0, cz + (cr + 0.17) * sin(ar)))
}

def canopy(bw: f32, bd: f32, cr: f32, cx: f32, cz: f32, y: f32, out_r: f32 = 1.62) -> (out: geo<mesh>) {
    """Стеклянный козырёк над витриной: гнутая полка полупрозрачного стекла в тёмной
    обвязке, радиальные рёбра, наклонные тяги к стене и плоские продолжения на оба
    прямых фасада."""
    a0 = -8.0
    a1 = 98.0
    glass = plan.arc_shell(cx = cx, cz = cz, r_in = cr + 0.06, r_out = cr + out_r, a0 = a0, a1 = a1, y0 = y, y1 = y + 0.05, grp = "canopy", n = 19)
    rim_out = plan.arc_shell(cx = cx, cz = cz, r_in = cr + out_r - 0.11, r_out = cr + out_r + 0.05, a0 = a0, a1 = a1, y0 = y - 0.15, y1 = y + 0.11, grp = "iron", n = 19)
    rim_in = plan.arc_shell(cx = cx, cz = cz, r_in = cr + 0.03, r_out = cr + 0.16, a0 = a0, a1 = a1, y0 = y - 0.05, y1 = y + 0.11, grp = "iron", n = 19)
    rib = parts.piece(size = vec3(0.08, 0.08, out_r - 0.02), pos = vec3(0, 0, (out_r + 0.06) * 0.5), grp = "iron")
    ribs = mark(realize(instance_on_points(plan.arc_anchors(cx = cx, cz = cz, r = cr + 0.05, y = y + 0.02, a0 = a0, a1 = a1, n = 8), source = rib)), "iron", where = true, domain = faces)
    # Тяги: прут от стены выше козырька к его наружной кромке (наклон в локальной
    # плоскости YZ инстанса — поворот вокруг локального X).
    rise = 0.92
    tie_len = sqrt(out_r * out_r + rise * rise)
    tie = transform(parts.piece(size = vec3(0.05, tie_len, 0.05), pos = (0, 0, 0), grp = "iron"), rotate = vec3(degrees(atan2(out_r, rise)), 0, 0))
    ties = mark(realize(instance_on_points(plan.arc_anchors(cx = cx, cz = cz, r = cr + out_r * 0.5, y = y + rise * 0.5, a0 = 8.0, a1 = 82.0, n = 4), source = tie)), "iron", where = true, domain = faces)
    # Плоские продолжения на фасады +X (полоса по Z) и +Z (по X).
    ext = 1.62
    gx = parts.piece(size = vec3(out_r, 0.05, ext), pos = vec3(bw * 0.5 + out_r * 0.5, y + 0.025, cz - ext * 0.5), grp = "canopy")
    gz = parts.piece(size = vec3(ext, 0.05, out_r), pos = vec3(cx - ext * 0.5, y + 0.025, bd * 0.5 + out_r * 0.5), grp = "canopy")
    ex = parts.piece(size = vec3(0.14, 0.26, ext), pos = vec3(bw * 0.5 + out_r, y - 0.02, cz - ext * 0.5), grp = "iron")
    ez = parts.piece(size = vec3(ext, 0.26, 0.14), pos = vec3(cx - ext * 0.5, y - 0.02, bd * 0.5 + out_r), grp = "iron")
    cap_x = parts.piece(size = vec3(out_r + 0.16, 0.26, 0.14), pos = vec3(bw * 0.5 + out_r * 0.5, y - 0.02, cz - ext), grp = "iron")
    cap_z = parts.piece(size = vec3(0.14, 0.26, out_r + 0.16), pos = vec3(cx - ext, y - 0.02, bd * 0.5 + out_r * 0.5), grp = "iron")
    out = merge(glass, rim_out, rim_in, ribs, ties, gx, gz, ex, ez, cap_x, cap_z)
}

def menu_board(w: f32, h: f32) -> (out: geo<mesh>) {
    """Меню-борд: тёмная рама с тремя подсвеченными экранами (лицо +Z, центр в 0)."""
    frame = parts.piece(size = vec3(w, h, 0.08), pos = (0, 0, 0), grp = "frame")
    scr0 = parts.piece(size = vec3(w - 0.13, h * 0.26, 0.05), pos = vec3(0, h * 0.31, 0.03), grp = "screen")
    scr1 = parts.piece(size = vec3(w - 0.13, h * 0.26, 0.05), pos = vec3(0, 0.0, 0.03), grp = "screen")
    scr2 = parts.piece(size = vec3(w - 0.13, h * 0.26, 0.05), pos = vec3(0, 0.0 - h * 0.31, 0.03), grp = "screen")
    out = merge(frame, scr0, scr1, scr2)
}

def ground_floor(bw: f32, bd: f32, cr: f32, walk_top: f32, base_top: f32, g_top: f32, door_a: f32, glz_a0: f32, rng: rng) -> (out: geo<mesh>) {
    """Сборка первого этажа: кирпичные стены прямых участков, цокольный поясок,
    пилон с дверью, подзор, витрина с залом, фриз, козырёк, фонари, меню-борд и
    окна кирпичных флангов. door_a — ось двери на дуге, glz_a0 — начало витрины."""
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    a_glz = glz_a0
    wain_top = base_top + 0.86
    head_y = g_top - 0.66

    walls = merge(shell.straight_walls(bw = bw, bd = bd, cr = cr, y0 = walk_top, y1 = g_top, grp = "brick"), shell.brick_skins(bw = bw, bd = bd, cr = cr, y0 = base_top, y1 = g_top, rng = split_rng(rng, key = "skin")))
    base = base_course(bw = bw, bd = bd, cr = cr, y0 = walk_top, y1 = base_top)
    pier = door_pier(cx = cx, cz = cz, cr = cr, y0 = base_top - 0.10, y1 = g_top, a0 = -11.0, a1 = a_glz)
    hall = tavern(cx = cx, cz = cz, cr = cr, y0 = base_top, y1 = head_y, n_seg = 6, rng = split_rng(rng, key = "hall"))
    wain = wainscot(cx = cx, cz = cz, cr = cr, y0 = base_top, y1 = wain_top, a0 = a_glz, a1 = 92.0)
    glaz = glazing(cx = cx, cz = cz, cr = cr, y0 = wain_top + 0.08, y1 = head_y, a0 = a_glz, a1 = 92.0, n_seg = 5)
    # Фриз между импостом витрины и верхом первого этажа — закрывает дугу.
    frieze = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.14, r_out = cr + 0.10, a0 = -11.0, a1 = 93.0, y0 = head_y + 0.16, y1 = g_top, grp = "trim", n = 17)
    door = entrance(cx = cx, cz = cz, cr = cr, y0 = base_top, a_mid = door_a, rng = split_rng(rng, key = "door"))
    can = canopy(bw = bw, bd = bd, cr = cr, cx = cx, cz = cz, y = g_top - 0.30)

    # Фонари: один на пилоне у входа, один на кирпичном фланге +Z.
    la = radians(a_glz + 4.0)
    lamp_arc = transform(transform(fixtures.lantern(at = vec3(0, 0, 0)), rotate = vec3(0, 90.0 - a_glz - 4.0, 0)), translate = vec3(cx + (cr + 0.13) * cos(la), base_top + 1.72, cz + (cr + 0.13) * sin(la)))
    lamp_z = transform(fixtures.lantern(at = vec3(0, 0, 0)), translate = vec3(0.0 - bw * 0.5 + 0.85, base_top + 1.72, bd * 0.5 + 0.09))
    board = transform(menu_board(w = 0.66, h = 1.12), translate = vec3(0.35, base_top + 1.52, bd * 0.5 + 0.11))
    wins = windows.flank_windows(bw = bw, bd = bd, w = 0.94, h = 1.52, y = base_top + 1.02, rng = split_rng(rng, key = "gwin"))
    out = merge(walls, base, pier, hall, wain, glaz, frieze, door, can, lamp_arc, lamp_z, board, wins)
}
