# Подошва квартала: каменная терраса под домом, булыжная мостовая с бордюром по
# внешнему краю и тёплая плитка-предвходовая площадка веером у круглого угла.
#
# Булыжник — сетка инстансов, из которой удаляются камни под домом и под площадкой:
# обе маски считаются в плане (точка внутри скругления / внутри угловой четверти),
# поэтому мостовая и площадка стыкуются без зазора и наложения.
import lib.parts
import lib.plan as plan

def inside_plan(w: f32, d: f32, r: f32, cx: f32, cz: f32) -> (out: field<bool>) {
    """Маска «точка плана внутри контура со скруглённым углом (+X, +Z)»: прямоугольник
    w×d, а в угловой четверти — ещё и внутри радиуса r от (cx, cz)."""
    px = dot(@P, (1, 0, 0))
    pz = dot(@P, (0, 0, 1))
    rect = px > 0.0 - w * 0.5 & px < w * 0.5 & pz > 0.0 - d * 0.5 & pz < d * 0.5
    in_q = px > cx & pz > cz
    out = rect & (in_q ? length(vec3(px - cx, 0, pz - cz)) < r : true)
}

def terrace(bw: f32, bd: f32, cr: f32, ext: f32, y0: f32, y1: f32) -> (out: geo<mesh>) {
    """Каменная плита-терраса вокруг дома: контур плана, раздутый на ext."""
    out = plan.plan_prism(w = bw + 2.0 * ext, d = bd + 2.0 * ext, r = cr + ext, y0 = y0, y1 = y1, grp = "stone")
}

def curb(bw: f32, bd: f32, cr: f32, ext: f32, y: f32, h: f32, t: f32 = 0.36) -> (out: geo<mesh>) {
    """Бордюрный камень по внешней кромке террасы: гнутый сегмент по круглому углу и
    четыре прямых бруса по прямым кромкам. Именно рант, а не плита — plan_prism даёт
    сплошное тело и накрыл бы всю мостовую."""
    xs = bw * 0.5 + ext
    zs = bd * 0.5 + ext
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    arc = plan.arc_shell(cx = cx, cz = cz, r_in = cr + ext - t, r_out = cr + ext, a0 = 0.0, a1 = 90.0, y0 = y, y1 = y + h, grp = "trim", n = 17)
    yc = y + h * 0.5
    e_x = parts.piece(size = vec3(t, h, cz + zs), pos = vec3(xs - t * 0.5, yc, (cz - zs) * 0.5), grp = "trim")
    e_z = parts.piece(size = vec3(cx + xs, h, t), pos = vec3((cx - xs) * 0.5, yc, zs - t * 0.5), grp = "trim")
    b_x = parts.piece(size = vec3(t, h, 2.0 * zs), pos = vec3(t * 0.5 - xs, yc, 0), grp = "trim")
    b_z = parts.piece(size = vec3(2.0 * xs, h, t), pos = vec3(0, yc, t * 0.5 - zs), grp = "trim")
    out = merge(arc, e_x, e_z, b_x, b_z)
}

def cobbles(bw: f32, bd: f32, cr: f32, ext: f32, y: f32, pitch: f32, apron_r: f32, rng: rng) -> (out: geo<mesh>) {
    """Булыжная мостовая: сетка камней с шагом pitch по террасе, минус пятно дома
    (контур + отмостка) и минус угловая площадка радиуса apron_r. Нечётные ряды
    смещены на полшага, у каждого камня свой @tint и микроповорот."""
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    w = bw + 2.0 * ext - 0.60
    d = bd + 2.0 * ext - 0.60
    nx = int(w / pitch)
    nz = int(d / pitch)
    g2 = plan.point_grid(nx = nx, nz = nz, pitch = pitch, y = y, stagger = 0.5)
    px = dot(@P, (1, 0, 0))
    pz = dot(@P, (0, 0, 1))
    under_house = inside_plan(w = bw + 0.62, d = bd + 0.62, r = cr + 0.31, cx = cx, cz = cz)
    under_apron = px > cx & pz > cz & length(vec3(px - cx, 0, pz - cz)) < apron_r
    kept = delete(g2, where = under_house | under_apron)
    shade = random(lo = 0.66, hi = 1.30, rng = split_rng(rng, key = "tint"))
    tinted = set(kept, "tint", vec3(shade * 1.02, shade, shade * 1.04))
    jit = set_position(tinted, offset = random_vec(lo = vec3(-0.012, -0.008, -0.012), hi = vec3(0.012, 0.004, 0.012), rng = split_rng(rng, key = "jit")))
    spun = set(jit, "orient", orient_from_euler(vec3(0, random(lo = -7.0, hi = 7.0, rng = split_rng(rng, key = "yaw")), 0)), domain = points)
    stone = parts.cbox(size = vec3(pitch - 0.045, 0.10, pitch - 0.045), k = 0.20)
    out = mark(realize(instance_on_points(spun, source = stone)), "cobble", where = true, domain = faces)
}

def apron(bw: f32, bd: f32, cr: f32, y: f32, r_out: f32, rng: rng) -> (out: geo<mesh>) {
    """Предвходовая площадка: тёплая плитка веером в угловой четверти от отмостки
    дома до радиуса r_out, плюс низкая ступень-обрамление по её внешней дуге."""
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    r_in = cr + 0.26
    n_ring = 4
    n_seg = 11
    step_r = (r_out - r_in) / f32(n_ring)
    # Плитка веером: n_ring концентрических рядов по n_seg секторов.
    ring = repeat (fan_ring(cx = cx, cz = cz, r0 = r_in, r1 = r_in + step_r * 0.94, y = y, n = n_seg, rng = split_rng(rng, key = "r0")), iterations = n_ring - 1) |acc| {
        k = f32(@iteration) + 1.0
        ra = r_in + k * step_r
        acc = merge(acc, fan_ring(cx = cx, cz = cz, r0 = ra, r1 = ra + step_r * 0.94, y = y, n = n_seg + @iteration + 1, rng = split_rng(rng, key = "r1")))
    }
    edge = plan.arc_shell(cx = cx, cz = cz, r_in = r_out, r_out = r_out + 0.22, a0 = -3.0, a1 = 93.0, y0 = y - 0.10, y1 = y + 0.05, grp = "trim", n = 17)
    out = merge(ring, edge)
}

def fan_ring(cx: f32, cz: f32, r0: f32, r1: f32, y: f32, n: int, rng: rng) -> (out: geo<mesh>) {
    """Один концентрический ряд плитки площадки: n плоских вставок по сектору дуги,
    ширина вставки — хорда сегмента среднего радиуса, свой @tint на плитку."""
    rm = (r0 + r1) * 0.5
    span = 90.0 / f32(n)
    tile = parts.cbox(size = vec3(plan.chord(r = rm, span_deg = span) - 0.035, 0.10, r1 - r0 - 0.035), k = 0.16)
    pts0 = plan.arc_mid_anchors(cx = cx, cz = cz, r = rm, y = y, a0 = 0.0, a1 = 90.0, n = n)
    shade = random(lo = 0.80, hi = 1.18, rng = split_rng(rng, key = "tint"))
    pts = set(pts0, "tint", vec3(shade * 1.05, shade, shade * 0.90))
    out = mark(realize(instance_on_points(pts, source = tile)), "apron", where = true, domain = faces)
}

def steps(bw: f32, bd: f32, cr: f32, y_walk: f32, y_base: f32, a_mid: f32) -> (out: geo<mesh>) {
    """Две гнутые ступени у входа: от мостовой на уровень цокольного пояска, по дуге
    вокруг дверного отсека."""
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    dy = (y_base - y_walk) * 0.5
    s0 = plan.arc_shell(cx = cx, cz = cz, r_in = cr + 0.02, r_out = cr + 0.72, a0 = a_mid - 17.0, a1 = a_mid + 17.0, y0 = y_walk, y1 = y_walk + dy, grp = "trim", n = 9)
    s1 = plan.arc_shell(cx = cx, cz = cz, r_in = cr + 0.02, r_out = cr + 0.40, a0 = a_mid - 15.0, a1 = a_mid + 15.0, y0 = y_walk + dy, y1 = y_base, grp = "trim", n = 9)
    out = merge(s0, s1)
}

def street_base(bw: f32, bd: f32, cr: f32, walk_top: f32, base_top: f32, door_a: f32, rng: rng) -> (out: geo<mesh>) {
    """Сборка подошвы: терраса, бордюр, булыжник, предвходовая площадка и ступени."""
    ext = 1.95
    apron_r = cr + 1.72
    terr = terrace(bw = bw, bd = bd, cr = cr, ext = ext, y0 = 0.0, y1 = walk_top - 0.06)
    rim = curb(bw = bw, bd = bd, cr = cr, ext = ext, y = walk_top - 0.10, h = 0.20)
    cob = cobbles(bw = bw, bd = bd, cr = cr, ext = ext, y = walk_top - 0.01, pitch = 0.42, apron_r = apron_r, rng = split_rng(rng, key = "cob"))
    apr = apron(bw = bw, bd = bd, cr = cr, y = walk_top, r_out = apron_r, rng = split_rng(rng, key = "apron"))
    st = steps(bw = bw, bd = bd, cr = cr, y_walk = walk_top, y_base = base_top, a_mid = door_a)
    out = merge(terr, rim, cob, apr, st)
}
