# Неоновая вывеска-«лопасть» INN: тёмное щитовое поле с неоновой рамкой и тремя
# литерами из трубок, вынесенное кронштейнами от кирпичного фасада +X.
#
# Литеры набираются в локальной плоскости Y–Z (нормаль щита — +X): вертикальные
# штрихи — брусья вдоль Y, диагональ N — брус, повёрнутый вокруг локального X.
import lib.parts

def bar_v(h: f32, t: f32, at: vec3) -> (out: geo<mesh>) {
    """Вертикальный штрих литеры высотой h (толщина t), центр в at."""
    out = parts.piece(size = vec3(t * 0.8, h, t), pos = at, grp = "neon")
}

def bar_z(len: f32, t: f32, at: vec3) -> (out: geo<mesh>) {
    """Поперечный штрих литеры длиной len вдоль Z (засечка), центр в at."""
    out = parts.piece(size = vec3(t * 0.8, t, len), pos = at, grp = "neon")
}

def glyph_i(lh: f32, lw: f32, t: f32, at: vec3) -> (out: geo<mesh>) {
    """Литера I: ствол с верхней и нижней засечками. Центр клетки в at."""
    stem = bar_v(h = lh, t = t, at = at)
    top = bar_z(len = lw * 0.72, t = t, at = at + vec3(0, lh * 0.5 - t * 0.5, 0))
    bot = bar_z(len = lw * 0.72, t = t, at = at + vec3(0, t * 0.5 - lh * 0.5, 0))
    out = merge(stem, top, bot)
}

def glyph_n(lh: f32, lw: f32, t: f32, at: vec3) -> (out: geo<mesh>) {
    """Литера N: два ствола по краям клетки и диагональ между их верхом и низом.
    Диагональ — брус длиной по гипотенузе, повёрнутый вокруг локального X."""
    hw = lw * 0.5 - t * 0.5
    left = bar_v(h = lh, t = t, at = at + vec3(0, 0, hw))
    right = bar_v(h = lh, t = t, at = at + vec3(0, 0, 0.0 - hw))
    dz = 2.0 * hw
    dlen = sqrt(dz * dz + lh * lh)
    ang = degrees(atan2(dz, lh))
    diag0 = parts.piece(size = vec3(t * 0.8, dlen - t * 0.4, t * 0.86), pos = (0, 0, 0), grp = "neon")
    diag = transform(transform(diag0, rotate = vec3(ang, 0, 0)), translate = at)
    out = merge(left, right, diag)
}

def blade(bh: f32, bwz: f32, t: f32, rng: rng) -> (out: geo<mesh>) {
    """Щит вывески в локальной системе (нормаль +X, центр в 0): тёмное поле, неоновая
    рамка по контуру и литеры I / N / N сверху вниз."""
    field = parts.piece(size = vec3(0.10, bh, bwz), pos = (0, 0, 0), grp = "board")
    back = parts.piece(size = vec3(0.06, bh - 0.06, bwz - 0.06), pos = vec3(-0.07, 0, 0), grp = "frame")
    # Неоновая рамка: две продольные и две поперечные трубки с отступом от края.
    m = 0.09
    fr_t = bar_z(len = bwz - 2.0 * m, t = 0.05, at = vec3(0.06, bh * 0.5 - m, 0))
    fr_b = bar_z(len = bwz - 2.0 * m, t = 0.05, at = vec3(0.06, m - bh * 0.5, 0))
    fr_l = bar_v(h = bh - 2.0 * m, t = 0.05, at = vec3(0.06, 0, bwz * 0.5 - m))
    fr_r = bar_v(h = bh - 2.0 * m, t = 0.05, at = vec3(0.06, 0, m - bwz * 0.5))
    # Три клетки литер по высоте щита.
    cell = (bh - 2.0 * m - 0.20) / 3.0
    lh = cell * 0.74
    lw = bwz - 2.0 * m - 0.22
    y_i = cell
    g_i = glyph_i(lh = lh, lw = lw, t = t, at = vec3(0.09, y_i, 0))
    g_n1 = glyph_n(lh = lh, lw = lw, t = t, at = vec3(0.09, 0.0, 0))
    g_n2 = glyph_n(lh = lh, lw = lw, t = t, at = vec3(0.09, 0.0 - y_i, 0))
    dust = set(merge(fr_t, fr_b, fr_l, fr_r), "tint", vec3(1.0, 0.96, 0.9) * random(lo = 0.95, hi = 1.05, rng = split_rng(rng, key = "neon")))
    out = merge(field, back, dust, g_i, g_n1, g_n2)
}

def inn_sign(bw: f32, bd: f32, y_top: f32, rng: rng) -> (out: geo<mesh>) {
    """Вывеска на фасаде +X: щит, вынесенный на 0.34 от стены двумя кронштейнами с
    подкосами; верх щита на отметке y_top, ось — в средней части кирпичного фланга."""
    bh = 3.85
    bwz = 1.12
    gap = 0.34
    z0 = 0.0 - bd * 0.5 + 2.05
    x_wall = bw * 0.5
    x_board = x_wall + gap + 0.05
    yc = y_top - bh * 0.5
    board = transform(blade(bh = bh, bwz = bwz, t = 0.125, rng = rng), translate = vec3(x_board, yc, z0))
    # Кронштейны: горизонтальные консоли от стены к щиту плюс наклонные подкосы.
    arm_y0 = y_top - 0.24
    arm_y1 = y_top - bh + 0.42
    arm0 = parts.piece(size = vec3(gap + 0.10, 0.09, 0.09), pos = vec3(x_wall + (gap + 0.10) * 0.5, arm_y0, z0), grp = "iron")
    arm1 = parts.piece(size = vec3(gap + 0.10, 0.09, 0.09), pos = vec3(x_wall + (gap + 0.10) * 0.5, arm_y1, z0), grp = "iron")
    plate0 = parts.piece(size = vec3(0.07, 0.26, 0.26), pos = vec3(x_wall + 0.03, arm_y0, z0), grp = "iron")
    plate1 = parts.piece(size = vec3(0.07, 0.26, 0.26), pos = vec3(x_wall + 0.03, arm_y1, z0), grp = "iron")
    brace_len = sqrt(gap * gap + 0.34 * 0.34)
    brace0 = transform(parts.piece(size = vec3(brace_len, 0.05, 0.05), pos = (0, 0, 0), grp = "iron"), rotate = vec3(0, 0, 0.0 - degrees(atan2(0.34, gap))))
    brace = transform(brace0, translate = vec3(x_wall + gap * 0.5, arm_y0 - 0.17, z0))
    out = merge(board, arm0, arm1, plate0, plate1, brace)
}
