# Окна отеля: гнутая лента окон эркера (по дуге, с освещённым номером за стеклом)
# и прямоугольные окна кирпичных флангов.
#
# Круглый угол корпуса оставлен открытым (см. shell.pgg), поэтому эркер собирается
# здесь целиком: штукатурные простенки под и над проёмом закрывают дугу, а сама
# оконная лента стоит перед ними, а за ней — тёплая задняя стенка номера и
# занавеси на реальной глубине. Плоская вставка точно перекрывает сегмент дуги,
# если её ширина равна хорде сегмента.
import lib.parts
import lib.plan as plan

def curtain_panel(w: f32, h: f32) -> (out: geo<mesh>) {
    """Занавесь: одна светлая панель с двумя утолщёнными складками по краям. Именно
    одна панель, а не щит из вертикальных досок: частые доски на дуге читаются
    жалюзи, а не шторой, — а нужен силуэт шторы на тёплом фоне."""
    body = parts.piece(size = vec3(w, h, 0.05), pos = (0, 0, 0), grp = "curtain")
    fold_l = parts.piece(size = vec3(w * 0.17, h, 0.08), pos = vec3(0.0 - w * 0.41, 0, 0.02), grp = "curtain")
    fold_r = parts.piece(size = vec3(w * 0.17, h, 0.08), pos = vec3(w * 0.41, 0, 0.02), grp = "curtain")
    out = merge(body, fold_l, fold_r)
}

def bay_room(cx: f32, cz: f32, cr: f32, y0: f32, y1: f32, n_seg: int, rng: rng) -> (out: geo<mesh>) {
    """Интерьер номера за гнутым окном: тёплая задняя стенка и занавеси по сегментам
    дуги — референсное «свечение изнутри с силуэтами штор». Занавесь чуть уже
    сегмента, поэтому тёплый свет обводит её по краям."""
    back = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.34, r_out = cr - 0.26, a0 = -2.0, a1 = 92.0, y0 = y0 - 0.06, y1 = y1 + 0.06, grp = "warm", n = 23)
    span = 90.0 / f32(n_seg)
    curt = curtain_panel(w = plan.chord(r = cr, span_deg = span) * 0.66, h = y1 - y0 - 0.04)
    pts0 = plan.arc_mid_anchors(cx = cx, cz = cz, r = cr - 0.19, y = (y0 + y1) * 0.5, a0 = 0.0, a1 = 90.0, n = n_seg)
    shade = random(lo = 0.88, hi = 1.10, rng = split_rng(rng, key = "curt"))
    pts = set(pts0, "tint", vec3(shade, shade * 0.98, shade * 0.94))
    curtains = realize(instance_on_points(pts, source = curt))
    out = merge(back, curtains)
}

def bay_window_band(cx: f32, cz: f32, cr: f32, y: f32, h: f32, n_seg: int, rng: rng) -> (out: geo<mesh>) {
    """Лента окон гнутого эркера: гнутые подоконная и верхняя обвязки переплёта,
    тёмные средники на границах n_seg сегментов дуги и стёкла плоскими вставками.
    Радиусы отсчитываются от cr — линии стекла."""
    expect n_seg >= 2: "bay_window_band: минимум два сегмента"
    span = 90.0 / f32(n_seg)
    seg_w = plan.chord(r = cr, span_deg = span)
    yc = y + h * 0.5

    rail_lo = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.15, r_out = cr + 0.11, a0 = -2.5, a1 = 92.5, y0 = y - 0.10, y1 = y, grp = "frame", n = 23)
    rail_hi = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.15, r_out = cr + 0.11, a0 = -2.5, a1 = 92.5, y0 = y + h, y1 = y + h + 0.10, grp = "frame", n = 23)

    # Сплошного полотна стекла нет намеренно: непрозрачная плита закрыла бы тёплый
    # интерьер за ней. Проём читается переплётом — поперечный шпрос и средники.
    sash = parts.piece(size = vec3(seg_w - 0.06, 0.08, 0.12), pos = vec3(0, 0.0 - h * 0.22, 0.0), grp = "frame")
    leaves = realize(instance_on_points(plan.arc_mid_anchors(cx = cx, cz = cz, r = cr, y = yc, a0 = 0.0, a1 = 90.0, n = n_seg), source = sash))

    mull = parts.piece(size = vec3(0.10, h + 0.04, 0.18), pos = (0, 0, 0), grp = "frame")
    mulls = mark(realize(instance_on_points(plan.arc_anchors(cx = cx, cz = cz, r = cr + 0.02, y = yc, a0 = 0.0, a1 = 90.0, n = n_seg + 1), source = mull)), "frame", where = true, domain = faces)

    out = merge(rail_lo, rail_hi, leaves, mulls, bay_room(cx = cx, cz = cz, cr = cr, y0 = y, y1 = y + h, n_seg = n_seg, rng = rng))
}

def bay_spandrels(cx: f32, cz: f32, cr: f32, fy0: f32, fy1: f32, wy0: f32, wy1: f32) -> (out: geo<mesh>) {
    """Штукатурные простенки эркера, закрывающие дугу под проёмом (fy0..wy0) и над
    ним (wy1..fy1) — светлое поле между оконными лентами."""
    lo = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.10, r_out = cr + 0.04, a0 = -1.5, a1 = 91.5, y0 = fy0, y1 = wy0 + 0.04, grp = "stucco", n = 23)
    hi = plan.arc_shell(cx = cx, cz = cz, r_in = cr - 0.10, r_out = cr + 0.04, a0 = -1.5, a1 = 91.5, y0 = wy1 - 0.04, y1 = fy1, grp = "stucco", n = 23)
    out = merge(lo, hi)
}

def flank_window(w: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Прямоугольное окно кирпичного фланга (лицо +Z, центр проёма в 0): светлый
    каменный отлив-подоконник и перемычка, выступающая тёмная рама, за ней тёплый
    задник и занавесь чуть уже проёма (тёплый свет обводит её по краю), поперечный
    шпрос перед занавесью. Стена фланга сплошная, поэтому глубину даёт вынос рамы."""
    sill = parts.piece(size = vec3(w + 0.36, 0.13, 0.30), pos = vec3(0, 0.0 - h * 0.5 - 0.065, 0.09), grp = "trim")
    head = parts.piece(size = vec3(w + 0.28, 0.12, 0.24), pos = vec3(0, h * 0.5 + 0.06, 0.06), grp = "trim")
    jamb_l = parts.piece(size = vec3(0.11, h, 0.21), pos = vec3(0.0 - w * 0.5 - 0.055, 0, 0.055), grp = "frame")
    jamb_r = parts.piece(size = vec3(0.11, h, 0.21), pos = vec3(w * 0.5 + 0.055, 0, 0.055), grp = "frame")
    lintel = parts.piece(size = vec3(w + 0.11, 0.10, 0.21), pos = vec3(0, h * 0.5 - 0.05, 0.055), grp = "frame")
    back = parts.piece(size = vec3(w, h, 0.06), pos = vec3(0, 0, -0.01), grp = "warm")
    shade = random(lo = 0.88, hi = 1.10, rng = split_rng(rng, key = "curt"))
    curt0 = set(curtain_panel(w = w * 0.62, h = h - 0.10), "tint", vec3(shade, shade * 0.98, shade * 0.94), domain = points)
    curt = transform(curt0, translate = vec3(0, 0, 0.035))
    trans = parts.piece(size = vec3(w, 0.09, 0.13), pos = vec3(0, 0.0 - h * 0.18, 0.085), grp = "frame")
    out = merge(sill, head, jamb_l, jamb_r, lintel, back, curt, trans)
}

def flank_windows(bw: f32, bd: f32, w: f32, h: f32, y: f32, rng: rng) -> (out: geo<mesh>) {
    """Окна одного этажа на двух уличных флангах: одно на кирпичном участке фасада
    +Z (слева от эркера) и одно на фасаде +X (справа-ниже эркера), в осях,
    одинаковых для всех этажей."""
    win_z = flank_window(w = w, h = h, rng = split_rng(rng, key = "z"))
    win_x = flank_window(w = w, h = h, rng = split_rng(rng, key = "x"))
    on_z = transform(win_z, translate = vec3(0.0 - bw * 0.5 + 1.30, y + h * 0.5, bd * 0.5 + 0.06))
    on_x = transform(transform(win_x, rotate = vec3(0, 90, 0)), translate = vec3(bw * 0.5 + 0.06, y + h * 0.5, 0.0 - bd * 0.5 + 1.30))
    out = merge(on_z, on_x)
}

def floor_windows(bw: f32, bd: f32, cr: f32, fy0: f32, fy1: f32, y: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Остекление одного жилого этажа (тело этажа fy0..fy1, проём y..y+h): гнутая
    лента эркера с интерьером, штукатурные простенки под и над ней и по окну на
    каждом кирпичном фланге — всё на единой отметке подоконника."""
    cx = bw * 0.5 - cr
    cz = bd * 0.5 - cr
    span = bay_spandrels(cx = cx, cz = cz, cr = cr, fy0 = fy0, fy1 = fy1, wy0 = y, wy1 = y + h)
    bay = bay_window_band(cx = cx, cz = cz, cr = cr + 0.09, y = y, h = h, n_seg = 5, rng = split_rng(rng, key = "bay"))
    flanks = flank_windows(bw = bw, bd = bd, w = 0.94, h = h * 0.88, y = y + h * 0.06, rng = split_rng(rng, key = "flank"))
    out = merge(span, bay, flanks)
}

def all_floors(bw: f32, bd: f32, cr: f32, g_top: f32, floor_u: f32, band_h: f32, n: int, rng: rng) -> (out: geo<mesh>) {
    """Остекление всех n жилых этажей: тело этажа i начинается на (g_top + band_h)
    плюс шаг (floor_u + band_h), проём — на 0.46 выше пола, поэтому подоконники всех
    этажей стоят на единых осях."""
    expect n >= 1: "all_floors: хотя бы один жилой этаж"
    sill = 0.58
    win_h = floor_u - 1.36
    step = floor_u + band_h
    fy = g_top + band_h
    f0 = floor_windows(bw = bw, bd = bd, cr = cr, fy0 = fy, fy1 = fy + floor_u, y = fy + sill, h = win_h, rng = split_rng(rng, key = 0))
    out = repeat (f0, iterations = n - 1) |acc| {
        k = f32(@iteration) + 1.0
        fyk = fy + k * step
        acc = merge(acc, floor_windows(bw = bw, bd = bd, cr = cr, fy0 = fyk, fy1 = fyk + floor_u, y = fyk + sill, h = win_h, rng = split_rng(rng, key = @iteration)))
    }
}
