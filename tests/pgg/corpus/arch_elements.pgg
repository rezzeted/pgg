# A5 (docs/pgg/architecture_library_plan.md §6.6): элементы на рёбрах и скатах.
# Дом на Г-плане: фасадное дерево (цоколь | 2 этажа | венец) → band_edges даёт рёбра
# всех полос — один терминал карниза обслуживает все этажи и объёмы через pick_role;
# крыша roof_l → желоб по всем рёбрам R_EAVE Г-плана; труба по правилу конька
# chimney_rule (автоматически выше самого высокого конька); слуховое окно на скате
# через dormer_scope; навершия на концах коньков через edge_ends. Точные проверки —
# в arch_lib_test.cpp (ArchLib.Elements*).
import lib.layout.scope as ls
import lib.layout.split as lsp
import lib.layout.edges as lse
import lib.arch.kinds as k
import lib.arch.plan as ap
import lib.arch.facade as af
import lib.arch.roof as ar
import lib.arch.elements as ae
import lib.arch.terminals_basic as tb

rng = rng_from_seed(7)

plan = ap.plan_l(w = 9.0, d = 9.0, cut_w = 3.0, cut_d = 2.5)
style = af.style_default()
wall_h = 1.2 + 2.0 * 3.6 + 0.6
fpat = lsp.pattern_add(lsp.pattern_add(lsp.pattern_add(lsp.pattern_empty(), size = 1.0, kind = k.K_WALL(), flex = true), size = 1.1, kind = k.K_WINDOW()), size = 1.0, kind = k.K_WALL(), flex = true)
slots, band_scopes = af.facade_tree(plan = plan, style = style, floors = 2, facade_pattern = fpat)

faces = af.facades(plan = plan, y0 = 0.0, y1 = wall_h, t = 0.30)
walls = af.walls(faces = faces, scopes = slots, rng = split_rng(rng, key = "walls"))
wins = ls.stamp(scopes = ls.pick(scopes = slots, kind = k.K_WINDOW()), source = tb.win_flat(w = 1.05, h = 2.2))

# Крыша Г-плана (пересечение двускатных крыльев, ендова 45°).
sl, ed, pl = ar.roof_l(w = 9.0, d = 9.0, cut_w = 3.0, cut_d = 2.5, kind = cross, pitch = 45.0, overhang = 0.4, y0 = wall_h)
tiles = ls.stamp(scopes = ar.tile_anchors(slopes = sl, planes = pl), source = tb.tile_plain())

# Карниз/пояса/отливы: рёбра всех полос (band_edges), один терминал на все этажи
# и оба объёма Г-плана — приёмка A5.
bed = af.band_edges(bands_in = band_scopes)
tops = lse.pick_role(edges = bed, role = k.R_FLOOR_TOP())
bots = lse.pick_role(edges = bed, role = k.R_FLOOR_BOTTOM())
crown = foreach e in tops {
    e = lse.place_edge(g = tb.cornice_run(len = lse.edge_len(e)), e = e)
}
sills = foreach e in bots {
    e = lse.place_edge(g = tb.trim_run(len = lse.edge_len(e)), e = e)
}

# Желоб по карнизу Г-плана (все рёбра R_EAVE) — приёмка A5.
eaves = lse.pick_role(edges = ed, role = k.R_EAVE())
gut = foreach e in eaves {
    e = lse.place_edge(g = tb.gutter_run(len = lse.edge_len(e)), e = e)
}

# Труба по правилу конька: верх автоматически выше самого высокого конька + 0.5.
chim_top = ae.chimney_rule(edges = ed, h_min = wall_h + 2.0)
chim = transform(tb.chimney_stack(w = 0.7, d = 0.7, h = chim_top - wall_h), translate = vec3(0.0 - 2.0, wall_h, 0.0 - 1.5))

# Слуховое окно на скате (island 1) и навершия на концах коньков.
ds = ae.dormer_scope(slopes = sl, planes = pl, island = 1, u = 0.8, t = 0.4, w = 0.9, h = 1.3, dep = 0.60)
dorm = ls.place(g = tb.dormer_gable(w = 0.9, h = 1.3, dep = 0.60), s = ds)
ridges = lse.pick_role(edges = ed, role = k.R_RIDGE())
ends = lse.edge_ends(edges = ridges)
fins = ls.stamp(scopes = ends, source = tb.finial_ball())

house = merge(walls, wins, sl, tiles, crown, sills, gut, chim, dorm, fins)

output bed
output tops
output bots
output eaves
output ridges
output ends
output ds
output chim
output dorm
output house
