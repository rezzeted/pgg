{
  "mcpServers": {
    "pgg": {
      "command": "/bin/sh",
      "args": [
        "tools/run_pgg_mcp_server.sh"
      ],
      "cwd": ".",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "pgg-win": {
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/run_pgg_mcp_server.ps1"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PGG_REPO_ROOT": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    }
  }
}
