{
  "mcpServers": {
    "pgg": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "tools.pgg_mcp.launch"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PGG_REPO_ROOT": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
