# A1 (docs/pgg/architecture_library_plan.md): split по паттернам —
# fixed / flex / cycle / ось Y / повёрнутый родитель; merge детей разных стадий
# без E609 (единая схема scope). Точные проверки значений — в layout_test.cpp.
import lib.layout.scope as ls
import lib.layout.split as lsp

param seed: int = 3

s = ls.scope(at = vec3(0, 0, 0), yaw = 0.0, size = vec3(10.0, 3.0, 0.4), kind = 0)

pf = lsp.pattern_add(lsp.pattern_add(lsp.pattern_add(lsp.pattern_empty(), size = 1.0, kind = 2), size = 2.0, kind = 1), size = 1.0, kind = 2)
fixed = lsp.split(s, pf)

px = lsp.pattern_add(lsp.pattern_add(lsp.pattern_add(lsp.pattern_empty(), size = 1.0, kind = 1, flex = true), size = 1.2, kind = 2), size = 1.0, kind = 1, flex = true)
flexed = lsp.split(s, px)

pr = lsp.pattern_add(lsp.pattern_add(lsp.pattern_add(lsp.pattern_empty(), size = 2.0, kind = 1), size = 1.0, kind = 2), size = 1.0, kind = 1, flex = true)
rep = lsp.split(s, pr, cycle = true)

sb = ls.scope(at = vec3(0, 0, 0), yaw = 0.0, size = vec3(10.0, 6.4, 0.4), kind = 0)
pb = lsp.pattern_add(lsp.pattern_add(lsp.pattern_add(lsp.pattern_empty(), size = 1.0, kind = 3), size = 1.0, kind = 4, flex = true), size = 0.6, kind = 5)
bands = lsp.split(sb, pb, axis = 1)

sr = ls.scope(at = vec3(10, 0, 0), yaw = 90.0, size = vec3(6.0, 3.0, 0.4), kind = 0)
rot = lsp.split(sr, pf)

merged = merge(fixed, bands)

output fixed
output flexed
output rep
output bands
output rot
output merged
